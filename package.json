{
  "name": "dentalempireos",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "test:scanner-reminders": "node --experimental-strip-types --test tests/scanner-action-plan-reminders.test.ts",
    "portfolio:source": "node scripts/clinical-content-portfolio-deck.mjs",
    "portfolio:pdf": "npm run portfolio:source && node scripts/render-clinical-content-portfolio.mjs",
    "resources:generate": "node --experimental-strip-types scripts/generate-clinic-resources.mjs",
    "resources:import:dry-run": "node --experimental-strip-types scripts/import-clinic-resources.mjs --dry-run",
    "resources:import": "node --experimental-strip-types scripts/import-clinic-resources.mjs --remote",
    "db:migrate": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply DB --remote",
    "db:seed": "node scripts/generate-mdx-migration.js > migrations/seed-books.sql && wrangler d1 execute DB --file=migrations/seed-books.sql --remote",
    "db:seed:local": "node scripts/generate-mdx-migration.js > migrations/seed-books.sql && wrangler d1 execute DB --file=migrations/seed-books.sql --local",
    "db:seed:blog": "wrangler d1 execute DB --file=migrations/seed-blog.sql --remote",
    "db:seed:blog:local": "wrangler d1 execute DB --file=migrations/seed-blog.sql --local",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@better-auth/infra": "^0.3.7",
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-bubble-menu": "^3.27.1",
    "@tiptap/extension-code-block-lowlight": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-subscript": "^3.27.1",
    "@tiptap/extension-superscript": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "astro": "^7.2.0",
    "better-auth": "^1.6.26",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^3.19.0",
    "kysely": "^0.29.4",
    "kysely-d1": "^0.4.0",
    "lowlight": "^3.3.0",
    "marked": "^18.0.9",
    "pdf-lib": "^1.17.1",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
