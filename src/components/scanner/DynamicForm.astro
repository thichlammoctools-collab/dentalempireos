---
// DynamicForm: Generic multi-step form that renders any survey_definition from DB.
// Pass surveyData (JSON-serializable) as a prop — generated by the parent page.
//
// Replaces SurveyForm.astro. Differences:
//   - No hardcoded question data — reads everything from the prop
//   - All question types (textarea/select/radio/yesno) supported
//   - Translations (VI/EN) come from the definition
//   - localStorage draft persistence keyed by survey id
//   - Submits JSON body to /api/scanner/submit

interface ClinicProfile {
  id: string;
  name: string | null;
  clinic_name: string | null;
  clinic_address: string | null;
  phone: string | null;
  logo_url: string | null;
}

interface Props {
  surveyData: {
    id: string;
    slug: string;
    title_vi: string;
    title_en: string;
    description_vi: string | null;
    description_en: string | null;
    lead_fields: Record<string, any>;
    translations_vi: Record<string, string>;
    translations_en: Record<string, string>;
    sections: Array<{
      id: number;
      title_vi: string;
      title_en: string;
      subtitle_vi: string | null;
      subtitle_en: string | null;
      ref: string | null;
      questions: Array<{
        id: number;
        question_id: string;
        type: 'textarea' | 'select' | 'radio' | 'yesno';
        label_vi: string;
        label_en: string;
        placeholder_vi: string | null;
        placeholder_en: string | null;
        options_vi: string[] | null;
        options_en: string[] | null;
        scale_labels_vi: Record<string, string> | null;
        scale_labels_en: Record<string, string> | null;
        required: number;
        anchor: number;
      }>;
    }>;
  };
  clinicProfile?: ClinicProfile | null;
}

const { surveyData, clinicProfile } = Astro.props;

const defaultScaleVi: Record<string, string> = {
  '1': 'Chưa có',
  '2': 'Đang bắt đầu',
  '3': 'Đã có nhưng chưa ổn định',
  '4': 'Ổn định',
  '5': 'Đầu tàu và nhất quán',
};

const defaultScaleEn: Record<string, string> = {
  '1': 'Not yet',
  '2': 'Starting',
  '3': 'Inconsistent',
  '4': 'Stable',
  '5': 'Exemplary',
};
---

<div id="survey-form" class="survey-wrap" data-default-lang="vi" data-survey-id={surveyData.id} data-survey-slug={surveyData.slug} data-survey={JSON.stringify(surveyData)} data-clinic={clinicProfile ? JSON.stringify(clinicProfile) : ''} data-scale-vi={JSON.stringify(defaultScaleVi)} data-scale-en={JSON.stringify(defaultScaleEn)}>
  <!-- Language toggle -->
  <div class="lang-toggle">
    <button type="button" class="lang-btn active" data-lang="vi">Tiếng Việt</button>
    <button type="button" class="lang-btn" data-lang="en">English</button>
  </div>

  <!-- Stepper -->
  <div class="stepper">
    <div class="stepper-fill" id="stepper-fill"></div>
  </div>
  <div class="step-labels" id="step-labels"></div>

  <!-- Intro card -->
  <div class="card intro-card" id="card-intro">
    <h1 class="form-title" id="intro-title">{surveyData.title_vi}</h1>
    <p class="form-desc" id="intro-desc">{surveyData.description_vi ?? ''}</p>

    <div class="form-section">
      <h2 class="section-title" id="intro-info-title">Thông tin cơ bản</h2>
      <div id="intro-fields"></div>
    </div>

    <div class="nav-buttons">
      <div></div>
      <button type="button" class="btn btn-primary" id="btn-start">Bắt đầu →</button>
    </div>
  </div>

  <!-- Question cards -->
  <div id="parts-container"></div>

  <!-- Submit card -->
  <div class="card submit-card hidden" id="card-submit">
    <h2 class="section-title" id="submit-title">Sẵn sàng gửi?</h2>
    <p class="form-desc" id="submit-desc">Hệ thống sẽ lưu hồ sơ và bắt đầu phân tích...</p>

    <div class="nav-buttons">
      <button type="button" class="btn btn-ghost" id="btn-back-submit">← Quay lại</button>
      <button type="button" class="btn btn-primary" id="btn-submit">
        <span id="submit-btn-label">Gửi</span>
      </button>
    </div>

    <p id="submit-error" class="error-text hidden"></p>
  </div>
</div>

<script>
  // Read ALL data from data attributes — define:vars causes SSR stream truncation in Astro
  const wrap = document.getElementById('survey-form');
  if (!(wrap instanceof HTMLElement)) throw new Error('Survey form container is missing.');

  type LeadField = {
    label_vi?: string;
    label_en?: string;
    placeholder_vi?: string;
    placeholder_en?: string;
    type?: string;
    required?: boolean | number;
  };
  type Question = {
    id: number;
    question_id: string;
    type: 'textarea' | 'select' | 'radio' | 'yesno';
    label_vi: string;
    label_en: string;
    placeholder_vi?: string | null;
    placeholder_en?: string | null;
    options_vi?: string[] | null;
    options_en?: string[] | null;
    scale_labels_vi?: Record<string, string> | null;
    scale_labels_en?: Record<string, string> | null;
    required?: number;
    anchor?: number;
  };
  type Section = {
    id: number;
    title_vi: string;
    title_en: string;
    subtitle_vi?: string | null;
    subtitle_en?: string | null;
    ref?: string | null;
    questions: Question[];
  };
  type SurveyData = {
    id: string;
    title_vi: string;
    title_en: string;
    description_vi?: string | null;
    description_en?: string | null;
    lead_fields?: Record<string, LeadField>;
    translations_vi?: Record<string, string>;
    translations_en?: Record<string, string>;
    sections: Section[];
  };
  type AnswerRecord = Record<string, string | null> & { lang: string; survey_id: string };
  type SubmitResponse = { error?: string; requiresAuth?: boolean; redirect?: string };

  function getSubmitErrorMessage(error: string | undefined): string {
    if (error === 'action_plan_read_only') {
      return currentLang === 'vi'
        ? 'Kế hoạch hành động này chỉ xem và không thể tạo lần quét lại được liên kết.'
        : 'This action plan is read-only and cannot be used for a linked rescan.';
    }
    if (error === 'action_plan_unavailable') {
      return currentLang === 'vi'
        ? 'Kế hoạch hành động này không còn khả dụng để tạo lần quét lại được liên kết.'
        : 'This action plan is no longer available for a linked rescan.';
    }
    return error || 'Submit failed';
  }

  function requiredElement<T extends HTMLElement>(id: string): T {
    const element = document.getElementById(id);
    if (!(element instanceof HTMLElement)) throw new Error(`Required element #${id} is missing.`);
    return element as T;
  }

  function formControl(selector: string): HTMLInputElement | HTMLTextAreaElement | null {
    const element = document.querySelector(selector);
    return element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement ? element : null;
  }

  const surveyData = JSON.parse(wrap.dataset.survey || '{}') as SurveyData;
  const rawProfile = wrap.dataset.clinic;
  const clinicProfile = rawProfile ? JSON.parse(rawProfile) as Record<string, string | null> : null;
  const defaultScaleVi = JSON.parse(wrap.dataset.scaleVi || '{}') as Record<string, string>;
  const defaultScaleEn = JSON.parse(wrap.dataset.scaleEn || '{}') as Record<string, string>;

  const STORAGE_KEY = `dentalempire-scanner-draft-${surveyData.id}`;

  const partsContainer = requiredElement<HTMLDivElement>('parts-container');
  const stepperFill = requiredElement<HTMLDivElement>('stepper-fill');
  const stepLabels = requiredElement<HTMLDivElement>('step-labels');
  const cardIntro = requiredElement<HTMLDivElement>('card-intro');
  const cardSubmit = requiredElement<HTMLDivElement>('card-submit');
  const btnStart = requiredElement<HTMLButtonElement>('btn-start');
  const btnSubmit = requiredElement<HTMLButtonElement>('btn-submit');
  const btnBackSubmit = requiredElement<HTMLButtonElement>('btn-back-submit');
  const submitError = requiredElement<HTMLParagraphElement>('submit-error');

  let currentLang = 'vi';
  let currentStep = -1;
  const answers: AnswerRecord = { lang: 'vi', survey_id: surveyData.id };
  let requestIdempotencyKey: string | null = null;
  let requestFingerprint: string | null = null;
  const partEls: HTMLDivElement[] = [];

  function t(vi: string | null | undefined, en: string | null | undefined): string {
    return currentLang === 'vi' ? (vi ?? en ?? '') : (en ?? vi ?? '');
  }

  function getTrans(key: string, fallbackVi: string, fallbackEn: string): string {
    const t = currentLang === 'vi'
      ? (surveyData.translations_vi?.[key] ?? fallbackVi)
      : (surveyData.translations_en?.[key] ?? fallbackEn);
    return t;
  }

  // ── Lead fields rendering ────────────────────────
  function buildIntroFields() {
    const container = requiredElement<HTMLDivElement>('intro-fields');
    container.innerHTML = '';
    const lead = surveyData.lead_fields ?? {};
    const order = ['owner_name', 'clinic_name', 'clinic_address', 'email', 'years_in_operation', 'staff_count'];

    for (const fieldName of order) {
      const cfg = lead[fieldName];
      if (!cfg) continue;
      const label = t(cfg.label_vi, cfg.label_en);
      const placeholder = t(cfg.placeholder_vi, cfg.placeholder_en);
      const type = cfg.type ?? (fieldName === 'email' ? 'email' : fieldName.includes('_operation') || fieldName.includes('_count') ? 'number' : 'text');
      const required = cfg.required ?? false;

      const div = document.createElement('div');
      div.className = 'form-row';
      div.innerHTML = `
        <div class="form-col">
          <label class="form-label">${escapeHtml(label)}${required ? ' <span class="req">*</span>' : ''}</label>
          <input
            type="${type}"
            name="${fieldName}"
            class="form-input"
            ${required ? 'required' : ''}
            placeholder="${escapeHtml(placeholder ? placeholder : '')}"
            ${type === 'number' ? 'min="0" max="500"' : ''}
          />
        </div>
      `;
      container.appendChild(div);
    }

    // Add "Save profile" checkbox if logged in
    if (clinicProfile) {
      const saveDiv = document.createElement('div');
      saveDiv.className = 'form-row';
      saveDiv.innerHTML = `
        <div class="form-col" style="grid-column:1/-1">
          <label class="save-profile-row">
            <input type="checkbox" id="save-profile-check" checked style="accent-color:var(--primary);width:16px;height:16px;" />
            <span class="form-label" style="margin:0;font-weight:400;color:var(--color-on-surface-variant);cursor:pointer;">
              ${currentLang === 'vi' ? 'Lưu thông tin này cho lần sau' : 'Save this info for next time'}
            </span>
          </label>
        </div>
      `;
      container.appendChild(saveDiv);
    }
  }

  // ── Draft persistence ────────────────────────────
  function saveDraft() {
    try {
      const data = {
        lang: currentLang,
        step: currentStep,
        answers,
        idempotencyKey: requestIdempotencyKey,
        requestFingerprint,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {}
  }

  function loadDraft() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const data = JSON.parse(raw);
      if (!data || typeof data !== 'object') return false;
      Object.assign(answers, data.answers ?? {});
      currentLang = (data.lang === 'en' ? 'en' : 'vi');
      currentStep = typeof data.step === 'number' ? data.step : -1;
      requestIdempotencyKey = typeof data.idempotencyKey === 'string' && data.idempotencyKey ? data.idempotencyKey : null;
      requestFingerprint = typeof data.requestFingerprint === 'string' && data.requestFingerprint ? data.requestFingerprint : null;
      return true;
    } catch {
      return false;
    }
  }

  function clearDraft() {
    requestIdempotencyKey = null;
    requestFingerprint = null;
    try { localStorage.removeItem(STORAGE_KEY); } catch {}
  }

  function stableStringify(value: unknown): string {
    if (value === null || typeof value !== 'object') return JSON.stringify(value);
    if (Array.isArray(value)) return `[${value.map(stableStringify).join(',')}]`;
    const record = value as Record<string, unknown>;
    return `{${Object.keys(record).sort().map((key) => `${JSON.stringify(key)}:${stableStringify(record[key])}`).join(',')}}`;
  }

  function submissionFingerprint(payload: Record<string, unknown>): string {
    const resultInputs: Record<string, string | null> = {};
    Object.keys(answers).sort().forEach((key) => {
      if (key !== 'lang' && key !== 'survey_id') resultInputs[key] = answers[key];
    });
    return stableStringify({
      surveyId: payload.survey_id,
      lang: payload.lang,
      ownerName: payload.owner_name ?? null,
      clinicName: payload.clinic_name ?? null,
      clinicAddress: payload.clinic_address ?? null,
      clinicPhone: payload.clinic_phone ?? null,
      email: payload.email ?? null,
      yearsInOperation: payload.years_in_operation ?? null,
      staffCount: payload.staff_count ?? null,
      responses: resultInputs,
      actionPlanId: payload.action_plan_id ?? null,
    });
  }

  function newIdempotencyKey(): string {
    if (typeof crypto.randomUUID === 'function') return crypto.randomUUID();
    const bytes = new Uint8Array(16);
    crypto.getRandomValues(bytes);
    return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
  }

  // ── Build part cards ─────────────────────────────
  function buildParts() {
    partsContainer.innerHTML = '';
    partEls.length = 0;

    surveyData.sections.forEach((section: Section, idx: number) => {
      const card = document.createElement('div');
      card.className = 'card part-card hidden';
      card.dataset.step = String(idx);
      card.dataset.sectionId = String(section.id);

      const ref = section.ref
        ? `<div class="part-ref">${escapeHtml(t(section.ref, section.ref))}</div>`
        : '';

      card.innerHTML = `
        <div class="part-header">
          ${ref}
          <h2 class="part-title">${escapeHtml(t(section.title_vi, section.title_en))}</h2>
          <p class="part-subtitle">${escapeHtml(t(section.subtitle_vi, section.subtitle_en))}</p>
        </div>
      `;

      section.questions.forEach((q: Question) => {
        const block = document.createElement('div');
        block.className = 'question' + (q.anchor ? ' anchor' : '');
        const anchorBadge = q.anchor
          ? `<span class="anchor-badge">⭐ ${currentLang === 'vi' ? 'Câu neo' : 'Anchor'}</span>`
          : '';

        let inputHtml = '';
        if (q.type === 'textarea') {
          inputHtml = `<textarea class="form-textarea" name="${q.question_id}" placeholder="${escapeHtml(t(q.placeholder_vi, q.placeholder_en) ?? '')}" ${q.required ? 'required' : ''}></textarea>`;
        } else if (q.type === 'select') {
          const labels = q.scale_labels_vi ?? defaultScaleVi;
          const enLabels = q.scale_labels_en ?? defaultScaleEn;
          const pills = [1, 2, 3, 4, 5].map((n) => {
            const labelText = currentLang === 'en'
              ? (enLabels[String(n)] ?? labels[String(n)] ?? '')
              : (labels[String(n)] ?? enLabels[String(n)] ?? '');
            return `
              <label class="scale-option">
                <input type="radio" name="${q.question_id}" value="${n}" ${q.required ? 'required' : ''} />
                <span class="scale-pill">
                  <span class="scale-num">${n}</span>
                  <span class="scale-text">${escapeHtml(labelText)}</span>
                </span>
              </label>
            `;
          }).join('');
          inputHtml = `<div class="scale-group">${pills}</div>`;
        } else if (q.type === 'radio') {
          const opts = q.options_vi ?? [];
          const enOpts = q.options_en ?? [];
          const options = opts.map((opt: string, i: number) => {
            const enOpt = enOpts[i] ?? opt;
            const display = currentLang === 'en' ? enOpt : opt;
            return `
              <label class="radio-option">
                <input type="radio" name="${q.question_id}" value="${escapeHtml(opt)}" ${q.required ? 'required' : ''} />
                <span class="radio-label">${escapeHtml(display)}</span>
              </label>
            `;
          }).join('');
          inputHtml = `<div class="radio-group">${options}</div>`;
        } else if (q.type === 'yesno') {
          const yesLabel = currentLang === 'vi' ? 'Có' : 'Yes';
          const noLabel = currentLang === 'vi' ? 'Chưa' : 'No';
          inputHtml = `
            <div class="radio-group">
              <label class="radio-option">
                <input type="radio" name="${q.question_id}" value="1" ${q.required ? 'required' : ''} />
                <span class="radio-label">${escapeHtml(yesLabel)}</span>
              </label>
              <label class="radio-option">
                <input type="radio" name="${q.question_id}" value="0" ${q.required ? 'required' : ''} />
                <span class="radio-label">${escapeHtml(noLabel)}</span>
              </label>
            </div>
          `;
        }

        block.innerHTML = `
          ${anchorBadge}
          <label class="q-label">${escapeHtml(t(q.label_vi, q.label_en))}</label>
          ${inputHtml}
        `;
        card.appendChild(block);
      });

      // Nav buttons
      const nav = document.createElement('div');
      nav.className = 'nav-buttons';
      nav.innerHTML = `
        <button type="button" class="btn btn-ghost" data-action="prev">← ${currentLang === 'vi' ? 'Quay lại' : 'Back'}</button>
        <button type="button" class="btn btn-primary" data-action="next">${currentLang === 'vi' ? 'Tiếp tục' : 'Next'} →</button>
      `;
      card.appendChild(nav);

      nav.querySelector('[data-action="prev"]')?.addEventListener('click', () => goTo(currentStep - 1));
      nav.querySelector('[data-action="next"]')?.addEventListener('click', () => goTo(currentStep + 1));

      card.addEventListener('change', (e) => { saveFromEvent(e); saveDraft(); });
      card.addEventListener('input', (e) => { saveFromEvent(e); saveDraft(); });

      partsContainer.appendChild(card);
      partEls.push(card);
    });

    applyAnswersToDom();
  }

  function saveFromEvent(e: Event) {
    const target = e.target;
    if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) || !target.name) return;
    answers[target.name] = target.value;
  }

  function applyAnswersToDom() {
    document.querySelectorAll('input, textarea').forEach((element) => {
      const el = element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement ? element : null;
      if (!el) return;
      if (!el.name) return;
      const val = answers[el.name];
      if (val == null || val === '') return;
      if (el instanceof HTMLInputElement && el.type === 'radio') {
        if (el.value === String(val)) el.checked = true;
      } else {
        el.value = String(val);
      }
    });
  }

  // ── Step labels ─────────────────────────────────
  function buildStepLabels() {
    const labels = surveyData.sections.map((section: Section, idx: number) => {
      const title = t(section.title_vi, section.title_en);
      const num = title.match(/^\s*(?:PHẦN|PART)\s*(\d+)/i);
      const n = num ? num[1] : String(idx + 1);
      return `<span data-step-idx="${idx}">${n}</span>`;
    });
    labels.push(`<span data-step-idx="${surveyData.sections.length}">${currentLang === 'vi' ? 'Gửi' : 'Submit'}</span>`);
    stepLabels.innerHTML = labels.join('');
  }

  // ── Navigation ──────────────────────────────────
  function goTo(step: number) {
    if (step < -1 || step > surveyData.sections.length) return;

    // Validate intro required fields when leaving intro
    if (currentStep === -1 && step >= 0) {
      const lead = surveyData.lead_fields ?? {};
      for (const [fieldName, cfg] of Object.entries(lead)) {
        if (cfg?.required) {
          const el = formControl(`[name="${fieldName}"]`);
          if (!el?.value?.trim()) {
            alert(currentLang === 'vi' ? 'Vui lòng điền đầy đủ thông tin bắt buộc.' : 'Please fill all required fields.');
            return;
          }
        }
      }
      // Save intro fields
      ['owner_name', 'clinic_name', 'clinic_address', 'email', 'years_in_operation', 'staff_count'].forEach((k) => {
        const el = formControl(`[name="${k}"]`);
        if (el) answers[k] = el.value || null;
      });
    }

    currentStep = step;
    cardIntro.classList.toggle('hidden', step !== -1);
    cardSubmit.classList.toggle('hidden', step !== surveyData.sections.length);
    partEls.forEach((el, i) => el.classList.toggle('hidden', i !== step));

    // Stepper
    const progress = step < 0 ? 0 : step >= surveyData.sections.length ? 100 : Math.round((step / surveyData.sections.length) * 100);
    stepperFill.style.width = `${progress}%`;

    stepLabels.querySelectorAll('span').forEach((s) => {
      const idx = parseInt(s.dataset.stepIdx ?? '-1', 10);
      s.classList.toggle('active', idx === step);
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });
    saveDraft();
  }

  // ── Submit ──────────────────────────────────────
  async function submit() {
    submitError.classList.add('hidden');
    btnSubmit.disabled = true;
    const original = btnSubmit.innerHTML;
    btnSubmit.innerHTML = `<span>${getTrans('submitting', 'Đang xử lý...', 'Processing...')}</span>`;

    // Final read of all fields
    document.querySelectorAll('input, textarea').forEach((element) => {
      const el = element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement ? element : null;
      if (!el) return;
      if (el.name && (el.type === 'text' || el.type === 'email' || el.type === 'number' || el.tagName === 'TEXTAREA')) {
        if (el.value) answers[el.name] = el.value;
      }
    });
    answers.lang = currentLang;

    // Check auth — redirect to login if not logged in
    if (!clinicProfile) {
      const currentUrl = encodeURIComponent(window.location.pathname);
      window.location.href = `/login?redirect=${currentUrl}`;
      return;
    }

    // Show save checkbox if clinicProfile exists
    const saveProfileCheck = document.getElementById('save-profile-check');
    const saveChecked = saveProfileCheck instanceof HTMLInputElement && saveProfileCheck.checked;

    try {
      const payload: Record<string, unknown> = { ...answers, save_profile: saveChecked };
      const nextFingerprint = submissionFingerprint(payload);
      if (requestFingerprint !== nextFingerprint || !requestIdempotencyKey) {
        requestFingerprint = nextFingerprint;
        requestIdempotencyKey = newIdempotencyKey();
      }
      // Persist before the first request so lost responses and reloads retry the
      // same server-validated submission rather than creating another report.
      saveDraft();
      payload.idempotency_key = requestIdempotencyKey;
      const res = await fetch('/api/scanner/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Idempotency-Key': requestIdempotencyKey },
        body: JSON.stringify(payload),
      });
      const data = await res.json() as SubmitResponse;

      if (!res.ok) {
        if (data.requiresAuth) {
          const currentUrl = encodeURIComponent(window.location.pathname);
          window.location.href = `/login?redirect=${currentUrl}`;
          return;
        }
        throw new Error(getSubmitErrorMessage(data.error));
      }
      clearDraft();
      window.location.href = data.redirect || `/scanner/result/${surveyData.id}`;
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Submit failed';
      submitError.textContent = msg;
      submitError.classList.remove('hidden');
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = original;
    }
  }

  // ── Language switching ──────────────────────────
  function setLang(lang: string | undefined, skipNav = false) {
    if (lang !== 'vi' && lang !== 'en') return;
    currentLang = lang;
    answers.lang = lang;

    document.querySelectorAll('.lang-btn').forEach((button) => {
      if (button instanceof HTMLButtonElement) {
        button.classList.toggle('active', button.dataset.lang === lang);
      }
    });

    // Update intro
    buildIntroFields();
    requiredElement<HTMLElement>('intro-title').textContent = t(surveyData.title_vi, surveyData.title_en);
    requiredElement<HTMLElement>('intro-desc').textContent = t(surveyData.description_vi, surveyData.description_en) || '';
    requiredElement<HTMLElement>('intro-info-title').textContent =
      currentLang === 'vi' ? 'Thông tin cơ bản' : 'Basic Information';
    requiredElement<HTMLElement>('submit-title').textContent =
      getTrans('submit_title', 'Sẵn sàng gửi?', 'Ready to submit?');
    requiredElement<HTMLElement>('submit-desc').textContent =
      getTrans('submit_desc', 'Hệ thống sẽ lưu hồ sơ và bắt đầu phân tích...', 'We will save your profile and begin the AI analysis...');
    requiredElement<HTMLElement>('submit-btn-label').textContent =
      getTrans('submitButton', 'Gửi Hồ Sơ', 'Submit Profile');
    btnStart.textContent = getTrans('start', 'Bắt đầu →', 'Start →');
    btnBackSubmit.textContent = getTrans('back', '← Quay lại', '← Back');

    buildParts();
    buildStepLabels();
    if (!skipNav) goTo(currentStep);
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    } as Record<string, string>)[c] ?? c);
  }

  // ── Init ────────────────────────────────────────
  const hasDraft = loadDraft();
  setLang(currentLang, true);

  document.querySelectorAll('.lang-btn').forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    button.addEventListener('click', () => { setLang(button.dataset.lang); saveDraft(); });
  });
  btnStart.addEventListener('click', () => goTo(0));
  btnSubmit.addEventListener('click', () => submit());
  btnBackSubmit.addEventListener('click', () => goTo(surveyData.sections.length - 1));

  // Populate intro from draft, then clinicProfile
  buildIntroFields();
  document.querySelectorAll('.intro-card input[name]').forEach((element) => {
    if (!(element instanceof HTMLInputElement)) return;
    const el = element;
    const v = answers[el.name];
    if (v != null && v !== '') {
      el.value = String(v);
    } else if (clinicProfile && el.name) {
      // Prefill from clinic profile if no draft value
      const val = clinicProfile[el.name];
      if (val) el.value = String(val);
    }
  });

  if (hasDraft && typeof currentStep === 'number' && currentStep >= 0 && currentStep < surveyData.sections.length) {
    goTo(currentStep);

    const banner = document.createElement('div');
    banner.id = 'restore-banner';
    banner.innerHTML = `
      <div style="background:rgba(59,130,246,0.15); border:1px solid rgba(59,130,246,0.3); border-radius:0.5rem; padding:0.75rem 1rem; margin-bottom:1rem; display:flex; justify-content:space-between; align-items:center; gap:0.5rem; flex-wrap:wrap;">
         <span style="color:var(--color-on-surface); font-size:0.85rem;">
          ${currentLang === 'vi' ? '📋 Bạn có bản nháp chưa hoàn thành.' : '📋 You have an unfinished draft.'}
        </span>
         <button type="button" id="clear-draft-btn" style="background:transparent; border:1px solid var(--color-outline-variant); color:var(--color-on-surface-variant); border-radius:0.375rem; padding:0.3rem 0.75rem; font-size:0.8rem; cursor:pointer; white-space:nowrap;">
          ${currentLang === 'vi' ? 'Xoá & bắt đầu lại' : 'Clear & start over'}
        </button>
      </div>
    `;
    wrap.insertBefore(banner, wrap.children[1]);
    document.getElementById('clear-draft-btn')?.addEventListener('click', () => {
      clearDraft();
      window.location.reload();
    });
  } else {
    currentStep = -1;
    goTo(-1);
  }
</script>

