---
interface Props {
  planId: string;
  compact?: boolean;
  readOnly?: boolean;
}

const { planId, compact = false, readOnly = false } = Astro.props;
---

<section
  class:list={['action-plan-checklist', compact && 'action-plan-checklist--compact']}
  data-action-plan-checklist
  data-plan-id={planId}
  data-read-only={readOnly ? 'true' : 'false'}
  aria-labelledby={`action-plan-heading-${planId}`}
>
  <div class="action-plan-checklist__header">
    <div>
      <p class="action-plan-checklist__eyebrow">Kế hoạch hành động</p>
      <h2 id={`action-plan-heading-${planId}`} class="action-plan-checklist__title">Danh sách ưu tiên</h2>
    </div>
    <span class="action-plan-checklist__summary" data-progress-summary>Đang tải tiến độ…</span>
  </div>
  <p id={`action-plan-read-only-${planId}`} class="action-plan-checklist__message" data-plan-message aria-live="polite">Đang tải các việc cần làm của bạn.</p>
  <div class="action-plan-checklist__actions" data-plan-actions></div>
  {compact && (
    <div class="action-plan-checklist__footer" data-plan-footer hidden>
      <a data-plan-detail class="action-plan-checklist__link">
        Mở kế hoạch đầy đủ
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
      <a data-plan-comparison class="action-plan-checklist__link" hidden>
        So sánh lần quét lại
        <span class="material-symbols-outlined" aria-hidden="true">compare_arrows</span>
      </a>
    </div>
  )}
</section>

<script src="/scripts/action-plan-checklist.js?v=20260814-colored-metadata-tags" is:inline></script>

<style is:global>
  .action-plan-checklist { margin: 0 0 1.25rem; padding: 1.25rem; color: var(--color-on-surface); background: var(--color-surface); border: 1px solid var(--color-outline-variant); border-radius: 1rem; }
  .action-plan-checklist__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .action-plan-checklist__eyebrow { margin: 0 0 .2rem; color: var(--color-primary); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .action-plan-checklist__title { margin: 0; font-size: 1.15rem; font-weight: 750; }
  .action-plan-checklist__summary { flex: none; padding: .3rem .55rem; color: var(--color-primary); background: color-mix(in srgb, var(--color-primary-container) 58%, transparent); border-radius: 999px; font-size: .75rem; font-weight: 700; white-space: nowrap; }
  .action-plan-checklist__message { margin: .75rem 0 0; color: var(--color-on-surface-variant); font-size: .85rem; line-height: 1.5; }
  .action-plan-checklist__actions { display: grid; gap: .65rem; margin-top: 1rem; }
  .action-plan-checklist__action { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .75rem; padding: .85rem; background: var(--color-surface-container); border: 1px solid var(--color-outline-variant); border-radius: .75rem; }
  .action-plan-checklist__action-title { margin: 0; color: var(--color-on-surface); font-size: .9rem; font-weight: 700; line-height: 1.4; }
  .action-plan-checklist__action-description { margin: .3rem 0 0; color: var(--color-on-surface-variant); font-size: .78rem; line-height: 1.5; }
  .action-plan-checklist__meta { display: flex; flex-wrap: wrap; gap: .4rem; margin: .6rem 0 0; }
  .action-plan-checklist__tag { display: inline-flex; align-items: center; min-height: 1.65rem; padding: .2rem .5rem; color: var(--color-on-surface-variant); background: var(--color-surface); border: 1px solid var(--color-outline-variant); border-radius: 999px; font-size: .7rem; font-weight: 700; line-height: 1.2; white-space: nowrap; }
  .action-plan-checklist__tag--category { color: var(--color-on-secondary-container); background: color-mix(in srgb, var(--color-secondary-container) 72%, var(--color-surface)); border-color: color-mix(in srgb, var(--color-secondary) 38%, var(--color-outline-variant)); }
  .action-plan-checklist__tag--priority-high { color: var(--color-on-error-container); background: color-mix(in srgb, var(--color-error-container) 72%, var(--color-surface)); border-color: color-mix(in srgb, var(--color-error) 42%, var(--color-outline-variant)); }
  .action-plan-checklist__tag--priority-medium { color: var(--color-on-tertiary-container); background: color-mix(in srgb, var(--color-warning-container) 72%, var(--color-surface)); border-color: color-mix(in srgb, var(--color-warning) 45%, var(--color-outline-variant)); }
  .action-plan-checklist__tag--priority-low { color: var(--color-on-surface-variant); background: var(--color-surface-container-high); }
  .action-plan-checklist__tag--target { color: var(--color-on-primary-container); background: color-mix(in srgb, var(--color-primary-container) 56%, var(--color-surface)); border-color: color-mix(in srgb, var(--color-primary) 42%, var(--color-outline-variant)); }
  .dark .action-plan-checklist__tag--category { color: var(--color-secondary-fixed); }
  .dark .action-plan-checklist__tag--priority-high { color: var(--color-error); }
  .dark .action-plan-checklist__tag--priority-medium { color: var(--color-tertiary-fixed); }
  .dark .action-plan-checklist__tag--priority-low { color: var(--color-on-surface); }
  .dark .action-plan-checklist__tag--target { color: var(--color-primary-fixed); }
  .action-plan-checklist__status-label { display: grid; gap: .3rem; align-self: start; color: var(--color-on-surface-variant); font-size: .7rem; font-weight: 700; letter-spacing: .01em; }
  .action-plan-checklist__status {
    --status-color: var(--color-primary);
    --status-background: color-mix(in srgb, var(--color-primary-container) 52%, var(--color-surface));
    min-width: 9.5rem;
    padding: .48rem 1.9rem .48rem .8rem;
    color: var(--color-on-surface);
    background-color: var(--status-background);
    border: 1px solid color-mix(in srgb, var(--status-color) 56%, var(--color-outline-variant));
    border-radius: 999px;
    font: inherit;
    font-size: .78rem;
    font-weight: 700;
    line-height: 1.25;
    cursor: pointer;
  }
  .action-plan-checklist__status[data-status="in_progress"] { --status-color: var(--color-warning); --status-background: color-mix(in srgb, var(--color-warning-container) 68%, var(--color-surface)); }
  .action-plan-checklist__status[data-status="completed"] { --status-color: var(--color-success); --status-background: color-mix(in srgb, var(--color-success-container) 72%, var(--color-surface)); }
  .action-plan-checklist__status[data-status="skipped"] { --status-color: var(--color-outline); --status-background: color-mix(in srgb, var(--color-surface-container-high) 76%, var(--color-surface)); }
  .action-plan-checklist__status:hover:not(:disabled) { border-color: var(--status-color); }
  .action-plan-checklist__status:disabled { opacity: .72; cursor: not-allowed; }
  .action-plan-checklist__status:focus-visible, .action-plan-checklist__link:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .action-plan-checklist__footer { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; padding-top: .9rem; border-top: 1px solid var(--color-outline-variant); }
  .action-plan-checklist__link { display: inline-flex; align-items: center; gap: .25rem; color: var(--color-primary); font-size: .82rem; font-weight: 700; text-decoration: none; }
  .action-plan-checklist__link:hover { text-decoration: underline; }
  .action-plan-checklist__link .material-symbols-outlined { font-size: 1rem; }
  .action-plan-checklist--compact { margin: 0 0 1.25rem; border-radius: .75rem; }
  .action-plan-checklist--compact .action-plan-checklist__action-description { display: none; }
  @media (max-width: 640px) {
    .action-plan-checklist { padding: 1rem; }
    .action-plan-checklist__header, .action-plan-checklist__action { grid-template-columns: 1fr; }
    .action-plan-checklist__header { display: grid; }
    .action-plan-checklist__summary { justify-self: start; }
    .action-plan-checklist__status-label { width: 100%; }
    .action-plan-checklist__status { width: 100%; }
  }
</style>
