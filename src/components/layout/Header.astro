---
const navLinks = [
  { href: '/about', label: 'Giới thiệu' },
  { href: '/dich-vu', label: 'Dịch vụ' },
  { href: '/blog', label: 'Tin Tức' },
  { href: '/resources', label: 'Tài nguyên' },
  { href: '/scanner', label: 'Scanner', badge: 'AI' },
  { href: '/book', label: 'Đọc ngay', cta: true },
];

const mobileHeaderLinks = [
  { href: '/', label: 'Trang chủ', icon: 'home' },
  { href: '/about', label: 'Giới thiệu', icon: 'info' },
  { href: '/dich-vu', label: 'Dịch vụ', icon: 'handshake' },
  { href: '/courses', label: 'Khóa học', icon: 'play_circle' },
];

const currentPath = Astro.url.pathname;
const currentHash = Astro.url.hash;
const user = Astro.locals.user;
---

<header class="fixed top-0 w-full z-50 bg-surface-container-lowest glass-nav border-b border-outline-variant h-20">
  <div class="flex justify-between items-center w-full px-6 max-w-[1200px] mx-auto h-full">
    <!-- Logo -->
    <a href="/" class="hidden lg:flex items-center hover:opacity-80 transition-opacity">
      <img src="/images/logo-header.png" alt="Dental Empire" class="h-10 w-auto" width="140" height="46" fetchpriority="high" decoding="async" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Điều hướng chính">
      {navLinks.slice(0, 6).map((link) => {
        const isAnchorLink = link.href.startsWith('/#');
        const isActive = isAnchorLink
          ? currentPath === '/' && currentHash === link.href.slice(1)
          : link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'label-md font-semibold transition-colors flex items-center gap-1.5',
              link.cta
                ? 'rounded-lg bg-primary px-4 py-2 text-on-primary shadow-sm hover:bg-primary/90 hover:shadow-md'
                : isActive
                ? 'text-primary border-b-2 border-primary pb-1'
                : 'text-on-surface-variant hover:text-primary',
            ]}
          >
            {link.label}
            {link.badge && (
              <span class="px-1.5 py-0.5 bg-amber-500 text-[9px] font-bold text-black rounded-full leading-none">
                {link.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <div class="lg:hidden flex items-center justify-between w-full">
      {mobileHeaderLinks.map((link) => {
        const isActive = link.href === '/'
          ? currentPath === '/'
          : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            aria-label={link.label}
            class:list={[
              'flex items-center justify-center w-9 h-9 rounded-lg transition-all',
              isActive
                ? 'text-primary bg-primary/10'
                : 'text-on-surface-variant hover:text-primary hover:bg-surface-container',
            ]}
          >
            <span class="material-symbols-outlined text-xl">{link.icon}</span>
          </a>
        );
      })}

      <!-- Mobile: theme toggle -->
      <button
        id="mobile-home-theme-toggle"
        type="button"
        role="switch"
        aria-checked="false"
        class="flex items-center justify-center w-9 h-9 rounded-lg text-on-surface-variant hover:text-primary hover:bg-surface-container transition-all"
        title="Đổi giao diện sáng/tối"
        aria-label="Đổi giao diện sáng/tối"
      >
        <span id="mobile-home-theme-icon" class="material-symbols-outlined text-xl">light_mode</span>
      </button>
    </div>

    <!-- Right side (desktop only) -->
    <div class="hidden lg:flex items-center gap-4">
      <button
        id="desktop-theme-toggle"
        type="button"
        role="switch"
        aria-checked="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors"
        title="Đổi giao diện"
      >
        <span id="desktop-theme-icon" class="material-symbols-outlined text-[20px]">light_mode</span>
      </button>
      <!-- Auth state: keep a stable slot while the session is loading. -->
      <div id="auth-slot" class:list={['min-w-[280px]', user ? '' : 'invisible']} aria-busy={user ? 'false' : 'true'}>
        <!-- Auth: logged-out state -->
        <div id="auth-logged-out" class:list={['items-center justify-end gap-2', user ? 'hidden' : 'hidden']}>
          <a
            href="/login"
            class="px-4 py-2 label-md font-semibold text-on-surface-variant hover:text-primary transition-colors"
          >
            Đăng nhập
          </a>
          <a
            href="/register"
            class="px-5 py-2.5 btn-primary-metallic font-bold rounded-lg label-md"
          >
            Đăng ký
          </a>
        </div>

        <!-- Auth: logged-in state -->
        <div id="auth-logged-in" class:list={['items-center justify-end gap-3', user ? 'flex' : 'hidden']}>
          <a
            id="auth-wallet-link"
            href="/account/wallet"
            class="hidden items-center gap-1.5 rounded-lg bg-primary/10 px-2.5 py-1.5 text-xs font-bold text-primary transition hover:bg-primary/20"
            aria-label="Ví Credits"
          >
            <span class="material-symbols-outlined text-base">account_balance_wallet</span>
            <span id="auth-credit-balance">0</span>
          </a>
          <a
            id="auth-profile-link"
            href="/account/profile"
            class="flex items-center gap-2 p-1 rounded-full text-on-surface-variant hover:text-primary transition-all group focus-visible:ring-2 focus-visible:ring-primary focus:outline-none"
            title={user ? (user.name ? `${user.name} (${user.email || ''})` : (user.email || 'Hồ sơ cá nhân')) : 'Hồ sơ cá nhân'}
            aria-label={user ? (user.name || user.email || 'Hồ sơ cá nhân') : 'Hồ sơ cá nhân'}
          >
            <div class="relative w-8 h-8 rounded-full overflow-hidden flex items-center justify-center bg-surface-container-high border border-outline-variant/40 group-hover:border-primary/50 transition-colors flex-shrink-0">
              <img
                id="auth-user-avatar"
                src={user?.image || ''}
                alt={user?.name || 'Avatar'}
                class:list={[
                  'w-full h-full object-cover rounded-full',
                  user?.image ? '' : 'hidden',
                ]}
                loading="lazy"
                onerror="this.classList.add('hidden'); const fb = this.nextElementSibling; if (fb) fb.classList.remove('hidden');"
              />
              <span
                id="auth-user-avatar-fallback"
                class:list={[
                  'material-symbols-outlined text-[20px] text-on-surface-variant group-hover:text-primary transition-colors',
                  user?.image ? 'hidden' : '',
                ]}
              >
                account_circle
              </span>
            </div>
            <span id="auth-user-email" class="hidden"></span>
          </a>
          <button
            id="auth-logout"
            class="flex items-center gap-2 px-4 py-2 label-md font-semibold btn-icon text-on-surface-variant hover:text-primary"
          >
            <span class="material-symbols-outlined text-[20px]">logout</span>
            Đăng xuất
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { getSession, signOut } from '../../lib/auth-client';
  import { onThemeChange, toggleTheme, updateThemeToggle } from '../../scripts/theme';

  function updateHeaderAvatar(user: { image?: string | null; name?: string | null; email?: string | null } | null) {
    const avatarImg = document.getElementById('auth-user-avatar') as HTMLImageElement | null;
    const avatarFallback = document.getElementById('auth-user-avatar-fallback');
    const profileLink = document.getElementById('auth-profile-link');
    const userEmailSpan = document.getElementById('auth-user-email');

    if (!user) {
      if (avatarImg) {
        avatarImg.src = '';
        avatarImg.classList.add('hidden');
      }
      avatarFallback?.classList.remove('hidden');
      if (userEmailSpan) userEmailSpan.textContent = '';
      return;
    }

    const titleText = user.name ? `${user.name} (${user.email || ''})` : (user.email || 'Hồ sơ cá nhân');
    if (profileLink) {
      profileLink.setAttribute('title', titleText);
      profileLink.setAttribute('aria-label', titleText);
    }
    if (userEmailSpan) {
      userEmailSpan.textContent = user.name || user.email || '';
    }

    if (user.image && avatarImg) {
      avatarImg.src = user.image;
      avatarImg.alt = user.name || 'Avatar';
      avatarImg.classList.remove('hidden');
      avatarFallback?.classList.add('hidden');
      avatarImg.onerror = () => {
        avatarImg.classList.add('hidden');
        avatarFallback?.classList.remove('hidden');
      };
    } else {
      if (avatarImg) {
        avatarImg.src = '';
        avatarImg.classList.add('hidden');
      }
      avatarFallback?.classList.remove('hidden');
    }
  }

  async function initAuthState() {
    const authSlot = document.getElementById('auth-slot');

    try {
      const { data } = await getSession();
      const loggedIn = !!data?.user;

      const show = (id: string, display: string) => {
        const el = document.getElementById(id);
        if (el) {
          el.classList.remove('hidden');
          el.classList.add(display);
        }
      };

      const hide = (id: string, display: string) => {
        const el = document.getElementById(id);
        if (el) {
          el.classList.add('hidden');
          el.classList.remove(display);
        }
      };

      if (loggedIn && data?.user) {
        hide('auth-logged-out', 'flex');
        show('auth-logged-in', 'flex');
        updateHeaderAvatar(data.user);
        try {
          const walletResponse = await fetch('/api/credits/wallet');
          if (walletResponse.ok) {
            const wallet = await walletResponse.json() as { balance?: { available?: number } };
            const balance = document.getElementById('auth-credit-balance');
            if (balance) balance.textContent = String(wallet.balance?.available ?? 0);
            show('auth-wallet-link', 'inline-flex');
          }
        } catch {
          // The account area remains usable if a migration is not deployed yet.
        }
      } else {
        hide('auth-logged-in', 'flex');
        show('auth-logged-out', 'flex');
        updateHeaderAvatar(null);
      }

      document.getElementById('auth-logout')?.addEventListener('click', async () => {
        await signOut();
        window.location.href = '/';
      });
    } catch {
      const loggedOut = document.getElementById('auth-logged-out');
      const loggedIn = document.getElementById('auth-logged-in');
      loggedIn?.classList.add('hidden');
      loggedIn?.classList.remove('flex');
      loggedOut?.classList.remove('hidden');
      loggedOut?.classList.add('flex');
      updateHeaderAvatar(null);
    } finally {
      authSlot?.classList.remove('invisible');
      authSlot?.removeAttribute('aria-busy');
    }
  }

  // Listen for user avatar updates across windows/components
  window.addEventListener('user-avatar-updated', ((e: CustomEvent<{ image?: string; name?: string }>) => {
    if (e.detail?.image !== undefined) {
      updateHeaderAvatar({ image: e.detail.image, name: e.detail.name });
    }
  }) as EventListener);

  // Resolve auth immediately; the surrounding slot prevents layout shift.
  void initAuthState();

  const desktopThemeToggle = document.getElementById('desktop-theme-toggle');
  const desktopThemeIcon = document.getElementById('desktop-theme-icon');
  const mobileHomeThemeToggle = document.getElementById('mobile-home-theme-toggle');
  const mobileHomeThemeIcon = document.getElementById('mobile-home-theme-icon');
  const syncDesktopTheme = () => updateThemeToggle(desktopThemeToggle, null, desktopThemeIcon);
  const syncMobileHomeTheme = () => updateThemeToggle(mobileHomeThemeToggle, null, mobileHomeThemeIcon);
  desktopThemeToggle?.addEventListener('click', () => {
    toggleTheme();
    syncDesktopTheme();
    syncMobileHomeTheme();
  });
  mobileHomeThemeToggle?.addEventListener('click', () => {
    toggleTheme();
    syncDesktopTheme();
    syncMobileHomeTheme();
  });
  syncDesktopTheme();
  syncMobileHomeTheme();
  onThemeChange(() => {
    syncDesktopTheme();
    syncMobileHomeTheme();
  });
</script>
