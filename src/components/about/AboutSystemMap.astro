---
const systems = [
  { label: 'Lâm sàng', icon: 'dentistry', className: 'node-clinical' },
  { label: 'Đội ngũ', icon: 'groups', className: 'node-team' },
  { label: 'Tăng trưởng', icon: 'trending_up', className: 'node-growth' },
  { label: 'Tài chính', icon: 'account_balance_wallet', className: 'node-finance' },
] as const;
---

<aside class="system-map" aria-label="Bản đồ hệ điều hành Dental Empire OS">
  <div class="ambient" aria-hidden="true">
    <span class="orbit orbit-one"></span>
    <span class="orbit orbit-two"></span>
  </div>

  <div class="map-header">
    <div>
      <p>BẢN ĐỒ HỆ ĐIỀU HÀNH</p>
      <h2>Một điểm nhìn chung cho mọi quyết định.</h2>
    </div>
    <span class="material-symbols-outlined header-icon" aria-hidden="true">account_tree</span>
  </div>

  <div class="map-stage" aria-label="Các hệ thống trong phòng khám">
    <svg class="connectors" viewBox="0 0 400 270" preserveAspectRatio="none" aria-hidden="true">
      <path d="M200 135 L90 62 M200 135 L310 62 M200 135 L90 208 M200 135 L310 208" />
      <circle cx="200" cy="135" r="4" />
    </svg>

    <div class="core" aria-hidden="true">
      <span class="material-symbols-outlined">hub</span>
      <span class="pulse"></span>
      <span class="core-label">DEOS</span>
    </div>

    {systems.map((system) => (
      <div class:list={['node', system.className]}>
        <span class="material-symbols-outlined node-icon" aria-hidden="true">{system.icon}</span>
        <span>{system.label}</span>
      </div>
    ))}
  </div>

  <div class="map-caption">
    <span class="material-symbols-outlined" aria-hidden="true">south_east</span>
    <p>Từ chuyên môn đến lợi nhuận, các hệ thống cùng chạy theo một chuẩn vận hành.</p>
  </div>
</aside>

<style>
  .system-map { position: relative; overflow: hidden; min-height: 31rem; padding: 1.5rem; border: 1px solid color-mix(in srgb, var(--color-primary) 32%, var(--color-outline-variant)); border-radius: 2rem; background: color-mix(in srgb, var(--color-surface-container) 84%, transparent); box-shadow: 0 24px 64px color-mix(in srgb, var(--color-primary) 12%, transparent); backdrop-filter: blur(18px); }
  .ambient, .orbit { position: absolute; pointer-events: none; }
  .ambient { inset: 0; overflow: hidden; }
  .orbit { top: 52%; left: 50%; border: 1px solid color-mix(in srgb, var(--color-primary) 28%, transparent); border-radius: 50%; transform: translate(-50%, -50%) rotate(-18deg); }
  .orbit-one { width: 82%; height: 42%; }
  .orbit-two { width: 66%; height: 64%; border-color: color-mix(in srgb, var(--color-tertiary) 26%, transparent); transform: translate(-50%, -50%) rotate(54deg); }
  .map-header { position: relative; z-index: 1; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .map-header p { margin: 0; color: var(--color-primary); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; }
  .map-header h2 { max-width: 16rem; margin: 0.5rem 0 0; color: var(--color-on-surface); font-size: 1.25rem; font-weight: 900; line-height: 1.35; }
  .header-icon { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 1px solid color-mix(in srgb, var(--color-primary) 28%, transparent); border-radius: 0.9rem; color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 10%, transparent); }
  .map-stage { position: relative; z-index: 1; height: 17.5rem; margin-top: 1.1rem; }
  .connectors { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .connectors path { fill: none; stroke: color-mix(in srgb, var(--color-primary) 52%, transparent); stroke-width: 1.25; stroke-dasharray: 5 5; }
  .connectors circle { fill: var(--color-tertiary); filter: drop-shadow(0 0 7px var(--color-tertiary)); }
  .core { position: absolute; top: 50%; left: 50%; display: flex; width: 5.5rem; height: 5.5rem; align-items: center; justify-content: center; border: 1px solid color-mix(in srgb, var(--color-primary) 62%, transparent); border-radius: 50%; color: var(--color-primary); background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 24%, transparent), color-mix(in srgb, var(--color-surface-container-lowest) 88%, transparent) 68%); box-shadow: 0 0 0 10px color-mix(in srgb, var(--color-primary) 6%, transparent), 0 0 36px color-mix(in srgb, var(--color-primary) 24%, transparent); transform: translate(-50%, -50%); }
  .core > .material-symbols-outlined { font-size: 1.7rem; transform: translateY(-0.45rem); }
  .core-label { position: absolute; bottom: 0.8rem; font-size: 0.6rem; font-weight: 900; letter-spacing: 0.14em; }
  .pulse { position: absolute; inset: -0.65rem; border: 1px solid color-mix(in srgb, var(--color-primary) 28%, transparent); border-radius: 50%; animation: pulse 3.2s ease-out infinite; }
  .node { position: absolute; display: flex; min-width: 7.4rem; align-items: center; gap: 0.55rem; padding: 0.65rem 0.75rem; border: 1px solid color-mix(in srgb, var(--color-outline-variant) 72%, transparent); border-radius: 1rem; color: var(--color-on-surface); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.04em; background: color-mix(in srgb, var(--color-surface-container-lowest) 86%, transparent); box-shadow: 0 8px 22px color-mix(in srgb, var(--color-surface-container-lowest) 65%, transparent); }
  .node-icon { display: inline-grid; width: 2rem; height: 2rem; place-items: center; border-radius: 0.65rem; color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 13%, transparent); font-size: 1.15rem; }
  .node-clinical { top: 0.9rem; left: 0; } .node-team { top: 0.9rem; right: 0; } .node-growth { bottom: 0.9rem; left: 0; } .node-finance { right: 0; bottom: 0.9rem; }
  .node-growth .node-icon, .node-finance .node-icon { color: var(--color-tertiary); background: color-mix(in srgb, var(--color-tertiary) 15%, transparent); }
  .map-caption { position: relative; z-index: 1; display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent); color: var(--color-on-surface-variant); font-size: 0.875rem; line-height: 1.5; }
  .map-caption p { margin: 0; } .map-caption span { color: var(--color-primary); }
  @keyframes pulse { 0% { transform: scale(0.8); opacity: 0.8; } 75%, 100% { transform: scale(1.35); opacity: 0; } }
  @media (max-width: 640px) { .system-map { min-height: 29rem; padding: 1.25rem; border-radius: 1.5rem; } .map-stage { height: 15rem; } .node { min-width: 6.2rem; padding: 0.55rem; font-size: 0.65rem; } .node-icon { width: 1.8rem; height: 1.8rem; } .core { width: 4.7rem; height: 4.7rem; } .core-label { bottom: 0.62rem; font-size: 0.52rem; } }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>
