---
/**
 * PaymentButton — uses the enabled automatic or manual payment method.
 *
 * Usage:
 *   <PaymentButton productId="course-premium" productName="Khóa học Premium" price={500000} />
 *
 * Props:
 *   productId  — ID of the product to purchase
 *   productName — Display name (shown on button if no slot)
 *   price      — Price in VND (display only, real price from DB)
 *   class      — Additional CSS classes
 */

import { env } from 'cloudflare:workers';
import { getPayosSettings, getManualPaymentSettings } from '../lib/payos-db';

interface Props {
  productId: string;
  productName?: string;
  price?: number;
  class?: string;
}

const { productId, productName, price, class: className = '' } = Astro.props;

const user = Astro.locals.user;

// Lấy trạng thái bật/tắt của từng phương thức thanh toán
const [payosSettings, manualSettings] = await Promise.all([
  getPayosSettings(env.DB),
  getManualPaymentSettings(env.DB),
]);

const payosEnabled = payosSettings?.is_active === 1;
const manualEnabled = manualSettings?.is_active === 1;
const hasAnyMethod = payosEnabled || manualEnabled;
const paymentMethodDescription = payosEnabled && manualEnabled
  ? 'Chọn phương thức thanh toán phù hợp với bạn.'
  : payosEnabled
    ? 'Thanh toán và kích hoạt tự động sau khi hoàn tất.'
    : 'Quét QR đúng số tiền, sau đó nhắn Zalo để kích hoạt.';

// Nếu chỉ còn 1 phương thức, tự động chọn (bỏ qua dialog)
const singleMethod = payosEnabled && !manualEnabled ? 'payos'
  : !payosEnabled && manualEnabled ? 'manual'
  : null;
---

{user ? (
  hasAnyMethod ? (
    <>
    <button
      data-product-id={productId}
      data-product-name={productName ?? ''}
      data-single-method={singleMethod}
      class={`payment-method-trigger group relative px-6 py-3 btn-primary-metallic font-bold rounded-xl text-sm active:scale-95 transition-all ${className}`}
    >
      <span>
        {price ? `Mua ngay — ${price.toLocaleString('vi-VN')}₫` : 'Mua ngay'}
      </span>
    </button>
    {singleMethod ? (
      <dialog class="payment-method-dialog fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-outline-variant/30 bg-surface p-0 text-on-surface shadow-2xl backdrop:bg-black/70">
        <div class="p-6">
          <div class="flex items-start justify-between gap-4">
            <h2 class="text-lg font-bold text-on-surface">Thanh toán</h2>
            <button type="button" class="payment-dialog-close rounded-lg p-1 text-on-surface-variant hover:bg-surface-container-high" aria-label="Đóng"><span class="material-symbols-outlined">close</span></button>
          </div>
          <p class="payment-dialog-error hidden mt-4 text-xs text-rose-300" role="alert"></p>
        </div>
      </dialog>
    ) : (
      <dialog class="payment-method-dialog fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-outline-variant/30 bg-surface p-0 text-on-surface shadow-2xl backdrop:bg-black/70">
        <div class="p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-bold text-on-surface">Chọn phương thức thanh toán</h2>
              <p class="mt-1 text-sm text-on-surface-variant">{paymentMethodDescription}</p>
            </div>
             <button type="button" class="payment-dialog-close rounded-lg p-1 text-on-surface-variant hover:bg-surface-container-high" aria-label="Đóng"><span class="material-symbols-outlined">close</span></button>
          </div>
          <div class="mt-5 grid gap-3">
            {payosEnabled && (
              <button type="button" class="payment-option payment-option-payos text-left rounded-xl border border-primary/35 bg-primary/10 p-4 hover:bg-primary/15 transition-colors" data-method="payos">
                <span class="flex items-center gap-3"><span class="material-symbols-outlined text-primary">bolt</span><span><strong class="block text-sm text-on-surface">Thanh toán tự động qua PayOS</strong><span class="text-xs text-on-surface-variant">Xác nhận và kích hoạt tự động sau thanh toán.</span></span></span>
              </button>
            )}
            {manualEnabled && (
                <button type="button" class="payment-option payment-option-manual text-left rounded-xl border border-outline-variant/30 p-4 hover:bg-surface-container-high transition-colors" data-method="manual">
                 <span class="flex items-center gap-3"><span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400">qr_code_2</span><span><strong class="block text-sm text-on-surface">Chuyển khoản ngân hàng</strong><span class="text-xs text-on-surface-variant">Quét QR đúng số tiền, sau đó nhắn Zalo để kích hoạt.</span></span></span>
              </button>
            )}
          </div>
          <p class="payment-dialog-error hidden mt-4 text-xs text-rose-300" role="alert"></p>
        </div>
      </dialog>
    )}
    </>
  ) : (
    <span class={`inline-block px-6 py-3 rounded-xl text-sm font-bold bg-surface-container-high text-on-surface-variant cursor-not-allowed ${className}`}>
      Thanh toán tạm thời không khả dụng
    </span>
  )
) : (
  <a
    href={`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`}
    class={`inline-block px-6 py-3 btn-primary-metallic font-bold rounded-xl text-sm active:scale-95 transition-all ${className}`}
  >
    Đăng nhập để mua
  </a>
)}

<script>
  document.querySelectorAll('.payment-method-trigger').forEach((trigger) => {
    const button = trigger as HTMLButtonElement;
    const dialog = button.nextElementSibling as HTMLDialogElement | null;
    if (!dialog) return;

    const singleMethod = button.dataset.singleMethod;
    const productId = button.dataset.productId;
    let isCreatingPayment = false;

    // Helper: tạo thanh toán theo phương thức
    async function createPayment(method: string) {
      const error = dialog.querySelector('.payment-dialog-error') as HTMLElement;
      if (!productId || !method || isCreatingPayment) return;

      const showError = (message: string) => {
        if (!dialog.open) dialog.showModal();
        error.textContent = message;
        error.classList.remove('hidden');
      };

      isCreatingPayment = true;
      button.disabled = true;
      error.classList.add('hidden');
      try {
        const resp = await fetch(method === 'manual' ? '/api/manual-payment/create-payment' : '/api/payos/create-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product_id: productId }),
        });
        const data = await resp.json() as Record<string, unknown>;
        if (!resp.ok || data.error) {
          showError((data.error as string) || 'Lỗi tạo thanh toán. Vui lòng thử lại.');
          return;
        }
        if (method === 'manual' && data.orderId) {
          window.location.href = `/orders/${encodeURIComponent(data.orderId as string)}`;
        } else if (data.checkoutUrl) {
          window.location.href = data.checkoutUrl as string;
        }
      } catch {
        showError('Lỗi kết nối. Vui lòng thử lại.');
      } finally {
        isCreatingPayment = false;
        button.disabled = false;
      }
    }

    // Nếu chỉ có 1 phương thức, tự động submit khi bấm "Mua ngay"
    dialog.querySelector('.payment-dialog-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    if (singleMethod) {
      button.addEventListener('click', () => createPayment(singleMethod));
      return;
    }

    // Trường hợp nhiều phương thức — mở dialog
    button.addEventListener('click', () => dialog.showModal());

    dialog.addEventListener('close', () => {
      dialog.querySelectorAll('.payment-option').forEach((option) => option.removeAttribute('disabled'));
    });

    dialog.querySelectorAll('.payment-option').forEach((option) => {
      option.addEventListener('click', async (event) => {
        const target = event.currentTarget as HTMLButtonElement;
        const method = target.dataset.method;
        const error = dialog.querySelector('.payment-dialog-error') as HTMLElement;
        if (!method) return;

        target.disabled = true;
        error.classList.add('hidden');
        try {
          await createPayment(method);
        } finally {
          target.disabled = false;
        }
      });
    });
  });
</script>
