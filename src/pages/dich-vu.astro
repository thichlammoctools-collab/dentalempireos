---
import { env } from 'cloudflare:workers';
import PaymentButton from '../components/PaymentButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { listProductEntitlements } from '../lib/entitlement-db';
import { getActiveProducts, type Product } from '../lib/payos-db';

export const prerender = false;

type ServiceProgram = 'self_serve' | 'guided_3m' | 'guided_6m' | 'full_implementation';

interface ServiceProduct {
  product: Product;
  programs: ServiceProgram[];
}

let serviceProducts: ServiceProduct[] = [];

try {
  const products = (await getActiveProducts(env.DB)).filter(
    (product) => product.type === 'service_program',
  );
  const productsWithEntitlements = await Promise.all(
    products.map(async (product) => ({
      product,
      entitlements: await listProductEntitlements(env.DB, product.id),
    })),
  );

  serviceProducts = productsWithEntitlements.map(({ product, entitlements }) => ({
    product,
    programs: entitlements
      .filter((entitlement) => entitlement.content_type === 'service')
      .map((entitlement) => entitlement.content_id)
      .filter((program): program is ServiceProgram => (
        program === 'self_serve'
        || program === 'guided_3m'
        || program === 'guided_6m'
        || program === 'full_implementation'
      )),
  }));
} catch {
  // The marketing page remains available if the product catalog is temporarily unavailable.
  serviceProducts = [];
}

const selfServeProduct = serviceProducts.find(({ programs }) => programs.includes('self_serve'))?.product;
const guidedProducts = serviceProducts
  .filter(({ programs }) => programs.includes('guided_3m') || programs.includes('guided_6m'))
  .map(({ product }) => product);

const consultationHref = (interest: 'guided' | 'implementation') =>
  `#dang-ky-tu-van?service_interest=${interest}`;

const foundationBenefits = [
  { icon: 'menu_book', title: 'Sách hệ thống', description: 'Khung tư duy và quy trình quản trị phòng khám theo từng tầng vận hành.' },
  { icon: 'auto_awesome', title: 'AI Tools', description: 'Công cụ AI hỗ trợ phân tích, xây nội dung và chuẩn bị đầu việc.' },
  { icon: 'fact_check', title: 'Scanner', description: 'Khảo sát thực trạng để nhận diện điểm nghẽn và ưu tiên cải thiện.' },
  { icon: 'school', title: 'Khóa học', description: 'Lộ trình học giúp đội ngũ hiểu cách áp dụng vào công việc hằng ngày.' },
  { icon: 'article', title: 'Blog Premium', description: 'Góc nhìn chuyên sâu, tình huống thực tế và bài học vận hành.' },
  { icon: 'folder_special', title: 'Tài nguyên Premium', description: 'Biểu mẫu, checklist và tài liệu để chuẩn hóa cách làm.' },
];

const formatDuration = (duration: number | null) =>
  duration ? `${duration} ngày truy cập` : 'Truy cập không thời hạn';
---

<BaseLayout
  title="Dịch vụ triển khai phòng khám | Dental Empire OS"
  description="Ba cấp độ đồng hành cùng Dental Empire OS: tự triển khai, tư vấn đồng hành và triển khai trọn gói cho phòng khám nha khoa."
  ogImage="/images/services-og.svg"
  ogImageAlt="Dịch vụ triển khai hệ thống phòng khám - Dental Empire OS"
  keywords="dịch vụ quản trị phòng khám nha khoa, tư vấn vận hành nha khoa, triển khai hệ thống phòng khám, Dental Empire OS"
>
  <section class="relative overflow-hidden border-b border-outline-variant/20">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-x-0 top-0 h-[560px] bg-[radial-gradient(ellipse_65%_60%_at_50%_-10%,rgba(0,139,210,0.20),transparent_70%)]"></div>
      <div class="absolute -right-32 top-20 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl"></div>
      <div class="absolute -left-36 top-56 h-80 w-80 rounded-full bg-primary/10 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 pb-20 pt-16 md:pb-24 md:pt-24">
      <header class="mx-auto max-w-4xl text-center">
        <p class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-1.5 text-xs font-bold text-amber-700 dark:text-amber-300">
          <span class="material-symbols-outlined text-[16px]">architecture</span>
          Dịch vụ triển khai hệ thống
        </p>
        <h1 class="mt-6 text-4xl font-black leading-tight text-on-surface md:text-6xl">
          Biến tri thức thành một
          <span class="bg-gradient-to-r from-primary to-cyan-500 bg-clip-text text-transparent"> phòng khám vận hành được</span>
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant md:text-xl">
          Chọn mức độ đồng hành phù hợp với nguồn lực hiện tại: tự triển khai có hướng dẫn, làm cùng chuyên gia, hoặc xây hệ thống từ nền tảng đến vận hành thực tế.
        </p>
      </header>

      <div class="mx-auto mt-10 grid max-w-4xl gap-3 sm:grid-cols-3">
        <a href="#tu-trien-khai" class="rounded-2xl border border-outline-variant/30 bg-surface-container-lowest/70 px-4 py-4 text-left transition-colors hover:border-primary/50 hover:bg-primary/5">
          <span class="text-xs font-bold text-primary">01</span>
          <span class="mt-1 block font-bold text-on-surface">Tự triển khai</span>
          <span class="mt-1 block text-xs leading-relaxed text-on-surface-variant">Tự học, tự làm theo lộ trình.</span>
        </a>
        <a href="#dong-hanh" class="rounded-2xl border border-primary/35 bg-primary/10 px-4 py-4 text-left transition-colors hover:bg-primary/15">
          <span class="text-xs font-bold text-primary">02</span>
          <span class="mt-1 block font-bold text-on-surface">Đồng hành tư vấn</span>
          <span class="mt-1 block text-xs leading-relaxed text-on-surface-variant">Có người cùng ưu tiên và phản biện.</span>
        </a>
        <a href="#tron-goi" class="rounded-2xl border border-outline-variant/30 bg-surface-container-lowest/70 px-4 py-4 text-left transition-colors hover:border-primary/50 hover:bg-primary/5">
          <span class="text-xs font-bold text-primary">03</span>
          <span class="mt-1 block font-bold text-on-surface">Triển khai trọn gói</span>
          <span class="mt-1 block text-xs leading-relaxed text-on-surface-variant">Thiết kế và đưa hệ thống vào vận hành.</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 md:py-24" aria-labelledby="service-options-title">
    <div class="mb-10 max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Ba cách bắt đầu</p>
      <h2 id="service-options-title" class="mt-2 text-3xl font-black text-on-surface md:text-4xl">Bắt đầu đúng với mức độ sẵn sàng của phòng khám</h2>
      <p class="mt-3 leading-relaxed text-on-surface-variant">Mỗi gói khác nhau ở mức độ can thiệp, nhịp đồng hành và phần việc đội ngũ Dental Empire OS trực tiếp cùng bạn thực hiện.</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      <article id="tu-trien-khai" class="flex scroll-mt-28 flex-col rounded-3xl border border-outline-variant/30 bg-surface-container-low p-6 md:p-7">
        <div class="flex items-start justify-between gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-500/15 text-primary"><span class="material-symbols-outlined">rocket_launch</span></div>
          <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">Tự chủ</span>
        </div>
        <h3 class="mt-5 text-2xl font-black text-on-surface">Tự triển khai</h3>
        <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">Dành cho người đã sẵn sàng dành thời gian học, tự ra quyết định và tự triển khai theo lộ trình.</p>
        <ul class="mt-6 space-y-3 text-sm text-on-surface-variant">
          <li class="flex gap-2"><span class="material-symbols-outlined text-[19px] text-emerald-600 dark:text-emerald-400">check_circle</span>Truy cập thư viện tri thức và công cụ trong gói.</li>
          <li class="flex gap-2"><span class="material-symbols-outlined text-[19px] text-emerald-600 dark:text-emerald-400">check_circle</span>Tự dùng scanner để xác định điểm cần ưu tiên.</li>
          <li class="flex gap-2"><span class="material-symbols-outlined text-[19px] text-emerald-600 dark:text-emerald-400">check_circle</span>Tự chịu trách nhiệm cho tiến độ triển khai.</li>
        </ul>
        <div class="mt-7 border-t border-outline-variant/25 pt-5">
          {selfServeProduct ? (
            <>
              <p class="text-xs font-semibold uppercase tracking-wide text-on-surface-variant">{selfServeProduct.name}</p>
              <p class="mt-1 text-2xl font-black text-on-surface">{selfServeProduct.price.toLocaleString('vi-VN')}₫</p>
              <p class="mt-1 text-xs text-on-surface-variant">{formatDuration(selfServeProduct.duration_days)}</p>
              {selfServeProduct.description && <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">{selfServeProduct.description}</p>}
              <PaymentButton productId={selfServeProduct.id} productName={selfServeProduct.name} price={selfServeProduct.price} class="mt-5 w-full" />
            </>
          ) : (
            <p class="text-sm leading-relaxed text-on-surface-variant">Gói tự triển khai sẽ hiển thị nút mua khi sản phẩm tương ứng đang được mở bán.</p>
          )}
        </div>
      </article>

      <article id="dong-hanh" class="relative flex scroll-mt-28 flex-col rounded-3xl border-2 border-primary/60 bg-gradient-to-b from-primary/10 to-surface-container-low p-6 shadow-xl shadow-primary/10 md:p-7">
        <span class="absolute -top-3 left-6 rounded-full bg-primary px-3 py-1 text-xs font-black text-on-primary">Được khuyến nghị</span>
        <div class="flex items-start justify-between gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500/15 text-amber-700 dark:text-amber-300"><span class="material-symbols-outlined">handshake</span></div>
          <span class="rounded-full bg-amber-500/10 px-3 py-1 text-xs font-bold text-amber-700 dark:text-amber-300">Có đồng hành</span>
        </div>
        <h3 class="mt-5 text-2xl font-black text-on-surface">Đồng hành tư vấn</h3>
        <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">Dành cho phòng khám cần người cùng chẩn đoán, ưu tiên vấn đề và giữ nhịp thực hiện trong quá trình thay đổi.</p>
        <ul class="mt-6 space-y-3 text-sm text-on-surface-variant">
          <li class="flex gap-2"><span class="material-symbols-outlined text-[19px] text-primary">check_circle</span>Buổi tư vấn theo thực trạng và mục tiêu riêng.</li>
          <li class="flex gap-2"><span class="material-symbols-outlined text-[19px] text-primary">check_circle</span>Phản biện kế hoạch, thứ tự ưu tiên và chỉ số theo dõi.</li>
          <li class="flex gap-2"><span class="material-symbols-outlined text-[19px] text-primary">check_circle</span>Đồng hành tháo gỡ vướng mắc khi đội ngũ triển khai.</li>
        </ul>
        <div class="mt-7 border-t border-primary/20 pt-5">
          {guidedProducts.length > 0 ? (
            <div class="space-y-4">
              {guidedProducts.map((product) => (
                <div class="rounded-2xl border border-primary/25 bg-surface-container-lowest/70 p-4">
                  <p class="text-sm font-bold text-on-surface">{product.name}</p>
                  <p class="mt-1 text-xl font-black text-on-surface">{product.price.toLocaleString('vi-VN')}₫</p>
                  <p class="mt-1 text-xs text-on-surface-variant">{formatDuration(product.duration_days)}</p>
                  {product.description && <p class="mt-2 text-xs leading-relaxed text-on-surface-variant">{product.description}</p>}
                  <PaymentButton productId={product.id} productName={product.name} price={product.price} class="mt-4 w-full" />
                </div>
              ))}
              <a href={consultationHref('guided')} class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-primary/40 px-5 py-3 text-sm font-bold text-primary transition-colors hover:bg-primary/10"><span class="material-symbols-outlined text-[18px]">mail</span>Trao đổi trước khi mua</a>
            </div>
          ) : (
            <a href={consultationHref('guided')} class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-on-primary transition-colors hover:brightness-110"><span class="material-symbols-outlined text-[18px]">mail</span>Đăng ký buổi tư vấn</a>
          )}
        </div>
      </article>

      <article id="tron-goi" class="flex scroll-mt-28 flex-col rounded-3xl border border-outline-variant/30 bg-surface-container-low p-6 md:p-7">
        <div class="flex items-start justify-between gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-500/15 text-violet-700 dark:text-violet-300"><span class="material-symbols-outlined">precision_manufacturing</span></div>
          <span class="rounded-full bg-violet-500/10 px-3 py-1 text-xs font-bold text-violet-700 dark:text-violet-300">Theo dự án</span>
        </div>
        <h3 class="mt-5 text-2xl font-black text-on-surface">Triển khai trọn gói</h3>
        <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">Dành cho phòng khám cần thiết kế hệ thống, chuyển hóa thành tài liệu và đưa vào nhịp vận hành với mức can thiệp sâu hơn.</p>
        <ul class="mt-6 space-y-3 text-sm text-on-surface-variant">
          <li class="flex gap-2"><span class="material-symbols-outlined text-[19px] text-violet-600 dark:text-violet-300">check_circle</span>Khảo sát, chẩn đoán và xác định phạm vi dự án.</li>
          <li class="flex gap-2"><span class="material-symbols-outlined text-[19px] text-violet-600 dark:text-violet-300">check_circle</span>Thiết kế quy trình, vai trò, chỉ số và tài liệu cần thiết.</li>
          <li class="flex gap-2"><span class="material-symbols-outlined text-[19px] text-violet-600 dark:text-violet-300">check_circle</span>Hỗ trợ đào tạo, thử nghiệm và điều chỉnh theo thực tế.</li>
        </ul>
        <div class="mt-7 border-t border-outline-variant/25 pt-5">
          <p class="text-sm leading-relaxed text-on-surface-variant">Phạm vi, nhân sự tham gia và chi phí được xác định sau buổi trao đổi thực trạng.</p>
          <a href={consultationHref('implementation')} class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-on-surface px-5 py-3 text-sm font-bold text-surface transition-transform hover:-translate-y-0.5"><span class="material-symbols-outlined text-[18px]">calendar_month</span>Đăng ký tư vấn dự án</a>
        </div>
      </article>
    </div>
  </section>

  <section class="border-y border-outline-variant/20 bg-surface-container-low">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Nền tảng chung</p>
          <h2 class="mt-2 text-3xl font-black text-on-surface">Một hệ sinh thái để học, đo lường và làm</h2>
          <p class="mt-4 leading-relaxed text-on-surface-variant">Các gói sử dụng hệ sinh thái Dental Empire OS để đưa kiến thức đến gần công việc thực tế hơn. Phạm vi truy cập cụ thể được xác nhận theo từng sản phẩm hoặc dự án.</p>
          <a href="/ai-tools" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-primary hover:underline">Khám phá AI Tools và Scanner <span class="material-symbols-outlined text-[18px]">arrow_forward</span></a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {foundationBenefits.map((benefit) => (
            <div class="rounded-2xl border border-outline-variant/25 bg-surface-container-lowest p-4">
              <span class="material-symbols-outlined text-primary">{benefit.icon}</span>
              <h3 class="mt-3 font-bold text-on-surface">{benefit.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-on-surface-variant">{benefit.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 md:py-24" aria-labelledby="comparison-title">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Khác biệt nằm ở cách làm cùng nhau</p>
      <h2 id="comparison-title" class="mt-2 text-3xl font-black text-on-surface">Tư vấn không chỉ là thêm nội dung</h2>
      <p class="mt-3 leading-relaxed text-on-surface-variant">Tự triển khai cung cấp đường đi. Đồng hành tư vấn và triển khai trọn gói bổ sung khả năng nhìn đúng vấn đề, đưa ra quyết định phù hợp bối cảnh và biến quyết định thành thói quen vận hành.</p>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-outline-variant/25 p-5"><span class="text-sm font-black text-primary">Tự triển khai</span><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Bạn chủ động học, chọn công cụ và tự tổ chức việc áp dụng. Phù hợp khi đã có người chịu trách nhiệm triển khai nội bộ.</p></div>
      <div class="rounded-2xl border border-primary/30 bg-primary/5 p-5"><span class="text-sm font-black text-primary">Đồng hành tư vấn</span><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Có chuyên gia cùng chẩn đoán, phản biện lựa chọn và giúp duy trì ưu tiên. Phần triển khai chính vẫn do đội ngũ phòng khám sở hữu.</p></div>
      <div class="rounded-2xl border border-outline-variant/25 p-5"><span class="text-sm font-black text-primary">Triển khai trọn gói</span><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Đội ngũ cùng thiết kế hệ thống, chuẩn bị đầu ra và hỗ trợ đưa vào vận hành. Phù hợp cho bài toán cần thay đổi sâu và liên phòng ban.</p></div>
    </div>
  </section>

  <section id="dang-ky-tu-van" class="scroll-mt-20 border-t border-outline-variant/20 bg-gradient-to-br from-primary/10 via-surface to-amber-500/5">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 md:py-24 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div>
      <h2 class="text-3xl font-black text-on-surface md:text-4xl">Chưa chắc nên bắt đầu từ đâu?</h2>
      <p class="mt-4 leading-relaxed text-on-surface-variant">Gửi bối cảnh hiện tại của phòng khám. Buổi trao đổi sẽ giúp xác định mức độ đồng hành phù hợp trước khi bạn đầu tư thời gian hoặc ngân sách.</p>
      <div class="mt-7 flex items-center gap-3 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary">schedule</span>Phản hồi trong giờ làm việc, không cần đăng nhập.</div>
      </div>
      <form id="consultation-form" class="rounded-2xl border border-outline-variant/30 bg-surface-container-lowest p-5 text-left shadow-lg shadow-primary/5 md:p-7">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-semibold text-on-surface">Họ và tên <span class="text-error" aria-hidden="true">*</span><input required name="name" maxlength="100" autocomplete="name" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" /></label>
          <label class="block text-sm font-semibold text-on-surface">Số điện thoại <span class="text-error" aria-hidden="true">*</span><input required name="phone" maxlength="24" autocomplete="tel" inputmode="tel" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" /></label>
          <label class="block text-sm font-semibold text-on-surface">Email <span class="font-normal text-on-surface-variant">(không bắt buộc)</span><input type="email" name="email" maxlength="254" autocomplete="email" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" /></label>
          <label class="block text-sm font-semibold text-on-surface">Tên phòng khám <span class="font-normal text-on-surface-variant">(không bắt buộc)</span><input name="clinic_name" maxlength="160" autocomplete="organization" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" /></label>
          <label class="block text-sm font-semibold text-on-surface">Quy mô nhân sự <span class="font-normal text-on-surface-variant">(không bắt buộc)</span><input name="team_size" maxlength="80" placeholder="Ví dụ: 10-20 người" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" /></label>
          <label class="block text-sm font-semibold text-on-surface">Nhu cầu chính <span class="text-error" aria-hidden="true">*</span><select required name="service_interest" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"><option value="guided">Đồng hành tư vấn</option><option value="implementation">Triển khai trọn gói</option><option value="general">Chưa xác định</option></select></label>
          <label class="block text-sm font-semibold text-on-surface sm:col-span-2">Bạn muốn được tư vấn điều gì? <span class="text-error" aria-hidden="true">*</span><textarea required name="message" minlength="10" maxlength="2000" rows="4" class="mt-2 w-full resize-y rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"></textarea></label>
        </div>
        <label class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-on-primary transition-transform hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-60"><span class="material-symbols-outlined text-[19px]">send</span>Gửi yêu cầu tư vấn</button><p id="consultation-status" class="text-sm text-on-surface-variant" role="status" aria-live="polite"></p></div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#consultation-form');
  const status = document.querySelector<HTMLElement>('#consultation-status');
  const interest = form?.elements.namedItem('service_interest');
  const selectedInterest = new URLSearchParams(window.location.search).get('service_interest');
  if (
    interest instanceof HTMLSelectElement
    && (selectedInterest === 'guided' || selectedInterest === 'implementation' || selectedInterest === 'general')
  ) {
    interest.value = selectedInterest;
  }

  document.querySelectorAll<HTMLAnchorElement>('a[href^="#dang-ky-tu-van?"]').forEach((link) => {
    link.addEventListener('click', () => {
      const selected = new URL(link.href).searchParams.get('service_interest');
      if (interest instanceof HTMLSelectElement && selected) interest.value = selected;
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!button || !status) return;
    button.disabled = true;
    status.textContent = 'Đang gửi thông tin...';
    status.className = 'text-sm text-on-surface-variant';
    try {
      const response = await fetch('/api/consultation-requests', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
      const data = await response.json().catch(() => null) as { error?: string } | null;
      if (!response.ok) throw new Error(data?.error ?? 'Không thể gửi yêu cầu.');
      form.reset();
      status.textContent = 'Đã nhận yêu cầu. Chúng tôi sẽ liên hệ lại sớm.';
      status.className = 'text-sm text-emerald-600 dark:text-emerald-400';
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Không thể gửi yêu cầu. Vui lòng thử lại.';
      status.className = 'text-sm text-error';
    } finally {
      button.disabled = false;
    }
  });
</script>
