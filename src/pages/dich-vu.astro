---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

const currentUser = Astro.locals.user;
---

<BaseLayout title="Tư vấn tác giả | Dental Empire OS" description="Đặt buổi tư vấn trực tiếp với tác giả Dental Empire OS để xác định ưu tiên vận hành cho phòng khám.">
  <section class="relative overflow-hidden border-b border-outline-variant/20">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true"><div class="absolute inset-x-0 top-0 h-[560px] bg-[radial-gradient(ellipse_65%_60%_at_50%_-10%,rgba(0,139,210,0.20),transparent_70%)]"></div><div class="absolute -right-32 top-20 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl"></div></div>
    <div class="relative mx-auto max-w-5xl px-4 pb-20 pt-16 text-center md:pb-24 md:pt-24">
      <p class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-1.5 text-xs font-bold text-amber-700 dark:text-amber-300"><span class="material-symbols-outlined text-[16px]">forum</span>Tư vấn trực tiếp với tác giả</p>
      <h1 class="mx-auto mt-6 max-w-4xl text-4xl font-black leading-tight text-on-surface md:text-6xl">Từ kết quả Scanner đến <span class="bg-gradient-to-r from-primary to-cyan-500 bg-clip-text text-transparent">một ưu tiên vận hành rõ ràng</span></h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant md:text-xl">Buổi tư vấn dành cho chủ phòng khám cần nhìn đúng điểm nghẽn, xác định bước đi tiếp theo và phản biện kế hoạch thay đổi theo bối cảnh thực tế.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">{currentUser ? <a href="#dat-lich-tu-van" class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-on-primary transition hover:brightness-110"><span class="material-symbols-outlined">calendar_month</span>Đặt yêu cầu tư vấn</a> : <a href="/login?redirect=/dich-vu" class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-on-primary transition hover:brightness-110"><span class="material-symbols-outlined">login</span>Đăng nhập để đặt tư vấn</a>}<a href="/scanner" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary/35 px-6 py-3.5 text-sm font-bold text-primary transition hover:bg-primary/10"><span class="material-symbols-outlined">fact_check</span>Làm Scanner trước</a></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 md:py-24"><div class="mb-10 max-w-3xl"><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Buổi tư vấn có cấu trúc</p><h2 class="mt-2 text-3xl font-black text-on-surface md:text-4xl">Dành thời gian cho vấn đề cần quyết định</h2></div><div class="grid gap-5 md:grid-cols-3"><article class="rounded-3xl border border-outline-variant/30 bg-surface-container-low p-6"><span class="material-symbols-outlined text-primary">clinical_notes</span><h3 class="mt-5 text-xl font-black text-on-surface">1. Đọc bối cảnh</h3><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Xem mục tiêu, tình trạng vận hành và kết quả Scanner nếu bạn đã thực hiện.</p></article><article class="rounded-3xl border border-primary/35 bg-primary/5 p-6"><span class="material-symbols-outlined text-primary">target</span><h3 class="mt-5 text-xl font-black text-on-surface">2. Chọn ưu tiên</h3><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Xác định điểm cần giải quyết trước, tiêu chí thành công và phần việc đội ngũ có thể bắt đầu ngay.</p></article><article class="rounded-3xl border border-outline-variant/30 bg-surface-container-low p-6"><span class="material-symbols-outlined text-primary">route</span><h3 class="mt-5 text-xl font-black text-on-surface">3. Chốt bước tiếp theo</h3><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Nhận định hướng hành động phù hợp, thay vì một gói giải pháp cố định cho mọi phòng khám.</p></article></div></section>

  <section class="border-y border-outline-variant/20 bg-surface-container-low"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 md:py-24 lg:grid-cols-[0.9fr_1.1fr] lg:items-start"><div><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Sử dụng Credits</p><h2 class="mt-2 text-3xl font-black text-on-surface">Đặt lịch theo block 30 phút</h2><p class="mt-4 leading-relaxed text-on-surface-variant">Sau khi gửi yêu cầu, quản trị viên xác nhận lịch và tạm giữ Credits theo số block đã chọn. Credits chỉ được settle sau buổi tư vấn theo thời lượng thực tế; phần chưa dùng được hoàn lại vào ví.</p><div class="mt-6 rounded-2xl border border-primary/25 bg-primary/5 p-4 text-sm text-on-surface-variant"><span class="font-bold text-primary">Lưu ý:</span> Giá phút/Credit và lịch hẹn được xác nhận bởi quản trị viên. Chưa có tích hợp lịch ngoài ở giai đoạn này.</div></div><div class="rounded-3xl border border-outline-variant/30 bg-surface-container-lowest p-6 md:p-8"><h3 class="text-xl font-black text-on-surface">Trước khi đặt lịch</h3><ul class="mt-5 space-y-3 text-sm text-on-surface-variant"><li class="flex gap-2"><span class="material-symbols-outlined text-primary">check_circle</span>Hoàn thiện hồ sơ phòng khám.</li><li class="flex gap-2"><span class="material-symbols-outlined text-primary">check_circle</span>Thực hiện Scanner liên quan nếu cần phân tích dữ liệu cụ thể.</li><li class="flex gap-2"><span class="material-symbols-outlined text-primary">check_circle</span>Chuẩn bị một câu hỏi hoặc quyết định quan trọng cần làm rõ.</li></ul><a href={currentUser ? '#dat-lich-tu-van' : '/login?redirect=/dich-vu'} class="mt-7 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-on-primary"><span class="material-symbols-outlined">calendar_month</span>{currentUser ? 'Gửi yêu cầu đặt lịch' : 'Đăng nhập để tiếp tục'}</a></div></div></section>

  <section id="dat-lich-tu-van" class="scroll-mt-20 bg-gradient-to-br from-primary/10 via-surface to-amber-500/5"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 md:py-24 lg:grid-cols-[0.8fr_1.2fr] lg:items-start"><div><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Yêu cầu tư vấn</p><h2 class="mt-2 text-3xl font-black text-on-surface md:text-4xl">Gửi bối cảnh của bạn</h2><p class="mt-4 leading-relaxed text-on-surface-variant">Chúng tôi kiểm tra thông tin, liên hệ xác nhận và đề xuất thời gian phù hợp. Đây chưa phải xác nhận lịch hay thanh toán.</p></div>{currentUser ? <form id="consultation-form" class="rounded-2xl border border-outline-variant/30 bg-surface-container-lowest p-5 text-left shadow-lg shadow-primary/5 md:p-7"><div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm font-semibold text-on-surface">Họ và tên <span class="text-error">*</span><input required name="name" maxlength="100" autocomplete="name" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary" /></label><label class="block text-sm font-semibold text-on-surface">Số điện thoại <span class="text-error">*</span><input required name="phone" maxlength="24" autocomplete="tel" inputmode="tel" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary" /></label><label class="block text-sm font-semibold text-on-surface">Tên phòng khám<input name="clinic_name" maxlength="160" autocomplete="organization" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary" /></label><label class="block text-sm font-semibold text-on-surface">Số block 30 phút<select name="requested_blocks" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary"><option value="1">1 block · 30 phút</option><option value="2">2 block · 60 phút</option><option value="3">3 block · 90 phút</option></select></label><label class="block text-sm font-semibold text-on-surface sm:col-span-2">Bạn muốn tư vấn điều gì? <span class="text-error">*</span><textarea required name="message" minlength="10" maxlength="2000" rows="4" class="mt-2 w-full resize-y rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary"></textarea></label></div><label class="absolute -left-[9999px] h-px w-px overflow-hidden">Website<input name="website" tabindex="-1" autocomplete="off" /></label><div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-on-primary disabled:cursor-wait disabled:opacity-60"><span class="material-symbols-outlined">send</span>Gửi yêu cầu</button><p id="consultation-status" class="text-sm text-on-surface-variant" role="status"></p></div></form> : <div class="rounded-2xl border border-outline-variant/30 bg-surface-container-lowest p-8 text-center"><span class="material-symbols-outlined text-4xl text-primary">lock</span><h3 class="mt-4 text-xl font-black text-on-surface">Đăng nhập để gửi yêu cầu tư vấn</h3><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Tài khoản giúp liên kết yêu cầu với ví Credits, lịch hẹn và kết quả Scanner của bạn.</p><a href="/login?redirect=/dich-vu" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-on-primary"><span class="material-symbols-outlined">login</span>Đăng nhập</a></div>}</div></section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#consultation-form');
  const status = document.querySelector<HTMLElement>('#consultation-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!button || !status) return;
    button.disabled = true; status.textContent = 'Đang gửi thông tin...';
    try {
      const response = await fetch('/api/consultation-requests', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
      const data = await response.json().catch(() => null) as { error?: string } | null;
      if (!response.ok) throw new Error(data?.error ?? 'Không thể gửi yêu cầu.');
      form.reset(); status.textContent = 'Đã nhận yêu cầu. Chúng tôi sẽ liên hệ để xác nhận lịch.'; status.className = 'text-sm text-emerald-600 dark:text-emerald-400';
    } catch (error) { status.textContent = error instanceof Error ? error.message : 'Không thể gửi yêu cầu.'; status.className = 'text-sm text-error'; } finally { button.disabled = false; }
  });
</script>
