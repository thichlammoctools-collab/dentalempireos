---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout title="Tư vấn tác giả | Dental Empire OS" description="Đặt buổi tư vấn trực tiếp với tác giả Dental Empire OS để xác định ưu tiên vận hành cho phòng khám.">
  <section class="relative overflow-hidden border-b border-outline-variant/20">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true"><div class="absolute inset-x-0 top-0 h-[560px] bg-[radial-gradient(ellipse_65%_60%_at_50%_-10%,rgba(0,139,210,0.20),transparent_70%)]"></div><div class="absolute -right-32 top-20 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl"></div></div>
    <div class="relative mx-auto max-w-5xl px-4 pb-20 pt-16 text-center md:pb-24 md:pt-24">
      <p class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-1.5 text-xs font-bold text-amber-700 dark:text-amber-300"><span class="material-symbols-outlined text-[16px]">forum</span>Tư vấn trực tiếp với tác giả</p>
      <h1 class="mx-auto mt-6 max-w-4xl text-4xl font-black leading-tight text-on-surface md:text-6xl">Từ kết quả Scanner đến <span class="bg-gradient-to-r from-primary to-cyan-500 bg-clip-text text-transparent">một ưu tiên vận hành rõ ràng</span></h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-on-surface-variant md:text-xl">Buổi tư vấn dành cho chủ phòng khám cần nhìn đúng điểm nghẽn, xác định bước đi tiếp theo và phản biện kế hoạch thay đổi theo bối cảnh thực tế.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a href="#dat-lich-tu-van" data-track-cta="consultation_request" data-track-placement="services_hero" class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-on-primary transition hover:brightness-110"><span class="material-symbols-outlined">calendar_month</span>Đặt yêu cầu tư vấn</a><a href="/scanner" data-track-cta="scanner" data-track-placement="services_hero" class="inline-flex items-center justify-center gap-2 rounded-xl border border-primary/35 px-6 py-3.5 text-sm font-bold text-primary transition hover:bg-primary/10"><span class="material-symbols-outlined">fact_check</span>Làm Scanner trước</a></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 md:py-24"><div class="mb-10 max-w-3xl"><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Buổi tư vấn có cấu trúc</p><h2 class="mt-2 text-3xl font-black text-on-surface md:text-4xl">Dành thời gian cho vấn đề cần quyết định</h2></div><div class="grid gap-5 md:grid-cols-3"><article class="rounded-3xl border border-outline-variant/30 bg-surface-container-low p-6"><span class="material-symbols-outlined text-primary">clinical_notes</span><h3 class="mt-5 text-xl font-black text-on-surface">1. Đọc bối cảnh</h3><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Xem mục tiêu, tình trạng vận hành và kết quả Scanner nếu bạn đã thực hiện.</p></article><article class="rounded-3xl border border-primary/35 bg-primary/5 p-6"><span class="material-symbols-outlined text-primary">target</span><h3 class="mt-5 text-xl font-black text-on-surface">2. Chọn ưu tiên</h3><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Xác định điểm cần giải quyết trước, tiêu chí thành công và phần việc đội ngũ có thể bắt đầu ngay.</p></article><article class="rounded-3xl border border-outline-variant/30 bg-surface-container-low p-6"><span class="material-symbols-outlined text-primary">route</span><h3 class="mt-5 text-xl font-black text-on-surface">3. Chốt bước tiếp theo</h3><p class="mt-3 text-sm leading-relaxed text-on-surface-variant">Nhận định hướng hành động phù hợp, thay vì một gói giải pháp cố định cho mọi phòng khám.</p></article></div></section>

  <section class="border-y border-outline-variant/20 bg-surface-container-low"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 md:py-24 lg:grid-cols-[0.9fr_1.1fr] lg:items-start"><div><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Quy trình minh bạch</p><h2 class="mt-2 text-3xl font-black text-on-surface">Gửi yêu cầu trước, xác nhận lịch sau</h2><p class="mt-4 leading-relaxed text-on-surface-variant">Chúng tôi xem bối cảnh, liên hệ xác nhận và đề xuất thời gian phù hợp. Gửi yêu cầu chưa phải là xác nhận lịch hay thanh toán.</p></div><a href="#dat-lich-tu-van" data-track-cta="consultation_request" data-track-placement="services_process" class="inline-flex items-center justify-center gap-2 self-start rounded-xl bg-primary px-5 py-3 text-sm font-bold text-on-primary"><span class="material-symbols-outlined">calendar_month</span>Gửi yêu cầu tư vấn</a></div></section>

  <section id="dat-lich-tu-van" class="scroll-mt-20 bg-gradient-to-br from-primary/10 via-surface to-amber-500/5"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 md:py-24 lg:grid-cols-[0.8fr_1.2fr] lg:items-start"><div><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Yêu cầu tư vấn</p><h2 class="mt-2 text-3xl font-black text-on-surface md:text-4xl">Gửi bối cảnh của bạn</h2><p class="mt-4 leading-relaxed text-on-surface-variant">Chúng tôi chỉ dùng thông tin này để liên hệ và xác nhận nhu cầu tư vấn.</p></div><form id="consultation-form" class="rounded-2xl border border-outline-variant/30 bg-surface-container-lowest p-5 text-left shadow-lg shadow-primary/5 md:p-7"><div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm font-semibold text-on-surface">Họ và tên <span class="text-error">*</span><input required name="name" maxlength="100" autocomplete="name" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary" /></label><label class="block text-sm font-semibold text-on-surface">Số điện thoại <span class="text-error">*</span><input required name="phone" maxlength="24" autocomplete="tel" inputmode="tel" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary" /></label><label class="block text-sm font-semibold text-on-surface">Email<input name="email" type="email" maxlength="254" autocomplete="email" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary" /></label><label class="block text-sm font-semibold text-on-surface">Tên phòng khám<input name="clinic_name" maxlength="160" autocomplete="organization" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary" /></label><label class="block text-sm font-semibold text-on-surface">Quy mô nhân sự<input name="team_size" maxlength="80" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary" /></label><label class="block text-sm font-semibold text-on-surface">Nhu cầu <span class="text-error">*</span><select required name="service_interest" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary"><option value="general">Chưa xác định</option><option value="guided">Đồng hành tư vấn</option><option value="implementation">Triển khai trọn gói</option></select></label></div><label class="mt-5 block text-sm font-semibold text-on-surface">Nội dung cần tư vấn <span class="text-error">*</span><textarea required name="message" minlength="10" maxlength="2000" rows="5" class="mt-2 w-full rounded-xl border border-outline-variant/40 bg-surface px-4 py-3 font-normal text-on-surface outline-none focus:border-primary"></textarea></label><input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" /><div class="mt-6 flex flex-wrap items-center gap-4"><button type="submit" class="rounded-xl bg-primary px-5 py-3 text-sm font-bold text-on-primary">Gửi yêu cầu tư vấn</button><p id="consultation-status" class="text-sm text-on-surface-variant" aria-live="polite"></p></div></form></div></section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#consultation-form');
  const status = document.querySelector<HTMLElement>('#consultation-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!button || !status) return;
    button.disabled = true; status.textContent = 'Đang gửi thông tin...';
    try {
      const payload = Object.fromEntries(new FormData(form));
      const attribution = window.dentalAnalytics?.getAttribution?.() ?? {};
      const response = await fetch('/api/consultation-requests', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...payload, ...attribution, anonymous_id: window.dentalAnalytics?.getAnonymousId?.() }) });
      const data = await response.json().catch(() => null) as { error?: string } | null;
      if (!response.ok) throw new Error(data?.error ?? 'Không thể gửi yêu cầu.');
      form.reset(); status.textContent = 'Đã nhận yêu cầu. Chúng tôi sẽ liên hệ để xác nhận lịch.'; status.className = 'text-sm text-emerald-600 dark:text-emerald-400';
    } catch (error) { status.textContent = error instanceof Error ? error.message : 'Không thể gửi yêu cầu.'; status.className = 'text-sm text-error'; } finally { button.disabled = false; }
  });
</script>
