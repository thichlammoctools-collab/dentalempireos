---
import { marked } from 'marked';
import { env } from 'cloudflare:workers';
import { getChapterTree, listPublishedChapters, listAllSections, getSupportSettings, type SectionNode, type ChapterRow, type AutoKeyword } from '../../lib/book-db';
import { getTierLabel } from '../../lib/collection-helpers';
import BookLayout from '../../layouts/BookLayout.astro';
import BookHeader from '../../components/book/BookHeader.astro';
import ChapterNav from '../../components/book/ChapterNav.astro';
import KeywordAutoLink from '../../components/book/KeywordAutoLink.astro';
import DonateWidget from '../../components/book/DonateWidget.astro';

import ReviewDrawer from '../../components/book/ReviewDrawer.astro';
import { listReviewsByChapter, getReviewStats } from '../../lib/review-db';
import { getActiveBookProduct, hasAccess } from '../../lib/payos-db';
import PaymentButton from '../../components/PaymentButton.astro';

// Configure marked ONCE at module level (persists across requests within the same isolate)
marked.use({ breaks: true });

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/book');

const db = env.DB;

// ── In-memory cache (per isolate, 60s TTL) ─────────────────────────────────────
interface ChapterCacheEntry {
  html: string;
  attachments: AttachmentItem[];
  sectionNavItems: ReturnType<typeof flattenSections>;
  ch: ChapterRow;
  ts: number;
}
const _chapterCache = new Map<string, ChapterCacheEntry>();
const _CHAPTER_TTL_MS = 60_000;

const dbFetchStart = Date.now();

// Fire ALL data fetches in parallel — no sequential dependencies
// Non-critical queries are wrapped individually so missing tables/columns don't crash the page
const [tree, autoKeywordsResult, allPublished, supportSettings] = await Promise.all([
  getChapterTree(db, slug),
  listAllSections(db).catch((): AutoKeyword[] => []),
  listPublishedChapters(db),
  getSupportSettings(db).catch(() => null),
]);
const autoKeywords: AutoKeyword[] = autoKeywordsResult ?? [];

if (!tree) {
  return new Response('Không tìm thấy chương', { status: 404 });
}

const { chapter: ch, sections } = tree;

function hasPremiumSection(nodes: SectionNode[]): boolean {
  return nodes.some((section) => section.is_free === 0 || hasPremiumSection(section.children));
}

const hasPremiumSections = hasPremiumSection(sections);

// ── Book paywall: section.is_free controls visibility; a product grants full access.
let bookProduct: Awaited<ReturnType<typeof getActiveBookProduct>> = null;
let userHasAccess = false;

try {
  bookProduct = await getActiveBookProduct(db);
  if (bookProduct) {
    const currentUser = Astro.locals.user;
    if (currentUser) {
      userHasAccess = await hasAccess(db, currentUser.id, bookProduct.id);
    }
  }
} catch {
  // Gracefully degrade if product table doesn't have book_unlock type yet
}

// The reader response varies by the viewer's entitlement. Never let an unlocked
// render be reused for a visitor who has not purchased the book.
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('Vary', 'Cookie');

const groupedByTier = [1, 2, 3].map((tier) => ({
  tier,
  label: getTierLabel(tier),
  chapters: allPublished
    .filter((c) => c.tier === tier)
    .map((c) => ({
      id: c.id,
      data: { title: c.title, tier: c.tier, chapter: c.chapter_no },
    })),
}));

const flatIds = allPublished.map((c) => c.id);
const currentIdx = flatIds.indexOf(slug);
const prevCh = currentIdx > 0 ? allPublished[currentIdx - 1] : null;
const nextCh = currentIdx < flatIds.length - 1 ? allPublished[currentIdx + 1] : null;
const prev = prevCh ? { id: prevCh.id, data: { title: prevCh.title, tier: prevCh.tier } } : null;
const next = nextCh ? { id: nextCh.id, data: { title: nextCh.title, tier: nextCh.tier } } : null;

const modules = sections.map((s) => ({
  title: s.title,
  slug: s.slug,
}));

// ── Helpers (move outside handler for cache reuse) ─────────────────────────────────
function flattenSections(
  nodes: SectionNode[],
  prefix = '',
): { title: string; slug: string; level: number; sectionNumber: string }[] {
  const result: { title: string; slug: string; level: number; sectionNumber: string }[] = [];
  let localIdx = 0;
  for (const node of nodes) {
    localIdx++;
    const sectionNumber = prefix ? `${prefix}.${localIdx}` : `${localIdx}`;
    result.push({ title: node.title, slug: node.slug, level: node.level, sectionNumber });
    if (node.children.length > 0) {
      result.push(...flattenSections(node.children, sectionNumber));
    }
  }
  return result;
}

interface AttachmentItem {
  id: string; type: 'image' | 'file'; title: string; url: string;
  caption?: string; filename?: string; mime?: string | null; mimeLabel?: string;
  sectionSlug: string; sectionTitle: string; ext?: string; previewable: boolean;
}

interface PreviewState {
  exhausted: boolean;
}

function getFileMeta(mime: string | null): { icon: string; badge: string; iconBg: string; badgeClass: string; isPreviewable: boolean; mimeLabel: string } {
  if (!mime) return { icon: 'description', badge: 'FILE', iconBg: 'bg-secondary/15 text-secondary', badgeClass: 'bg-secondary/15 text-secondary', isPreviewable: false, mimeLabel: 'File' };
  if (mime.includes('pdf')) return { icon: 'picture_as_pdf', badge: 'PDF', iconBg: 'bg-error/15 text-error', badgeClass: 'bg-error/15 text-error', isPreviewable: true, mimeLabel: 'PDF Document' };
  if (mime.includes('word') || mime.includes('document')) return { icon: 'article', badge: 'DOC', iconBg: 'bg-primary/15 text-primary', badgeClass: 'bg-primary/15 text-primary', isPreviewable: false, mimeLabel: 'Word Document' };
  if (mime.includes('sheet') || mime.includes('excel')) return { icon: 'table_chart', badge: 'XLS', iconBg: 'bg-green-400/15 text-green-400', badgeClass: 'bg-green-400/15 text-green-400', isPreviewable: false, mimeLabel: 'Excel Spreadsheet' };
  if (mime.includes('presentation') || mime.includes('powerpoint')) return { icon: 'slideshow', badge: 'PPT', iconBg: 'bg-tertiary/15 text-tertiary', badgeClass: 'bg-tertiary/15 text-tertiary', isPreviewable: false, mimeLabel: 'PowerPoint' };
  if (mime.includes('image')) return { icon: 'image', badge: 'IMG', iconBg: 'bg-tertiary/15 text-tertiary', badgeClass: 'bg-tertiary/15 text-tertiary', isPreviewable: true, mimeLabel: 'Image' };
  return { icon: 'description', badge: 'FILE', iconBg: 'bg-secondary/15 text-secondary', badgeClass: 'bg-secondary/15 text-secondary', isPreviewable: false, mimeLabel: 'File' };
}

function renderMarkdown(text: string): string {
  let html = marked.parse(text) as string;
  html = html.replace(
    /<img\b([^>]*)>/gi,
    (match, attrs: string) => {
      let fixed = attrs.replace(
        /\bsrc="([^"]*)"/i,
        (_: string, src: string) => {
          if (/^https?:\/\//.test(src)) return `src="${src}"`;
          if (src.startsWith('/media/')) return `src="${src}"`;
          return `src="/media/${src}"`;
        }
      );
      if (!/onerror/i.test(fixed)) {
        fixed += ' onerror="this.style.display=\'none\'"';
      }
      return `<img${fixed}>`;
    }
  );
  return html;
}

function renderSection(
  s: SectionNode,
  attachments: AttachmentItem[],
  sectionNumber = '',
  hasChapterAccess = true,
  previewState?: PreviewState,
): string {
  const accessible = hasChapterAccess || s.is_free === 1;
  if (previewState?.exhausted) return '';

  const tag = s.level <= 2 ? 'h2' : s.level === 3 ? 'h3' : s.level === 4 ? 'h4' : 'h5';
  let html = `<${tag} id="${s.slug}" class="section-heading">${sectionNumber ? `<span class="section-number">${sectionNumber}</span>` : ''}${s.title}</${tag}>`;

  for (const block of s.blocks) {
    if (!accessible) {
      // Render only first block as preview, then add paywall marker
      if (block.type === 'text' && block.text_md) {
        const previewText = block.text_md.slice(0, 200);
        html += renderMarkdown(previewText);
        if (block.text_md.length > 200) html += '...';
      } else if (block.type === 'image' && block.r2_key) {
        html += `<div class="my-6 flex items-center gap-3 rounded-xl border border-primary/25 bg-primary/10 p-4 text-on-surface-variant">
          <span class="material-symbols-outlined text-primary">lock</span>
          <p class="m-0 text-sm">Hình minh họa này thuộc phần nội dung chuyên sâu. Mở khóa chương để xem đầy đủ.</p>
        </div>`;
      }
      // Marks the end of the server-rendered preview without duplicating an element ID.
      html += `<div class="paywall-marker" data-paywall="true"></div>`;
      if (previewState) previewState.exhausted = true;
      break; // Stop rendering more blocks
    }
    if (block.type === 'text' && block.text_md) {
      html += renderMarkdown(block.text_md);
    } else if (block.type === 'image' && block.r2_key) {
      const imageUrl = `/media/${block.r2_key}`;
      attachments.push({
        id: block.id, type: 'image',
        title: block.caption ?? `Hình ảnh trong ${s.title}`,
        url: imageUrl, caption: block.caption ?? undefined,
        sectionSlug: s.slug, sectionTitle: s.title, previewable: true,
      });
      html += `<div id="attachment-${block.id}" class="attachment-anchor"></div><figure class="my-6">
        <img src="${imageUrl}" alt="${block.alt ?? ''}" class="rounded-xl w-full" loading="lazy" decoding="async" />
        ${block.caption ? `<figcaption class="text-center text-sm text-on-surface-variant mt-2">${block.caption}</figcaption>` : ''}
      </figure>`;
    } else if (block.type === 'file' && block.r2_key) {
      const meta = getFileMeta(block.mime);
      const ext = (block.filename ?? '').split('.').pop()?.toUpperCase() ?? meta.badge;
      attachments.push({
        id: block.id, type: 'file',
        title: block.filename ?? `Tệp trong ${s.title}`,
        url: `/media/${block.r2_key}`,
        caption: block.caption ?? undefined, filename: block.filename ?? undefined,
        mime: block.mime, mimeLabel: meta.mimeLabel,
        sectionSlug: s.slug, sectionTitle: s.title,
        ext, previewable: meta.isPreviewable,
      });
      html += `<div id="attachment-${block.id}" class="attachment-anchor"></div><div class="file-card my-5 relative overflow-hidden rounded-xl border border-outline-variant/40 bg-surface-container-low hover:border-primary/30 transition-all duration-300"
        data-file-url="/media/${block.r2_key}"
        data-file-mime="${block.mime ?? ''}"
        data-file-name="${(block.filename ?? 'file').replace(/"/g, '&quot;')}"
        data-file-card>
        <div class="file-progress-overlay hidden absolute inset-0 bg-surface-container-low/95 backdrop-blur-sm z-10 flex items-center px-4 gap-3">
          <div class="flex-1">
            <div class="h-1.5 bg-surface-container-high rounded-full overflow-hidden">
              <div class="file-progress-bar h-full rounded-full transition-all duration-200" style="width: 0%; background: var(--color-primary);"></div>
            </div>
            <p class="text-[10px] text-on-surface-variant mt-1 font-medium">
              <span class="file-progress-pct">0</span>% · <span class="file-progress-status">Đang tải...</span>
            </p>
          </div>
          <button class="file-cancel-btn w-7 h-7 flex items-center justify-center rounded-full text-on-surface-variant hover:text-error hover:bg-error/10 transition-all" title="Hủy">
            <span class="material-symbols-outlined text-[16px]">close</span>
          </button>
        </div>
        <div class="flex items-center gap-3 sm:gap-4 p-3.5 sm:p-4">
          <div class="flex-shrink-0 w-11 h-11 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center ${meta.iconBg} transition-transform duration-300 group-hover:scale-105">
            <span class="material-symbols-outlined text-2xl">${meta.icon}</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <p class="text-sm text-on-surface font-semibold truncate">${block.filename ?? 'Tải file'}</p>
              <span class="flex-shrink-0 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider rounded ${meta.badgeClass}">${ext}</span>
            </div>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="text-xs text-on-surface-variant file-mime-label">${meta.mimeLabel}</span>
              <span class="text-xs text-on-surface-variant file-size-display hidden"></span>
            </div>
            ${block.caption ? `<p class="text-xs text-on-surface-variant/70 mt-1 line-clamp-1">${block.caption}</p>` : ''}
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            ${meta.isPreviewable ? `<button class="file-preview-btn w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-xl text-on-surface-variant hover:text-primary hover:bg-primary/10 border border-transparent hover:border-primary/20 transition-all duration-200" title="Xem trước">
              <span class="material-symbols-outlined text-[20px]">visibility</span>
            </button>` : ''}
            <button class="file-download-btn btn-primary-metallic flex items-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl text-xs sm:text-sm font-bold text-white" title="Tải file">
              <span class="material-symbols-outlined text-[16px] sm:text-[18px]">download</span>
              <span class="hidden sm:inline">Tải</span>
            </button>
          </div>
        </div>
      </div>`;
    }
  }

  for (let ci = 0; ci < s.children.length; ci++) {
    const childNum = sectionNumber ? `${sectionNumber}.${ci + 1}` : `${ci + 1}`;
    html += renderSection(s.children[ci], attachments, childNum, hasChapterAccess, previewState);
  }

  return html;
}

// ── Cache lookup (chapter content rendering is the expensive part) ───────────────
// Never share a rendered premium chapter between an entitled and a locked visitor.
const readerCacheKey = `${slug}:${hasPremiumSections ? (userHasAccess ? 'unlocked' : 'locked') : 'public'}`;
const cached = _chapterCache.get(readerCacheKey);
let strippedContent: string;
let attachments: AttachmentItem[];

if (cached && Date.now() - cached.ts < _CHAPTER_TTL_MS) {
  strippedContent = cached.html;
  attachments = cached.attachments;
} else {
  const localAttachments: AttachmentItem[] = [];
  const previewState = userHasAccess ? undefined : { exhausted: false };
  const sectionsHtml = sections
    .map((s, i) => renderSection(s, localAttachments, `${i + 1}`, userHasAccess && !!bookProduct, previewState))
    .join('');
  strippedContent = sectionsHtml;
  attachments = localAttachments;
  _chapterCache.set(readerCacheKey, { html: strippedContent, attachments, sectionNavItems: [], ts: Date.now(), ch });
}

// Trigger stale revalidation in background (non-blocking)
if (cached && Date.now() - cached.ts >= _CHAPTER_TTL_MS) {
  const staleAttachments: AttachmentItem[] = [];
  const previewState = userHasAccess ? undefined : { exhausted: false };
  const freshSectionsHtml = sections
    .map((s, i) => renderSection(s, staleAttachments, `${i + 1}`, userHasAccess && !!bookProduct, previewState))
    .join('');
  const freshHtml = freshSectionsHtml;
  _chapterCache.set(readerCacheKey, { html: freshHtml, attachments: staleAttachments, sectionNavItems: [], ts: Date.now(), ch });
}

const attachmentCount = attachments.length;
const imageAttachments = attachments.filter((item) => item.type === 'image');
const fileAttachments = attachments.filter((item) => item.type === 'file');

// Compute sectionNavItems (cheap, always fresh)
const sectionNavItems = flattenSections(sections);

// Reviews — parallel fetch (wrapped in try-catch: table may not exist yet)
const reviewLimit = 10;
let reviews: Awaited<ReturnType<typeof listReviewsByChapter>> = [];
let reviewStats: Awaited<ReturnType<typeof getReviewStats>> = { avgRating: 0, totalReviews: 0 };
try {
  [reviews, reviewStats] = await Promise.all([
    listReviewsByChapter(db, slug, reviewLimit, 0),
    getReviewStats(db, slug),
  ]);
} catch {
  // review table may not exist in D1 yet — gracefully degrade
  reviews = [];
  reviewStats = { avgRating: 0, totalReviews: 0 };
}
const currentUser = Astro.locals.user;
---

<BookLayout
  title={ch.title}
  description={ch.description ?? ''}
  groupedChapters={groupedByTier}
  currentSlug={slug}
  currentModules={modules}
  sections={sectionNavItems}
  attachments={attachments}
  tier={ch.tier}
  tierLabel={getTierLabel(ch.tier)}
  chapterNo={ch.chapter_no}
  prev={prev}
  next={next}
  isLoggedIn={!!currentUser}
  currentUserId={currentUser?.id}
  chapterId={slug}
>
  <!-- Mobile-optimized Book Header -->
  <BookHeader
    title={ch.title}
    description={ch.description ?? ''}
    tier={ch.tier}
    tierLabel={getTierLabel(ch.tier)}
    chapterNo={ch.chapter_no}
  />


  <!-- Chapter Content -->
  <div class="prose prose-invert prose-headings:text-white prose-p:text-on-surface-variant prose-a:text-primary prose-strong:text-white prose-li:text-on-surface-variant prose-figure:my-6 max-w-none reader-content" id="reader-content" set:html={strippedContent} />

  {hasPremiumSections && !userHasAccess ? (
    <section id="book-paywall" class="relative -mt-8 mb-10 pt-14">
      <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-transparent via-surface/85 to-surface pointer-events-none"></div>
      <div class="relative overflow-hidden rounded-2xl border border-primary/30 bg-gradient-to-br from-primary/15 via-surface-container to-surface-container-low p-6 sm:p-8 text-center shadow-xl">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl border border-primary/30 bg-primary/15 text-primary">
          <span class="material-symbols-outlined text-2xl">lock</span>
        </div>
        <p class="mb-1 text-xs font-bold uppercase tracking-[0.16em] text-primary">Nội dung chuyên sâu</p>
        <h2 class="m-0 text-xl font-bold text-white sm:text-2xl">Mở khóa chương này để đọc toàn bộ</h2>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-on-surface-variant">
          {bookProduct?.description || `Bạn đang xem phần đọc thử của ${ch.title}. Mở khóa để truy cập đầy đủ chương này.`}
        </p>
        <div class="mt-5 flex flex-col items-center justify-center gap-3 sm:flex-row">
          {bookProduct ? (
            <PaymentButton productId={bookProduct.id} productName={bookProduct.name} price={bookProduct.price} />
          ) : (
            <span class="rounded-xl border border-amber-400/30 bg-amber-400/10 px-4 py-3 text-sm font-medium text-amber-200">
              Chương này chưa được cấu hình sản phẩm thanh toán.
            </span>
          )}
          {!currentUser && bookProduct && (
            <a href={`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`} class="text-sm font-semibold text-primary hover:underline">
              Đã có tài khoản? Đăng nhập
            </a>
          )}
        </div>
        {bookProduct && (
          <p class="mt-4 text-xs text-on-surface-variant/70">Thanh toán an toàn qua PayOS · {bookProduct.duration_days ? `Truy cập ${bookProduct.duration_days} ngày` : 'Truy cập vĩnh viễn'}</p>
        )}
      </div>
    </section>
  ) : null}

  {attachmentCount > 0 ? (
    <section id="attachments-summary" class="att-list-section mt-10 mb-8">
      <div class="att-list-header">
        <span class="att-list-label">
          <span class="material-symbols-outlined text-[16px]">attach_file</span>
          {attachmentCount} đính kèm
        </span>
        <span class="att-list-counts">
          {imageAttachments.length > 0 && <span class="att-count-chip">{imageAttachments.length} hình</span>}
          {fileAttachments.length > 0 && <span class="att-count-chip att-count-chip--file">{fileAttachments.length} file</span>}
        </span>
      </div>
      <div class="att-list">
        {attachments.map((item, idx) => (
          <a href={`#attachment-${item.id}`} class="att-list-item">
            <span class="att-list-num">{idx + 1}</span>
            <span class={`att-list-icon ${item.type === 'image' ? 'att-list-icon--img' : 'att-list-icon--file'}`}>
              <span class="material-symbols-outlined text-[16px]">{item.type === 'image' ? 'image' : 'description'}</span>
            </span>
            <span class="att-list-info">
              <span class="att-list-title">{item.title}</span>
              <span class="att-list-meta">{item.sectionTitle}</span>
            </span>
            <span class={`att-list-badge ${item.type === 'image' ? 'att-badge--img' : 'att-badge--' + (item.ext ?? 'file').toLowerCase()}`}>
              {item.type === 'image' ? 'Hình' : item.ext ?? 'Tệp'}
            </span>
            <span class="att-list-action">
              {item.previewable ? 'Xem' : 'Mở'}
              <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  <!-- Donate Widget -->
  <DonateWidget settings={supportSettings ?? { enabled: 0, title: '', message: '', qr_url: '', payment_methods: '' }} />

  <!-- Scanner CTA — Tier 1 chapters (Ch.1-5) have matching mini scanner -->
  {(() => {
    const scannerMap: any = {
      1: { slug: 'he-thong-check', title: 'Hệ Thống Check', icon: 'settings', color: 'from-blue-600/20 to-cyan-600/5 border-blue-500/30' },
      2: { slug: 'nhan-su-check', title: 'Nhân Sự Check', icon: 'groups', color: 'from-emerald-600/20 to-teal-600/5 border-emerald-500/30' },
      3: { slug: 'quy-trinh-check', title: 'Quy Trình Check', icon: 'account_tree', color: 'from-amber-600/20 to-orange-600/5 border-amber-500/30' },
      4: { slug: 'tiep-don-check', title: 'Tiếp Đón Check', icon: 'sentiment_satisfied', color: 'from-pink-600/20 to-rose-600/5 border-pink-500/30' },
      5: { slug: 'tai-chinh-check', title: 'Tài Chính Check', icon: 'payments', color: 'from-violet-600/20 to-purple-600/5 border-violet-500/30' },
    };
    const scanner = scannerMap[ch.chapter_no];
    if (!scanner) return null;
    return (
      <section class="mt-10 mb-8">
        <div class={`glass-card rounded-2xl p-6 border bg-gradient-to-br ${scanner.color}`}>
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-surface-container-high border border-outline-variant/30 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-primary text-[24px]">{scanner.icon}</span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant/70 mb-1">Đo lường nhanh</p>
              <h3 class="text-lg font-bold text-white mb-1">{scanner.title}</h3>
              <p class="text-sm text-on-surface-variant mb-4">5 câu hỏi giúp bạn nhìn rõ thực tế — kèm AI phân tích cá nhân hóa cho phòng khám của bạn.</p>
              <a
                href={`/scanner/${scanner.slug}`}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-sm font-semibold hover:bg-primary/90 transition-all"
              >
                <span>Làm bài check ngay</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    );
  })()}

  <!-- Newsletter Subscription Widget -->
  <section id="newsletter-widget" class="mt-10 mb-8" data-chapter-slug={slug}>
    <div class="rounded-2xl p-5 border border-amber-500/30 bg-gradient-to-br from-amber-500/5 to-transparent">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-amber-400 text-[20px]">mail</span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-wider text-amber-400/70 mb-0.5">Nhận tips hàng tuần</p>
          <h3 class="text-sm font-bold text-white mb-1">Cập nhật nội dung mới qua email</h3>
          <p class="text-xs text-on-surface-variant mb-3">Không spam — chỉ gửi khi có bài mới hoặc tips hữu ích từ BS. Vinh.</p>
          <form id="newsletter-form" class="flex gap-2">
            <input
              type="email"
              id="newsletter-email"
              placeholder="email@example.com"
              required
              class="flex-1 px-3 py-2 bg-white/5 border border-outline-variant/30 rounded-lg text-white placeholder:text-white/30 focus:ring-2 focus:ring-amber-400/50 focus:outline-none text-sm"
            />
            <button
              type="submit"
              id="newsletter-submit"
              class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-black font-bold text-sm rounded-lg transition-colors shrink-0"
            >
              Đăng ký
            </button>
          </form>
          <p id="newsletter-success" class="hidden text-xs text-emerald-400 mt-2"></p>
          <p id="newsletter-error" class="hidden text-xs text-rose-400 mt-2"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter Navigation -->
  <KeywordAutoLink autoKeywords={autoKeywords} />

  <script>
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
    const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement | null;
    const successEl = document.getElementById('newsletter-success');
    const errorEl = document.getElementById('newsletter-error');
    const widget = document.getElementById('newsletter-widget');
    const chapterSlug = widget?.dataset.chapterSlug || '';

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim();
      if (!email) return;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '...'; }
      if (successEl) successEl.classList.add('hidden');
      if (errorEl) errorEl.classList.add('hidden');
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'book', post_slug: chapterSlug }),
        });
        const data = await res.json() as { success?: boolean; error?: string; message?: string };
        if (data.success) {
          if (successEl) {
            successEl.textContent = data.message || 'Đăng ký thành công!';
            successEl.classList.remove('hidden');
          }
          if (form) form.classList.add('hidden');
        } else {
          if (errorEl) { errorEl.textContent = data.error || 'Có lỗi xảy ra.'; errorEl.classList.remove('hidden'); }
        }
      } catch {
        if (errorEl) { errorEl.textContent = 'Không thể kết nối.'; errorEl.classList.remove('hidden'); }
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Đăng ký'; }
      }
    });
  </script>
</BookLayout>
