---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { getOrderWithProduct } from '../../lib/payos-db';
import { listProductEntitlements } from '../../lib/entitlement-db';

export const prerender = false;

const orderId = Astro.url.searchParams.get('id') ?? Astro.params.id ?? '';
const user = Astro.locals.user;

if (!user || !orderId) return Astro.redirect('/login');

const order = await getOrderWithProduct(env.DB, orderId, user.id);

if (!order) {
  return Astro.redirect('/account/payments');
}

const statusConfig: Record<string, { label: string; className: string; icon: string }> = {
  pending: { label: 'Chờ thanh toán', className: 'bg-amber-400/15 text-amber-300', icon: 'schedule' },
  paid: { label: 'Đã thanh toán', className: 'bg-emerald-400/15 text-emerald-300', icon: 'check_circle' },
  cancelled: { label: 'Đã hủy', className: 'bg-rose-400/15 text-rose-300', icon: 'cancel' },
  expired: { label: 'Hết hạn', className: 'bg-white/10 text-on-surface-variant', icon: 'timer_off' },
};

const st = statusConfig[order.status] ?? statusConfig.pending;
const isManual = !order.payment_link_id;
const canPay = order.status === 'pending' && isManual;
const entitlements = await listProductEntitlements(env.DB, order.product_id).catch(() => []);
const hasEntitlement = (contentType: string) =>
  entitlements.some((entitlement) => entitlement.content_type === contentType);
---

<BaseLayout title={`Đơn hàng ${order.id} | Dental Empire OS`} noindex={true}>
  <main class="min-h-screen bg-surface pt-24 pb-16">
    <div class="max-w-lg mx-auto px-4">

      <a href="/account/payments" class="inline-flex items-center gap-1 mb-6 text-sm text-on-surface-variant hover:text-primary">
        <span class="material-symbols-outlined text-lg">arrow_back</span>
        Lịch sử thanh toán
      </a>

      <!-- Header -->
      <div class="flex items-center gap-3 mb-6">
        <div class={`w-12 h-12 rounded-full flex items-center justify-center ${st.className}`}>
          <span class="material-symbols-outlined text-2xl">{st.icon}</span>
        </div>
        <div>
          <h1 class="text-xl font-bold text-white">{st.label}</h1>
          <p class="text-sm text-on-surface-variant">
            {new Date(order.created_at).toLocaleString('vi-VN')}
          </p>
        </div>
      </div>

      <!-- Order details -->
      <div class="glass-card rounded-2xl border border-outline-variant/20 overflow-hidden">
        <div class="p-5 border-b border-outline-variant/15">
          <h2 class="font-bold text-white">{order.product_name}</h2>
          <p class="mt-1 text-xs text-on-surface-variant">
            {isManual ? 'Chuyển khoản ngân hàng' : 'Thanh toán tự động PayOS'}
          </p>
        </div>

        <dl class="divide-y divide-outline-variant/15 text-sm">
          <div class="p-4 flex justify-between gap-4">
            <dt class="text-on-surface-variant">Mã đơn hàng</dt>
            <dd class="font-mono text-xs text-white">{order.id}</dd>
          </div>
          <div class="p-4 flex justify-between gap-4">
            <dt class="text-on-surface-variant">Số tiền</dt>
            <dd class="font-bold text-primary">{order.amount.toLocaleString('vi-VN')}đ</dd>
          </div>
          {isManual && (
            <div class="p-4 flex justify-between gap-4">
              <dt class="text-on-surface-variant">Nội dung CK</dt>
              <dd class="font-mono font-bold text-primary">DEOS {order.order_code}</dd>
            </div>
          )}
          <div class="p-4 flex justify-between gap-4">
            <dt class="text-on-surface-variant">Trạng thái</dt>
            <dd>
              <span class={`px-2 py-0.5 rounded-full text-[11px] font-bold ${st.className}`}>
                {st.label}
              </span>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Actions -->
      {canPay && (
        <a
          href={`/payment/manual?order=${order.id}`}
          class="mt-6 w-full flex items-center justify-center gap-2 px-6 py-3.5 btn-primary-metallic font-bold rounded-xl text-sm"
        >
          <span class="material-symbols-outlined text-[19px]">bolt</span>
          Thanh toán ngay
        </a>
      )}

      {order.status === 'paid' && (
        <div class="mt-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-center">
          <p class="text-sm text-emerald-300 font-medium">Đơn hàng đã được xác nhận. Bạn có thể truy cập nội dung ngay.</p>
          <div class="mt-3 flex flex-col sm:flex-row gap-2">
            {hasEntitlement('scanner') && (
              <a href="/scanner" class="flex-1 px-4 py-2.5 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 font-bold rounded-xl text-sm text-center transition-all">
                Khám phá Scanner
              </a>
            )}
            {hasEntitlement('book') && (
              <a href="/book" class="flex-1 px-4 py-2.5 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 font-bold rounded-xl text-sm text-center transition-all">
                Đọc tài liệu
              </a>
            )}
          </div>
        </div>
      )}

      {order.status === 'cancelled' && (
        <div class="mt-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-center">
          <p class="text-sm text-rose-300">Đơn hàng đã bị hủy. Vui lòng tạo đơn mới nếu muốn tiếp tục.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
