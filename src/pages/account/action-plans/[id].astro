---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActionPlanChecklist from '../../../components/scanner/ActionPlanChecklist.astro';
import { env } from 'cloudflare:workers';
import { createAuth } from '../../../lib/auth';
import { getScannerActionPlanForUser } from '../../../lib/scanner-action-plan-db';

export const prerender = false;

const auth = createAuth(env);
const session = await auth.api.getSession({ headers: Astro.request.headers });
const planId = Astro.params.id?.trim() ?? '';
if (!session?.user) return Astro.redirect(`/login?redirect=/account/action-plans/${encodeURIComponent(planId)}`);
if (!planId || planId.length > 100) return new Response('Not found', { status: 404 });

const plan = await getScannerActionPlanForUser(env.DB, planId, session.user.id);
if (!plan || plan.retention_visibility !== 'available') return new Response('Not found', { status: 404 });
const survey = await env.DB.prepare('SELECT "title_vi" FROM "survey_definition" WHERE "id" = ?').bind(plan.survey_id).first<{ title_vi: string }>();
const sourceResultHref = plan.source_response_id === null ? null : `/scanner/result/${plan.source_response_id}`;
---

<BaseLayout title="Chi tiết kế hoạch hành động | Dental Empire OS" description="Theo dõi các việc ưu tiên từ Scanner." noindex={true}>
  <div class="min-h-screen bg-surface pt-24 pb-16">
    <main class="max-w-[860px] mx-auto px-4 md:px-6">
      <nav class="mb-5" aria-label="Điều hướng kế hoạch">
        <a href="/account/action-plans" class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline"><span class="material-symbols-outlined text-base">arrow_back</span>Tất cả kế hoạch</a>
      </nav>
      <header class="glass-card rounded-2xl border border-outline-variant/20 p-5 md:p-6 mb-5">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-primary">{survey?.title_vi ?? 'Scanner'}</p>
        <h1 class="mt-2 text-2xl font-bold text-on-surface">{plan.title ?? 'Kế hoạch hành động'}</h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-on-surface-variant">{plan.summary ?? 'Theo dõi và cập nhật từng việc ưu tiên trong kế hoạch này.'}</p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          {sourceResultHref && <a href={sourceResultHref} class="inline-flex items-center gap-1.5 font-semibold text-on-surface-variant hover:text-primary"><span class="material-symbols-outlined text-base">description</span>Xem kết quả Scanner</a>}
          <a href={`/account/action-plans/${plan.id}/comparison`} class="inline-flex items-center gap-1.5 font-semibold text-on-surface-variant hover:text-primary"><span class="material-symbols-outlined text-base">compare_arrows</span>So sánh lần quét lại</a>
        </div>
      </header>
      <ActionPlanChecklist planId={plan.id} />
    </main>
  </div>
</BaseLayout>
