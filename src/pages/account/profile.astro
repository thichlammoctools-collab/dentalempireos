---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotificationBell from '../../components/layout/NotificationBell.astro';
import { env } from 'cloudflare:workers';
import { createAuth } from '../../lib/auth';
import { listQuestionsByUser } from '../../lib/question-db';
import { listChapters } from '../../lib/book-db';
import { getUserHistory } from '../../lib/scanner-history-db';
import { getScannerResponse } from '../../lib/scanner-response-db';
import { getCreditBalance } from '../../lib/credit-db';
import { getClinicProfile } from '../../lib/clinic-profile-db';

export const prerender = false;

const auth = createAuth(env);
const result = await auth.api.getSession({ headers: Astro.request.headers });
if (!result?.user) {
  return Astro.redirect('/login?redirect=/account/profile');
}

const user = Astro.locals.user;

const questions = await listQuestionsByUser(env.DB, result.user.id);
const chapters = await listChapters(env.DB);
const chapterMap = new Map(chapters.map(c => [c.id, { title: c.title, tier: c.tier, chapter_no: c.chapter_no }]));

const scannerHistory = await getUserHistory(env.DB, result.user.id, 50);
const scannerAssets = (await Promise.all(
  scannerHistory.map(async (entry) => {
    const response = await getScannerResponse(env.DB, entry.response_id);
    if (!response) return null;

    const hasAnalysis = Boolean(response.ai_analysis?.trim());
    const hasPlan = Boolean(response.ai_plan?.trim());
    const assets = [
      hasAnalysis && hasPlan && { type: 'pdf', label: 'Báo cáo tổng hợp', icon: 'picture_as_pdf', href: `/api/scanner/${entry.response_id}/pdf?type=combined` },
      hasAnalysis && { type: 'pdf', label: 'PDF phân tích', icon: 'picture_as_pdf', href: `/api/scanner/${entry.response_id}/pdf?type=analysis` },
      hasPlan && { type: 'pdf', label: 'PDF kế hoạch', icon: 'picture_as_pdf', href: `/api/scanner/${entry.response_id}/pdf?type=plan` },
      response.image_analysis_key && { type: 'image', label: 'Hình phân tích', icon: 'image', href: `/api/scanner/${entry.response_id}/image?type=analysis&download=1` },
      response.image_plan_key && { type: 'image', label: 'Hình kế hoạch', icon: 'image', href: `/api/scanner/${entry.response_id}/image?type=plan&download=1` },
    ].filter(Boolean) as Array<{ type: 'pdf' | 'image'; label: string; icon: string; href: string }>;

    return assets.length > 0
      ? { responseId: entry.response_id, scannerTitle: entry.scanner_title_vi ?? 'Scanner', assets }
      : null;
  }),
)).filter((entry): entry is NonNullable<typeof entry> => entry !== null);

const scannerAssetCount = scannerAssets.reduce((count, entry) => count + entry.assets.length, 0);

const creditBalance = await getCreditBalance(env.DB, result.user.id);
const clinicProfile = await getClinicProfile(env.DB, result.user.id);
const clinicCompletion = [clinicProfile?.clinic_name, clinicProfile?.clinic_address, clinicProfile?.phone, clinicProfile?.logo_url]
  .filter(Boolean).length;
const isClinicReady = Boolean(clinicProfile?.clinic_name);


function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'vừa xong';
  if (mins < 60) return `${mins} phút trước`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs} giờ trước`;
  const days = Math.floor(hrs / 24);
  return `${days} ngày trước`;
}

function statusInfo(status: string) {
  if (status === 'open') return { label: 'Chờ trả lời', icon: 'pending', color: 'text-error bg-error/10' };
  if (status === 'answered') return { label: 'Đã trả lời', icon: 'check_circle', color: 'text-primary bg-primary/10' };
  return { label: 'Đã đóng', icon: 'archive', color: 'text-on-surface-variant bg-surface-container-high' };
}

---

<BaseLayout title="Hồ Sơ Cá Nhân | Dental Empire OS" description="Quản lý thông tin hồ sơ cá nhân." noindex={true}>
  <div class="min-h-screen bg-surface pt-24 pb-16">
    <div class="max-w-[1100px] mx-auto px-4 md:px-6">

      <!-- Page Header -->
      <div class="flex items-start justify-between gap-4 mb-6 md:mb-8">
        <div class="min-w-0">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-primary mb-1">Tài khoản của bạn</p>
          <h1 class="text-xl md:text-2xl font-bold text-white">Hồ sơ cá nhân</h1>
          <p class="text-xs md:text-sm text-on-surface-variant mt-1 max-w-2xl">Quản lý danh tính, quyền truy cập và những việc cần làm tiếp theo.</p>
        </div>
        <NotificationBell />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[340px_1fr] gap-4 md:gap-6">

        <!-- LEFT COLUMN: Profile Card (sticky on desktop) -->
        <div class="flex flex-col gap-4 lg:gap-6 lg:sticky lg:top-24 lg:self-start">

          <!-- Identity Card -->
          <div class="glass-card rounded-2xl p-5 md:p-6 border border-outline-variant/20">
            <!-- Avatar -->
            <div class="flex flex-col items-center gap-3">
              <div class="relative group">
                {user?.image ? (
                  <img
                    id="avatar-preview"
                    src={user.image}
                    alt="Avatar"
                    class="w-24 h-24 md:w-28 md:h-28 rounded-full object-cover border-2 border-outline-variant/30"
                  />
                ) : (
                  <div
                    id="avatar-preview"
                    class="w-24 h-24 md:w-28 md:h-28 rounded-full bg-primary/10 flex items-center justify-center border-2 border-outline-variant/30"
                  >
                    <span class="material-symbols-outlined text-5xl text-primary/40">person</span>
                  </div>
                )}
                <button
                  id="avatar-trigger"
                  type="button"
                  class="absolute inset-0 flex items-center justify-center bg-black/50 rounded-full opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity"
                  aria-label="Thay đổi ảnh"
                >
                  <span class="material-symbols-outlined text-white text-2xl">photo_camera</span>
                </button>
              </div>

              <input id="avatar-input" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
              <button id="avatar-mobile-trigger" type="button" class="sm:hidden inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:underline">
                <span class="material-symbols-outlined text-base">photo_camera</span>
                Đổi ảnh đại diện
              </button>

              <div class="text-center">
                <p id="display-name" class="text-base md:text-lg font-bold text-white truncate max-w-[260px]">{user?.name}</p>
                <p class="text-xs text-on-surface-variant mt-0.5 truncate max-w-[260px]">{user?.email}</p>
              </div>

              <p id="avatar-error" class="hidden text-xs text-rose-400 text-center"></p>
              <p class="text-[10px] text-on-surface-variant text-center">JPEG/PNG/WebP · tối đa 5MB</p>
           </div>

           <!-- Clinic setup status -->
           <a
             href="/account/clinic"
             class:list={[
               'block rounded-2xl p-4 border transition-colors group',
               isClinicReady
                 ? 'border-primary/25 bg-primary/[0.06] hover:bg-primary/[0.1]'
                 : 'border-tertiary/30 bg-tertiary/[0.08] hover:bg-tertiary/[0.12]',
             ]}
           >
             <div class="flex items-start gap-3">
               <span class:list={['material-symbols-outlined mt-0.5', isClinicReady ? 'text-primary' : 'text-tertiary']}>
                 {isClinicReady ? 'verified' : 'assignment_late'}
               </span>
               <div class="min-w-0 flex-1">
                 <div class="flex items-center justify-between gap-2">
                   <p class="text-sm font-bold text-white">Hồ sơ phòng khám</p>
                   <span class:list={['text-[10px] font-bold', isClinicReady ? 'text-primary' : 'text-tertiary']}>
                     {isClinicReady ? 'Sẵn sàng' : `${clinicCompletion}/4 mục`}
                   </span>
                 </div>
                 <p class="text-[11px] leading-relaxed text-on-surface-variant mt-1">
                   {isClinicReady
                     ? 'Thông tin sẽ được điền sẵn khi bạn thực hiện Scanner.'
                     : 'Hoàn tất tên phòng khám để dùng Scanner nhanh hơn.'}
                 </p>
               </div>
               <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors">chevron_right</span>
             </div>
           </a>

            <!-- Divider -->
            <div class="h-px bg-outline-variant/15 my-5"></div>

            <!-- Stats -->
            <div class="grid grid-cols-2 gap-3">
              <div class="flex flex-col items-center text-center p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/40">
                <span class="material-symbols-outlined text-primary text-lg">folder_copy</span>
                <p class="text-base font-bold text-white mt-1">{scannerAssetCount}</p>
                <p class="text-[10px] text-on-surface-variant">Tài liệu</p>
              </div>
              <div class="flex flex-col items-center text-center p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/40">
                <span class="material-symbols-outlined text-primary text-lg">forum</span>
                <p class="text-base font-bold text-white mt-1">{questions.length}</p>
                <p class="text-[10px] text-on-surface-variant">Câu hỏi</p>
              </div>
            </div>
          </div>

          <!-- Credit Balance Card -->
          <div class="glass-card rounded-2xl p-5 border border-primary/20 bg-gradient-to-br from-primary/10 to-transparent">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider">Ví Credits</h3>
              <span class="material-symbols-outlined text-primary text-base">account_balance_wallet</span>
            </div>
            <p class="text-3xl font-black text-white">{creditBalance.available}</p>
            <p class="text-[11px] text-on-surface-variant mt-1">
              {creditBalance.reserved > 0 && <span>Tạm giữ: {creditBalance.reserved} · </span>}
              Tổng: {creditBalance.total}
            </p>
            <a href="/account/wallet" class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline">
              Nạp credits
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>

            <!-- Hướng dẫn sử dụng -->
            <div class="mt-4 pt-4 border-t border-outline-variant/15">
              <p class="text-[11px] font-semibold text-on-surface-variant mb-2.5">Cách dùng Credits</p>
              <div class="flex flex-col gap-2.5">
                <div class="flex items-start gap-2.5">
                  <span class="material-symbols-outlined text-sm text-primary mt-0.5">analytics</span>
                  <div>
                    <p class="text-xs font-semibold text-white">Scanner phòng khám</p>
                    <p class="text-[10px] text-on-surface-variant">Mỗi lượt quét trả phí bằng Credits</p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5">
                  <span class="material-symbols-outlined text-sm text-primary mt-0.5">menu_book</span>
                  <div>
                    <p class="text-xs font-semibold text-white">Mở khóa nội dung</p>
                    <p class="text-[10px] text-on-surface-variant">Sách, blog theo ngày · Khóa học, tài liệu vĩnh viễn</p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5">
                  <span class="material-symbols-outlined text-sm text-primary mt-0.5">psychology</span>
                  <div>
                    <p class="text-xs font-semibold text-white">Công cụ AI</p>
                    <p class="text-[10px] text-on-surface-variant">Phân tích, kế hoạch AI cho phòng khám</p>
                  </div>
                </div>
              </div>
              <p class="text-[10px] text-on-surface-variant mt-3">Credits không hết hạn. Tạm giữ sẽ hoàn lại khi yêu cầu hoàn tất.</p>
            </div>
          </div>

          <!-- Edit Profile Card -->
          <div class="glass-card rounded-2xl p-5 md:p-6 border border-outline-variant/20">
            <h2 class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-4">Thông tin</h2>

            <!-- Name -->
            <div class="mb-4">
              <label class="block text-xs font-semibold text-on-surface-variant mb-1.5" for="name-input">Tên hiển thị</label>
              <input
                id="name-input"
                type="text"
                value={user?.name ?? ''}
                maxlength="100"
                class="w-full px-3 py-2.5 bg-white/5 border border-outline-variant rounded-lg text-white placeholder:text-white/30 focus:ring-2 focus:ring-primary focus:outline-none text-sm"
              />
              <p id="name-error" class="hidden text-xs text-rose-400 mt-1.5"></p>
            </div>

            <!-- Email (read-only) -->
            <div class="mb-4">
              <label class="block text-xs font-semibold text-on-surface-variant mb-1.5">Email</label>
              <div class="flex items-center gap-2 px-3 py-2.5 bg-white/5 border border-outline-variant/30 rounded-lg text-on-surface-variant text-sm">
                <span class="material-symbols-outlined text-base">lock</span>
                <span class="truncate flex-1">{user?.email}</span>
              </div>
              <p class="text-[10px] text-on-surface-variant mt-1">Không thể thay đổi</p>
            </div>

            <button
              id="name-save-btn"
              type="button"
              disabled
              class="w-full px-4 py-2.5 btn-primary-metallic font-bold rounded-lg text-sm active:scale-95 transition-all disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Lưu thay đổi
            </button>
          </div>

          <!-- Quick links -->
          <div class="rounded-2xl border border-outline-variant/20 overflow-hidden">
            <div class="bg-surface-container-low px-5 py-3 border-b border-outline-variant/30">
              <h2 class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider">Quản lý</h2>
            </div>
            <div class="flex flex-col">
              <a href="/account/wallet" class="flex items-center gap-3 px-5 py-3 text-sm text-on-surface-variant hover:bg-white/5 hover:text-white transition-colors">
                <span class="material-symbols-outlined text-primary">account_balance_wallet</span>
                Ví Credits
                <span class="material-symbols-outlined ml-auto text-base">chevron_right</span>
              </a>
              <a href="/account/payments" class="flex items-center gap-3 px-5 py-3 text-sm text-on-surface-variant hover:bg-white/5 hover:text-white transition-colors">
                <span class="material-symbols-outlined text-primary">receipt_long</span>
                Lịch sử thanh toán
                <span class="material-symbols-outlined ml-auto text-base">chevron_right</span>
              </a>
              <a
                href="/account/clinic"
                class="flex items-center gap-3 px-5 py-3 hover:bg-white/[0.05] transition-colors group"
              >
                <span class="material-symbols-outlined text-primary text-lg">local_hospital</span>
                <div class="flex-1">
                  <p class="text-sm font-semibold text-white group-hover:text-primary transition-colors">Hồ sơ phòng khám</p>
                  <p class="text-[10px] text-on-surface-variant">Tên, địa chỉ, logo</p>
                </div>
                <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-primary transition-colors text-lg">chevron_right</span>
              </a>
              <div class="h-px bg-outline-variant/10"></div>
               <a
                 href="/account/action-plans"
                 class="flex items-center gap-3 px-5 py-3 hover:bg-white/[0.05] transition-colors group"
               >
                 <span class="material-symbols-outlined text-primary text-lg">assignment</span>
                 <div class="flex-1">
                   <p class="text-sm font-semibold text-white group-hover:text-primary transition-colors">Kế hoạch hành động</p>
                   <p class="text-[10px] text-on-surface-variant">Việc ưu tiên từ Scanner</p>
                 </div>
                 <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-primary transition-colors text-lg">chevron_right</span>
               </a>
               <a
                 href="/account/scanner-history"
                 class="flex items-center gap-3 px-5 py-3 hover:bg-white/[0.05] transition-colors group"
               >
                <span class="material-symbols-outlined text-primary text-lg">history</span>
                <div class="flex-1">
                  <p class="text-sm font-semibold text-white group-hover:text-primary transition-colors">Lịch sử Scanner</p>
                  <p class="text-[10px] text-on-surface-variant">Kết quả đã làm</p>
                </div>
                <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-primary transition-colors text-lg">chevron_right</span>
              </a>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: Products + Questions -->
        <div class="flex flex-col gap-4 md:gap-6">

          <!-- Reading Progress -->
          <section class="glass-card rounded-2xl p-5 md:p-6 border border-outline-variant/20" id="reading-stats-section">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm md:text-base font-bold text-white">Tiến độ đọc</h2>
              <span class="material-symbols-outlined text-primary text-lg">auto_stories</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="reading-stats-grid">
              <div class="flex flex-col items-center text-center p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/40">
                <span class="material-symbols-outlined text-primary text-lg" id="rp-completed-icon">trending_up</span>
                <p class="text-base font-bold text-white mt-1 animate-pulse" id="rp-completed" aria-live="polite">...</p>
                <p class="text-[10px] text-on-surface-variant">Đã đọc</p>
              </div>
              <div class="flex flex-col items-center text-center p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/40">
                <span class="material-symbols-outlined text-primary text-lg" id="rp-progress-icon">menu_book</span>
                <p class="text-base font-bold text-white mt-1 animate-pulse" id="rp-progress" aria-live="polite">...</p>
                <p class="text-[10px] text-on-surface-variant">Đang đọc</p>
              </div>
              <div class="flex flex-col items-center text-center p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/40">
                <span class="material-symbols-outlined text-primary text-lg">bookmark</span>
                <p class="text-base font-bold text-white mt-1 animate-pulse" id="rp-bookmarked" aria-live="polite">...</p>
                <p class="text-[10px] text-on-surface-variant">Đánh dấu</p>
              </div>
              <div class="flex flex-col items-center text-center p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/40">
                <span class="material-symbols-outlined text-primary text-lg">calendar_today</span>
                <p class="text-base font-bold text-white mt-1 animate-pulse" id="rp-last-read" aria-live="polite">...</p>
                <p class="text-[10px] text-on-surface-variant">Lần cuối</p>
              </div>
            </div>
            <!-- Week bar -->
            <div class="mt-4 pt-4 border-t border-outline-variant/15">
              <p class="text-[10px] text-on-surface-variant mb-2">Tuần này</p>
              <div class="flex gap-1" id="week-bar">
                <div class="flex-1 flex flex-col items-center gap-1">
                  <div class="w-full h-8 rounded bg-white/5" id="day-bar-0"></div>
                  <span class="text-[9px] text-on-surface-variant">T2</span>
                </div>
                <div class="flex-1 flex flex-col items-center gap-1">
                  <div class="w-full h-8 rounded bg-white/5" id="day-bar-1"></div>
                  <span class="text-[9px] text-on-surface-variant">T3</span>
                </div>
                <div class="flex-1 flex flex-col items-center gap-1">
                  <div class="w-full h-8 rounded bg-white/5" id="day-bar-2"></div>
                  <span class="text-[9px] text-on-surface-variant">T4</span>
                </div>
                <div class="flex-1 flex flex-col items-center gap-1">
                  <div class="w-full h-8 rounded bg-white/5" id="day-bar-3"></div>
                  <span class="text-[9px] text-on-surface-variant">T5</span>
                </div>
                <div class="flex-1 flex flex-col items-center gap-1">
                  <div class="w-full h-8 rounded bg-white/5" id="day-bar-4"></div>
                  <span class="text-[9px] text-on-surface-variant">T6</span>
                </div>
                <div class="flex-1 flex flex-col items-center gap-1">
                  <div class="w-full h-8 rounded bg-white/5" id="day-bar-5"></div>
                  <span class="text-[9px] text-on-surface-variant">T7</span>
                </div>
                <div class="flex-1 flex flex-col items-center gap-1">
                  <div class="w-full h-8 rounded bg-white/5" id="day-bar-6"></div>
                  <span class="text-[9px] text-on-surface-variant">CN</span>
                </div>
              </div>
            </div>
          </section>

          <!-- Generated scanner documents and images -->
          <section class="glass-card rounded-2xl p-5 md:p-6 border border-outline-variant/20">
            <div class="flex items-center justify-between gap-4 mb-4">
              <div>
                <h2 class="text-sm md:text-base font-bold text-white">Tài liệu đã tạo</h2>
                <p class="text-[11px] text-on-surface-variant mt-0.5">Bản PDF và hình minh họa từ các kết quả Scanner của bạn.</p>
              </div>
              <span class="px-2 py-0.5 text-[11px] font-bold bg-primary/10 text-primary rounded-full">{scannerAssetCount}</span>
            </div>

            {scannerAssetCount === 0 ? (
              <div class="text-center py-8">
                <span class="material-symbols-outlined text-5xl text-on-surface-variant/20 block mb-3">folder_open</span>
                <p class="text-sm text-on-surface-variant mb-1">Chưa có tài liệu nào</p>
                <p class="text-xs text-on-surface-variant/70 mb-4">PDF và hình minh họa sẽ xuất hiện sau khi bạn tạo báo cáo Scanner.</p>
                <a
                  href="/account/scanner-history"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-on-primary font-bold text-xs hover:opacity-90 transition-all"
                >
                  <span class="material-symbols-outlined text-sm">history</span>
                  Xem lịch sử Scanner
                </a>
              </div>
            ) : (
              <div class="flex flex-col gap-3">
                {scannerAssets.map(entry => (
                  <div class="rounded-xl bg-surface-container-low border border-outline-variant/40 hover:border-primary/50 transition-colors p-3">
                    <a href={`/scanner/result/${entry.responseId}`} class="block text-sm font-semibold text-on-surface hover:text-primary transition-colors truncate mb-2">
                      {entry.scannerTitle}
                    </a>
                    <div class="flex flex-wrap gap-2">
                      {entry.assets.map(asset => (
                        <a
                          href={asset.href}
                          download
                          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-surface-container-high border border-outline-variant/50 text-xs font-semibold text-on-surface hover:bg-primary/15 hover:border-primary/50 hover:text-primary transition-colors"
                        >
                          <span class="material-symbols-outlined text-sm">{asset.icon}</span>
                          {asset.label}
                          <span class="material-symbols-outlined text-sm" aria-hidden="true">download</span>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
                <a href="/account/scanner-history" class="inline-flex self-start items-center gap-1.5 text-xs font-semibold text-primary hover:underline">
                  Xem toàn bộ lịch sử Scanner
                  <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
              </div>
            )}
          </section>

          <!-- My Questions -->
          <section class="glass-card rounded-2xl p-5 md:p-6 border border-outline-variant/20">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm md:text-base font-bold text-white">Câu hỏi của tôi</h2>
              <span class="px-2 py-0.5 text-[11px] font-bold bg-primary/10 text-primary rounded-full">{questions.length}</span>
            </div>

            {questions.length === 0 ? (
              <div class="text-center py-8">
                <span class="material-symbols-outlined text-5xl text-on-surface-variant/20 block mb-3">question_answer</span>
                <p class="text-sm text-on-surface-variant mb-1">Chưa có câu hỏi nào</p>
                <p class="text-xs text-on-surface-variant/70 mb-4">Hãy đọc tài liệu và nhấn nút "Hỏi Tác Giả" để đặt câu hỏi.</p>
                <a
                  href="/book"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-on-primary font-bold text-xs hover:opacity-90 transition-all"
                >
                  <span class="material-symbols-outlined text-sm">menu_book</span>
                  Đọc tài liệu
                </a>
              </div>
            ) : (
              <div class="flex flex-col gap-2">
                {questions.slice(0, 5).map(q => {
                  const ch = chapterMap.get(q.chapter_id);
                  const st = statusInfo(q.status);
                  return (
                    <a
                      href={`/my-questions/${q.id}`}
                      class="flex items-start gap-3 p-3 rounded-xl bg-white/5 hover:bg-white/10 transition-colors group"
                    >
                      <div class:list={['w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0', st.color]}>
                        <span class="material-symbols-outlined text-base">{st.icon}</span>
                      </div>
                      <div class="flex-1 min-w-0">
                        <h3 class="text-sm font-semibold text-white truncate group-hover:text-primary transition-colors">{q.title}</h3>
                        <div class="flex items-center gap-1.5 mt-1 text-[11px] text-on-surface-variant">
                          <span class:list={['px-1.5 py-0.5 rounded text-[10px] font-bold', st.color]}>{st.label}</span>
                          {ch && <span>Tier {ch.tier} · Ch{String(ch.chapter_no).padStart(2, '0')}</span>}
                          <span>· {timeAgo(q.createdAt)}</span>
                        </div>
                      </div>
                      <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-primary transition-colors self-center">chevron_right</span>
                    </a>
                  );
                })}
                {questions.length > 5 && (
                  <p class="text-xs text-center text-on-surface-variant/60 mt-2">
                    Và {questions.length - 5} câu hỏi khác...
                  </p>
                )}
              </div>
            )}
          </section>
        </div>
      </div>

    </div>
  </div>

  <script>
    import { authClient } from '../../lib/auth-client';

    // ── Reading Progress Stats ──
    (async () => {
      const setEl = (id: string, val: string | number) => {
        const e = document.getElementById(id);
        if (e) {
          e.textContent = String(val);
          e.classList.remove('animate-pulse');
        }
      };

      try {
        const res = await fetch('/api/reading-progress');
        if (!res.ok) throw new Error('Reading progress unavailable');
        const data = await res.json() as { progress: Array<{ chapter_id: string; max_pct: number; bookmarked: number; last_read_at: string }>; stats: { totalChapters: number; completed: number; inProgress: number; bookmarked: number; lastReadAt: string | null } };

        const stats = data.stats;
        if (!stats) return;

        setEl('rp-completed', stats.completed);
        setEl('rp-progress', stats.inProgress);
        setEl('rp-bookmarked', stats.bookmarked);

        const completedIcon = document.getElementById('rp-completed-icon');
        const progressIcon = document.getElementById('rp-progress-icon');
        if (stats.completed > 0 && completedIcon) completedIcon.textContent = 'check_circle';
        if (stats.inProgress > 0 && progressIcon) progressIcon.textContent = 'menu_book';

        if (stats.lastReadAt) {
          const days = Math.floor((Date.now() - new Date(stats.lastReadAt).getTime()) / 86400000);
          setEl('rp-last-read', days === 0 ? 'Hôm nay' : days === 1 ? '1 ngày' : `${days} ngày`);
        } else {
          setEl('rp-last-read', '—');
        }

        // Week bar
        const dayMap: Record<string, number> = {};
        const now = new Date();
        for (let i = 6; i >= 0; i--) {
          const d = new Date(now);
          d.setDate(d.getDate() - i);
          const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
          dayMap[key] = 0;
        }
        for (const p of data.progress) {
          const key = p.last_read_at.slice(0, 10);
          if (key in dayMap) dayMap[key]++;
        }
        Object.entries(dayMap).forEach(([, count], idx) => {
          const bar = document.getElementById(`day-bar-${idx}`);
          if (bar && count > 0) {
            bar.classList.remove('bg-white/5');
            bar.classList.add('bg-primary');
            (bar as HTMLElement).style.opacity = String(Math.min(1, 0.3 + count * 0.35));
          }
        });
      } catch (_) {
        ['rp-completed', 'rp-progress', 'rp-bookmarked', 'rp-last-read'].forEach((id) => setEl(id, '—'));
      }
    })();

    let originalName = (document.getElementById('name-input') as HTMLInputElement).value;
    const originalImageSrc = document.getElementById('avatar-preview')?.getAttribute('src') ?? '';

    // ── Avatar upload ──
    const avatarInput = document.getElementById('avatar-input') as HTMLInputElement;
    const avatarTrigger = document.getElementById('avatar-trigger') as HTMLButtonElement;
    const avatarMobileTrigger = document.getElementById('avatar-mobile-trigger') as HTMLButtonElement;
    const avatarPreview = document.getElementById('avatar-preview') as HTMLElement;
    const avatarError = document.getElementById('avatar-error') as HTMLElement;
    const displayNameEl = document.getElementById('display-name');
    let isUploading = false;

    avatarTrigger?.addEventListener('click', () => avatarInput.click());
    avatarMobileTrigger?.addEventListener('click', () => avatarInput.click());

    avatarInput?.addEventListener('change', async () => {
      const file = avatarInput.files?.[0];
      if (!file) return;

      avatarError.classList.add('hidden');

      if (file.size > 5 * 1024 * 1024) {
        avatarError.textContent = 'File quá lớn (tối đa 5MB).';
        avatarError.classList.remove('hidden');
        avatarInput.value = '';
        return;
      }

      const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
      if (!allowedTypes.includes(file.type)) {
        avatarError.textContent = 'Chỉ hỗ trợ JPEG, PNG, WebP.';
        avatarError.classList.remove('hidden');
        avatarInput.value = '';
        return;
      }

      const previewUrl = URL.createObjectURL(file);
      if (avatarPreview.tagName === 'IMG') {
        (avatarPreview as HTMLImageElement).src = previewUrl;
      } else {
        const img = document.createElement('img');
        img.id = 'avatar-preview';
        img.src = previewUrl;
        img.alt = 'Avatar';
        img.className = 'w-24 h-24 md:w-28 md:h-28 rounded-full object-cover border-2 border-outline-variant/30';
        avatarPreview.parentNode?.replaceChild(img, avatarPreview);
      }

      if (isUploading) return;
      isUploading = true;

      try {
        const fd = new FormData();
        fd.append('file', file);
        const res = await fetch('/api/account/avatar', { method: 'POST', body: fd });

        if (!res.ok) {
          const body = await res.json().catch((): { error?: string } => ({})) as { error?: string };
          throw new Error(body.error || 'Upload failed');
        }

        const { url } = await res.json() as { url: string };

        const { error } = await authClient.updateUser({ image: url });
        if (error) throw new Error(error.message || 'Failed to update user');

        window.showToast('Cập nhật ảnh thành công', 'success');
      } catch (err: any) {
        if (originalImageSrc && avatarPreview.tagName === 'IMG') {
          (avatarPreview as HTMLImageElement).src = originalImageSrc;
        }
        avatarError.textContent = err?.message || 'Có lỗi xảy ra.';
        avatarError.classList.remove('hidden');
        window.showToast('Cập nhật ảnh thất bại', 'error');
      } finally {
        isUploading = false;
        avatarInput.value = '';
      }
    });

    // ── Name save ──
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const nameSaveBtn = document.getElementById('name-save-btn') as HTMLButtonElement;
    const nameError = document.getElementById('name-error') as HTMLElement;

    function checkNameDirty() {
      const dirty = nameInput.value.trim() !== originalName.trim();
      nameSaveBtn.disabled = !dirty || nameInput.value.trim() === '';
    }

    nameInput?.addEventListener('input', checkNameDirty);

    nameSaveBtn?.addEventListener('click', async () => {
      const newName = nameInput.value.trim();
      if (!newName || newName === originalName.trim()) return;

      nameSaveBtn.disabled = true;
      nameSaveBtn.textContent = 'Đang lưu...';
      nameError.classList.add('hidden');

      try {
        const { error } = await authClient.updateUser({ name: newName });
        if (error) throw new Error(error.message || 'Failed to update');

        // Update displayed name in identity card
        if (displayNameEl) displayNameEl.textContent = newName;

        window.showToast('Cập nhật tên thành công', 'success');
        nameSaveBtn.textContent = 'Lưu thay đổi';
        originalName = newName;
        checkNameDirty();
      } catch (err: any) {
        nameError.textContent = err?.message || 'Có lỗi xảy ra.';
        nameError.classList.remove('hidden');
        window.showToast('Cập nhật tên thất bại', 'error');
        nameSaveBtn.disabled = false;
        nameSaveBtn.textContent = 'Lưu thay đổi';
      }
    });
  </script>
</BaseLayout>
