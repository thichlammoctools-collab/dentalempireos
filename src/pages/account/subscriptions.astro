---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { createAuth } from '../../lib/auth';
import { listProductEntitlements } from '../../lib/entitlement-db';
import { listUserAccess } from '../../lib/payos-db';
import { listSurveyDefinitions } from '../../lib/survey-config-db';

export const prerender = false;

const auth = createAuth(env);
const result = await auth.api.getSession({ headers: Astro.request.headers });
if (!result?.user) {
  return Astro.redirect('/login?redirect=/account/subscriptions');
}

const accesses = await listUserAccess(env.DB, result.user.id);

// Resolve product details
const accessDetails = await Promise.all(
  accesses.map(async (a) => {
    const prod = await env.DB
      .prepare('SELECT * FROM "product" WHERE "id" = ?')
      .bind(a.product_id)
      .first<{ id: string; name: string; price: number | null; description: string | null }>();
    const isExpiring = a.expires_at
      ? new Date(a.expires_at).getTime() - Date.now() < 7 * 24 * 60 * 60 * 1000
      : false;
    const productEntitlements = prod
      ? await listProductEntitlements(env.DB, prod.id)
      : [];
    const entitlements = a.selected_scanner_id
      ? productEntitlements.filter((entitlement) => (
        entitlement.content_type !== 'scanner' || entitlement.content_id === a.selected_scanner_id
      ))
      : productEntitlements;
    return { ...a, product: prod, entitlements, isExpiring };
  }),
);

const entitlementTypeLabels: Record<string, string> = {
  book: 'Tài liệu',
  ai_app: 'Công cụ AI',
  scanner: 'Scanner',
  course: 'Khóa học',
  blog: 'Blog',
  resource: 'Tài liệu',
  service: 'Dịch vụ',
};

function formatDate(iso: string | null): string {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

const totalSpent = accessDetails.reduce(
  (sum, a) => sum + (a.product?.price ?? 0), 0,
);

// Build scanner ID → slug mapping for linking to specific scanner pages
const surveyDefs = await listSurveyDefinitions(env.DB, { status: 'active' });
const scannerSlugMap = new Map<string, string>(
  surveyDefs.map((s) => [s.id, s.slug]),
);
---

<BaseLayout title="Quản lý Subscription | Dental Empire OS" noindex={true}>
  <div class="min-h-screen bg-surface pt-24 pb-16">
    <div class="max-w-3xl mx-auto px-4">

      <!-- Back -->
      <a
        href="/account/profile"
        class="flex items-center gap-1 text-sm text-on-surface-variant hover:text-primary transition-colors mb-6"
      >
        <span class="material-symbols-outlined text-lg">arrow_back</span>
        Quay lại hồ sơ
      </a>

       <h1 class="text-2xl font-bold text-on-surface mb-2">Quản lý Subscription</h1>
      <p class="text-sm text-on-surface-variant mb-6">
        Các sản phẩm và dịch vụ bạn đã mua.
      </p>

      {accessDetails.length === 0 ? (
        <div class="glass-card rounded-2xl p-8 text-center">
          <span class="material-symbols-outlined text-5xl text-on-surface-variant/20 block mb-3">workspace_premium</span>
          <p class="text-on-surface mb-4">Chưa có subscription nào</p>
           <a href="/scanner/pack" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-on-primary font-bold text-sm">
            Khám phá Scanner Pack
          </a>
        </div>
      ) : (
        <>
          <!-- Summary -->
          <div class="flex items-center justify-between mb-4">
            <p class="text-sm text-on-surface-variant">
              {accessDetails.length} sản phẩm
            </p>
             <p class="text-sm font-bold text-on-surface">
              Tổng: {totalSpent.toLocaleString('vi-VN')}đ
            </p>
          </div>

          <div class="flex flex-col gap-3">
            {accessDetails.map(a => (
              <div class="glass-card rounded-2xl p-5 border border-outline-variant/20">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-primary text-xl">
                        {a.entitlements.some((entitlement) => entitlement.content_type === 'scanner') ? 'analytics' : a.entitlements.some((entitlement) => entitlement.content_type === 'service') ? 'support_agent' : 'inventory_2'}
                      </span>
                       <h3 class="text-on-surface font-bold truncate">{a.product?.name ?? a.product_id}</h3>
                    </div>
                    {a.product?.description && (
                      <p class="text-xs text-on-surface-variant mt-1 line-clamp-2">
                        {a.product.description}
                      </p>
                    )}
                    <p class="text-[11px] text-on-surface-variant mt-2">
                      {a.is_active
                        ? <span class="text-emerald-400 font-semibold">Hoạt động</span>
                        : <span class="text-rose-400 font-semibold">Hết hạn</span>}
                      {a.expires_at ? ` · HSD: ${formatDate(a.expires_at)}` : ' · Vĩnh viễn'}
                    </p>
                    {a.isExpiring && (
                      <span class="inline-block mt-2 px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 text-[10px] font-bold">
                        Sắp hết hạn
                      </span>
                    )}
                    {a.entitlements.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-1.5">
                        {a.entitlements.map((entitlement) => (
                          <span class="rounded-md bg-secondary-container/50 px-2 py-1 text-[10px] font-semibold text-on-secondary-container">
                            {entitlementTypeLabels[entitlement.content_type] ?? entitlement.content_type}: {entitlement.content_id === '*' ? 'Toàn bộ' : entitlement.content_id}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                  <div class="text-right shrink-0">
                    {a.product?.price ? (
                      <>
                         <p class="text-on-surface font-bold">{a.product.price.toLocaleString('vi-VN')}đ</p>
                        <p class="text-[10px] text-on-surface-variant">Mua: {formatDate(a.granted_at)}</p>
                      </>
                    ) : (
                      <span class="text-xs text-on-surface-variant">—</span>
                    )}
                  </div>
                </div>

                {a.entitlements.some((entitlement) => entitlement.content_type === 'scanner') && (
                  <div class="mt-4 pt-4 border-t border-outline-variant/15 flex flex-wrap gap-2">
                    {a.entitlements
                      .filter((entitlement) => entitlement.content_type === 'scanner')
                      .map((entitlement) => {
                        const isWildcard = entitlement.content_id === '*';
                        const slug = isWildcard ? null : scannerSlugMap.get(entitlement.content_id);
                        const href = slug ? `/scanner/${slug}` : '/scanner';
                        return (
                          <a
                            href={href}
                            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary/10 text-primary text-sm font-semibold hover:bg-primary/20 transition-all"
                          >
                            <span class="material-symbols-outlined text-base">analytics</span>
                            {isWildcard ? 'Mở Scanner' : `Mở ${surveyDefs.find((s) => s.id === entitlement.content_id)?.title_vi ?? 'Scanner'}`}
                          </a>
                        );
                      })}
                  </div>
                )}
              </div>
            ))}
          </div>
        </>
      )}

      <!-- Navigation -->
      <div class="mt-8 flex flex-wrap gap-3">
         <a href="/account/profile" class="px-4 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-sm text-on-surface-variant transition-colors">
          Hồ sơ cá nhân
        </a>
        <a href="/scanner/pack" class="px-4 py-2 rounded-xl bg-primary/10 hover:bg-primary/20 text-primary text-sm font-semibold transition-colors">
          Mua thêm
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
