---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listUserOrders, listUserOrdersWithScanners } from '../../lib/payos-db';

export const prerender = false;
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?redirect=%2Faccount%2Fpayments');
let orders;
try {
  orders = await listUserOrdersWithScanners(env.DB, user.id);
} catch (error) {
  console.error('[account/payments] Failed to load scanner details:', error);
  const baseOrders = await listUserOrders(env.DB, user.id);
  orders = baseOrders.map((order) => ({ ...order, scanner_names: [], scanner_links: [] }));
}
const status: Record<string, { label: string; className: string }> = {
  pending: { label: 'Chờ xác nhận', className: 'bg-amber-400/15 text-amber-600 dark:text-amber-300' }, paid: { label: 'Đã thanh toán', className: 'bg-emerald-400/15 text-emerald-600 dark:text-emerald-300' }, cancelled: { label: 'Đã hủy', className: 'bg-rose-400/15 text-rose-600 dark:text-rose-300' }, expired: { label: 'Hết hạn', className: 'bg-on-surface/10 text-on-surface-variant' },
};
---

<BaseLayout title="Lịch sử thanh toán | Dental Empire OS" noindex={true}>
  <main class="min-h-screen bg-surface pt-24 pb-16"><div class="max-w-3xl mx-auto px-4"><a href="/account/profile" class="inline-flex items-center gap-1 mb-6 text-sm text-on-surface-variant hover:text-primary"><span class="material-symbols-outlined text-lg">arrow_back</span>Quay lại hồ sơ</a><h1 class="text-2xl font-bold text-on-surface">Lịch sử thanh toán</h1><p class="mt-1 mb-6 text-sm text-on-surface-variant">Theo dõi tất cả đơn hàng và trạng thái kích hoạt.</p>
   {orders.length === 0 ? <div class="glass-card rounded-2xl p-8 text-center text-sm text-on-surface-variant">Bạn chưa có đơn hàng nào.</div> : <div class="space-y-3">{orders.map(order => { const orderStatus = status[order.status] ?? status.pending; return <article class="glass-card rounded-2xl p-5 border border-outline-variant/20"><div class="flex items-start justify-between gap-4"><div><h2 class="font-bold text-on-surface">{order.product_name}</h2>{order.scanner_links.length > 0 && <p class="mt-1 text-xs text-on-surface-variant">Scanner: <span class="text-on-surface">{order.scanner_links.map((scanner, index) => <>{index > 0 && ', '}<a href={scanner.href} class="hover:text-primary hover:underline">{scanner.name}</a></>)}</span></p>}<p class="mt-1 text-xs text-on-surface-variant">{order.payment_link_id ? 'Thanh toán tự động PayOS' : 'Chuyển khoản ngân hàng'} · {new Date(order.created_at).toLocaleString('vi-VN')}</p>{!order.payment_link_id && <p class="mt-1 text-xs text-on-surface-variant">Nội dung CK: <strong class="font-mono text-primary">DEOS {order.order_code}</strong></p>}</div><span class={`shrink-0 px-2 py-1 rounded-full text-[11px] font-bold ${orderStatus.className}`}>{orderStatus.label}</span></div><div class="mt-4 pt-3 border-t border-outline-variant/15 flex justify-between text-sm"><span class="text-on-surface-variant">Mã đơn: <span class="font-mono text-xs text-on-surface-variant">{order.id}</span></span><strong class="text-on-surface">{order.amount.toLocaleString('vi-VN')}đ</strong></div></article>; })}</div>}</div></main>
</BaseLayout>
