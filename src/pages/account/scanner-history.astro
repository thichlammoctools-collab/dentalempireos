---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { createAuth } from '../../lib/auth';
import { getUserHistory } from '../../lib/scanner-history-db';
import { getScannerResponse, parseScores } from '../../lib/scanner-response-db';

export const prerender = false;

const auth = createAuth(env);
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session?.user) {
  return Astro.redirect('/login?redirect=/account/scanner-history');
}

const history = await getUserHistory(env.DB, session.user.id, 50);
const scannerGroups = [...new Map(history.map((entry) => [entry.survey_id, {
  surveyId: entry.survey_id,
  title: entry.scanner_title_vi ?? 'Scanner',
  slug: entry.scanner_slug,
  entries: history.filter((item) => item.survey_id === entry.survey_id),
}])).values()];
const selectedScannerId = Astro.url.searchParams.get('scanner') ?? scannerGroups[0]?.surveyId ?? null;
const selectedScanner = scannerGroups.find((group) => group.surveyId === selectedScannerId) ?? scannerGroups[0] ?? null;
const selectedResponses = selectedScanner
  ? await Promise.all(selectedScanner.entries.map(async (entry) => ({ entry, response: await getScannerResponse(env.DB, entry.response_id) })))
  : [];
const selectedTimeline = selectedResponses.filter((item): item is typeof item & { response: NonNullable<typeof item.response> } => item.response !== null);
const chronologicalTimeline = [...selectedTimeline].reverse();
const latestScore = selectedTimeline[0]?.response ? parseScores(selectedTimeline[0].response.scores_json).total ?? selectedTimeline[0].entry.score_total : null;
const firstScore = chronologicalTimeline[0]?.response ? parseScores(chronologicalTimeline[0].response.scores_json).total ?? chronologicalTimeline[0].entry.score_total : null;

function formatDate(iso: string): string {
  const d = new Date(iso);
  const now = new Date();
  const diff = now.getTime() - d.getTime();
  const days = Math.floor(diff / 86400000);
  if (days === 0) return 'Hôm nay';
  if (days === 1) return 'Hôm qua';
  if (days < 7) return `${days} ngày trước`;
  return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

function scoreColor(label: string | null): { bg: string; text: string; border: string } {
  if (!label) return { bg: 'bg-white/5', text: 'text-on-surface-variant', border: 'border-outline-variant/20' };
  const l = label.toLowerCase();
  if (l.includes('xuất sắc') || l.includes('excellent') || l.includes('tuyệt'))
    return { bg: 'bg-emerald-500/10', text: 'text-emerald-400', border: 'border-emerald-500/20' };
  if (l.includes('tốt') || l.includes('good'))
    return { bg: 'bg-primary/10', text: 'text-primary', border: 'border-primary/20' };
  if (l.includes('trung bình') || l.includes('cần') || l.includes('needs'))
    return { bg: 'bg-amber-500/10', text: 'text-amber-400', border: 'border-amber-500/20' };
  return { bg: 'bg-rose-500/10', text: 'text-rose-400', border: 'border-rose-500/20' };
}
---

<BaseLayout title="Lịch Sử Scanner | Dental Empire OS" description="Lịch sử các lần làm scanner của bạn." noindex={true}>
  <div class="min-h-screen bg-surface pt-24 pb-16">
    <div class="max-w-[1100px] mx-auto px-4 md:px-6">
      <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
        <div>
          <p class="text-xs font-bold tracking-[0.14em] uppercase text-primary mb-2">Theo dõi tiến độ phòng khám</p>
          <h1 class="text-2xl md:text-3xl font-bold text-on-surface">Lịch sử Check</h1>
          <p class="text-sm text-on-surface-variant mt-2">Xem mọi lần đánh giá hoặc đi sâu vào hành trình của từng Scanner.</p>
        </div>
        <a href="/scanner" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-primary text-on-primary text-sm font-bold hover:opacity-90 transition-opacity">
          <span class="material-symbols-outlined text-base">add</span>Check mới
        </a>
      </header>

      {history.length === 0 ? (
        <div class="glass-card rounded-2xl p-10 md:p-16 border border-outline-variant/20 text-center">
          <span class="material-symbols-outlined text-7xl text-on-surface-variant/30 block mb-4 mx-auto">history</span>
          <h2 class="text-lg font-bold text-on-surface mb-2">Chưa có lịch sử Check</h2>
          <p class="text-sm text-on-surface-variant mb-6 max-w-sm mx-auto">Bạn chưa thực hiện Scanner nào. Hãy bắt đầu để đánh giá phòng khám của bạn.</p>
          <a href="/scanner" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-on-primary font-bold text-sm"><span class="material-symbols-outlined text-base">explore</span>Khám phá Scanner</a>
        </div>
      ) : (
        <>
          <nav class="flex items-center gap-1 border-b border-outline-variant/30 mb-5" aria-label="Chế độ xem lịch sử">
            <a href="/account/scanner-history" class:list={['px-3 py-2.5 text-sm font-semibold border-b-2 -mb-px', !Astro.url.searchParams.has('all') ? 'border-primary text-primary' : 'border-transparent text-on-surface-variant']}>Theo Scanner</a>
            <a href="/account/scanner-history?all=1" class:list={['px-3 py-2.5 text-sm font-semibold border-b-2 -mb-px', Astro.url.searchParams.has('all') ? 'border-primary text-primary' : 'border-transparent text-on-surface-variant']}>Tất cả lịch sử</a>
          </nav>

          {Astro.url.searchParams.has('all') ? (
            <section class="glass-card rounded-2xl border border-outline-variant/20 overflow-hidden">
              <div class="px-5 py-4 border-b border-outline-variant/20 flex items-center justify-between"><h2 class="font-bold text-on-surface">Tất cả hoạt động</h2><span class="text-xs text-on-surface-variant">{history.length} kết quả · mới nhất trước</span></div>
              <div class="divide-y divide-outline-variant/15">
                {history.map((entry) => { const colors = scoreColor(entry.score_label); return <a href={`/account/scanner-history?scanner=${entry.survey_id}`} class="flex items-center gap-3 p-4 hover:bg-surface-container-low transition-colors"><span class="w-10 h-10 rounded-xl bg-primary/10 text-primary grid place-items-center material-symbols-outlined">analytics</span><span class="flex-1 min-w-0"><b class="block text-sm text-on-surface truncate">{entry.scanner_title_vi ?? 'Scanner'}</b><small class="text-xs text-on-surface-variant">{formatDate(entry.created_at)}</small></span>{entry.score_total !== null && <span class:list={['text-xs font-bold px-2.5 py-1 rounded-lg border', colors.bg, colors.text, colors.border]}>{entry.score_label} · {entry.score_total.toFixed(1)}</span>}<span class="material-symbols-outlined text-on-surface-variant">chevron_right</span></a>; })}
              </div>
            </section>
          ) : selectedScanner && (
            <div class="grid grid-cols-1 lg:grid-cols-[290px_1fr] gap-5">
              <aside class="glass-card rounded-2xl border border-outline-variant/20 overflow-hidden h-fit">
                <div class="px-5 py-4 border-b border-outline-variant/20 flex justify-between"><h2 class="font-bold text-sm text-on-surface">Scanner của bạn</h2><span class="text-xs text-on-surface-variant">{scannerGroups.length} Scanner</span></div>
                <div class="divide-y divide-outline-variant/15">
                  {scannerGroups.map((group) => { const latest = group.entries[0]; const previous = group.entries[1]; const change = latest?.score_total != null && previous?.score_total != null ? latest.score_total - previous.score_total : null; return <a href={`/account/scanner-history?scanner=${group.surveyId}`} class:list={['block px-5 py-4 hover:bg-surface-container-low transition-colors', group.surveyId === selectedScanner.surveyId && 'bg-primary/10 border-l-[3px] border-primary pl-4']}><b class="text-sm text-on-surface block truncate">{group.title}</b><span class="block text-xs text-on-surface-variant mt-1">{group.entries.length} lần Check · {formatDate(latest.created_at)}</span><span class="flex justify-between mt-2 text-xs"><b class="text-primary">{latest.score_total?.toFixed(1) ?? '—'} điểm</b>{change !== null && <b class:list={[change > 0 ? 'text-emerald-500' : change < 0 ? 'text-rose-500' : 'text-on-surface-variant']}>{change > 0 ? '↑ +' : change < 0 ? '↓ ' : ''}{change.toFixed(1)}</b>}</span></a>; })}
                </div>
              </aside>
              <section class="glass-card rounded-2xl border border-outline-variant/20 overflow-hidden">
                <header class="p-5 border-b border-outline-variant/20 flex flex-col sm:flex-row gap-4 justify-between sm:items-center"><div><h2 class="text-xl font-bold text-on-surface">{selectedScanner.title}</h2><p class="text-xs text-on-surface-variant mt-1">{selectedScanner.entries.length} lần đánh giá · Theo dõi từ {formatDate(chronologicalTimeline[0]?.entry.created_at ?? selectedScanner.entries.at(-1)?.created_at ?? '')}</p></div><div class="flex items-center gap-3"><div class="w-14 h-14 rounded-full border-[6px] border-primary grid place-items-center text-sm font-bold text-on-surface">{latestScore?.toFixed(0) ?? '—'}</div><div class="text-xs"><span class="block text-on-surface-variant">Điểm hiện tại</span>{typeof latestScore === 'number' && typeof firstScore === 'number' && <b class:list={['block mt-1', latestScore > firstScore ? 'text-emerald-500' : latestScore < firstScore ? 'text-rose-500' : 'text-on-surface-variant']}>{latestScore === firstScore ? 'Không đổi từ mốc đầu' : `${latestScore > firstScore ? '↑ +' : '↓ '}${Math.abs(latestScore - firstScore).toFixed(1)} điểm từ mốc đầu`}</b>}</div></div></header>
                <div class="p-5 md:p-6">
                  {chronologicalTimeline.map(({ entry, response }, index) => { const score = parseScores(response.scores_json).total ?? entry.score_total; const before = chronologicalTimeline[index - 1]; const beforeScore = before ? parseScores(before.response.scores_json).total ?? before.entry.score_total : null; const delta = typeof score === 'number' && typeof beforeScore === 'number' ? score - beforeScore : null; const status = response.ai_analysis_status === 'done' ? 'Phân tích đã sẵn sàng' : response.ai_analysis_status === 'failed' ? 'Phân tích cần thử lại' : 'Check hoàn tất'; const colors = scoreColor(entry.score_label); return <article class="grid grid-cols-[76px_20px_1fr] gap-3 md:gap-4 last:pb-0"><time class="text-xs text-on-surface-variant pt-1"><b class="block text-on-surface">{formatDate(entry.created_at)}</b>{new Date(entry.created_at).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}</time><div class="relative flex justify-center"><span class="w-3 h-3 mt-1.5 rounded-full bg-primary border-[3px] border-primary-container z-10"></span>{index < chronologicalTimeline.length - 1 && <span class="absolute top-5 bottom-0 w-px bg-outline-variant"></span>}</div><div class="border border-outline-variant/25 rounded-xl p-4 mb-5"><div class="flex gap-3 justify-between items-start"><div><h3 class="font-bold text-sm text-on-surface">{index === 0 ? 'Mốc đánh giá đầu tiên' : 'Check hoàn tất'}</h3><p class="text-xs text-on-surface-variant mt-1">{status}</p></div>{score !== null && <span class:list={['text-[11px] font-bold px-2 py-1 rounded-md border whitespace-nowrap', colors.bg, colors.text, colors.border]}>{entry.score_label ?? 'Đã chấm điểm'} · {score.toFixed(1)}</span>}</div><div class="flex flex-wrap gap-x-4 gap-y-1 mt-3 text-xs text-on-surface-variant"><span>{delta === null ? 'Điểm tham chiếu ban đầu' : <>So với lần trước <b class:list={['ml-1', delta > 0 ? 'text-emerald-500' : delta < 0 ? 'text-rose-500' : 'text-on-surface-variant']}>{delta > 0 ? '+' : ''}{delta.toFixed(1)} điểm</b></>}</span>{response.ai_plan_status === 'done' && <span>Kế hoạch hành động đã tạo</span>}</div><div class="mt-3 rounded-lg bg-surface-container-low px-3 py-2 text-xs text-on-surface-variant">Thông tin liên quan: <b class="text-on-surface">{response.clinic_name ?? 'Báo cáo Check của bạn'}</b>{response.years_in_operation !== null && <> · {response.years_in_operation} năm hoạt động</>}</div><a href={`/scanner/result/${entry.response_id}`} class="inline-flex items-center gap-1 text-xs font-bold text-primary mt-3">Xem báo cáo đầy đủ <span class="material-symbols-outlined text-sm">arrow_forward</span></a></div></article>; })}
                </div>
              </section>
            </div>
          )}
        </>
      )}
    </div>
  </div>
</BaseLayout>
