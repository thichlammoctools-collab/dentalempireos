---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaymentButton from '../components/PaymentButton.astro';
import FrameworkVisual from '../components/home/FrameworkVisual.astro';
import { env } from 'cloudflare:workers';
import { getHomepageSettings, getDefaults } from '../lib/homepage-db';
import {
  getActiveBookProduct,
  getPayosSettings,
  getManualPaymentSettings,
  getPayosEnv,
} from '../lib/payos-db';
import { getTierStats } from '../lib/book-db';

export const prerender = false;

const [savedHomepage, activeBookProduct, payosSettings, manualPaymentSettings, tier1Stats, tier2Stats, tier3Stats] = await Promise.all([
  getHomepageSettings(env.DB),
  getActiveBookProduct(env.DB),
  getPayosSettings(env.DB),
  getManualPaymentSettings(env.DB),
  getTierStats(env.DB, 1),
  getTierStats(env.DB, 2),
  getTierStats(env.DB, 3),
]);

const homepage = savedHomepage ?? getDefaults();
const payosEnv = getPayosEnv(env.DB, payosSettings, env);
const payosPaymentAvailable = payosSettings?.is_active === 1
  && Boolean(payosEnv.PAYOS_CLIENT_ID && payosEnv.PAYOS_API_KEY && payosEnv.PAYOS_CHECKSUM_KEY);
const manualPaymentAvailable = manualPaymentSettings?.is_active === 1
  && Boolean(
    manualPaymentSettings.bank_bin.trim()
    && manualPaymentSettings.account_number.trim()
    && manualPaymentSettings.zalo_url.trim(),
  );
const canPurchaseBook = Boolean(activeBookProduct && (payosPaymentAvailable || manualPaymentAvailable));

const paymentCopy = payosPaymentAvailable && manualPaymentAvailable
  ? 'Bạn có thể thanh toán qua PayOS hoặc chuyển khoản theo hướng dẫn xác nhận.'
  : payosPaymentAvailable
    ? 'Thanh toán qua PayOS đang hoạt động; quyền truy cập được kích hoạt khi hệ thống nhận được xác nhận thanh toán thành công.'
    : manualPaymentAvailable
      ? 'Thanh toán chuyển khoản đang hoạt động; quét QR đúng số tiền rồi nhắn Zalo để được xác nhận.'
      : 'Thanh toán hiện chưa được cấu hình. Bạn vẫn có thể xem trước nội dung sách.';

const tiers = [
  { number: 1, name: homepage.tier1_name, subtitle: homepage.tier1_subtitle, icon: homepage.tier1_icon, stats: tier1Stats },
  { number: 2, name: homepage.tier2_name, subtitle: homepage.tier2_subtitle, icon: homepage.tier2_icon, stats: tier2Stats },
  { number: 3, name: homepage.tier3_name, subtitle: homepage.tier3_subtitle, icon: homepage.tier3_icon, stats: tier3Stats },
];

const testimonials = [
  { quote: homepage.testimonial1_quote, name: homepage.testimonial1_name, role: homepage.testimonial1_role, avatar: homepage.testimonial1_avatar },
  { quote: homepage.testimonial2_quote, name: homepage.testimonial2_name, role: homepage.testimonial2_role, avatar: homepage.testimonial2_avatar },
  { quote: homepage.testimonial3_quote, name: homepage.testimonial3_name, role: homepage.testimonial3_role, avatar: homepage.testimonial3_avatar },
];

const faqs = [
  {
    question: 'Sách này phù hợp với ai?',
    answer: 'Sách dành cho bác sĩ, chủ phòng khám và quản lý muốn nhìn hoạt động nha khoa như một hệ thống có thể đo lường, chuẩn hóa và cải tiến.',
  },
  {
    question: 'Mua sách có được nhận kèm các mẫu tài liệu vận hành không?',
    answer: 'Không. SOP, KPI dashboard, CRM tracker, financial report, marketing plan và hiring template là các tài nguyên riêng trên nền tảng; chúng không được đóng gói hoặc mở khóa cùng sách.',
  },
  {
    question: 'Tôi thanh toán bằng cách nào?',
    answer: paymentCopy,
  },
  {
    question: 'Tôi có thể xem nội dung trước khi mua không?',
    answer: 'Có. Bạn có thể vào mục Đọc sách để xem các nội dung được mở xem trước. Các phần cần quyền truy cập sẽ hiển thị theo trạng thái của sản phẩm.',
  },
  {
    question: 'Tôi có thể đọc sách trên điện thoại, máy tính bảng và máy tính không?',
    answer: 'Có. Giao diện đọc sách được thiết kế responsive để sử dụng thuận tiện trên điện thoại, máy tính bảng và máy tính để bàn.',
  },
  {
    question: 'Sau khi thanh toán, quyền truy cập được kích hoạt như thế nào?',
    answer: payosPaymentAvailable && manualPaymentAvailable
      ? 'Với PayOS, quyền truy cập được kích hoạt khi hệ thống nhận được xác nhận thanh toán thành công. Nếu chọn chuyển khoản, hãy làm theo hướng dẫn xác nhận trên trang thanh toán.'
      : payosPaymentAvailable
        ? 'Với PayOS, quyền truy cập được kích hoạt khi hệ thống nhận được xác nhận thanh toán thành công.'
      : manualPaymentAvailable
        ? 'Sau khi chuyển khoản, hãy làm theo hướng dẫn xác nhận trên trang thanh toán để được kích hoạt quyền truy cập.'
        : 'Khi phương thức thanh toán được mở, hướng dẫn kích hoạt sẽ hiển thị tại trang thanh toán.',
  },
];
---

<BaseLayout
  title="Dental Empire OS | Hệ điều hành quản trị phòng khám nha khoa"
  description="Khung tư duy quản trị giúp phòng khám nha khoa chẩn đoán, chuẩn hóa và nhân bản vận hành."
>
  <section class="homepage-hero relative overflow-hidden bg-surface-container-lowest">
    <div class="homepage-hero__grid" aria-hidden="true"></div>
    <div class="homepage-hero__glow homepage-hero__glow--cyan" aria-hidden="true"></div>
    <div class="homepage-hero__glow homepage-hero__glow--amber" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-[1200px] gap-12 px-6 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:py-28">
      <div class="max-w-3xl">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/35 bg-primary/10 px-4 py-2 text-sm font-bold tracking-wide text-primary">
          <span class="material-symbols-outlined text-lg">hub</span>
          {homepage.badge_text}
        </p>
        <h1 class="max-w-3xl text-4xl font-black leading-tight text-on-surface sm:text-5xl lg:text-6xl">{homepage.hero_title_line1}<br class="hidden sm:block" />{homepage.hero_title_line2}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-on-surface-variant">{homepage.hero_description}</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-3" aria-label="Lợi ích chính">
          <li class="rounded-2xl border border-outline-variant/70 bg-surface-container/80 p-4 text-sm font-semibold text-on-surface">Chẩn đoán đúng điểm nghẽn trước khi sửa quy trình.</li>
          <li class="rounded-2xl border border-outline-variant/70 bg-surface-container/80 p-4 text-sm font-semibold text-on-surface">Chuẩn hóa cách đội ngũ ra quyết định mỗi ngày.</li>
          <li class="rounded-2xl border border-outline-variant/70 bg-surface-container/80 p-4 text-sm font-semibold text-on-surface">Tạo nền để vận hành ổn định và có thể nhân bản.</li>
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          {canPurchaseBook && activeBookProduct ? (
            <PaymentButton productId={activeBookProduct.id} productName={activeBookProduct.name} price={activeBookProduct.price} class="text-base" />
          ) : (
            <a href="/book" class="inline-flex items-center gap-2 rounded-xl btn-primary-metallic px-6 py-3 font-bold transition-transform active:scale-95">
              {homepage.hero_cta_primary}
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </a>
          )}
          <a href="/book" class="inline-flex items-center gap-2 rounded-xl border border-outline-variant px-6 py-3 font-bold text-on-surface hover:border-primary hover:text-primary transition-colors">
            {homepage.hero_cta_secondary}
            <span class="material-symbols-outlined text-lg">menu_book</span>
          </a>
        </div>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-on-surface-variant">{homepage.hero_stats_text}</p>
      </div>

      <div class="self-center space-y-5">
        <FrameworkVisual />
        <aside class="hero-steps rounded-3xl border border-outline-variant/70 bg-surface-container-lowest/80 p-5">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">Vận hành không phụ thuộc</p>
          <ol class="mt-5 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
            <li class="hero-step"><span class="hero-step__number">01</span><div><h2 class="font-bold text-on-surface">Nhìn được hệ thống</h2><p class="mt-1 text-sm text-on-surface-variant">Tách triệu chứng khỏi nguyên nhân gốc.</p></div></li>
            <li class="hero-step"><span class="hero-step__number">02</span><div><h2 class="font-bold text-on-surface">Thiết kế cách chạy</h2><p class="mt-1 text-sm text-on-surface-variant">Biến kinh nghiệm thành tiêu chuẩn chung.</p></div></li>
            <li class="hero-step"><span class="hero-step__number">03</span><div><h2 class="font-bold text-on-surface">Để đội ngũ tự vận hành</h2><p class="mt-1 text-sm text-on-surface-variant">Theo dõi bằng số liệu, không chỉ sự có mặt.</p></div></li>
          </ol>
        </aside>
      </div>
    </div>
  </section>

  <section id="pain-points" class="scroll-mt-24 border-y border-outline-variant/60 bg-surface-container-low py-20">
    <div class="mx-auto max-w-[1200px] px-6">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Bốn điểm nghẽn thường gặp</p>
      <h2 class="mt-3 max-w-3xl text-3xl font-black text-on-surface sm:text-4xl">Khi mọi quyết định đều phải đi qua bạn, phòng khám chưa có hệ điều hành.</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <article class="rounded-2xl border border-outline-variant/70 bg-surface-container-lowest p-6"><span class="material-symbols-outlined text-3xl text-primary">person_alert</span><h3 class="mt-4 text-xl font-bold text-on-surface">Chủ phòng khám là nút thắt</h3><p class="mt-2 leading-relaxed text-on-surface-variant">Việc nhỏ cũng cần chờ phê duyệt, khiến tốc độ xử lý phụ thuộc vào lịch có mặt của bạn.</p></article>
        <article class="rounded-2xl border border-outline-variant/70 bg-surface-container-lowest p-6"><span class="material-symbols-outlined text-3xl text-primary">account_tree</span><h3 class="mt-4 text-xl font-bold text-on-surface">Quy trình nằm trong đầu người giỏi</h3><p class="mt-2 leading-relaxed text-on-surface-variant">Đội ngũ làm theo kinh nghiệm riêng, nên chất lượng thay đổi theo từng ca và từng người.</p></article>
        <article class="rounded-2xl border border-outline-variant/70 bg-surface-container-lowest p-6"><span class="material-symbols-outlined text-3xl text-primary">query_stats</span><h3 class="mt-4 text-xl font-bold text-on-surface">Có dữ liệu nhưng không có nhịp quản trị</h3><p class="mt-2 leading-relaxed text-on-surface-variant">Báo cáo chỉ xuất hiện khi có vấn đề, thay vì trở thành công cụ ra quyết định đều đặn.</p></article>
        <article class="rounded-2xl border border-outline-variant/70 bg-surface-container-lowest p-6"><span class="material-symbols-outlined text-3xl text-primary">groups_3</span><h3 class="mt-4 text-xl font-bold text-on-surface">Mở rộng làm mọi thứ phức tạp hơn</h3><p class="mt-2 leading-relaxed text-on-surface-variant">Khi thêm người hoặc thêm cơ sở, tiêu chuẩn cũ không còn được truyền đạt và kiểm soát nhất quán.</p></article>
      </div>
    </div>
  </section>

  <section id="roadmap" class="roadmap-section scroll-mt-24 py-20">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Lộ trình thay đổi</p><h2 class="mt-3 text-3xl font-black text-on-surface sm:text-4xl">Chẩn đoán trước, chuẩn hóa sau, rồi mới nhân bản.</h2></div><a href="/scanner/total-os-diagnostic" class="inline-flex items-center gap-2 font-bold text-primary hover:text-on-surface transition-colors">Làm Total OS Diagnostic <span class="material-symbols-outlined">arrow_forward</span></a></div>
      <div class="roadmap-line mt-10 grid gap-5 lg:grid-cols-3">
        <article class="roadmap-card"><div class="roadmap-card__icon"><span class="material-symbols-outlined">troubleshoot</span></div><p class="mt-6 text-sm font-black text-primary">01. Diagnosis</p><h3 class="mt-3 text-2xl font-bold text-on-surface">Chẩn đoán</h3><p class="mt-3 leading-relaxed text-on-surface-variant">Đo mức độ phụ thuộc, tìm các điểm đứt trong luồng bệnh nhân, đội ngũ và tài chính.</p></article>
        <article class="roadmap-card"><div class="roadmap-card__icon"><span class="material-symbols-outlined">account_tree</span></div><p class="mt-6 text-sm font-black text-primary">02. Standardize</p><h3 class="mt-3 text-2xl font-bold text-on-surface">Chuẩn hóa</h3><p class="mt-3 leading-relaxed text-on-surface-variant">Xác định tiêu chuẩn, vai trò, chỉ số và nhịp họp để công việc không cần nhắc lại bằng miệng.</p></article>
        <article class="roadmap-card"><div class="roadmap-card__icon"><span class="material-symbols-outlined">network_node</span></div><p class="mt-6 text-sm font-black text-primary">03. Replicate</p><h3 class="mt-3 text-2xl font-bold text-on-surface">Nhân bản</h3><p class="mt-3 leading-relaxed text-on-surface-variant">Dùng hệ thống đã kiểm chứng để đào tạo người mới, mở rộng dịch vụ hoặc phát triển cơ sở tiếp theo.</p></article>
      </div>
    </div>
  </section>

  <section id="what-you-get" class="scroll-mt-24 bg-surface-container-low py-20">
    <div class="mx-auto max-w-[1200px] px-6">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">{homepage.tier_section_heading}</p>
      <h2 class="mt-3 max-w-3xl text-3xl font-black text-on-surface sm:text-4xl">{homepage.tier_section_subheading}</h2>
      <div class="tier-grid mt-10 grid gap-5 lg:grid-cols-3">
        {tiers.map((tier) => (
          <article class="tier-card">
            <div class="flex items-start justify-between gap-4"><p class="text-sm font-black text-primary">TẦNG {tier.number}</p><span class="tier-card__icon material-symbols-outlined" aria-hidden="true">{tier.icon}</span></div>
            <h3 class="mt-3 text-2xl font-bold text-on-surface">{tier.name}</h3>
            <p class="mt-3 min-h-12 leading-relaxed text-on-surface-variant">{tier.subtitle}</p>
            <dl class="mt-6 flex gap-6 border-t border-outline-variant/60 pt-5 text-sm"><div><dt class="text-on-surface-variant">Chương đã xuất bản</dt><dd class="mt-1 text-2xl font-black text-primary">{tier.stats.chapterCount}</dd></div><div><dt class="text-on-surface-variant">Đề mục</dt><dd class="mt-1 text-2xl font-black text-primary">{tier.stats.sectionCount}</dd></div></dl>
            <a href="/book" class="mt-6 inline-flex items-center gap-2 font-bold text-primary hover:text-on-surface transition-colors">Khám phá nội dung <span class="material-symbols-outlined text-lg">arrow_forward</span></a>
          </article>
        ))}
      </div>
      <div class="mt-8 rounded-2xl border border-amber-400/30 bg-amber-400/10 p-6">
        <h3 class="text-lg font-bold text-on-surface">Tài nguyên nền tảng là danh mục riêng</h3>
        <p class="mt-2 max-w-4xl leading-relaxed text-on-surface-variant">SOP, KPI dashboard, CRM tracker, financial report, marketing plan và hiring template có trên nền tảng như các tài nguyên riêng. Chúng không được đóng gói hoặc mở khóa cùng sách.</p>
        <a href="/resources" class="mt-4 inline-flex items-center gap-2 font-bold text-primary hover:text-on-surface transition-colors">Xem tài nguyên <span class="material-symbols-outlined text-lg">arrow_forward</span></a>
      </div>
    </div>
  </section>

  <section id="comparison" class="scroll-mt-24 py-20">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
        <article class="rounded-3xl border border-outline-variant/70 p-8"><p class="text-sm font-bold uppercase tracking-[0.16em] text-on-surface-variant">Cách tiếp cận rời rạc</p><h2 class="mt-4 text-3xl font-black text-on-surface">Học các khóa theo chủ đề rời rạc</h2><ul class="mt-7 space-y-4 text-on-surface-variant"><li class="flex gap-3"><span class="material-symbols-outlined text-rose-400">close</span>Mỗi chủ đề giải quyết một lát cắt nhưng thiếu thứ tự ưu tiên.</li><li class="flex gap-3"><span class="material-symbols-outlined text-rose-400">close</span>Kiến thức khó chuyển thành nhịp vận hành chung của đội ngũ.</li><li class="flex gap-3"><span class="material-symbols-outlined text-rose-400">close</span>Kết quả phụ thuộc vào khả năng tự ghép nối của từng người học.</li></ul></article>
        <article class="rounded-3xl border border-primary/45 bg-primary/10 p-8"><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Dental Empire OS</p><h2 class="mt-4 text-3xl font-black text-on-surface">{activeBookProduct?.name ?? 'Một khung quản trị nối các quyết định với nhau.'}</h2>{canPurchaseBook && activeBookProduct && <p class="mt-3 text-2xl font-black text-primary">{activeBookProduct.price.toLocaleString('vi-VN')}₫</p>}<ul class="mt-7 space-y-4 text-on-surface"><li class="flex gap-3"><span class="material-symbols-outlined text-primary">check_circle</span>Bắt đầu từ chẩn đoán để biết việc nào cần làm trước.</li><li class="flex gap-3"><span class="material-symbols-outlined text-primary">check_circle</span>Liên kết vận hành, con người, tài chính và trải nghiệm bệnh nhân.</li><li class="flex gap-3"><span class="material-symbols-outlined text-primary">check_circle</span>Hướng đến một hệ thống có thể đào tạo, kiểm tra và lặp lại.</li></ul>{canPurchaseBook && activeBookProduct ? <PaymentButton productId={activeBookProduct.id} productName={activeBookProduct.name} price={activeBookProduct.price} class="mt-8 text-base" /> : <a href="/book" class="mt-8 inline-flex items-center gap-2 rounded-xl btn-primary-metallic px-6 py-3 font-bold transition-transform active:scale-95">Xem sách <span class="material-symbols-outlined text-lg">arrow_forward</span></a>}</article>
      </div>
    </div>
  </section>

  <section id="reviews" class="scroll-mt-24 bg-surface-container-low py-20">
    <div class="mx-auto max-w-[1200px] px-6">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">{homepage.testimonial_section_heading}</p>
      <h2 class="mt-3 max-w-3xl text-3xl font-black text-on-surface sm:text-4xl">{homepage.testimonial_section_subheading}</h2>
      <div class=”mt-10 grid gap-5 lg:grid-cols-3”>
        {testimonials.map((testimonial) => (
          <figure class=”flex flex-col rounded-3xl border border-outline-variant/70 bg-surface-container-lowest p-7”>
            <blockquote class=”flex-1 text-lg leading-relaxed text-on-surface”>”{testimonial.quote}”</blockquote>
            <figcaption class=”mt-7 border-t border-outline-variant/60 pt-5 flex items-center gap-3”>
              {testimonial.avatar ? (
                <img src={testimonial.avatar} alt={testimonial.name} class=”w-10 h-10 rounded-full object-cover border border-outline-variant/50” loading=”lazy” />
              ) : (
                <div class=”w-10 h-10 rounded-full bg-primary/15 flex items-center justify-center shrink-0”>
                  <span class=”material-symbols-outlined text-primary text-xl”>person</span>
                </div>
              )}
              <div>
                <p class=”font-bold text-on-surface”>{testimonial.name}</p>
                <p class=”mt-0.5 text-sm text-on-surface-variant”>{testimonial.role}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
      <article class="mt-10 grid gap-7 rounded-3xl border border-primary/30 bg-surface-container p-8 md:grid-cols-[auto_1fr] md:items-start">
        {homepage.founder_image_url ? (
          <img src={homepage.founder_image_url} alt={homepage.founder_name} class="w-20 h-20 rounded-2xl object-cover border border-outline-variant/30" loading="lazy" />
        ) : (
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/15 text-primary"><span class="material-symbols-outlined text-4xl">person</span></div>
        )}
        <div><p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">{homepage.founder_badge}</p><h3 class="mt-2 text-2xl font-black text-on-surface">{homepage.founder_heading}</h3><p class="mt-3 max-w-3xl leading-relaxed text-on-surface-variant">{homepage.founder_bio}</p><p class="mt-5 font-bold text-on-surface">{homepage.founder_name} <span class="font-normal text-on-surface-variant">· {homepage.founder_title}</span></p><div class="mt-5 flex flex-wrap gap-6 text-sm"><p><strong class="text-primary">{homepage.founder_stat1_value}</strong> <span class="text-on-surface-variant">{homepage.founder_stat1_label}</span></p><p><strong class="text-primary">{homepage.founder_stat2_value}</strong> <span class="text-on-surface-variant">{homepage.founder_stat2_label}</span></p></div>
          {homepage.founder_link_text && (
            <a href="/about" class="mt-4 inline-flex items-center gap-2 font-bold text-primary hover:text-on-surface transition-colors">{homepage.founder_link_text} <span class="material-symbols-outlined text-lg">arrow_forward</span></a>
          )}
        </div>
      </article>
    </div>
  </section>

  <section id="faq" class="scroll-mt-24 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-center text-sm font-bold uppercase tracking-[0.16em] text-primary">Câu hỏi thường gặp</p>
      <h2 class="mt-3 text-center text-3xl font-black text-on-surface sm:text-4xl">Thông tin rõ ràng trước khi bạn quyết định.</h2>
      <div class="mt-10 space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-outline-variant/70 bg-surface-container p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-on-surface"><span>{faq.question}</span><span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45">add</span></summary>
            <p class="pt-4 leading-relaxed text-on-surface-variant">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="buy" class="scroll-mt-24 bg-primary/10 py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">Bắt đầu từ hệ thống của bạn</p>
      <h2 class="mt-3 text-3xl font-black text-on-surface sm:text-5xl">{homepage.cta_heading}</h2>
      <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-on-surface-variant">{homepage.cta_subtext}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {canPurchaseBook && activeBookProduct ? (
          <PaymentButton productId={activeBookProduct.id} productName={activeBookProduct.name} price={activeBookProduct.price} class="text-base" />
        ) : (
          <a href={homepage.cta_primary_link || '/book'} class="inline-flex items-center gap-2 rounded-xl btn-primary-metallic px-6 py-3 font-bold transition-transform active:scale-95">
            {homepage.cta_primary_text}
            <span class="material-symbols-outlined text-lg">{homepage.cta_primary_icon || 'arrow_forward'}</span>
          </a>
        )}
        <a href={homepage.cta_secondary_link || '/book'} class="inline-flex items-center gap-2 rounded-xl border border-outline-variant bg-surface-container-lowest px-6 py-3 font-bold text-on-surface hover:border-primary hover:text-primary transition-colors">
          {homepage.cta_secondary_text}
          <span class="material-symbols-outlined text-lg">{homepage.cta_secondary_icon || 'menu_book'}</span>
        </a>
      </div>
      <p class="mt-4 text-sm text-on-surface-variant">{paymentCopy}</p>
    </div>
  </section>
</BaseLayout>
