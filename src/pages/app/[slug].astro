---
import { env } from 'cloudflare:workers';
import { getAppBySlug, parseAppConfig } from '../../lib/app-db';
import { getActiveCreditPricingRule, getCreditBalance } from '../../lib/credit-db';
import { canAccessAiApp } from '../../lib/entitlement-check';
import '../../styles/global.css';

export const prerender = false;

const slugParam = Astro.params.slug;
const slug = slugParam ?? '';

// Hồ Sơ Gốc Rễ is a Scanner, not a conversational SOP generator. Keep the
// legacy app URL working while directing users to its dedicated survey flow.
if (slug === 'ho-so-goc-re') {
  return Astro.redirect('/scanner/ho-so-goc-re');
}

const app = await getAppBySlug(env.DB, slug);

if (!app) return new Response('Không tìm thấy ứng dụng', { status: 404 });
if (app.status !== 'active') return new Response('Ứng dụng chưa kích hoạt', { status: 404 });
if (!(await canAccessAiApp(env.DB, Astro.locals.user?.id, app.id))) {
  return Astro.redirect('/ai-tools');
}

const config = parseAppConfig(app.config_json);
const promptVi = typeof config.prompt_vi === 'string' ? config.prompt_vi : '';
const modelOverride = typeof config.model_override === 'string' ? config.model_override : '*';
const pricingRule = await getActiveCreditPricingRule(env.DB, 'ai_app', app.id, modelOverride);
const creditBalance = Astro.locals.user ? await getCreditBalance(env.DB, Astro.locals.user.id) : null;
const creditNotice = pricingRule?.tokens_per_credit
  ? `Quy đổi: 1 Credit / ${pricingRule.tokens_per_credit.toLocaleString('vi-VN')} token.`
  : pricingRule?.credit_amount
    ? `Chi phí: ${pricingRule.credit_amount} Credits mỗi lượt AI.`
    : 'Công cụ hiện chưa tính Credits.';
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{app.name}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link id="material-symbols-stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" media="print" />
  <script is:inline>
    document.getElementById('material-symbols-stylesheet')?.addEventListener('load', function () {
      this.media = 'all';
    });
  </script>
  <noscript><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" /></noscript>
  <style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
  </style>
  <style>
    * { box-sizing: border-box; }
    html { background: #111214; }
    body {
      min-width: 0;
      min-height: 100vh;
      overflow-x: hidden;
      background: radial-gradient(circle at 50% -20%, #292d35 0%, #17191d 42%, #111214 100%);
      color: #e7e8ea;
      font-family: 'Be Vietnam Pro', sans-serif;
      font-weight: 400;
    }
    button, textarea { font: inherit; }
    button { -webkit-tap-highlight-color: transparent; }
    button:focus-visible, textarea:focus-visible { outline: 2px solid #a5b4fc; outline-offset: 2px; }
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }
    .app-header {
      position: sticky; top: 0; z-index: 100;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(17, 18, 20, 0.84);
      backdrop-filter: blur(18px);
    }
    .header-inner {
      display: flex; align-items: center; gap: 10px;
      width: min(100% - 32px, 768px); min-height: 64px; margin: 0 auto;
    }
    .header-icon {
      display: flex; flex: 0 0 auto; align-items: center; justify-content: center;
      width: 36px; height: 36px; border: 1px solid rgba(165, 180, 252, 0.18); border-radius: 11px;
      background: linear-gradient(145deg, rgba(129, 140, 248, 0.22), rgba(129, 140, 248, 0.08));
    }
    .header-text { flex: 1; min-width: 0; }
    .header-title { overflow: hidden; color: #fafafa; font-size: 14px; font-weight: 600; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
    .header-desc { overflow: hidden; margin-top: 1px; color: #989ca5; font-size: 11px; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
    .header-reset, .reset-link {
      border: 0; background: transparent; color: #aeb2bb; cursor: pointer;
    }
    .header-reset {
      display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center;
      width: 36px; height: 36px; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px;
    }
    .header-reset:hover { background: rgba(255, 255, 255, 0.08); color: #fff; }

    .workflow-shell {
      width: min(100% - 32px, 768px); margin: 0 auto; padding-top: 20px;
    }
    .workflow-back { color: #8edcf5; font-size: 12px; text-decoration: none; }
    .workflow-notice {
      display: flex; gap: 9px; margin-top: 18px; padding: 12px 14px;
      border: 1px solid rgba(111, 207, 240, 0.35); background: rgba(34, 96, 122, 0.22);
      color: #b8d3de; font-size: 12px; line-height: 1.5;
    }
    .credit-status {
      display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-top: 12px;
      color: #a9c1cb; font-size: 11px; line-height: 1.5;
    }
    .credit-status b { color: #f6c453; }
    .workflow-notice strong { color: #76d9ad; }
    .workflow-progress { height: 3px; margin-top: 22px; background: #1a3949; }
    .workflow-progress-fill { width: 0%; height: 100%; background: linear-gradient(90deg, #66cfee, #74d8ac); transition: width .25s ease; }
    .workflow-steps { display: flex; justify-content: space-between; gap: 8px; margin: 8px 0 2px; color: #7693a1; font-size: 10px; }
    .workflow-steps span.active { color: #73d7ab; font-weight: 700; }
    .chat-area {
      width: min(100% - 32px, 768px); min-height: 100%; margin: 0 auto;
      padding: 22px 0 calc(188px + env(safe-area-inset-bottom));
    }
    .msg-wrap {
      display: flex; align-items: flex-start; gap: 10px; width: 100%; margin-bottom: 20px;
      animation: msgIn 0.28s ease-out;
    }
    .msg-wrap.user { justify-content: flex-end; }
    .msg-wrap.user .user-avatar { order: 2; }
    @keyframes msgIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .msg-avatar {
      display: flex; flex: 0 0 auto; align-items: center; justify-content: center;
      width: 32px; height: 32px; margin-top: 3px; border-radius: 10px;
    }
    .ai-avatar { background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.08); }
    .user-avatar { background: rgba(129, 140, 248, 0.16); border: 1px solid rgba(165, 180, 252, 0.18); }
    .msg-bubble {
      max-width: min(82%, 620px); padding: 14px 16px; font-family: 'Be Vietnam Pro', sans-serif;
      font-size: 14px; font-weight: 400; line-height: 1.7; letter-spacing: -0.01em; overflow-wrap: anywhere;
    }
    .ai-bubble {
      background: rgba(37, 39, 44, 0.88); border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 5px 18px 18px; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    }
    .workflow-intro { max-width: 100%; padding: 22px; }
    .workflow-intro .workflow-kicker { color: #78d6f2; font-size: 10px; font-weight: 800; letter-spacing: 0.1em; }
    .workflow-intro h1 { margin: 9px 0; color: #fff; font-size: clamp(24px, 4vw, 32px); line-height: 1.2; }
    .workflow-intro p { color: #b4c8d1; font-size: 13px; line-height: 1.65; }
    .user-bubble {
      background: #4951a5; border: 1px solid rgba(199, 210, 254, 0.22);
      border-radius: 18px 5px 18px 18px; color: #fff; font-weight: 500;
      box-shadow: 0 10px 24px rgba(32, 36, 93, 0.24);
    }
    .msg-bubble p { margin-bottom: 8px; }
    .msg-bubble p:last-child { margin-bottom: 0; }
    .msg-bubble strong { color: #fff; font-weight: 600; }
    .msg-bubble ul, .msg-bubble ol { padding-left: 20px; margin: 6px 0; }
    .msg-bubble li { margin-bottom: 4px; }
    .msg-bubble code { padding: 1px 6px; border-radius: 5px; background: rgba(165, 180, 252, 0.12); color: #c7d2fe; font-size: 12px; }
    .sug-wrap { display: flex; flex-direction: column; align-items: stretch; gap: 8px; margin-top: 16px; }
    .sug-opt {
      position: relative; width: 100%; min-height: 40px; padding: 9px 34px 9px 12px; border: 1px solid rgba(165, 180, 252, 0.3); border-radius: 10px;
      background: rgba(129, 140, 248, 0.1); color: #e1e5ff; cursor: pointer; font-family: inherit; font-size: 13px; font-weight: 600;
      line-height: 1.4; text-align: left; transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }
    .sug-opt::after { position: absolute; top: 50%; right: 12px; color: #aeb8ff; content: '→'; font-size: 16px; transform: translateY(-50%); }
    .sug-opt:hover { border-color: rgba(165, 180, 252, 0.6); background: rgba(129, 140, 248, 0.19); color: #fff; }
    .sug-opt:active { transform: translateY(1px); background: rgba(129, 140, 248, 0.28); }

    .typing-wrap { display: flex; gap: 10px; margin-bottom: 20px; }
    .typing-bubble { padding: 12px 16px; border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 5px 18px 18px; background: rgba(37, 39, 44, 0.88); }
    .typing-dots { display: flex; align-items: center; gap: 4px; height: 20px; }
    .dot { width: 6px; height: 6px; border-radius: 50%; background: #9ca3af; animation: bounce 1.4s infinite; }
    .dot:nth-child(2) { animation-delay: 0.2s; }
    .dot:nth-child(3) { animation-delay: 0.4s; }
    @keyframes bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-5px); } }

    .input-area {
      position: fixed; right: 0; bottom: 0; left: 0; z-index: 100;
      padding: 12px max(16px, env(safe-area-inset-right)) calc(12px + env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
      border-top: 1px solid rgba(255, 255, 255, 0.08); background: rgba(17, 18, 20, 0.88); backdrop-filter: blur(18px);
    }
    .input-area[hidden] { display: none; }
    .input-inner { width: min(100%, 768px); margin: 0 auto; }
    .input-row {
      display: flex; align-items: flex-end; gap: 8px; padding: 7px 7px 7px 14px;
      border: 1px solid rgba(255, 255, 255, 0.13); border-radius: 16px; background: #25272c;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .input-row:focus-within { border-color: rgba(165, 180, 252, 0.72); box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.12); }
    .input-row textarea {
      flex: 1; min-width: 0; max-height: 120px; padding: 7px 0; border: 0; outline: 0; resize: none;
      background: transparent; color: #f3f4f6; font-size: 14px; line-height: 1.5;
    }
    .input-row textarea::placeholder { color: #8a8f99; }
    .input-row textarea:disabled { cursor: not-allowed; opacity: 0.55; }
    .send-btn {
      display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 38px; height: 38px;
      border: 0; border-radius: 12px; background: #818cf8; color: #12131a; cursor: pointer;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .send-btn:hover:not(:disabled) { background: #a5b4fc; transform: translateY(-1px); }
    .send-btn:active:not(:disabled) { transform: translateY(0); }
    .send-btn:disabled { cursor: not-allowed; opacity: 0.42; }
    .input-hint { display: flex; justify-content: space-between; gap: 12px; padding: 7px 2px 0; }
    .input-hint span, .reset-link { color: #858a94; font-size: 11px; line-height: 1.4; }
    .turn-counter { color: #74d7ad !important; font-weight: 600; }
    .turn-counter.is-final { color: #fbbf24 !important; }
    .reset-link { padding: 0; text-decoration: underline; text-underline-offset: 2px; }
    .reset-link:hover { color: #d7d9df; }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
    }
    @media (max-width: 640px) {
      .header-inner, .chat-area { width: min(100% - 24px, 768px); }
      .header-inner { min-height: 60px; }
      .chat-area { padding-top: 20px; padding-bottom: calc(184px + env(safe-area-inset-bottom)); }
      .msg-wrap { gap: 8px; margin-bottom: 16px; }
      .msg-avatar { width: 30px; height: 30px; }
      .msg-bubble { max-width: calc(100% - 38px); padding: 13px 14px; }
      .sug-opt { min-height: 44px; padding: 9px 12px; }
      .input-area { padding-top: 10px; }
      .input-row { padding-left: 12px; }
      .input-row textarea { font-size: 16px; }
      .send-btn { width: 42px; height: 42px; }
    }

    /* SOP Result Panel */
    .sop-panel {
      display: none;
      max-width: 720px;
      margin: 0 auto;
      padding: 24px 16px;
      scroll-margin-top: 80px;
    }
    .sop-panel.visible { display: block; }
    .sop-toolbar {
      display: flex; gap: 10px; align-items: center;
      margin-bottom: 20px; flex-wrap: wrap;
    }
    .sop-toolbar h2 { font-size: 18px; font-weight: 700; color: #f8fafc; flex: 1; }
    .sop-btn {
      padding: 8px 16px; border-radius: 10px; border: none;
      font-size: 13px; font-weight: 600; cursor: pointer;
      font-family: inherit; display: flex; align-items: center; gap: 6px;
      transition: all 0.15s;
    }
    .sop-btn.print { background: #059669; color: white; }
    .sop-btn.print:hover { background: #047857; }
    .sop-btn.new { background: rgba(51, 65, 85, 0.5); color: #94a3b8; border: 1px solid rgba(51, 65, 85, 0.8); }
    .sop-btn.new:hover { background: rgba(51, 65, 85, 0.8); color: #e2e8f0; }
    /* SOP Document (print-ready) */
    .sop-content {
      background: white;
      color: #1e293b;
      border-radius: 16px;
      padding: 48px;
      font-size: 13px;
      line-height: 1.8;
      box-shadow: 0 4px 24px rgba(0,0,0,0.3);
    }
    .sop-content h1 { font-size: 22px; font-weight: 700; text-align: center; color: #0f172a; margin-bottom: 4px; padding-bottom: 12px; border-bottom: 2px solid #4f46e5; }
    .sop-content h2 { font-size: 16px; font-weight: 700; color: #4f46e5; margin: 20px 0 8px; border-left: 3px solid #4f46e5; padding-left: 10px; }
    .sop-content h3 { font-size: 14px; font-weight: 600; color: #334155; margin: 14px 0 6px; }
    .sop-content p { margin: 6px 0; }
    .sop-content ol { padding-left: 24px; }
    .sop-content ol li { margin-bottom: 8px; }
    .sop-content ul { padding-left: 24px; }
    .sop-content ul li { margin-bottom: 4px; }
    .sop-content table { width: 100%; border-collapse: collapse; margin: 12px 0; }
    .sop-content th { background: #f1f5f9; padding: 8px 12px; text-align: left; font-weight: 600; border: 1px solid #e2e8f0; }
    .sop-content td { padding: 6px 12px; border: 1px solid #e2e8f0; }
    .sop-content strong { color: #0f172a; }
    .sop-content .sop-footer { margin-top: 24px; padding-top: 12px; border-top: 1px solid #e2e8f0; font-size: 11px; color: #94a3b8; text-align: center; }

    /* === Print Template (hidden, cloned for printing) === */
    #sop-print-root { display: none; }

    /* Print document page */
    .sop-page {
      background: white;
      color: #1a1a2e;
      font-family: 'Be Vietnam Pro', Arial, sans-serif;
      font-size: 11pt;
      line-height: 1.65;
      width: 210mm;
      min-height: 297mm;
      padding: 18mm 20mm 20mm;
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
    }

    /* Print header */
    .sop-print-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 10px;
      border-bottom: 2px solid #4f46e5;
      margin-bottom: 16px;
    }
    .sop-print-logo {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .sop-print-logo-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 16px;
      font-weight: 700;
    }
    .sop-print-logo-text {
      font-size: 13pt;
      font-weight: 700;
      color: #1a1a2e;
    }
    .sop-print-logo-sub {
      font-size: 7pt;
      color: #64748b;
      font-weight: 400;
    }
    .sop-print-doc-info {
      text-align: right;
      font-size: 8pt;
      color: #64748b;
    }
    .sop-print-doc-info strong { color: #1a1a2e; }

    /* Cover page */
    .sop-cover {
      text-align: center;
      padding: 20mm 0;
      min-height: 200mm;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .sop-cover-badge {
      display: inline-block;
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      color: white;
      font-size: 8pt;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 4px 16px;
      border-radius: 20px;
      margin-bottom: 20px;
    }
    .sop-cover-title {
      font-size: 24pt;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.3;
      margin-bottom: 8px;
    }
    .sop-cover-subtitle {
      font-size: 12pt;
      color: #64748b;
      margin-bottom: 32px;
    }
    .sop-cover-divider {
      width: 60px;
      height: 3px;
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      border-radius: 2px;
      margin: 0 auto 32px;
    }
    .sop-cover-meta {
      display: inline-block;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 20px 32px;
      text-align: left;
      font-size: 9pt;
    }
    .sop-cover-meta table { border-collapse: collapse; }
    .sop-cover-meta td {
      padding: 4px 0;
      vertical-align: top;
    }
    .sop-cover-meta td:first-child {
      color: #64748b;
      width: 120px;
      font-weight: 500;
    }
    .sop-cover-meta td:last-child {
      color: #1a1a2e;
      font-weight: 600;
    }
    .sop-cover-signatures {
      margin-top: 40px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 20px;
      text-align: center;
    }
    .sop-cover-sig-box {
      padding-top: 8px;
    }
    .sop-cover-sig-box-title {
      font-size: 8pt;
      color: #64748b;
      font-weight: 500;
      margin-bottom: 40px;
    }
    .sop-cover-sig-box-name {
      font-size: 9pt;
      font-weight: 700;
      color: #1a1a2e;
    }
    .sop-cover-sig-line {
      width: 100%;
      height: 1px;
      background: #e2e8f0;
      margin-top: 50px;
    }

    /* Print TOC */
    .sop-toc {
      margin: 16px 0;
      page-break-after: avoid;
    }
    .sop-toc-title {
      font-size: 13pt;
      font-weight: 700;
      color: #4f46e5;
      margin-bottom: 10px;
    }
    .sop-toc-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .sop-toc-list li {
      display: flex;
      align-items: center;
      padding: 5px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 10pt;
    }
    .sop-toc-list li:last-child { border-bottom: none; }
    .sop-toc-num {
      color: #4f46e5;
      font-weight: 700;
      width: 24px;
      flex-shrink: 0;
    }
    .sop-toc-text { flex: 1; color: #334155; }
    .sop-toc-dots {
      flex: 1;
      border-bottom: 1px dotted #cbd5e1;
      margin: 0 8px 4px;
    }
    .sop-toc-page { color: #94a3b8; font-size: 9pt; }

    /* Print body content */
    .sop-print-body {
      margin-top: 16px;
    }
    .sop-print-body h1 {
      font-size: 16pt;
      font-weight: 800;
      color: #0f172a;
      margin: 20px 0 10px;
      padding-bottom: 8px;
      border-bottom: 2px solid #4f46e5;
      page-break-after: avoid;
    }
    .sop-print-body h2 {
      font-size: 12pt;
      font-weight: 700;
      color: #4f46e5;
      margin: 16px 0 8px;
      padding: 6px 10px;
      background: #f8fafc;
      border-left: 3px solid #4f46e5;
      border-radius: 0 4px 4px 0;
      page-break-after: avoid;
    }
    .sop-print-body h3 {
      font-size: 11pt;
      font-weight: 700;
      color: #334155;
      margin: 12px 0 6px;
      page-break-after: avoid;
    }
    .sop-print-body p {
      margin: 5px 0;
      text-align: justify;
    }
    .sop-print-body > p:first-child { margin-top: 0; }
    .sop-print-body ol {
      padding-left: 22px;
      margin: 8px 0;
      counter-reset: item;
    }
    .sop-print-body ol li {
      margin-bottom: 7px;
      padding-left: 4px;
      position: relative;
    }
    .sop-print-body ol li::marker { color: #4f46e5; font-weight: 700; }
    .sop-print-body ul {
      padding-left: 20px;
      margin: 6px 0;
      list-style-type: disc;
    }
    .sop-print-body ul li {
      margin-bottom: 4px;
    }
    .sop-print-body ul li::marker { color: #4f46e5; }
    .sop-print-body table {
      width: 100%;
      border-collapse: collapse;
      margin: 10px 0;
      font-size: 9.5pt;
    }
    .sop-print-body th {
      background: #f1f5f9;
      padding: 7px 10px;
      text-align: left;
      font-weight: 700;
      border: 1px solid #e2e8f0;
      color: #334155;
    }
    .sop-print-body td {
      padding: 6px 10px;
      border: 1px solid #e2e8f0;
      vertical-align: top;
    }
    .sop-print-body tr:nth-child(even) td { background: #fafafa; }
    .sop-print-body strong { color: #0f172a; font-weight: 700; }
    .sop-print-body em { font-style: italic; color: #475569; }

    /* Step block (numbered procedure) */
    .sop-step {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-left: 4px solid #4f46e5;
      border-radius: 0 8px 8px 0;
      padding: 10px 14px;
      margin: 10px 0;
      page-break-inside: avoid;
    }
    .sop-step-num {
      display: inline-block;
      background: #4f46e5;
      color: white;
      font-size: 8pt;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 10px;
      margin-right: 8px;
      vertical-align: middle;
    }

    /* Warning / Note boxes */
    .sop-note {
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-left: 3px solid #f59e0b;
      border-radius: 0 6px 6px 0;
      padding: 8px 12px;
      margin: 10px 0;
      font-size: 9.5pt;
      page-break-inside: avoid;
    }
    .sop-note-label { font-weight: 700; color: #92400e; font-size: 8pt; text-transform: uppercase; letter-spacing: 1px; }

    /* Print footer */
    .sop-print-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 20mm;
      font-size: 8pt;
      color: #94a3b8;
      border-top: 1px solid #e2e8f0;
    }
    .sop-print-footer-left { color: #64748b; }
    .sop-print-footer-center { color: #64748b; font-weight: 600; }
    .sop-print-footer-right { color: #94a3b8; }
    @page { size: A4; margin: 0; }
    .sop-page:last-child .sop-print-footer { position: absolute; bottom: 18mm; left: 20mm; right: 20mm; }

    /* Page breaks */
    .sop-section-break { page-break-before: always; }
    .sop-page-break { page-break-before: always; }

    /* Print styles — hide everything except the print root */
    @media print {
      body { background: white; margin: 0; padding: 0; }
      body > * { display: none !important; visibility: hidden !important; }
      #sop-print-root {
        display: block !important;
        visibility: visible !important;
        position: fixed;
        top: 0;
        left: 0;
        width: 210mm;
      }
      #sop-print-root * {
        visibility: visible !important;
      }
      .sop-page {
        visibility: visible !important;
        box-shadow: none;
      }
      .sop-print-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        visibility: visible !important;
        display: flex !important;
      }
      .sop-cover { page-break-after: avoid; }
      .sop-step { page-break-inside: avoid; }
      .sop-note { page-break-inside: avoid; }
      table { page-break-inside: avoid; }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <div class="app-header">
    <div class="header-inner">
      <div class="header-icon">
        <span class="material-symbols-outlined" style="font-size:22px;color:#818cf8" aria-hidden="true">smart_toy</span>
      </div>
      <div class="header-text">
        <div class="header-title">{app.name}</div>
        {app.description && <div class="header-desc">{app.description}</div>}
      </div>
      <button class="header-reset" id="header-reset-btn" type="button" aria-label="Tạo cuộc trò chuyện mới" title="Tạo cuộc trò chuyện mới">
        <span class="material-symbols-outlined" style="font-size:19px" aria-hidden="true">refresh</span>
      </button>
    </div>
  </div>

  <div class="workflow-shell">
    <a class="workflow-back" href="/ai-tools">← Tất cả AI Tools</a>
    <div class="workflow-notice">
      <span class="material-symbols-outlined" style="font-size:17px;color:#72d7ac" aria-hidden="true">auto_awesome</span>
      <span>AI sẽ dẫn dắt theo từng bước để hiểu đúng bối cảnh và tạo <strong>đầu ra có thể triển khai</strong> cho phòng khám của bạn.</span>
    </div>
    <div class="credit-status" aria-live="polite">
      <span>{creditNotice}</span>
      {creditBalance && <span>Số dư: <b id="credit-balance">{creditBalance.available}</b> Credits</span>}
    </div>
    <p id="credit-usage" class="credit-status" aria-live="polite"></p>
    <div class="workflow-progress"><div id="workflow-progress-fill" class="workflow-progress-fill"></div></div>
    <div class="workflow-steps" id="workflow-steps"><span class="active">Bối cảnh</span><span>Chi tiết</span><span>Ưu tiên</span><span>Kết quả</span></div>
  </div>

  <!-- Chat area -->
  <div id="chat-view" class="chat-area" role="log" aria-live="polite" aria-atomic="false" aria-label="Lịch sử trò chuyện">
    <!-- Welcome message -->
    <div class="msg-wrap" id="welcome-msg">
      <div class="msg-avatar ai-avatar">
        <span class="material-symbols-outlined" style="font-size:16px;color:#818cf8" aria-hidden="true">smart_toy</span>
      </div>
      <div class="msg-bubble ai-bubble workflow-intro">
         <div class="workflow-kicker">AI WORKFLOW / BƯỚC 1</div>
         <h1>{app.name}</h1>
         <p>{app.description ?? 'Cung cấp bối cảnh chính xác nhất để AI chuẩn bị đầu ra phù hợp.'}</p>
         <p>Hãy bắt đầu bằng việc mô tả vấn đề bạn muốn làm rõ và kết quả bạn cần đạt.</p>
      </div>
    </div>
  </div>

  <!-- SOP Result -->
  <div id="sop-view" class="sop-panel">
    <div class="sop-toolbar">
      <h2>Kết quả SOP</h2>
      <button class="sop-btn print" id="print-sop-btn" type="button">
        <span class="material-symbols-outlined" style="font-size:16px" aria-hidden="true">print</span>
        In / Xuất PDF
      </button>
      <button class="sop-btn new" id="new-chat-btn" type="button">
        <span class="material-symbols-outlined" style="font-size:16px" aria-hidden="true">add</span>
        Tạo SOP mới
      </button>
    </div>
    <div id="sop-content" class="sop-content"></div>
  </div>

  <!-- Print-only template (hidden, cloned for printing) -->
  <div id="sop-print-root"></div>

  <!-- Input area -->
  <div class="input-area" id="input-area">
    <div class="input-inner">
      <div class="input-row">
        <label class="sr-only" for="user-input">Câu trả lời của bạn</label>
        <textarea
          id="user-input"
          rows="1"
          placeholder="Nhập câu trả lời..."
          autocomplete="off"
        ></textarea>
        <button class="send-btn" id="send-btn" type="button" aria-label="Gửi câu trả lời">
          <span class="material-symbols-outlined" style="font-size:18px" aria-hidden="true">arrow_upward</span>
        </button>
      </div>
      <div class="input-hint">
        <span>Enter gửi · Shift+Enter xuống dòng</span>
        <span id="turn-counter" class="turn-counter" aria-live="polite">Lượt 0/6</span>
        <button class="reset-link" id="reset-btn" type="button">Bắt đầu lại</button>
      </div>
    </div>
  </div>
  <div id="response-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

  <script
      is:inline
      define:vars={{
        appId: app.id,
        appName: app.name,
        promptVi,
        maxTurns: 6,
    }}
  >
    const chatView = document.getElementById('chat-view');
    const sopView = document.getElementById('sop-view');
    const sopContent = document.getElementById('sop-content');
    const sopPrintRoot = document.getElementById('sop-print-root');
    const userInput = document.getElementById('user-input');
    const sendBtn = document.getElementById('send-btn');
    const inputArea = document.getElementById('input-area');
    const resetBtn = document.getElementById('reset-btn');
    const headerResetBtn = document.getElementById('header-reset-btn');
    const newChatBtn = document.getElementById('new-chat-btn');
    const printSopBtn = document.getElementById('print-sop-btn');
    const responseStatus = document.getElementById('response-status');

    let conversationHistory = [];
    let isLoading = false;
    let generation = 0;
    let activeRequest = null;
    let userTurn = 0;
    const draftKey = `dentalempire-ai-workflow-${appId}`;

    function saveDraft() {
      try {
        localStorage.setItem(draftKey, JSON.stringify({ conversationHistory, userTurn }));
      } catch {}
    }

    function clearDraft() {
      try { localStorage.removeItem(draftKey); } catch {}
    }

    function escapeHtml(text) {
      const d = document.createElement('div');
      d.textContent = text;
      return d.innerHTML;
    }

    function renderMarkdown(text) {
      const inline = (value) => escapeHtml(value)
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/`(.*?)`/g, '<code>$1</code>');

      const lines = text.split('\n');
      const blocks = [];
      let i = 0;

      while (i < lines.length) {
        const line = lines[i];

        if (!line.trim()) { i++; continue; }
        if (/^###\s+/.test(line)) { blocks.push(`<h3>${inline(line.replace(/^###\s+/, ''))}</h3>`); i++; continue; }
        if (/^##\s+/.test(line)) { blocks.push(`<h2>${inline(line.replace(/^##\s+/, ''))}</h2>`); i++; continue; }
        if (/^#\s+/.test(line)) { blocks.push(`<h1>${inline(line.replace(/^#\s+/, ''))}</h1>`); i++; continue; }

        if (/^\d+\.\s+/.test(line)) {
          const items = [];
          while (i < lines.length && /^\d+\.\s+/.test(lines[i])) {
            items.push(`<li>${inline(lines[i].replace(/^\d+\.\s+/, ''))}</li>`);
            i++;
          }
          blocks.push(`<ol>${items.join('')}</ol>`);
          continue;
        }

        if (/^[-*]\s+/.test(line)) {
          const items = [];
          while (i < lines.length && /^[-*]\s+/.test(lines[i])) {
            items.push(`<li>${inline(lines[i].replace(/^[-*]\s+/, ''))}</li>`);
            i++;
          }
          blocks.push(`<ul>${items.join('')}</ul>`);
          continue;
        }

        const paragraph = [];
        while (i < lines.length && lines[i].trim()
          && !/^#+\s+/.test(lines[i])
          && !/^\d+\.\s+/.test(lines[i])
          && !/^[-*]\s+/.test(lines[i])) {
          paragraph.push(lines[i].trim());
          i++;
        }
        blocks.push(`<p>${inline(paragraph.join('\n')).replace(/\n/g, '<br>')}</p>`);
      }

      return blocks.join('');
    }

    function addOptions(msgWrap, options) {
      if (!options || !options.length) return;

      const suggestions = document.createElement('div');
      suggestions.className = 'sug-wrap';
      options.forEach(option => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'sug-opt';
        button.textContent = option;
        button.addEventListener('click', () => {
          userInput.value = option;
          autoResize(userInput);
          sendMessage();
        });
        suggestions.appendChild(button);
      });
      msgWrap.querySelector('.ai-bubble')?.appendChild(suggestions);
      scrollMessageIntoView(msgWrap);
    }

    function addMsg(role, html) {
      const wrap = document.createElement('div');
      wrap.className = 'msg-wrap' + (role === 'user' ? ' user' : '');
      if (role === 'ai') {
        wrap.innerHTML = `
          <div class="msg-avatar ai-avatar">
            <span class="material-symbols-outlined" style="font-size:16px;color:#818cf8" aria-hidden="true">smart_toy</span>
          </div>
          <div class="msg-bubble ai-bubble">
            <div class="msg-text">${html}</div>
          </div>`;
      } else {
        wrap.innerHTML = `
          <div class="msg-avatar user-avatar">
            <span class="material-symbols-outlined" style="font-size:16px;color:#c7d2fe" aria-hidden="true">person</span>
          </div>
          <div class="msg-bubble user-bubble"><div class="msg-text">${html}</div></div>`;
      }
      chatView.appendChild(wrap);
      scrollMessageIntoView(wrap);
      return wrap;
    }

    function scrollMessageIntoView(element) {
      element.scrollIntoView({ behavior: 'smooth', block: 'end' });
    }

    let streamingScrollFrame = null;

    function isNearPageBottom() {
      const distanceFromBottom = document.documentElement.scrollHeight - window.innerHeight - window.scrollY;
      return distanceFromBottom <= 160;
    }

    function scheduleStreamingScroll(element) {
      if (!isNearPageBottom() || streamingScrollFrame !== null) return;
      streamingScrollFrame = requestAnimationFrame(() => {
        streamingScrollFrame = null;
        if (!isNearPageBottom()) return;
        element.scrollIntoView({
          // Instant scrolling avoids per-character motion and honors reduced-motion users.
          behavior: 'auto',
          block: 'end',
        });
      });
    }

    function addTyping() {
      const wrap = document.createElement('div');
      wrap.className = 'typing-wrap';
      wrap.id = 'typing';
      wrap.setAttribute('role', 'status');
      wrap.setAttribute('aria-label', 'Trợ lý đang suy nghĩ');
      wrap.innerHTML = `
        <div class="msg-avatar ai-avatar">
          <span class="material-symbols-outlined" style="font-size:16px;color:#818cf8" aria-hidden="true">smart_toy</span>
        </div>
        <div class="typing-bubble">
          <div class="typing-dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>
        </div>`;
      chatView.appendChild(wrap);
      scrollMessageIntoView(wrap);
    }

    function removeTyping() {
      document.getElementById('typing')?.remove();
    }

    async function streamText(msgWrap, text, requestGeneration, speed = 15) {
      return new Promise((resolve) => {
        const textEl = msgWrap.querySelector('.msg-text');
        if (!textEl) { resolve(); return; }
        textEl.setAttribute('aria-hidden', 'true');
        let i = 0;
        textEl.innerHTML = '';
        function type() {
          if (requestGeneration !== generation) { resolve(); return; }
          if (i < text.length) {
            const partial = text.substring(0, i + 1);
            textEl.innerHTML = renderMarkdown(partial);
            scheduleStreamingScroll(msgWrap);
            i++;
            setTimeout(type, speed);
          } else {
            textEl.removeAttribute('aria-hidden');
            responseStatus.textContent = text;
            resolve();
          }
        }
        type();
      });
    }

    async function sendMessage() {
      const text = userInput.value.trim();
      if (!text || isLoading || userTurn >= maxTurns) return;
      const requestGeneration = ++generation;
      const controller = new AbortController();
      activeRequest?.abort();
      activeRequest = controller;

      userInput.value = '';
      autoResize(userInput);
        addMsg('user', escapeHtml(text));
       conversationHistory.push({ role: 'user', content: text });
       userTurn++;
       saveDraft();
      updateTurnCounter();
      setLoading(true);
      responseStatus.textContent = 'Đang tạo câu trả lời.';

      addTyping();

      try {
        const resp = await fetch(`/api/app/${appId}/chat`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          signal: controller.signal,
          body: JSON.stringify({
            messages: conversationHistory,
            prompt_vi: promptVi,
            app_name: appName,
          }),
        });

        if (requestGeneration !== generation) return;
        removeTyping();

        if (!resp.ok) {
          const data = await resp.json().catch(() => ({}));
          if (requestGeneration !== generation) return;
           const errorMessage = data.error || 'Không thể kết nối AI.';
          addMsg('ai', `<p><span style="color:#f87171">Lỗi: ${escapeHtml(errorMessage)}</span></p>`);
           conversationHistory.pop();
           userTurn = Math.max(0, userTurn - 1);
           updateTurnCounter();
          responseStatus.textContent = `Không thể tạo câu trả lời: ${errorMessage}`;
        } else {
          const data = await resp.json();
          if (requestGeneration !== generation) return;
          const reply = data.reply || '';
          const creditBalance = document.getElementById('credit-balance');
          if (creditBalance && data.balance?.available != null) {
            creditBalance.textContent = String(data.balance.available);
          }
          const creditUsage = document.getElementById('credit-usage');
          if (creditUsage && data.usage) {
            const tokens = Number(data.usage.total_tokens || 0).toLocaleString('vi-VN');
            const credits = Number(data.usage.credits_charged || 0).toLocaleString('vi-VN');
            creditUsage.textContent = `Lượt vừa dùng: ${tokens} token, quy đổi ${credits} Credits.`;
          }

          // Extract options from [data]...[/data] blocks
          let options = [];
          let cleanReply = reply;
          const dataStart = reply.indexOf('[data]');
          const dataEnd = reply.indexOf('[/data]');
          if (dataStart !== -1 && dataEnd !== -1 && dataEnd > dataStart) {
            const jsonStr = reply.slice(dataStart + 6, dataEnd).trim();
            try {
              const parsed = JSON.parse(jsonStr);
            options = Array.isArray(parsed.options) ? parsed.options.filter(option => typeof option === 'string') : [];
            } catch {}
            cleanReply = reply.slice(0, dataStart).trim();
          }

          // Stream the reply
          const msgWrap = addMsg('ai', '');
          await streamText(msgWrap, cleanReply, requestGeneration);
          if (requestGeneration !== generation) return;
          addOptions(msgWrap, options);

          conversationHistory.push({ role: 'assistant', content: reply });
          saveDraft();

          if (data.sop_complete && data.full_sop_text) {
            showSopResult(data.full_sop_text);
          }
        }
      } catch (err) {
        if (err.name === 'AbortError' || requestGeneration !== generation) return;
        removeTyping();
        addMsg('ai', '<p><span style="color:#f87171">Lỗi kết nối. Vui lòng thử lại.</span></p>');
        conversationHistory.pop();
        userTurn = Math.max(0, userTurn - 1);
        updateTurnCounter();
        responseStatus.textContent = 'Không thể tạo câu trả lời do lỗi kết nối.';
      } finally {
        if (requestGeneration === generation) {
          activeRequest = null;
          setLoading(false);
          userInput.focus();
        }
      }
    }

    // ─── Print Button ───
    printSopBtn.addEventListener('click', () => window.print());

    // ─── Markdown to HTML parser ───
    function parseMarkdownToHtml(text) {
      // Strip SOP markers
      text = text
        .replace(/^---SOP---\s*$/gm, '')
        .replace(/^---END-SOP---\s*$/gm, '');

      const lines = text.split('\n');
      const blocks = [];
      let i = 0;

      while (i < lines.length) {
        const line = lines[i];

        // Skip separator lines
        if (/^---+$/.test(line.trim())) { i++; continue; }

        // H1 – section title
        if (/^# (.+)/.test(line)) {
          blocks.push({ type: 'h1', text: line.replace(/^# /, '') });
          i++; continue;
        }

        // H2 – subsection
        if (/^## (.+)/.test(line)) {
          blocks.push({ type: 'h2', text: line.replace(/^## /, '') });
          i++; continue;
        }

        // H3
        if (/^### (.+)/.test(line)) {
          blocks.push({ type: 'h3', text: line.replace(/^### /, '') });
          i++; continue;
        }

        // Numbered list (e.g. "1. Do something")
        if (/^\d+\.\s/.test(line)) {
          const items = [];
          while (i < lines.length && /^\d+\.\s/.test(lines[i])) {
            items.push(lines[i].replace(/^\d+\.\s/, ''));
            i++;
          }
          blocks.push({ type: 'ol', items });
          continue;
        }

        // Bullet list
        if (/^[-*]\s/.test(line)) {
          const items = [];
          while (i < lines.length && /^[-*]\s/.test(lines[i])) {
            items.push(lines[i].replace(/^[-*]\s/, ''));
            i++;
          }
          blocks.push({ type: 'ul', items });
          continue;
        }

        // Table
        if (/^\|/.test(line) && i + 1 < lines.length && /^\|[-| ]/.test(lines[i + 1])) {
          const headerCells = lines[i].split('|').filter(c => c.trim());
          i++; // skip separator
          const rows = [];
          while (i < lines.length && /^\|/.test(lines[i])) {
            const cells = lines[i].split('|').filter((c, idx, arr) => idx > 0 && idx < arr.length - 1 && c.trim());
            if (cells.length) rows.push(cells);
            i++;
          }
          blocks.push({ type: 'table', headers: headerCells, rows });
          continue;
        }

        // Empty line → skip
        if (!line.trim()) { i++; continue; }

        // Paragraph
        let para = '';
        while (i < lines.length && lines[i].trim() && !/^#+\s/.test(lines[i]) && !/^\d+\.\s/.test(lines[i]) && !/^[-*]\s/.test(lines[i]) && !/^\|/.test(lines[i])) {
          para += (para ? ' ' : '') + lines[i].trim();
          i++;
        }
        if (para) blocks.push({ type: 'p', text: para });
      }

      // Convert blocks to HTML
      function esc(s) {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
      }

      function inline(s) {
        return esc(s)
          .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
          .replace(/\*(.+?)\*/g, '<em>$1</em>')
          .replace(/`(.+?)`/g, '<code>$1</code>');
      }

      return blocks.map(b => {
        if (b.type === 'h1') return `<h1>${inline(b.text)}</h1>`;
        if (b.type === 'h2') return `<h2>${inline(b.text)}</h2>`;
        if (b.type === 'h3') return `<h3>${inline(b.text)}</h3>`;
        if (b.type === 'ol') return `<ol>${b.items.map(it => `<li>${inline(it)}</li>`).join('')}</ol>`;
        if (b.type === 'ul') return `<ul>${b.items.map(it => `<li>${inline(it)}</li>`).join('')}</ul>`;
        if (b.type === 'table') {
          const ths = b.headers.map(h => `<th>${inline(h.trim())}</th>`).join('');
          const rows = b.rows.map(r => `<tr>${r.map(c => `<td>${inline(c.trim())}</td>`).join('')}</tr>`).join('');
          return `<table><thead><tr>${ths}</tr></thead><tbody>${rows}</tbody></table>`;
        }
        if (b.type === 'p') return `<p>${inline(b.text)}</p>`;
        return '';
      }).join('\n');
    }

    // ─── Extract TOC from blocks ───
    function extractToc(blocks) {
      const tocBlocks = blocks.filter(b => b.type === 'h2');
      return tocBlocks.map((b, i) => ({
        num: i + 1,
        text: b.text,
      }));
    }

    // ─── Parse markdown text back to blocks ───
    function parseMarkdownToBlocks(text) {
      text = text
        .replace(/^---SOP---\s*$/gm, '')
        .replace(/^---END-SOP---\s*$/gm, '');

      const lines = text.split('\n');
      const blocks = [];
      let i = 0;

      while (i < lines.length) {
        const line = lines[i];
        if (/^---+$/.test(line.trim())) { i++; continue; }
        if (/^# (.+)/.test(line)) { blocks.push({ type: 'h1', text: line.replace(/^# /, '') }); i++; continue; }
        if (/^## (.+)/.test(line)) { blocks.push({ type: 'h2', text: line.replace(/^## /, '') }); i++; continue; }
        if (/^### (.+)/.test(line)) { blocks.push({ type: 'h3', text: line.replace(/^### /, '') }); i++; continue; }
        if (/^\d+\.\s/.test(line)) {
          const items = [];
          while (i < lines.length && /^\d+\.\s/.test(lines[i])) { items.push(lines[i].replace(/^\d+\.\s/, '')); i++; }
          blocks.push({ type: 'ol', items }); continue;
        }
        if (/^[-*]\s/.test(line)) {
          const items = [];
          while (i < lines.length && /^[-*]\s/.test(lines[i])) { items.push(lines[i].replace(/^[-*]\s/, '')); i++; }
          blocks.push({ type: 'ul', items }); continue;
        }
        if (/^\|/.test(line) && i + 1 < lines.length && /^\|[-| ]/.test(lines[i + 1])) {
          const headerCells = lines[i].split('|').filter(c => c.trim());
          i++;
          const rows = [];
          while (i < lines.length && /^\|/.test(lines[i])) {
            const cells = lines[i].split('|').filter((c, idx, arr) => idx > 0 && idx < arr.length - 1 && c.trim());
            if (cells.length) rows.push(cells);
            i++;
          }
          blocks.push({ type: 'table', headers: headerCells, rows }); continue;
        }
        if (!line.trim()) { i++; continue; }
        let para = '';
        while (i < lines.length && lines[i].trim() && !/^#+\s/.test(lines[i]) && !/^\d+\.\s/.test(lines[i]) && !/^[-*]\s/.test(lines[i]) && !/^\|/.test(lines[i])) {
          para += (para ? ' ' : '') + lines[i].trim();
          i++;
        }
        if (para) blocks.push({ type: 'p', text: para });
      }
      return blocks;
    }

    // ─── Extract title (first H1) from markdown ───
    function extractTitle(md) {
      const m = md.match(/^#\s+(.+)$/m);
      return m ? m[1].trim() : 'Quy trình vận hành chuẩn (SOP)';
    }

    // ─── Build print document ───
    function buildPrintDocument(markdownText) {
      const title = extractTitle(markdownText);
      const today = new Date().toLocaleDateString('vi-VN', { day: '2-digit', month: 'long', year: 'numeric' });
      const blocks = parseMarkdownToBlocks(markdownText);
      const toc = extractToc(blocks);

      function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function inline(s) {
        return esc(s)
          .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
          .replace(/\*(.+?)\*/g, '<em>$1</em>')
          .replace(/`(.+?)`/g, '<code>$1</code>');
      }

      function renderBlocks(bs) {
        return bs.map(b => {
          if (b.type === 'h1') return `<h1>${inline(b.text)}</h1>`;
          if (b.type === 'h2') return `<h2>${inline(b.text)}</h2>`;
          if (b.type === 'h3') return `<h3>${inline(b.text)}</h3>`;
          if (b.type === 'ol') return `<ol>${b.items.map(it => `<li>${inline(it)}</li>`).join('')}</ol>`;
          if (b.type === 'ul') return `<ul>${b.items.map(it => `<li>${inline(it)}</li>`).join('')}</ul>`;
          if (b.type === 'table') {
            const ths = b.headers.map(h => `<th>${inline(h.trim())}</th>`).join('');
            const rows = b.rows.map(r => `<tr>${r.map(c => `<td>${inline(c.trim())}</td>`).join('')}</tr>`).join('');
            return `<table><thead><tr>${ths}</tr></thead><tbody>${rows}</tbody></table>`;
          }
          if (b.type === 'p') return `<p>${inline(b.text)}</p>`;
          return '';
        }).join('\n');
      }

      // Cover page + body as one continuous page (for print)
      // TOC rendered as visible list after cover info
      const tocHtml = toc.length > 0
        ? `<div class="sop-toc">
            <div class="sop-toc-title">MỤC LỤC</div>
            <ul class="sop-toc-list">
              ${toc.map(t => `
                <li>
                  <span class="sop-toc-num">${t.num}</span>
                  <span class="sop-toc-text">${inline(t.text)}</span>
                  <span class="sop-toc-dots"></span>
                  <span class="sop-toc-page">1</span>
                </li>`).join('')}
            </ul>
          </div>`
        : '';

      return `
<div class="sop-page">
  <div class="sop-print-header">
    <div class="sop-print-logo">
      <div class="sop-print-logo-icon">DE</div>
      <div>
        <div class="sop-print-logo-text">Dental Empire OS</div>
        <div class="sop-print-logo-sub">Quản lý Phòng khám Nha khoa</div>
      </div>
    </div>
    <div class="sop-print-doc-info">
      <strong>${inline(title)}</strong><br>
      Ngày ban hành: ${today}<br>
      Mã tài liệu: SOP-${new Date().getFullYear()}-001
    </div>
  </div>

  <div class="sop-cover">
    <div class="sop-cover-badge">Phòng khám Nha khoa</div>
    <div class="sop-cover-title">${inline(title)}</div>
    <div class="sop-cover-subtitle">Quy trình vận hành chuẩn (SOP)</div>
    <div class="sop-cover-divider"></div>
    <div class="sop-cover-meta">
      <table>
        <tr><td>Ngày ban hành</td><td>${today}</td></tr>
        <tr><td>Phiên bản</td><td>1.0</td></tr>
        <tr><td>Người phê duyệt</td><td>_______________</td></tr>
        <tr><td>Người soạn thảo</td><td>_______________</td></tr>
        <tr><td>Đơn vị</td><td>Phòng khám Nha khoa</td></tr>
      </table>
    </div>
    <div class="sop-cover-signatures">
      <div class="sop-cover-sig-box">
        <div class="sop-cover-sig-box-title">Người soạn thảo</div>
        <div class="sop-cover-sig-line"></div>
        <div class="sop-cover-sig-box-name" style="margin-top:6px;font-size:8pt;color:#64748b">Họ và tên</div>
      </div>
      <div class="sop-cover-sig-box">
        <div class="sop-cover-sig-box-title">Người kiểm tra</div>
        <div class="sop-cover-sig-line"></div>
        <div class="sop-cover-sig-box-name" style="margin-top:6px;font-size:8pt;color:#64748b">Họ và tên</div>
      </div>
      <div class="sop-cover-sig-box">
        <div class="sop-cover-sig-box-title">Người phê duyệt</div>
        <div class="sop-cover-sig-line"></div>
        <div class="sop-cover-sig-box-name" style="margin-top:6px;font-size:8pt;color:#64748b">Họ và tên</div>
      </div>
    </div>
  </div>

  ${tocHtml}

  <div class="sop-print-body">
    ${renderBlocks(blocks)}
  </div>

  <div class="sop-print-footer">
    <div class="sop-print-footer-left">Dental Empire OS · ${today}</div>
    <div class="sop-print-footer-center">${inline(title)}</div>
    <div class="sop-print-footer-right">Trang <span class="sop-page-num"></span></div>
  </div>
</div>`;
    }

    // ─── Show SOP result ───
    function showSopResult(markdownText) {
      // Hide chat, show SOP
      chatView.style.display = 'none';
      inputArea.hidden = true;
      sopView.classList.add('visible');

      // Render on-screen preview (simplified)
      const html = parseMarkdownToHtml(markdownText);
      const previewHtml = /<h1\b/i.test(html)
        ? html
        : `<h1>${escapeHtml(extractTitle(markdownText))}</h1>${html}`;
      sopContent.innerHTML = `
        ${previewHtml}
        <div class="sop-footer">Tạo bởi Dental Empire OS · ${new Date().toLocaleDateString('vi-VN')}</div>
      `;

      // Build print template
      sopPrintRoot.innerHTML = buildPrintDocument(markdownText);
      responseStatus.textContent = 'SOP đã hoàn tất và sẵn sàng để xem hoặc in.';
      sopView.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function resetChat() {
      if (!confirm('Bắt đầu lại hành trình AI? Mọi thông tin đã nhập sẽ bị xóa.')) return;
      generation++;
      activeRequest?.abort();
      activeRequest = null;
      removeTyping();
      conversationHistory = [];
      userTurn = 0;
      setLoading(false);
      clearDraft();
      sopView.classList.remove('visible');
      sopContent.innerHTML = '';
      sopPrintRoot.innerHTML = '';
      chatView.style.display = '';
      inputArea.hidden = false;
      userInput.value = '';
      autoResize(userInput);
      responseStatus.textContent = 'Cuộc trò chuyện đã được đặt lại.';
      chatView.innerHTML = `
        <div class="msg-wrap">
          <div class="msg-avatar ai-avatar">
            <span class="material-symbols-outlined" style="font-size:16px;color:#72d7ac" aria-hidden="true">auto_awesome</span>
          </div>
          <div class="msg-bubble ai-bubble workflow-intro">
             <div class="workflow-kicker">AI WORKFLOW / BƯỚC 1</div>
             <h1>${escapeHtml(appName)}</h1>
             <p>Hãy mô tả vấn đề bạn muốn làm rõ và kết quả bạn cần đạt.</p>
          </div>
      </div>`;
      updateTurnCounter();
      userInput.focus();
    }

    function updateTurnCounter() {
      const counter = document.getElementById('turn-counter');
      if (!counter) return;
      counter.textContent = `Bước ${Math.min(userTurn + 1, maxTurns)}/${maxTurns}`;
      counter.classList.toggle('is-final', userTurn >= maxTurns - 1);
      const progress = document.getElementById('workflow-progress-fill');
      const steps = document.querySelectorAll('#workflow-steps span');
      const stage = Math.min(3, Math.floor((userTurn / maxTurns) * 4));
      if (progress) progress.style.width = `${Math.min(100, (userTurn / maxTurns) * 100)}%`;
      steps.forEach((step, index) => step.classList.toggle('active', index <= stage));
      if (userTurn >= maxTurns) {
        userInput.disabled = true;
        sendBtn.disabled = true;
        userInput.placeholder = 'Đang hoàn tất SOP...';
      }
    }

    function autoResize(el) {
      el.style.height = 'auto';
      el.style.height = Math.min(el.scrollHeight, 120) + 'px';
    }

    function setLoading(state) {
      isLoading = state;
      const isTurnLimitReached = userTurn >= maxTurns;
      sendBtn.disabled = state || isTurnLimitReached;
      userInput.disabled = state || isTurnLimitReached;
      userInput.placeholder = state
        ? 'Đang suy nghĩ...'
        : isTurnLimitReached
          ? 'SOP đã hoàn tất'
          : 'Nhập câu trả lời...';
    }

    // Events
    userInput.addEventListener('input', () => autoResize(userInput));
    userInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });
    sendBtn.addEventListener('click', sendMessage);
    resetBtn.addEventListener('click', resetChat);
    headerResetBtn.addEventListener('click', resetChat);
    newChatBtn.addEventListener('click', resetChat);

    try {
      const rawDraft = localStorage.getItem(draftKey);
      const draft = rawDraft ? JSON.parse(rawDraft) : null;
      if (Array.isArray(draft?.conversationHistory) && draft.conversationHistory.length) {
        conversationHistory = draft.conversationHistory.filter(message =>
          message && (message.role === 'user' || message.role === 'assistant') && typeof message.content === 'string',
        );
        userTurn = conversationHistory.filter(message => message.role === 'user').length;
        chatView.querySelector('#welcome-msg')?.remove();
        conversationHistory.forEach(message => {
          addMsg(message.role, message.role === 'assistant' ? renderMarkdown(message.content) : escapeHtml(message.content));
        });
      }
    } catch {}
    updateTurnCounter();
    userInput.focus();
  </script>
</body>
</html>
