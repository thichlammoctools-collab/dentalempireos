---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { expireOldPendingCreditOrders } from '../../../lib/credit-db';

export const prerender = false;

await expireOldPendingCreditOrders(env.DB);

const { results: orders } = await env.DB.prepare(
  `SELECT o.*, u."name" AS "buyer_name", u."email" AS "buyer_email"
   FROM "credit_order" o LEFT JOIN "user" u ON u."id" = o."user_id"
   ORDER BY CASE o."status" WHEN 'pending' THEN 0 WHEN 'processing' THEN 1 ELSE 2 END, o."created_at" DESC`,
).all<{
  id: string; amount: number; credits_to_grant: number; status: string; payment_method: string; created_at: string; order_code: number | null; buyer_name: string | null; buyer_email: string | null;
}>();

const statusLabels: Record<string, string> = {
  pending: 'Chờ thanh toán',
  processing: 'Đang xử lý',
  paid: 'Đã thanh toán',
  cancelled: 'Đã hủy',
  expired: 'Hết hạn',
};
---

<AdminLayout title="Đơn nạp Credits | Admin">
  <section class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Credits Economy</p>
      <h2 class="mt-1 text-3xl font-bold text-on-surface">Đơn nạp Credits</h2>
      <p class="mt-2 text-sm text-on-surface-variant">Xác nhận chuyển khoản thủ công. Mỗi đơn chỉ có thể cấp Credits một lần.</p>
    </div>
  </section>

  <!-- Tabs -->
  <nav class="flex gap-1 rounded-xl bg-surface-container-low p-1 text-sm font-semibold w-fit">
    <a href="/admin/credits" class="flex items-center gap-2 rounded-lg px-4 py-2 text-on-surface-variant hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-base">dashboard</span> Tổng quan
    </a>
    <a href="/admin/credits/packages" class="flex items-center gap-2 rounded-lg px-4 py-2 text-on-surface-variant hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-base">add_card</span> Gói nạp
    </a>
    <a href="/admin/credits/pricing" class="flex items-center gap-2 rounded-lg px-4 py-2 text-on-surface-variant hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-base">tune</span> Bảng giá
    </a>
    <a href="/admin/credits/orders" class="flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-on-primary">
      <span class="material-symbols-outlined text-base">receipt_long</span> Đơn nạp
    </a>
  </nav>
  <section class="glass-card overflow-hidden rounded-2xl border border-outline-variant/20"><div class="overflow-x-auto"><table class="min-w-[850px] w-full text-sm"><thead class="bg-surface-container-low text-left text-xs uppercase tracking-wider text-on-surface-variant"><tr><th class="px-5 py-3">Thành viên</th><th class="px-4 py-3">Credits</th><th class="px-4 py-3">Thanh toán</th><th class="px-4 py-3">Trạng thái</th><th class="px-4 py-3">Tạo lúc</th><th class="px-5 py-3 text-right">Thao tác</th></tr></thead><tbody class="divide-y divide-outline-variant/15">{orders.length === 0 ? <tr><td colspan="6" class="px-5 py-10 text-center text-on-surface-variant">Chưa có đơn nạp Credits.</td></tr> : orders.map((order) => <tr><td class="px-5 py-4"><p class="font-semibold text-on-surface">{order.buyer_name ?? 'Thành viên'}</p><p class="text-xs text-on-surface-variant">{order.buyer_email ?? order.id}</p></td><td class="px-4 py-4 font-bold text-primary">{order.credits_to_grant}</td><td class="px-4 py-4"><p class="text-on-surface">{order.amount.toLocaleString('vi-VN')}đ</p><p class="text-xs text-on-surface-variant">{order.payment_method === 'manual' ? `CK ${order.order_code ?? ''}` : 'PayOS'}</p></td><td class="px-4 py-4"><span class:list={['rounded-full px-2 py-1 text-xs font-bold', order.status === 'paid' ? 'bg-emerald-500/10 text-emerald-500' : order.status === 'pending' ? 'bg-amber-500/10 text-amber-500' : order.status === 'expired' ? 'bg-rose-500/10 text-rose-400' : 'bg-surface-container-high text-on-surface-variant']}>{statusLabels[order.status] ?? order.status}</span></td><td class="px-4 py-4 text-xs text-on-surface-variant">{new Date(order.created_at).toLocaleString('vi-VN')}</td><td class="px-5 py-4 text-right">{order.payment_method === 'manual' && order.status === 'pending' && <div class="inline-flex gap-2"><button class="credit-order-confirm rounded-lg bg-emerald-500/15 px-3 py-2 text-xs font-bold text-emerald-500" data-order-id={order.id}>Xác nhận</button><button class="credit-order-cancel rounded-lg bg-rose-500/15 px-3 py-2 text-xs font-bold text-rose-400" data-order-id={order.id}>Hủy</button></div>}</td></tr>)}</tbody></table></div></section>
  <script>
    async function action(selector: string, suffix: string, message: string) {
      document.querySelectorAll(selector).forEach((element) => {
        (element as HTMLButtonElement).addEventListener('click', async () => {
          const orderId = (element as HTMLButtonElement).dataset.orderId;
          if (!orderId || !window.confirm(message)) return;
          const response = await fetch(`/api/admin/credit-orders/${encodeURIComponent(orderId)}/${suffix}`, { method: 'POST' });
          if (!response.ok) { const data = await response.json().catch(() => ({})) as { error?: string }; alert(data.error || 'Không thể cập nhật đơn.'); return; }
          window.location.reload();
        });
      });
    }
    action('.credit-order-confirm', 'confirm', 'Xác nhận đã nhận đủ tiền và cộng Credits?');
    action('.credit-order-cancel', 'cancel', 'Hủy đơn nạp Credits này?');
  </script>
</AdminLayout>
