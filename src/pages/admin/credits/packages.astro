---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

const { results: packages } = await env.DB.prepare(
  'SELECT * FROM "credit_package" ORDER BY "sort_order" ASC, "created_at" ASC'
).all<{
  id: string; name: string; price: number; credit_amount: number; bonus_credits: number; is_active: number; sort_order: number;
}>();

function formatPrice(vnd: number): string {
  return vnd.toLocaleString('vi-VN') + 'đ';
}
---

<AdminLayout title="Gói nạp Credits | Admin">
  <!-- Header -->
  <section class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Credits Economy</p>
      <h2 class="mt-1 text-3xl font-bold text-on-surface">Quản lý gói Credits</h2>
      <p class="mt-2 text-sm text-on-surface-variant">Tạo, chỉnh sửa và xóa gói nạp Credits hiển thị trong Ví Credits của thành viên.</p>
    </div>
  </section>

  <!-- Tabs -->
  <nav class="flex gap-1 rounded-xl bg-surface-container-low p-1 text-sm font-semibold w-fit">
    <a href="/admin/credits" class="flex items-center gap-2 rounded-lg px-4 py-2 text-on-surface-variant hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-base">dashboard</span> Tổng quan
    </a>
    <a href="/admin/credits/packages" class="flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-on-primary">
      <span class="material-symbols-outlined text-base">add_card</span> Gói nạp
    </a>
    <a href="/admin/credits/pricing" class="flex items-center gap-2 rounded-lg px-4 py-2 text-on-surface-variant hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-base">tune</span> Bảng giá
    </a>
    <a href="/admin/credits/orders" class="flex items-center gap-2 rounded-lg px-4 py-2 text-on-surface-variant hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-base">receipt_long</span> Đơn nạp
    </a>
  </nav>

  <div>

    <!-- Package List -->
    <section class="glass-card rounded-2xl border border-outline-variant/20 p-5 sm:p-6">
      <div class="mb-5 flex items-center justify-between gap-4">
        <div>
          <h3 class="font-bold text-on-surface">Danh sách gói</h3>
          <p class="mt-1 text-xs text-on-surface-variant">Nhấn vào gói để chỉnh sửa.</p>
        </div>
        <div class="flex items-center gap-3">
          <span class="px-2 py-0.5 text-xs font-bold bg-primary/10 text-primary rounded-full">{packages.length}</span>
          <button id="create-package-btn" class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-xs font-bold text-on-primary transition hover:brightness-110">
            <span class="material-symbols-outlined text-base">add</span> Thêm gói
          </button>
        </div>
      </div>

      {packages.length === 0 ? (
        <p class="py-8 text-center text-sm text-on-surface-variant">Chưa có gói Credits nào.</p>
      ) : (
        <div class="flex flex-col gap-2">
          {packages.map((item) => (
            <div
              class="package-row group flex items-center gap-4 rounded-xl border border-outline-variant/20 bg-white/[0.02] p-4 hover:border-primary/30 transition-colors cursor-pointer"
              data-id={item.id}
              data-name={item.name}
              data-price={item.price}
              data-credit-amount={item.credit_amount}
              data-bonus-credits={item.bonus_credits}
              data-sort-order={item.sort_order}
              data-is-active={item.is_active}
            >
              <!-- Credit badge -->
              <div class="w-12 h-12 rounded-xl bg-primary/10 flex flex-col items-center justify-center flex-shrink-0">
                <span class="text-base font-black text-primary leading-none">{item.credit_amount + item.bonus_credits}</span>
                <span class="text-[8px] text-primary/70 font-semibold">CR</span>
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <p class="font-semibold text-on-surface truncate">{item.name}</p>
                  <span class:list={[
                    'rounded-full px-2 py-0.5 text-[10px] font-bold flex-shrink-0',
                    item.is_active ? 'bg-emerald-500/10 text-emerald-500' : 'bg-surface-container-high text-on-surface-variant'
                  ]}>
                    {item.is_active ? 'Đang bán' : 'Tạm dừng'}
                  </span>
                </div>
                <p class="mt-1 text-xs text-on-surface-variant">
                  {item.credit_amount} cơ bản + {item.bonus_credits} thưởng · {formatPrice(item.price)}
                </p>
              </div>

              <div class="flex items-center gap-1 flex-shrink-0 opacity-60 group-hover:opacity-100 transition-opacity">
                <button class="edit-package-btn rounded-lg p-2 text-on-surface-variant hover:bg-white/10 hover:text-primary transition-colors" title="Chỉnh sửa">
                  <span class="material-symbols-outlined text-base">edit</span>
                </button>
                <button class="delete-package-btn rounded-lg p-2 text-on-surface-variant hover:bg-rose-500/15 hover:text-rose-400 transition-colors" title="Xóa" data-id={item.id} data-name={item.name}>
                  <span class="material-symbols-outlined text-base">delete</span>
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

  </div>

  <div id="package-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="form-title">
    <button class="absolute inset-0 cursor-default bg-black/65 backdrop-blur-sm" type="button" aria-label="Đóng" data-modal-close></button>
    <section class="relative z-10 max-h-[calc(100vh-2rem)] w-full max-w-2xl overflow-y-auto rounded-2xl border border-outline-variant/30 bg-surface p-5 shadow-2xl sm:p-6">
      <div class="mb-5 flex items-start justify-between gap-4">
        <div>
          <h3 class="font-bold text-on-surface" id="form-title">Thêm gói mới</h3>
          <p class="mt-1 text-xs text-on-surface-variant" id="form-subtitle">Điền thông tin để tạo gói.</p>
        </div>
        <div class="flex items-center gap-3">
          <button id="cancel-edit-btn" class="hidden text-xs font-semibold text-primary hover:underline">Hủy</button>
          <button class="rounded-lg p-2 text-on-surface-variant transition hover:bg-surface-container-high hover:text-on-surface" type="button" aria-label="Đóng" data-modal-close>
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
      </div>

      <form id="package-form" class="grid gap-4">
        <input type="hidden" name="id" id="pkg-id" />

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-1.5 text-sm font-semibold text-on-surface">
            Tên gói
            <input name="name" id="pkg-name" required placeholder="Ví dụ: Gói 100" class="w-full min-w-0 rounded-xl border border-outline-variant bg-surface-container-low px-3 py-2.5 text-sm font-normal text-on-surface" />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-on-surface">
            Giá (VND)
            <input name="price" id="pkg-price" required min="0" type="number" placeholder="100.000" class="w-full min-w-0 rounded-xl border border-outline-variant bg-surface-container-low px-3 py-2.5 text-sm font-normal text-on-surface" />
          </label>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-1.5 text-sm font-semibold text-on-surface">
            Credits cơ bản
            <input name="credit_amount" id="pkg-credit-amount" required min="1" type="number" placeholder="100" class="w-full min-w-0 rounded-xl border border-outline-variant bg-surface-container-low px-3 py-2.5 text-sm font-normal text-on-surface" />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-on-surface">
            Tặng thêm
            <input name="bonus_credits" id="pkg-bonus-credits" min="0" type="number" value="0" placeholder="0" class="w-full min-w-0 rounded-xl border border-outline-variant bg-surface-container-low px-3 py-2.5 text-sm font-normal text-on-surface" />
          </label>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3">
          <span class="material-symbols-outlined text-primary text-lg">calculate</span>
          <p class="text-sm text-on-surface">
            Khách nhận: <strong class="text-white text-base" id="package-credit-total">0</strong> <span class="text-on-surface-variant">Credits</span>
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
          <label class="grid gap-1.5 text-sm font-semibold text-on-surface">
            Thứ tự
            <input name="sort_order" id="pkg-sort-order" min="0" type="number" value="0" class="rounded-xl border border-outline-variant bg-surface-container-low px-3 py-2.5 text-sm text-on-surface w-24" />
          </label>
          <label class="flex items-center gap-2 rounded-xl border border-outline-variant bg-surface-container-low px-4 py-2.5 text-sm text-on-surface">
            <input name="is_active" id="pkg-is-active" checked type="checkbox" class="accent-primary" /> Đang bán
          </label>
        </div>

        <button id="submit-btn" class="w-full rounded-xl bg-primary px-4 py-2.5 text-sm font-bold text-on-primary">Lưu gói Credits</button>
      </form>
    </section>
  </div>

  <script>
    // ── Credit total preview ──
    const form = document.getElementById('package-form') as HTMLFormElement;
    const totalEl = document.getElementById('package-credit-total');
    const updateTotal = () => {
      const base = Number((form?.elements.namedItem('credit_amount') as HTMLInputElement)?.value || 0);
      const bonus = Number((form?.elements.namedItem('bonus_credits') as HTMLInputElement)?.value || 0);
      if (totalEl) totalEl.textContent = String(base + bonus);
    };
    form?.addEventListener('input', updateTotal);
    updateTotal();

    // ── Edit mode ──
    const formTitle = document.getElementById('form-title')!;
    const formSubtitle = document.getElementById('form-subtitle')!;
    const cancelBtn = document.getElementById('cancel-edit-btn')!;
    const submitBtn = document.getElementById('submit-btn')!;
    const modal = document.getElementById('package-modal')!;

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    }

    function resetForm() {
      form.reset();
      (document.getElementById('pkg-id') as HTMLInputElement).value = '';
      (document.getElementById('pkg-bonus-credits') as HTMLInputElement).value = '0';
      (document.getElementById('pkg-sort-order') as HTMLInputElement).value = '0';
      (document.getElementById('pkg-is-active') as HTMLInputElement).checked = true;
      formTitle.textContent = 'Thêm gói mới';
      formSubtitle.textContent = 'Điền thông tin bên dưới để tạo gói.';
      submitBtn.textContent = 'Lưu gói Credits';
      cancelBtn.classList.add('hidden');
      updateTotal();
    }

    document.getElementById('create-package-btn')?.addEventListener('click', () => {
      resetForm();
      openModal();
    });
    cancelBtn.addEventListener('click', () => {
      resetForm();
      closeModal();
    });
    document.querySelectorAll('[data-modal-close]').forEach((button) => button.addEventListener('click', closeModal));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    document.querySelectorAll('.package-row').forEach((row) => {
      row.addEventListener('click', (e) => {
        // Don't trigger edit if clicking delete button
        if ((e.target as HTMLElement).closest('.delete-package-btn')) return;

        const el = row as HTMLElement;
        (document.getElementById('pkg-id') as HTMLInputElement).value = el.dataset.id!;
        (document.getElementById('pkg-name') as HTMLInputElement).value = el.dataset.name!;
        (document.getElementById('pkg-price') as HTMLInputElement).value = el.dataset.price!;
        (document.getElementById('pkg-credit-amount') as HTMLInputElement).value = el.dataset.creditAmount!;
        (document.getElementById('pkg-bonus-credits') as HTMLInputElement).value = el.dataset.bonusCredits!;
        (document.getElementById('pkg-sort-order') as HTMLInputElement).value = el.dataset.sortOrder!;
        (document.getElementById('pkg-is-active') as HTMLInputElement).checked = el.dataset.isActive === '1';
        formTitle.textContent = 'Chỉnh sửa gói';
        formSubtitle.textContent = `Đang sửa: ${el.dataset.name}`;
        submitBtn.textContent = 'Cập nhật gói';
        cancelBtn.classList.remove('hidden');
        updateTotal();
        openModal();
      });
    });

    // ── Delete ──
    document.querySelectorAll('.delete-package-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.id;
        const name = (btn as HTMLElement).dataset.name;
        if (!id || !window.confirm(`Xác nhận xóa gói "${name}"?`)) return;

        const res = await fetch('/api/admin/credit-packages', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          alert(data.error || 'Không thể xóa gói.');
          return;
        }
        window.location.reload();
      });
    });

    // ── Submit (create or update) ──
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const body: Record<string, unknown> = {};
      for (const [key, value] of data.entries()) body[key] = value;
      for (const key of ['price', 'credit_amount', 'bonus_credits', 'sort_order']) {
        body[key] = body[key] === '' || body[key] === undefined ? null : Number(body[key]);
      }
      body.is_active = data.get('is_active') === 'on' ? 1 : 0;

      const res = await fetch('/api/admin/credit-packages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) {
        const result = await res.json().catch(() => ({}));
        alert(result.error || 'Không thể lưu gói Credits.');
        return;
      }
      window.location.reload();
    });
  </script>
</AdminLayout>
