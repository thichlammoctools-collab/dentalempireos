---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

const [packagesResult, rulesResult, ordersResult] = await Promise.all([
  env.DB.prepare('SELECT COUNT(*) AS "count" FROM "credit_package"').first<{ count: number }>(),
  env.DB.prepare('SELECT COUNT(*) AS "count" FROM "credit_pricing_rule"').first<{ count: number }>(),
  env.DB.prepare('SELECT COUNT(*) AS "count" FROM "credit_order" WHERE "status" = \'pending\'').first<{ count: number }>(),
]);

const packageCount = packagesResult?.count ?? 0;
const ruleCount = rulesResult?.count ?? 0;
const pendingOrders = ordersResult?.count ?? 0;
---

<AdminLayout title="Credits | Admin">
  <!-- Header -->
  <section class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Credits Economy</p>
      <h2 class="mt-1 text-3xl font-bold text-on-surface">Tổng quan Credits</h2>
      <p class="mt-2 text-sm text-on-surface-variant">Quản lý gói nạp, bảng giá và đơn hàng Credits.</p>
    </div>
  </section>

  <!-- Tabs -->
  <nav class="flex gap-1 rounded-xl bg-surface-container-low p-1 text-sm font-semibold w-fit">
    <a href="/admin/credits" class="flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-on-primary">
      <span class="material-symbols-outlined text-base">dashboard</span> Tổng quan
    </a>
    <a href="/admin/credits/packages" class="flex items-center gap-2 rounded-lg px-4 py-2 text-on-surface-variant hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-base">add_card</span> Gói nạp
    </a>
    <a href="/admin/credits/pricing" class="flex items-center gap-2 rounded-lg px-4 py-2 text-on-surface-variant hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-base">tune</span> Bảng giá
    </a>
    <a href="/admin/credits/orders" class="flex items-center gap-2 rounded-lg px-4 py-2 text-on-surface-variant hover:bg-surface-container-high transition-colors">
      <span class="material-symbols-outlined text-base">receipt_long</span> Đơn nạp
    </a>
  </nav>

  <!-- Quick Stats -->
  <div class="grid gap-4 sm:grid-cols-3">
    <a href="/admin/credits/packages" class="glass-card rounded-2xl border border-outline-variant/20 p-5 hover:border-primary/30 transition-colors group">
      <div class="flex items-center justify-between">
        <span class="material-symbols-outlined text-primary text-2xl">add_card</span>
        <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-primary transition-colors">arrow_forward</span>
      </div>
      <p class="mt-4 text-3xl font-black text-on-surface">{packageCount}</p>
      <p class="mt-1 text-sm text-on-surface-variant">Gói nạp Credits</p>
    </a>

    <a href="/admin/credits/pricing" class="glass-card rounded-2xl border border-outline-variant/20 p-5 hover:border-primary/30 transition-colors group">
      <div class="flex items-center justify-between">
        <span class="material-symbols-outlined text-primary text-2xl">tune</span>
        <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-primary transition-colors">arrow_forward</span>
      </div>
      <p class="mt-4 text-3xl font-black text-on-surface">{ruleCount}</p>
      <p class="mt-1 text-sm text-on-surface-variant">Rule bảng giá</p>
    </a>

    <a href="/admin/credits/orders" class:list={[
      'glass-card rounded-2xl border p-5 transition-colors group',
      pendingOrders > 0 ? 'border-amber-500/30 hover:border-amber-500/50' : 'border-outline-variant/20 hover:border-primary/30'
    ]}>
      <div class="flex items-center justify-between">
        <span class="material-symbols-outlined text-2xl" class:list={[pendingOrders > 0 ? 'text-amber-500' : 'text-primary']}>receipt_long</span>
        <span class="material-symbols-outlined text-on-surface-variant/30 group-hover:text-primary transition-colors">arrow_forward</span>
      </div>
      <p class="mt-4 text-3xl font-black text-on-surface">{pendingOrders}</p>
      <p class="mt-1 text-sm text-on-surface-variant">Đơn chờ xử lý</p>
    </a>
  </div>
</AdminLayout>
