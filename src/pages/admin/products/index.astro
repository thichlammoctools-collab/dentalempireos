---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listProducts } from '../../../lib/payos-db';
import { listProductEntitlements } from '../../../lib/entitlement-db';
import { listSurveyDefinitions } from '../../../lib/survey-config-db';
import { listResources } from '../../../lib/resource-db';
import {
  PRODUCT_ENTITLEMENT_PRESETS,
  PRODUCT_ENTITLEMENT_PRESET_LABELS,
} from '../../../lib/product-entitlement-presets';

export const prerender = false;

const db = env.DB;
const products = await listProducts(db);
const scanners = await listSurveyDefinitions(db, { status: 'active' });
const resources = await listResources(db);
const scannerLabels = Object.fromEntries(scanners.map((scanner) => [scanner.id, scanner.title_vi]));
const resourceLabels = Object.fromEntries(resources.map((resource) => [resource.id, resource.title]));
const productEntitlementMap = Object.fromEntries(await Promise.all(
  products.map(async (product) => [product.id, await listProductEntitlements(db, product.id)]),
));

const activeCount = products.filter((p) => p.is_active === 1).length;
const typeLabels: Record<string, string> = {
  access_package: 'Gói truy cập',
  course_unlock: 'Mở khóa khóa học',
  document_unlock: 'Mở khóa tài liệu',
  booking: 'Booking tư vấn',
  event_ticket: 'Vé sự kiện',
  survey_unlock: 'Mở khóa khảo sát AI',
  book_unlock: 'Mở khóa các chương trả phí',
  service_program: 'Gói dịch vụ',
};

const entitlementTypeLabels: Record<string, string> = {
  book: 'Sách',
  ai_app: 'AI app',
  scanner: 'Scanner',
  course: 'Khóa học',
  blog: 'Blog',
  resource: 'Tài liệu',
  service: 'Dịch vụ',
};

const entitlementPresets = {
  custom: [],
  ...PRODUCT_ENTITLEMENT_PRESETS,
} as const;

const entitlementIdLabels: Record<string, string> = {
  '*': 'Tất cả',
  consulting_guided: 'Tư vấn đồng hành',
  consulting_full: 'Tư vấn chuyên sâu',
  implementation_full: 'Triển khai toàn diện',
  team_training: 'Đào tạo đội ngũ',
  clinic_audit: 'Audit phòng khám',
  self_serve: 'Tự triển khai',
  guided_3m: 'Đồng hành 3 tháng',
  guided_6m: 'Đồng hành 6 tháng',
  full_implementation: 'Triển khai toàn diện',
};

function getEntitlementLabel(entitlement: { content_type: string; content_id: string }): string {
  if (entitlement.content_type === 'book' && entitlement.content_id === '*') {
    return 'Sách: Các chương trả phí';
  }
  if (entitlement.content_type === 'resource' && entitlement.content_id === '*') {
    return 'Tài liệu: Tất cả';
  }
  const typeLabel = entitlementTypeLabels[entitlement.content_type] ?? entitlement.content_type;
  const idLabel = entitlement.content_type === 'scanner'
    ? scannerLabels[entitlement.content_id] ?? entitlementIdLabels[entitlement.content_id] ?? entitlement.content_id
    : entitlement.content_type === 'resource'
      ? resourceLabels[entitlement.content_id] ?? entitlementIdLabels[entitlement.content_id] ?? entitlement.content_id
    : entitlementIdLabels[entitlement.content_id] ?? entitlement.content_id;
  return `${typeLabel}: ${idLabel}`;
}

function nanoid(): string {
  return crypto.randomUUID().replace(/-/g, '').slice(0, 16);
}

const newId = nanoid();
---

<AdminLayout title="Sản Phẩm | Admin">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
      <h2 class="text-3xl font-bold text-on-surface mb-1">Quản lý Sản Phẩm</h2>
      <p class="text-on-surface-variant">
        {products.length} sản phẩm · {activeCount} đang bán
      </p>
    </div>
    <button
      id="btn-new-product"
      class="bg-primary-container text-on-primary-container px-6 py-3 rounded-xl font-bold cyan-glow hover:opacity-90 active:scale-95 transition-all flex items-center justify-center gap-2 self-start md:self-auto"
    >
      <span class="material-symbols-outlined text-[20px]">add</span>
      <span class="text-sm">Tạo gói dịch vụ</span>
    </button>
  </div>

  <!-- New Product Modal -->
  <div id="new-product-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-overlay backdrop-blur-sm" id="modal-backdrop"></div>
    <div class="relative glass-card bg-surface-container-lowest rounded-2xl p-5 sm:p-6 lg:p-8 w-full max-w-2xl lg:max-w-5xl max-h-[calc(100vh-2rem)] overflow-y-auto shadow-2xl">
      <div class="flex items-center justify-between mb-6 lg:mb-8">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary mb-1">Dịch vụ</p>
          <h3 class="text-xl lg:text-2xl font-bold text-on-surface" id="modal-title">Tạo gói dịch vụ mới</h3>
        </div>
        <button id="modal-close" type="button" class="p-2 rounded-lg text-on-surface-variant hover:bg-surface-container-high transition-colors">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>
      <form id="product-form" class="flex flex-col gap-5 lg:grid lg:grid-cols-2 lg:gap-6">
        <input type="hidden" name="id" id="form-id" value={newId} />
        <input type="hidden" name="type" value="access_package" />
        <div class="lg:col-span-2">
          <label class="block text-sm font-semibold text-on-surface-variant mb-2">Tên gói dịch vụ <span class="text-red-400">*</span></label>
          <input type="text" name="name" required
            class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant rounded-xl text-on-surface placeholder:text-on-surface-variant/70 focus:ring-2 focus:ring-primary/40 focus:outline-none"
            placeholder="VD: Gói đồng hành 3 tháng"
          />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-5">
          <div>
            <label class="block text-sm font-semibold text-on-surface-variant mb-2">Hình thức</label>
            <div class="flex h-[50px] items-center gap-2 rounded-xl border border-outline-variant bg-surface-container-low px-4 text-sm text-on-surface">
              <span class="material-symbols-outlined text-primary text-[20px]">workspace_premium</span>
              Gói truy cập & dịch vụ
            </div>
          </div>
          <div>
            <label for="price-display" class="block text-sm font-semibold text-on-surface-variant mb-2">Giá bán <span class="text-red-400">*</span></label>
            <div class="relative">
              <input type="hidden" name="price" id="price" value="0" />
              <input type="text" id="price-display" inputmode="numeric" autocomplete="off" required
                class="w-full px-4 py-3 pr-14 bg-surface-container-low border border-outline-variant rounded-xl text-on-surface placeholder:text-on-surface-variant/70 focus:ring-2 focus:ring-primary/40 focus:outline-none tabular-nums"
                placeholder="0"
                aria-describedby="price-help"
              />
              <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm font-semibold text-on-surface-variant">đ</span>
            </div>
            <p id="price-help" class="mt-1 text-xs text-on-surface-variant/75">Nhập số tiền, hệ thống tự thêm dấu phân cách. Ví dụ: 4.500.000đ</p>
          </div>
        </div>
        <div class="rounded-xl border border-outline-variant/60 bg-surface-container-low/40 p-4 lg:p-5 lg:col-span-2">
          <label class="block text-sm font-semibold text-on-surface-variant mb-2">Quyền lợi trong gói</label>
          <select name="entitlement_preset" id="entitlement-preset"
            class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant rounded-xl text-on-surface focus:ring-2 focus:ring-primary/40 focus:outline-none"
          >
            <option value="custom">Tùy chỉnh</option>
            <option value="book_full">{PRODUCT_ENTITLEMENT_PRESET_LABELS.book_full}</option>
            <option value="ai_tools_all">{PRODUCT_ENTITLEMENT_PRESET_LABELS.ai_tools_all}</option>
            <option value="scanners_all">{PRODUCT_ENTITLEMENT_PRESET_LABELS.scanners_all}</option>
            <option value="scanner_custom">Mở khóa Scanner tùy chọn</option>
            <option value="courses_all">{PRODUCT_ENTITLEMENT_PRESET_LABELS.courses_all}</option>
            <option value="blog_premium">{PRODUCT_ENTITLEMENT_PRESET_LABELS.blog_premium}</option>
            <option value="resources_premium">{PRODUCT_ENTITLEMENT_PRESET_LABELS.resources_premium}</option>
            <option value="resource_custom">Mở khóa tài liệu tùy chọn</option>
            <option value="consulting_guided" data-service-preset>{PRODUCT_ENTITLEMENT_PRESET_LABELS.consulting_guided}</option>
            <option value="consulting_full" data-service-preset>{PRODUCT_ENTITLEMENT_PRESET_LABELS.consulting_full}</option>
            <option value="implementation_full" data-service-preset>{PRODUCT_ENTITLEMENT_PRESET_LABELS.implementation_full}</option>
            <option value="team_training" data-service-preset>{PRODUCT_ENTITLEMENT_PRESET_LABELS.team_training}</option>
            <option value="clinic_audit" data-service-preset>{PRODUCT_ENTITLEMENT_PRESET_LABELS.clinic_audit}</option>
            <option value="self_serve" data-service-preset>{PRODUCT_ENTITLEMENT_PRESET_LABELS.self_serve}</option>
            <option value="guided_3m" data-service-preset>{PRODUCT_ENTITLEMENT_PRESET_LABELS.guided_3m}</option>
            <option value="guided_6m" data-service-preset>{PRODUCT_ENTITLEMENT_PRESET_LABELS.guided_6m}</option>
            <option value="full_implementation" data-service-preset>{PRODUCT_ENTITLEMENT_PRESET_LABELS.full_implementation}</option>
          </select>
           <div id="entitlement-rows" class="flex flex-col gap-2 mt-3"></div>
            <div id="scanner-picker" class="hidden mt-3">
             <p class="mb-2 text-xs text-on-surface-variant">Chọn Scanner được mở khóa trong sản phẩm này:</p>
             <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
               {scanners.map((scanner) => (
                 <label class="scanner-option flex items-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container-low px-3 py-2 text-sm text-on-surface cursor-pointer hover:border-primary/60">
                   <input type="checkbox" value={scanner.id} class="scanner-checkbox h-4 w-4 rounded accent-primary" />
                   <span>{scanner.title_vi}</span>
                 </label>
               ))}
            </div>
            <div id="resource-picker" class="hidden mt-3">
              <p class="mb-2 text-xs text-on-surface-variant">Chọn tài liệu được mở khóa trong sản phẩm này:</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-64 overflow-y-auto">
                {resources.map((resource) => (
                  <label class="resource-option flex items-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container-low px-3 py-2 text-sm text-on-surface cursor-pointer hover:border-primary/60">
                    <input type="checkbox" value={resource.id} class="resource-checkbox h-4 w-4 rounded accent-primary" />
                    <span>{resource.title}</span>
                  </label>
                ))}
              </div>
            </div>
           </div>
          <button type="button" id="add-entitlement" class="mt-2 text-xs font-semibold text-primary hover:underline">
            + Thêm quyền lợi
          </button>
          <p class="mt-3 flex items-start gap-2 text-xs leading-relaxed text-on-surface-variant">
            <span class="material-symbols-outlined mt-0.5 text-[16px] text-primary">info</span>
             <span>Gói đăng ký Blog dùng quyền lợi <strong class="text-on-surface">blog:*</strong> để mở toàn bộ bài viết được đánh dấu Premium. Chỉ các bài bật Premium trong phần quản trị Blog mới yêu cầu gói này.</span>
          </p>
        </div>
        <div class="lg:col-span-2">
          <label class="block text-sm font-semibold text-on-surface-variant mb-2">Mô tả</label>
          <textarea name="description" rows="2"
            class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant rounded-xl text-on-surface placeholder:text-on-surface-variant/70 focus:ring-2 focus:ring-primary/40 focus:outline-none text-sm"
            placeholder="Mô tả ngắn về sản phẩm"
          ></textarea>
        </div>
        <div class="lg:col-span-2">
          <div>
            <label class="block text-sm font-semibold text-on-surface-variant mb-2">Thời hạn (ngày)</label>
            <input type="number" name="duration_days" min="0"
              class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant rounded-xl text-on-surface placeholder:text-on-surface-variant/70 focus:ring-2 focus:ring-primary/40 focus:outline-none"
              placeholder="Để trống = vĩnh viễn"
            />
            <p class="text-xs text-on-surface-variant/75 mt-1">Để trống nếu quyền truy cập vĩnh viễn</p>
          </div>
        </div>
        <div class="flex items-center gap-3 lg:col-span-2">
          <input type="checkbox" name="is_active" id="is_active" checked
            class="w-4 h-4 rounded border-outline-variant bg-surface-container-low text-primary focus:ring-primary"
          />
          <label for="is_active" class="text-sm text-on-surface">Đang bán</label>
        </div>
        <p id="form-error" class="hidden text-sm text-rose-400 lg:col-span-2"></p>
        <button type="submit" id="form-submit"
          class="w-full px-4 py-3 btn-primary-metallic font-bold rounded-xl text-sm active:scale-95 transition-all lg:col-span-2"
        >
          Tạo gói dịch vụ
        </button>
      </form>
    </div>
  </div>

  <!-- Products Table -->
  <div class="mt-8 glass-card rounded-2xl border border-outline-variant/20 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm min-w-[800px]">
        <thead>
          <tr class="border-b border-outline-variant/20 text-on-surface-variant">
            <th class="text-left px-4 py-3 font-semibold">Tên</th>
            <th class="text-left px-4 py-3 font-semibold">Loại</th>
            <th class="text-left px-4 py-3 font-semibold">Quyền lợi</th>
            <th class="text-right px-4 py-3 font-semibold">Giá</th>
            <th class="text-center px-4 py-3 font-semibold">Thời hạn</th>
            <th class="text-center px-4 py-3 font-semibold">Trạng thái</th>
            <th class="text-right px-4 py-3 font-semibold">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {products.length === 0 ? (
            <tr>
              <td colspan="7" class="px-4 py-8 text-center text-on-surface-variant">
                Chưa có gói dịch vụ nào. Nhấn "Tạo gói dịch vụ" để bắt đầu.
              </td>
            </tr>
          ) : products.map((p) => (
            <tr class="border-b border-outline-variant/20 hover:bg-primary/5 transition-colors" data-id={p.id}>
              <td class="px-4 py-4 text-on-surface font-semibold">{p.name}</td>
              <td class="px-4 py-3 text-on-surface-variant">{typeLabels[p.type] ?? p.type}</td>
              <td class="px-4 py-3 text-on-surface-variant text-xs">
                {productEntitlementMap[p.id]?.length ? (
                  <div class="flex flex-wrap gap-1">
                    {productEntitlementMap[p.id].map((entitlement) => (
                      <span class="px-1.5 py-0.5 bg-secondary-container/50 text-on-secondary-container rounded-md text-xs font-medium">
                        {getEntitlementLabel(entitlement)}
                      </span>
                    ))}
                  </div>
                ) : (
                  <span class="text-on-surface-variant/55">—</span>
                )}
              </td>
              <td class="px-4 py-4 text-right text-on-surface font-medium">{p.price.toLocaleString('vi-VN')}₫</td>
              <td class="px-4 py-3 text-center text-on-surface-variant">
                {p.duration_days ? `${p.duration_days} ngày` : '∞'}
              </td>
              <td class="px-4 py-3 text-center">
                <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold ${p.is_active ? 'bg-success-container text-success' : 'bg-surface-container-high text-on-surface-variant'}`}>
                  {p.is_active ? 'Đang bán' : 'Tạm dừng'}
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                <button
                  class="edit-btn text-primary hover:underline text-xs font-semibold"
                  data-id={p.id}
                  data-name={p.name}
                  data-type={p.type}
                  data-price={p.price}
                  data-description={p.description ?? ''}
                   data-duration_days={p.duration_days ?? ''}
                   data-reference_id={p.reference_id ?? ''}
                   data-app_id={p.app_id ?? ''}
                   data-entitlements={JSON.stringify(productEntitlementMap[p.id] ?? [])}
                  data-is_active={p.is_active}
                >
                  Sửa
                </button>
                <button
                  class="delete-btn text-rose-400 hover:underline text-xs font-semibold ml-2"
                  data-id={p.id}
                  data-name={p.name}
                >
                  Xóa
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script define:vars={{ typeLabels, entitlementPresets, scanners }}>
    const modal = document.getElementById('new-product-modal');
    const closeBtn = document.getElementById('modal-close');
    const newBtn = document.getElementById('btn-new-product');
    const form = document.getElementById('product-form');
    const errorEl = document.getElementById('form-error');
    const submitBtn = document.getElementById('form-submit');
    const priceInput = document.getElementById('price');
    const priceDisplay = document.getElementById('price-display');
    const modalTitle = document.getElementById('modal-title');
    const entitlementPreset = document.getElementById('entitlement-preset');
    const entitlementRows = document.getElementById('entitlement-rows');
    const scannerPicker = document.getElementById('scanner-picker');
    const resourcePicker = document.getElementById('resource-picker');
    const addEntitlementBtn = document.getElementById('add-entitlement');
    const typeSelect = form?.querySelector('[name="type"]');

    let editingId = null;
    const entitlementTypes = [
      ['book', 'Sách'],
      ['ai_app', 'AI app'],
      ['scanner', 'Scanner'],
      ['course', 'Khóa học'],
      ['blog', 'Blog'],
      ['resource', 'Tài liệu'],
      ['service', 'Dịch vụ'],
    ];

    function formatPrice(value) {
      const digits = String(value ?? '').replace(/\D/g, '');
      if (priceInput) priceInput.value = digits || '0';
      return digits ? Number(digits).toLocaleString('vi-VN') : '';
    }

    priceDisplay?.addEventListener('input', () => {
      priceDisplay.value = formatPrice(priceDisplay.value);
    });

    priceDisplay?.addEventListener('blur', () => {
      priceDisplay.value = formatPrice(priceDisplay.value);
    });

    function openModal() {
      modal?.classList.remove('hidden');
      updateEntitlementPresetOptions();
      const scannerId = new URLSearchParams(window.location.search).get('scanner');
      if (!editingId && scannerId) {
        const scanner = scanners.find((item) => item.id === scannerId);
        const nameInput = form?.querySelector('[name="name"]');
        if (scanner && nameInput) nameInput.value = `Mở khóa ${scanner.title_vi}`;
        if (scanner) {
          setSelectedScanners([{ content_type: 'scanner', content_id: scannerId }]);
          setPresetValue('scanner_custom');
        }
      }
    }

    function updateEntitlementPresetOptions() {
      entitlementPreset?.querySelectorAll('[data-service-preset]').forEach((option) => {
        option.hidden = false;
      });
    }

    function setPresetValue(value) {
      if (entitlementPreset) entitlementPreset.value = value;
      scannerPicker?.classList.toggle('hidden', value !== 'scanner_custom');
      resourcePicker?.classList.toggle('hidden', value !== 'resource_custom');
      const pickerMode = value === 'scanner_custom' || value === 'resource_custom';
      entitlementRows?.classList.toggle('hidden', pickerMode);
      addEntitlementBtn?.classList.toggle('hidden', pickerMode);
    }

    function markEntitlementsCustom() {
      setPresetValue('custom');
    }

    function getSelectedScanners() {
      return Array.from(document.querySelectorAll('.scanner-checkbox:checked'))
        .map((checkbox) => ({ content_type: 'scanner', content_id: checkbox.value }));
    }

    function setSelectedScanners(entitlements) {
      const ids = new Set(entitlements
        .filter((entitlement) => entitlement.content_type === 'scanner')
        .map((entitlement) => entitlement.content_id));
      document.querySelectorAll('.scanner-checkbox').forEach((checkbox) => {
        checkbox.checked = ids.has(checkbox.value);
      });
    }

    function getSelectedResources() {
      return Array.from(document.querySelectorAll('.resource-checkbox:checked'))
        .map((checkbox) => ({ content_type: 'resource', content_id: checkbox.value }));
    }

    function setSelectedResources(entitlements) {
      const ids = new Set(entitlements
        .filter((entitlement) => entitlement.content_type === 'resource')
        .map((entitlement) => entitlement.content_id));
      document.querySelectorAll('.resource-checkbox').forEach((checkbox) => {
        checkbox.checked = ids.has(checkbox.value);
      });
    }

    function addEntitlementRow(entitlement = { content_type: 'book', content_id: '' }) {
      if (!entitlementRows) return;
      const row = document.createElement('div');
      row.className = 'entitlement-row grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_2.5rem] items-center gap-2';

      const typeInput = document.createElement('select');
      typeInput.className = 'entitlement-type min-w-0 w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-on-surface text-sm focus:ring-2 focus:ring-primary/40 focus:outline-none';
      for (const [value, label] of entitlementTypes) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = label;
        option.selected = value === entitlement.content_type;
        typeInput.appendChild(option);
      }

      let idInput = document.createElement('input');
      idInput.type = 'text';
      idInput.value = entitlement.content_id || '';
      idInput.placeholder = 'ID hoặc *';
      idInput.className = 'entitlement-id min-w-0 w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant rounded-lg text-on-surface placeholder:text-on-surface-variant/70 text-sm focus:ring-2 focus:ring-primary/40 focus:outline-none';

      function renderContentIdInput() {
        const currentValue = idInput.value;
        const replacement = typeInput.value === 'scanner'
          ? document.createElement('select')
          : document.createElement('input');
        replacement.className = idInput.className;
        replacement.classList.add('entitlement-id');
        if (typeInput.value === 'scanner') {
          const empty = document.createElement('option');
          empty.value = '';
          empty.textContent = 'Chọn Scanner';
          replacement.appendChild(empty);
          const all = document.createElement('option');
          all.value = '*';
          all.textContent = 'Tất cả Scanner';
          replacement.appendChild(all);
          for (const scanner of scanners) {
            const option = document.createElement('option');
            option.value = scanner.id;
            option.textContent = scanner.title_vi;
            replacement.appendChild(option);
          }
        } else {
          replacement.type = 'text';
          replacement.placeholder = 'ID hoặc *';
        }
        replacement.value = currentValue;
        replacement.addEventListener('input', markEntitlementsCustom);
        replacement.addEventListener('change', markEntitlementsCustom);
        idInput.replaceWith(replacement);
        idInput = replacement;
      }

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'remove-entitlement w-10 h-10 flex items-center justify-center rounded-lg text-rose-400 hover:bg-rose-400/10';
      removeBtn.title = 'Xóa quyền lợi';
      removeBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">delete</span>';
      removeBtn.addEventListener('click', () => {
        row.remove();
        markEntitlementsCustom();
      });
      typeInput.addEventListener('change', () => {
        renderContentIdInput();
        markEntitlementsCustom();
      });
      idInput.addEventListener('input', markEntitlementsCustom);

      row.append(typeInput, idInput, removeBtn);
      entitlementRows.appendChild(row);
      renderContentIdInput();
    }

    function renderEntitlementRows(entitlements) {
      if (!entitlementRows) return;
      entitlementRows.innerHTML = '';
      for (const entitlement of entitlements) addEntitlementRow(entitlement);
    }

    function readEntitlements() {
      if (entitlementPreset?.value === 'scanner_custom') return getSelectedScanners();
      if (entitlementPreset?.value === 'resource_custom') return getSelectedResources();
      return Array.from(entitlementRows?.querySelectorAll('.entitlement-row') ?? [])
        .map((row) => ({
          content_type: row.querySelector('.entitlement-type')?.value,
          content_id: row.querySelector('.entitlement-id')?.value.trim(),
        }))
        .filter((entitlement) => entitlement.content_type && entitlement.content_id);
    }

    function inferEntitlementPreset(entitlements) {
      const normalized = entitlements
        .map((entitlement) => `${entitlement.content_type}:${entitlement.content_id}`)
        .sort()
        .join('|');
      for (const [preset, presetEntitlements] of Object.entries(entitlementPresets)) {
        const presetValue = presetEntitlements
          .map((entitlement) => `${entitlement.content_type}:${entitlement.content_id}`)
          .sort()
          .join('|');
        if (normalized === presetValue) return preset;
      }
      return 'custom';
    }

    entitlementPreset?.addEventListener('change', () => {
      const selected = entitlementPreset.value;
      if (selected === 'scanner_custom') {
        entitlementRows?.classList.add('hidden');
        scannerPicker?.classList.remove('hidden');
        setSelectedScanners([]);
        resourcePicker?.classList.add('hidden');
      } else if (selected === 'resource_custom') {
        entitlementRows?.classList.add('hidden');
        scannerPicker?.classList.add('hidden');
        resourcePicker?.classList.remove('hidden');
        setSelectedResources([]);
      } else {
        renderEntitlementRows(entitlementPresets[selected] || []);
        scannerPicker?.classList.add('hidden');
        resourcePicker?.classList.add('hidden');
      }
    });
    addEntitlementBtn?.addEventListener('click', () => {
      markEntitlementsCustom();
      addEntitlementRow();
    });

    function closeModal() {
      modal?.classList.add('hidden');
      form?.reset();
      if (priceDisplay) priceDisplay.value = '';
      if (priceInput) priceInput.value = '0';
      renderEntitlementRows([]);
      setSelectedScanners([]);
      setPresetValue('custom');
      updateEntitlementPresetOptions();
      editingId = null;
      modalTitle.textContent = 'Tạo gói dịch vụ mới';
      submitBtn.textContent = 'Tạo gói dịch vụ';
      errorEl?.classList.add('hidden');
    }

    newBtn?.addEventListener('click', openModal);
    if (new URLSearchParams(window.location.search).has('scanner')) openModal();
    closeBtn?.addEventListener('click', closeModal);

    // Edit buttons
    document.querySelectorAll('.edit-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const b = btn;
        editingId = b.dataset.id;
        const nameInput = form?.querySelector('[name="name"]');
        const typeInput = form?.querySelector('[name="type"]');
        const descInput = form?.querySelector('[name="description"]');
        const durInput = form?.querySelector('[name="duration_days"]');
        const activeInput = document.getElementById('is_active');

        if (nameInput) nameInput.value = b.dataset.name || '';
        if (typeInput) typeInput.value = b.dataset.type || '';
        if (priceDisplay) priceDisplay.value = formatPrice(b.dataset.price || '');
        if (descInput) descInput.value = b.dataset.description || '';
        if (durInput) durInput.value = b.dataset.duration_days || '';
        if (activeInput) activeInput.checked = b.dataset.is_active === '1';

        let entitlements = [];
        try { entitlements = JSON.parse(b.dataset.entitlements || '[]'); } catch {}
        renderEntitlementRows(entitlements);
        const inferredPreset = inferEntitlementPreset(entitlements);
         if (inferredPreset === 'custom' && entitlements.length > 0 && entitlements.every((entitlement) => entitlement.content_type === 'scanner')) {
           setSelectedScanners(entitlements);
           setPresetValue('scanner_custom');
         } else if (inferredPreset === 'custom' && entitlements.length > 0 && entitlements.every((entitlement) => entitlement.content_type === 'resource')) {
           setSelectedResources(entitlements);
           setPresetValue('resource_custom');
         } else {
          setPresetValue(inferredPreset);
        }
        updateEntitlementPresetOptions();

        modalTitle.textContent = 'Sửa gói dịch vụ';
        submitBtn.textContent = 'Cập nhật';
        modal?.classList.remove('hidden');
      });
    });

    const editProductId = new URLSearchParams(window.location.search).get('edit');
    if (editProductId) document.querySelector(`.edit-btn[data-id="${CSS.escape(editProductId)}"]`)?.click();

    // Delete buttons
    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const name = btn.dataset.name;
        if (!confirm(`Xác nhận xóa "${name}"?`)) return;
        const resp = await fetch(`/api/admin/products/${id}`, { method: 'DELETE' });
        if (resp.ok) {
          window.location.reload();
        } else {
          alert('Lỗi xóa sản phẩm');
        }
      });
    });

    // Form submit (two-step: product save → scanner mapping save)
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl?.classList.add('hidden');

      const data = new FormData(form);
       const selectedEntitlementPreset = data.get('entitlement_preset') || 'custom';
       const entitlementPreset = selectedEntitlementPreset === 'scanner_custom' || selectedEntitlementPreset === 'resource_custom'
         ? 'custom'
         : selectedEntitlementPreset;
       const customEntitlements = readEntitlements();
       if (selectedEntitlementPreset === 'scanner_custom' && customEntitlements.length === 0) {
         errorEl.textContent = 'Chọn ít nhất một Scanner để mở khóa.';
         errorEl?.classList.remove('hidden');
         return;
       }
       if (selectedEntitlementPreset === 'resource_custom' && customEntitlements.length === 0) {
         errorEl.textContent = 'Chọn ít nhất một tài liệu để mở khóa.';
         errorEl?.classList.remove('hidden');
         return;
       }
       const body = {
        name: data.get('name'),
        type: data.get('type'),
        price: Number(data.get('price') || 0),
        description: String(data.get('description') ?? ''),
        duration_days: data.get('duration_days') ? parseInt(String(data.get('duration_days')), 10) : null,
        reference_id: null,
        app_id: null,
        is_active: data.get('is_active') === 'on' ? 1 : 0,
        ...(entitlementPreset !== 'custom'
          ? { entitlement_preset: entitlementPreset }
          : customEntitlements.length > 0
            ? { entitlement_preset: entitlementPreset, entitlements: customEntitlements }
            : {}),
      };

      submitBtn.disabled = true;
      submitBtn.textContent = 'Đang lưu...';

      try {
        const url = editingId ? `/api/admin/products/${editingId}` : '/api/admin/products';
        const method = editingId ? 'PUT' : 'POST';
        const resp = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        const result = await resp.json();
        if (!resp.ok) {
          errorEl.textContent = result.error || 'Lỗi lưu sản phẩm';
          errorEl?.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = editingId ? 'Cập nhật' : 'Tạo gói dịch vụ';
          return;
        }

        window.location.reload();
      } catch {
        errorEl.textContent = 'Lỗi kết nối';
        errorEl?.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = editingId ? 'Cập nhật' : 'Tạo gói dịch vụ';
      }
    });
  </script>
</AdminLayout>
