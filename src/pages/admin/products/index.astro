---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listProducts } from '../../../lib/payos-db';
import { listProductEntitlements } from '../../../lib/entitlement-db';

export const prerender = false;

const products = await listProducts(env.DB);
const entitlementCounts = Object.fromEntries(await Promise.all(
  products.map(async (product) => [
    product.id,
    (await listProductEntitlements(env.DB, product.id)).length,
  ]),
));
---

<AdminLayout title="Sản phẩm cũ | Admin">
  <section class="mx-auto max-w-5xl">
    <div class="rounded-3xl border border-amber-500/35 bg-amber-500/10 p-6 md:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <div class="max-w-3xl"><div class="flex items-center gap-2 text-amber-700 dark:text-amber-300"><span class="material-symbols-outlined">warning</span><p class="text-xs font-bold uppercase tracking-[0.16em]">Legacy commerce</p></div><h2 class="mt-3 text-3xl font-black text-on-surface">Gói Product cũ đã ngừng tạo mới</h2><p class="mt-3 leading-relaxed text-on-surface-variant">Các gói trong danh sách này dùng `product_entitlement`, Credits legacy và thời hạn truy cập cũ. Chúng không tương thích với Ví Credits, thanh toán nạp Credits, bảng giá Scanner hoặc mở khóa nội dung theo Credits.</p><p class="mt-3 leading-relaxed text-on-surface-variant">Để tránh cấp quyền sai hoặc hiển thị giá gây hiểu lầm, trang này chỉ còn dùng để kiểm tra dữ liệu lịch sử.</p></div>
        <a href="/admin/credits" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-on-primary"><span class="material-symbols-outlined">account_balance_wallet</span>Quản lý Credits</a>
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2"><a href="/admin/credits" class="rounded-2xl border border-primary/30 bg-primary/5 p-5 transition hover:bg-primary/10"><span class="material-symbols-outlined text-primary">add_card</span><h3 class="mt-3 font-bold text-on-surface">Gói nạp Credits</h3><p class="mt-2 text-sm text-on-surface-variant">Tạo giá VND, Credits cơ bản và Credits bonus cho Ví Credits.</p></a><a href="/admin/credits" class="rounded-2xl border border-primary/30 bg-primary/5 p-5 transition hover:bg-primary/10"><span class="material-symbols-outlined text-primary">tune</span><h3 class="mt-3 font-bold text-on-surface">Giá tính năng</h3><p class="mt-2 text-sm text-on-surface-variant">Cấu hình Credits cho Scanner, khóa học, tài liệu và các tính năng khác.</p></a></div>

    <section class="mt-8 overflow-hidden rounded-2xl border border-outline-variant/20 bg-surface-container-low">
      <div class="border-b border-outline-variant/20 px-5 py-4"><h3 class="font-bold text-on-surface">Dữ liệu Product cũ</h3><p class="mt-1 text-sm text-on-surface-variant">Chỉ đọc. Không tạo, sửa hoặc kích hoạt lại từ giao diện này.</p></div>
      <div class="overflow-x-auto"><table class="min-w-[720px] w-full text-sm"><thead class="bg-surface-container-high/30 text-left text-xs uppercase tracking-wider text-on-surface-variant"><tr><th class="px-5 py-3">Tên gói</th><th class="px-4 py-3 text-right">Giá cũ</th><th class="px-4 py-3 text-center">Quyền legacy</th><th class="px-5 py-3 text-center">Trạng thái</th></tr></thead><tbody class="divide-y divide-outline-variant/15">{products.length === 0 ? <tr><td colspan="4" class="px-5 py-10 text-center text-on-surface-variant">Không có Product legacy.</td></tr> : products.map((product) => <tr><td class="px-5 py-4"><p class="font-semibold text-on-surface">{product.name}</p>{product.description && <p class="mt-1 max-w-lg truncate text-xs text-on-surface-variant">{product.description}</p>}</td><td class="px-4 py-4 text-right text-on-surface-variant">{product.price.toLocaleString('vi-VN')}đ</td><td class="px-4 py-4 text-center text-on-surface-variant">{entitlementCounts[product.id] ?? 0}</td><td class="px-5 py-4 text-center"><span class="rounded-full bg-surface-container-high px-2.5 py-1 text-xs font-bold text-on-surface-variant">Lưu trữ</span></td></tr>)}</tbody></table></div>
    </section>
  </section>
</AdminLayout>
