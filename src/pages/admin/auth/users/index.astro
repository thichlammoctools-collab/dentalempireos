---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { createAuth } from '../../../../lib/auth';

export const prerender = false;

const auth = createAuth(env);

const limit = 20;
const result = await auth.api.listUsers({
  headers: Astro.request.headers,
  limit,
  sortBy: 'createdAt',
  sortDirection: 'desc',
});
const users = result.users;
const total = result.total;
const weekStart = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();
const [bannedResult, newThisWeekResult] = await Promise.all([
  env.DB.prepare('SELECT COUNT(*) AS count FROM "user" WHERE "banned" = 1').first<{ count: number }>(),
  env.DB.prepare('SELECT COUNT(*) AS count FROM "user" WHERE "createdAt" >= ?').bind(weekStart).first<{ count: number }>(),
]);
const bannedCount = bannedResult?.count ?? 0;
const activeCount = Math.max(0, total - bannedCount);
const newThisWeek = newThisWeekResult?.count ?? 0;
---

<AdminLayout title="Người dùng | Dental Empire Admin" searchPlaceholder="Tìm email, tên người dùng...">
  <section class="user-admin-page space-y-6">
    <header class="relative overflow-hidden rounded-3xl border border-primary/20 bg-surface-container-low p-6 sm:p-8">
      <div class="pointer-events-none absolute -right-16 -top-24 h-56 w-56 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="relative flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <div class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-primary">
            <span class="material-symbols-outlined text-base">admin_panel_settings</span>
            Trung tâm thành viên
          </div>
          <h2 class="text-3xl font-extrabold tracking-tight text-on-surface sm:text-4xl">Quản lý người dùng</h2>
          <p class="mt-2 max-w-xl text-sm leading-6 text-on-surface-variant">Theo dõi trạng thái tài khoản, quyền truy cập sản phẩm và các phiên đăng nhập từ một nơi.</p>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-outline-variant/25 bg-surface/70 px-4 py-3 backdrop-blur-sm">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/15 text-primary"><span class="material-symbols-outlined">group</span></span>
          <div><p class="text-xs text-on-surface-variant">Cơ sở dữ liệu tài khoản</p><p class="font-bold text-on-surface">{total.toLocaleString('vi-VN')} thành viên</p></div>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      <div class="user-stat-card"><span class="user-stat-icon bg-primary/15 text-primary"><span class="material-symbols-outlined">groups</span></span><p>Tổng thành viên</p><strong>{total.toLocaleString('vi-VN')}</strong></div>
      <div class="user-stat-card"><span class="user-stat-icon bg-emerald-500/15 text-emerald-500"><span class="material-symbols-outlined">verified_user</span></span><p>Đang hoạt động</p><strong>{activeCount.toLocaleString('vi-VN')}</strong></div>
      <div class="user-stat-card"><span class="user-stat-icon bg-amber-500/15 text-amber-500"><span class="material-symbols-outlined">person_add</span></span><p>Mới 7 ngày</p><strong>{newThisWeek.toLocaleString('vi-VN')}</strong></div>
      <div class="user-stat-card"><span class="user-stat-icon bg-rose-500/15 text-rose-500"><span class="material-symbols-outlined">block</span></span><p>Đang bị cấm</p><strong>{bannedCount.toLocaleString('vi-VN')}</strong></div>
    </div>

    <section class="overflow-hidden rounded-3xl border border-outline-variant/25 bg-surface-container-low">
      <div class="flex flex-col gap-4 border-b border-outline-variant/20 p-4 sm:p-5 xl:flex-row xl:items-center xl:justify-between">
        <label class="relative block min-w-0 flex-1 xl:max-w-md">
          <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-on-surface-variant">search</span>
          <input id="user-search" type="search" placeholder="Tìm theo tên hoặc email..." class="h-11 w-full rounded-xl border border-outline-variant/35 bg-surface px-10 text-sm text-on-surface outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/15" />
          <kbd class="absolute right-3 top-1/2 hidden -translate-y-1/2 rounded border border-outline-variant/35 px-1.5 py-0.5 text-[10px] font-mono text-on-surface-variant sm:block">/</kbd>
        </label>
        <div class="flex items-center gap-1 rounded-xl bg-surface p-1" role="group" aria-label="Lọc trạng thái">
          <button class="user-filter is-active" type="button" data-filter="all">Tất cả <span>{total}</span></button>
          <button class="user-filter" type="button" data-filter="active">Hoạt động</button>
          <button class="user-filter" type="button" data-filter="banned">Bị cấm</button>
        </div>
      </div>

      <div class="flex items-center justify-between px-5 py-3 text-xs text-on-surface-variant">
        <p id="user-list-summary">Hiển thị <strong class="font-semibold text-on-surface">{users.length}</strong> trong số <strong class="font-semibold text-on-surface">{total}</strong> thành viên mới nhất</p>
        <span class="hidden items-center gap-1 sm:inline-flex"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>Dữ liệu mới nhất khi tải trang</span>
      </div>

      <div class="hidden overflow-x-auto lg:block">
        <table class="w-full min-w-[920px] text-left text-sm">
          <thead class="border-y border-outline-variant/20 bg-surface/60 text-[11px] font-bold uppercase tracking-[0.1em] text-on-surface-variant">
            <tr><th class="px-6 py-3.5">Thành viên</th><th class="px-6 py-3.5">Tài khoản</th><th class="px-6 py-3.5">Tham gia</th><th class="px-6 py-3.5">Hoạt động gần nhất</th><th class="px-6 py-3.5 text-right">Thao tác</th></tr>
          </thead>
          <tbody id="users-tbody">
            {users.length === 0 ? <tr><td colspan="5" class="px-6 py-16 text-center text-on-surface-variant">Chưa có người dùng nào.</td></tr> : users.map(user => (
              <tr class="user-row border-b border-outline-variant/15 transition-colors hover:bg-surface-container-high/45" data-user-key={user.id} data-search={`${user.name ?? ''} ${user.email ?? ''}`.toLowerCase()} data-status={user.banned ? 'banned' : 'active'}>
                <td class="px-6 py-4"><div class="flex items-center gap-3"><div class="user-avatar">{user.name?.charAt(0)?.toUpperCase() ?? '?'}</div><div class="min-w-0"><p class="truncate font-bold text-on-surface">{user.name || 'Chưa đặt tên'}</p><p class="mt-0.5 truncate text-xs text-on-surface-variant">{user.email}</p></div></div></td>
                <td class="px-6 py-4"><span class:list={["status-chip", user.banned ? "status-chip--blocked" : "status-chip--active"]}><span class="material-symbols-outlined text-[15px]">{user.banned ? 'block' : 'check_circle'}</span>{user.banned ? 'Bị cấm' : 'Hoạt động'}</span>{user.emailVerified && <p class="mt-1.5 text-xs text-emerald-500">Email đã xác thực</p>}</td>
                <td class="px-6 py-4 text-on-surface-variant">{new Date(user.createdAt).toLocaleDateString('vi-VN')}</td>
                <td class="px-6 py-4 text-on-surface-variant">{user.lastActiveAt ? new Date(user.lastActiveAt).toLocaleDateString('vi-VN') : 'Chưa có dữ liệu'}</td>
                <td class="px-6 py-4"><div class="flex items-center justify-end gap-2"><button class="detail-btn user-action-btn" data-user-id={user.id}><span class="material-symbols-outlined text-[17px]">visibility</span>Hồ sơ</button><button class:list={["ban-btn user-icon-action", user.banned ? "user-icon-action--restore" : "user-icon-action--danger"]} data-user-id={user.id} data-banned={String(!!user.banned)} title={user.banned ? 'Bỏ cấm người dùng' : 'Cấm người dùng'}><span class="material-symbols-outlined text-[18px]">{user.banned ? 'person_check' : 'person_off'}</span></button></div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div id="user-cards" class="space-y-3 p-4 lg:hidden">
        {users.map(user => (
          <article class="user-card user-row" data-user-key={user.id} data-search={`${user.name ?? ''} ${user.email ?? ''}`.toLowerCase()} data-status={user.banned ? 'banned' : 'active'}>
            <div class="flex items-start gap-3"><div class="user-avatar">{user.name?.charAt(0)?.toUpperCase() ?? '?'}</div><div class="min-w-0 flex-1"><p class="truncate font-bold text-on-surface">{user.name || 'Chưa đặt tên'}</p><p class="mt-0.5 truncate text-xs text-on-surface-variant">{user.email}</p></div><span class:list={["status-chip", user.banned ? "status-chip--blocked" : "status-chip--active"]}>{user.banned ? 'Bị cấm' : 'Hoạt động'}</span></div>
            <div class="mt-4 grid grid-cols-2 gap-3 border-t border-outline-variant/15 pt-3 text-xs"><p class="text-on-surface-variant">Tham gia<strong class="mt-1 block text-sm text-on-surface">{new Date(user.createdAt).toLocaleDateString('vi-VN')}</strong></p><p class="text-on-surface-variant">Hoạt động cuối<strong class="mt-1 block text-sm text-on-surface">{user.lastActiveAt ? new Date(user.lastActiveAt).toLocaleDateString('vi-VN') : 'Chưa có'}</strong></p></div>
            <div class="mt-4 flex gap-2"><button class="detail-btn user-action-btn flex-1 justify-center" data-user-id={user.id}><span class="material-symbols-outlined text-[17px]">visibility</span>Xem hồ sơ</button><button class:list={["ban-btn user-icon-action", user.banned ? "user-icon-action--restore" : "user-icon-action--danger"]} data-user-id={user.id} data-banned={String(!!user.banned)}><span class="material-symbols-outlined text-[18px]">{user.banned ? 'person_check' : 'person_off'}</span></button></div>
          </article>
        ))}
      </div>
      <div id="user-empty-filter" class="hidden px-6 py-16 text-center"><span class="material-symbols-outlined text-4xl text-on-surface-variant/50">person_search</span><p class="mt-3 font-semibold text-on-surface">Không tìm thấy thành viên phù hợp</p><p class="mt-1 text-sm text-on-surface-variant">Thử thay đổi từ khóa hoặc bộ lọc trạng thái.</p></div>
    </section>
  </section>

  <div id="user-modal" class="fixed inset-0 z-[100] hidden bg-slate-950/45 backdrop-blur-sm">
    <div id="user-drawer" class="ml-auto flex h-full w-full max-w-2xl translate-x-full flex-col border-l border-outline-variant/25 bg-surface shadow-2xl transition-transform duration-300">
      <div class="flex items-center justify-between border-b border-outline-variant/20 px-5 py-4 sm:px-6"><div><p class="text-xs font-bold uppercase tracking-[0.14em] text-primary">Hồ sơ thành viên</p><h3 class="mt-1 text-xl font-extrabold text-on-surface">Chi tiết người dùng</h3></div><button id="close-modal" class="flex h-10 w-10 items-center justify-center rounded-xl border border-outline-variant/25 text-on-surface-variant transition hover:bg-surface-container-high hover:text-on-surface" aria-label="Đóng chi tiết"><span class="material-symbols-outlined">close</span></button></div>
      <div id="modal-content" class="flex-1 overflow-y-auto p-5 sm:p-6"><div class="py-12 text-center text-on-surface-variant">Đang tải hồ sơ...</div></div>
    </div>
  </div>
  <style>
    .user-stat-card { display: flex; min-height: 122px; flex-direction: column; justify-content: space-between; border: 1px solid color-mix(in srgb, var(--color-outline-variant) 32%, transparent); border-radius: 1.25rem; background: var(--color-surface-container-low); padding: 1rem; }
    .user-stat-card p { margin-top: .8rem; font-size: .72rem; font-weight: 600; color: var(--color-on-surface-variant); }
    .user-stat-card strong { margin-top: .15rem; font-size: 1.65rem; line-height: 1; color: var(--color-on-surface); }
    .user-stat-icon { display: inline-flex; height: 2.25rem; width: 2.25rem; align-items: center; justify-content: center; border-radius: .75rem; }
    .user-filter { border-radius: .65rem; padding: .55rem .75rem; font-size: .75rem; font-weight: 700; color: var(--color-on-surface-variant); transition: background-color .15s, color .15s; }
    .user-filter:hover, .user-filter.is-active { background: var(--color-surface-container-high); color: var(--color-on-surface); }
    .user-filter span { margin-left: .2rem; opacity: .6; }
    .user-avatar { display: flex; height: 2.5rem; width: 2.5rem; flex-shrink: 0; align-items: center; justify-content: center; border: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent); border-radius: .85rem; background: color-mix(in srgb, var(--color-primary) 14%, transparent); color: var(--color-primary); font-size: .9rem; font-weight: 800; }
    .status-chip { display: inline-flex; align-items: center; gap: .3rem; border-radius: 999px; border: 1px solid; padding: .3rem .55rem; font-size: .68rem; font-weight: 700; white-space: nowrap; }
    .status-chip--active { border-color: color-mix(in srgb, #10b981 30%, transparent); background: color-mix(in srgb, #10b981 12%, transparent); color: #059669; }
    .status-chip--blocked { border-color: color-mix(in srgb, #f43f5e 30%, transparent); background: color-mix(in srgb, #f43f5e 12%, transparent); color: #e11d48; }
    .user-action-btn, .user-icon-action { display: inline-flex; align-items: center; gap: .35rem; border: 1px solid color-mix(in srgb, var(--color-outline-variant) 45%, transparent); border-radius: .7rem; padding: .48rem .7rem; font-size: .72rem; font-weight: 700; color: var(--color-on-surface); transition: border-color .15s, background-color .15s, color .15s; }
    .user-action-btn:hover { border-color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 8%, transparent); color: var(--color-primary); }
    .user-icon-action { height: 2.25rem; width: 2.25rem; justify-content: center; padding: 0; }
    .user-icon-action--danger { border-color: color-mix(in srgb, #f43f5e 30%, transparent); color: #e11d48; }
    .user-icon-action--danger:hover { background: color-mix(in srgb, #f43f5e 12%, transparent); }
    .user-icon-action--restore { border-color: color-mix(in srgb, #10b981 30%, transparent); color: #059669; }
    .user-icon-action--restore:hover { background: color-mix(in srgb, #10b981 12%, transparent); }
    .user-card { border: 1px solid color-mix(in srgb, var(--color-outline-variant) 28%, transparent); border-radius: 1.15rem; background: var(--color-surface); padding: 1rem; }
    .user-row.is-filtered { display: none; }
    #user-modal.is-open { display: block; }
    #user-modal.is-open #user-drawer { transform: translateX(0); }
    @media (max-width: 420px) { .user-filter { padding-inline: .5rem; font-size: .68rem; } }
  </style>
</AdminLayout>

<script>
declare function showToast(msg: string, type?: string): void;

const userActions = document.querySelector('.user-admin-page')!;
const modal = document.getElementById('user-modal')!;
const modalContent = document.getElementById('modal-content')!;

const allRows = Array.from(document.querySelectorAll<HTMLElement>('.user-row'));
const searchInput = document.getElementById('user-search') as HTMLInputElement | null;
const emptyFilter = document.getElementById('user-empty-filter');
const listSummary = document.getElementById('user-list-summary');
let currentFilter = 'all';

function applyUserFilters() {
  const query = searchInput?.value.trim().toLowerCase() ?? '';
  const visibleUserIds = new Set<string>();
  allRows.forEach((row) => {
    const matchesQuery = !query || (row.dataset.search ?? '').includes(query);
    const matchesStatus = currentFilter === 'all' || row.dataset.status === currentFilter;
    const shown = matchesQuery && matchesStatus;
    row.classList.toggle('is-filtered', !shown);
    if (shown && row.dataset.userKey) visibleUserIds.add(row.dataset.userKey);
  });
  const visible = visibleUserIds.size;
  emptyFilter?.classList.toggle('hidden', visible > 0);
  if (listSummary) listSummary.innerHTML = `Hiển thị <strong class="font-semibold text-on-surface">${visible}</strong> trong số <strong class="font-semibold text-on-surface">${new Set(allRows.map((row) => row.dataset.userKey)).size}</strong> thành viên`;
}

searchInput?.addEventListener('input', applyUserFilters);
document.querySelectorAll<HTMLButtonElement>('.user-filter').forEach((button) => {
  button.addEventListener('click', () => {
    currentFilter = button.dataset.filter ?? 'all';
    document.querySelectorAll('.user-filter').forEach((item) => item.classList.toggle('is-active', item === button));
    applyUserFilters();
  });
});
document.addEventListener('keydown', (event) => {
  if (event.key === '/' && document.activeElement !== searchInput) { event.preventDefault(); searchInput?.focus(); }
});

async function fetchUserDetail(userId: string) {
  modal.classList.add('is-open');
  modalContent.innerHTML = '<div class="text-center text-on-surface-variant py-8">Đang tải...</div>';

  try {
    const res = await fetch(`/api/admin/auth/users/${encodeURIComponent(userId)}`);
    const data = await res.json();

    const sessions = data.sessions ?? [];
    const accounts = data.accounts ?? [];
    const products = data.products ?? [];
    const accesses = data.accesses ?? [];

    modalContent.innerHTML = `
      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-1">
          <div class="text-xs text-on-surface-variant uppercase tracking-wider">Tên</div>
          <div class="font-semibold text-on-surface">${data.name ?? '-'}</div>
        </div>
        <div class="space-y-1">
          <div class="text-xs text-on-surface-variant uppercase tracking-wider">Email</div>
          <div class="font-semibold text-on-surface break-all">${data.email ?? '-'}</div>
        </div>
        <div class="space-y-1">
          <div class="text-xs text-on-surface-variant uppercase tracking-wider">Trạng thái</div>
          <div>${data.banned
            ? '<span class="text-red-400 font-semibold">Bị cấm</span>'
            : '<span class="text-green-400 font-semibold">Hoạt động</span>'}
          </div>
        </div>
        <div class="space-y-1">
          <div class="text-xs text-on-surface-variant uppercase tracking-wider">Xác thực email</div>
          <div>${data.emailVerified
            ? '<span class="text-green-400 font-semibold">Đã xác thực</span>'
            : '<span class="text-yellow-400 font-semibold">Chưa xác thực</span>'}
          </div>
        </div>
        <div class="space-y-1">
          <div class="text-xs text-on-surface-variant uppercase tracking-wider">Đăng ký</div>
          <div class="font-semibold text-on-surface">${new Date(data.createdAt).toLocaleDateString('vi-VN')}</div>
        </div>
        <div class="space-y-1">
          <div class="text-xs text-on-surface-variant uppercase tracking-wider">Hoạt động cuối</div>
          <div class="font-semibold text-on-surface">${data.lastActiveAt ? new Date(data.lastActiveAt).toLocaleDateString('vi-VN') : 'Chưa có'}</div>
        </div>
        <div class="space-y-1">
          <div class="text-xs text-on-surface-variant uppercase tracking-wider">Sessions</div>
          <div class="font-semibold text-on-surface">${sessions.length}</div>
        </div>
        <div class="space-y-1">
          <div class="text-xs text-on-surface-variant uppercase tracking-wider">Tài khoản liên kết</div>
          <div class="font-semibold text-on-surface">${accounts.length}</div>
        </div>
      </div>

      ${accounts.length > 0 ? `
      <div>
        <div class="text-sm font-semibold text-on-surface-variant mb-2">Tài khoản liên kết</div>
        <div class="space-y-2">
          ${accounts.map((acc: any) => `
            <div class="flex items-center gap-2 text-sm">
              <span class="material-symbols-outlined text-primary text-lg">${acc.providerId === 'google' ? 'mail' : 'key'}</span>
              <span class="font-mono text-on-surface">${acc.providerId}</span>
              <span class="text-on-surface-variant">${acc.accountId}</span>
            </div>
          `).join('')}
        </div>
      </div>
      ` : ''}

      <div class="pt-4 border-t border-outline-variant/20">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
          <div>
            <div class="text-sm font-semibold text-on-surface">Quyền sản phẩm</div>
            <p class="text-xs text-on-surface-variant mt-0.5">Cấp quyền thủ công theo thời hạn đã cấu hình cho sản phẩm.</p>
          </div>
          <select id="manual-product-select" class="min-w-52 rounded-lg border border-outline-variant/40 bg-surface-container px-3 py-2 text-sm text-on-surface focus:border-primary focus:outline-none">
            <option value="">Chọn sản phẩm để kích hoạt</option>
            ${products.map((product: any) => `<option value="${product.id}">${product.name}${product.duration_days ? ` (${product.duration_days} ngày)` : ' (vĩnh viễn)'}</option>`).join('')}
          </select>
        </div>
        ${accesses.length > 0 ? `
          <div class="space-y-2 mb-3">
            ${accesses.map((access: any) => `
              <div class="flex items-center justify-between gap-3 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-3 py-2 text-sm">
                <span class="font-medium text-on-surface">${access.product_name}</span>
                <span class="text-xs text-emerald-400">${access.expires_at ? `HSD ${new Date(access.expires_at).toLocaleDateString('vi-VN')}` : 'Vĩnh viễn'}</span>
              </div>
            `).join('')}
          </div>
        ` : '<p class="mb-3 text-sm text-on-surface-variant">Chưa có quyền sản phẩm đang hiệu lực.</p>'}
        <button data-action="grant-product" data-user-id="${userId}"
          class="modal-action-btn rounded-xl border border-primary/30 bg-primary/15 px-4 py-2 text-sm font-bold text-primary transition-all hover:bg-primary/25 disabled:cursor-not-allowed disabled:opacity-50">
          Kích hoạt sản phẩm
        </button>
      </div>

      <div class="flex flex-wrap gap-3 pt-4 border-t border-outline-variant/20">
        <button data-action="revoke-sessions" data-user-id="${userId}" data-modal="true"
          class="modal-action-btn px-4 py-2 rounded-xl text-sm font-bold bg-red-500/15 text-red-400 border border-red-500/30 hover:bg-red-500/25 transition-all cursor-pointer">
          Thu hồi sessions
        </button>
        <button data-action="${data.banned ? 'unban' : 'ban'}" data-user-id="${userId}" data-modal="true"
          class="modal-action-btn px-4 py-2 rounded-xl text-sm font-bold bg-surface-container border border-outline-variant/30 text-on-surface hover:border-primary transition-all cursor-pointer">
          ${data.banned ? 'Bỏ cấm' : 'Cấm người dùng'}
        </button>
        <button data-action="send-verification" data-user-id="${userId}" data-modal="true"
          class="modal-action-btn px-4 py-2 rounded-xl text-sm font-bold bg-surface-container border border-outline-variant/30 text-on-surface hover:border-primary transition-all cursor-pointer">
          Gửi email xác thực
        </button>
      </div>
    `;
  } catch {
    modalContent.innerHTML = '<div class="text-center text-red-400 py-8">Lỗi khi tải chi tiết</div>';
  }
}

// Detail
userActions.addEventListener('click', async (e) => {
  const detailBtn = (e.target as HTMLElement).closest('.detail-btn') as HTMLButtonElement | null;
  if (!detailBtn) return;
  const userId = detailBtn.dataset.userId!;
  await fetchUserDetail(userId);
});

// Ban/Unban
userActions.addEventListener('click', async (e) => {
  const banBtn = (e.target as HTMLElement).closest('.ban-btn') as HTMLButtonElement | null;
  if (!banBtn) return;
  const userId = banBtn.dataset.userId!;
  const banned = banBtn.dataset.banned === 'true';
  const action = banned ? 'unban' : 'ban';

  banBtn.disabled = true;
  try {
    const res = await fetch('/api/admin/auth/actions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, userId }),
    });
    if (res.ok) {
      showToast(banned ? 'Đã bỏ cấm người dùng' : 'Đã cấm người dùng');
      window.location.reload();
    } else {
      const data = await res.json();
      showToast(data.error || 'Lỗi', 'error');
    }
  } catch {
    showToast('Lỗi kết nối', 'error');
  } finally {
    banBtn.disabled = false;
  }
});

// Modal actions
modalContent.addEventListener('click', async (e) => {
  const btn = (e.target as HTMLElement).closest('.modal-action-btn') as HTMLButtonElement | null;
  if (!btn) return;

  const action = btn.dataset.action!;
  const userId = btn.dataset.userId!;

  if (action === 'grant-product') {
    const select = document.getElementById('manual-product-select') as HTMLSelectElement | null;
    const productId = select?.value;
    if (!productId) {
      showToast('Chọn sản phẩm cần kích hoạt', 'error');
      return;
    }

    btn.disabled = true;
    try {
      const res = await fetch(`/api/admin/auth/users/${encodeURIComponent(userId)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId }),
      });
      const data = await res.json();
      if (!res.ok) {
        showToast(data.error || 'Không thể kích hoạt sản phẩm', 'error');
        return;
      }
      showToast('Đã kích hoạt sản phẩm cho người dùng');
      await fetchUserDetail(userId);
    } catch {
      showToast('Lỗi kết nối', 'error');
    } finally {
      btn.disabled = false;
    }
    return;
  }

  btn.disabled = true;
  try {
    const res = await fetch('/api/admin/auth/actions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, userId }),
    });
    if (res.ok) {
      showToast('Thao tác thành công');
      modal.classList.remove('is-open');
      window.location.reload();
    } else {
      const data = await res.json();
      showToast(data.error || 'Lỗi', 'error');
    }
  } catch {
    showToast('Lỗi kết nối', 'error');
  } finally {
    btn.disabled = false;
  }
});

// Close modal
document.getElementById('close-modal')!.addEventListener('click', () => {
  modal.classList.remove('is-open');
});

modal.addEventListener('click', (event) => {
  if (event.target === modal) modal.classList.remove('is-open');
});
document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape') modal.classList.remove('is-open');
});
</script>
