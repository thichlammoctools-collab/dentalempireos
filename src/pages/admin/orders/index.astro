---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listOrders } from '../../../lib/payos-db';

export const prerender = false;

const db = env.DB;
const status = Astro.url.searchParams.get('status') ?? undefined;
const limit = 50;
const offset = 0;

const { orders, total } = await listOrders(db, { status, limit, offset });

const statusColors: Record<string, string> = {
  pending: 'bg-amber-500/20 text-amber-400',
  paid: 'bg-emerald-500/20 text-emerald-400',
  cancelled: 'bg-white/10 text-white/50',
  expired: 'bg-rose-500/20 text-rose-400',
};

const statusLabels: Record<string, string> = {
  pending: 'Chờ thanh toán',
  paid: 'Đã thanh toán',
  cancelled: 'Đã hủy',
  expired: 'Hết hạn',
};
---

<AdminLayout title="Đơn Hàng | Admin">
  <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
      <h2 class="text-3xl font-bold text-white mb-1">Quản lý Đơn Hàng</h2>
      <p class="text-on-surface-variant">{total} đơn hàng</p>
    </div>
    <!-- Status filter -->
    <div class="flex gap-2">
      <a href="/admin/orders" class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${!status ? 'bg-primary text-white' : 'bg-white/5 text-on-surface-variant hover:bg-white/10'}`}>
        Tất cả
      </a>
      {Object.entries(statusLabels).map(([key, label]) => (
        <a href={`/admin/orders?status=${key}`} class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${status === key ? 'bg-primary text-white' : 'bg-white/5 text-on-surface-variant hover:bg-white/10'}`}>
          {label}
        </a>
      ))}
    </div>
  </div>

  <!-- Orders Table -->
  <div class="mt-8 glass-card rounded-2xl border border-outline-variant/20 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-outline-variant/20 text-on-surface-variant">
            <th class="text-left px-4 py-3 font-semibold">Mã đơn</th>
            <th class="text-left px-4 py-3 font-semibold">User ID</th>
            <th class="text-left px-4 py-3 font-semibold">Sản phẩm</th>
            <th class="text-right px-4 py-3 font-semibold">Số tiền</th>
            <th class="text-center px-4 py-3 font-semibold">Trạng thái</th>
            <th class="text-left px-4 py-3 font-semibold">Ngày tạo</th>
            <th class="text-left px-4 py-3 font-semibold">Ngày thanh toán</th>
            <th class="text-center px-4 py-3 font-semibold">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {orders.length === 0 ? (
            <tr>
              <td colspan="8" class="px-4 py-8 text-center text-on-surface-variant">
                Chưa có đơn hàng nào.
              </td>
            </tr>
          ) : orders.map((o) => (
            <tr class="border-b border-outline-variant/10 hover:bg-white/5 transition-colors">
              <td class="px-4 py-3 text-white font-mono text-xs">{o.order_code}</td>
              <td class="px-4 py-3 text-on-surface-variant font-mono text-xs">{o.user_id.slice(0, 8)}...</td>
              <td class="px-4 py-3 text-on-surface-variant font-mono text-xs">{o.product_id}</td>
              <td class="px-4 py-3 text-right text-white">{o.amount.toLocaleString('vi-VN')}₫</td>
              <td class="px-4 py-3 text-center">
                <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold ${statusColors[o.status] ?? ''}`}>
                  {statusLabels[o.status] ?? o.status}
                </span>
              </td>
              <td class="px-4 py-3 text-on-surface-variant text-xs">
                {new Date(o.created_at).toLocaleDateString('vi-VN')}
              </td>
              <td class="px-4 py-3 text-on-surface-variant text-xs">
                {o.paid_at ? new Date(o.paid_at).toLocaleDateString('vi-VN') : '—'}
              </td>
              <td class="px-4 py-3 text-center">
                {o.payment_link_id === null && o.status === 'pending' ? (
                  <div class="flex justify-center gap-2">
                    <button
                      data-order-id={o.id}
                      class="confirm-manual-order px-3 py-1.5 rounded-lg bg-emerald-500 text-white text-xs font-bold hover:bg-emerald-400 disabled:opacity-50"
                    >
                      Xác nhận chuyển khoản
                    </button>
                    <button
                      data-order-id={o.id}
                      class="cancel-manual-order px-3 py-1.5 rounded-lg bg-rose-500 text-white text-xs font-bold hover:bg-rose-400 disabled:opacity-50"
                    >
                      Hủy đơn
                    </button>
                  </div>
                ) : (
                  <span class="text-xs text-on-surface-variant">—</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.confirm-manual-order').forEach((button) => {
    button.addEventListener('click', async (event) => {
      const target = event.currentTarget as HTMLButtonElement;
      if (!confirm('Xác nhận đã nhận đúng số tiền? Tài khoản khách sẽ được kích hoạt ngay.')) return;
      target.disabled = true;
      try {
        const response = await fetch(`/api/admin/orders/${target.dataset.orderId}/confirm`, {
          method: 'POST', credentials: 'include',
        });
        if (!response.ok) throw new Error();
        window.location.reload();
      } catch {
        target.disabled = false;
        alert('Không thể xác nhận đơn hàng. Vui lòng thử lại.');
      }
    });
  });

  document.querySelectorAll('.cancel-manual-order').forEach((button) => {
    button.addEventListener('click', async (event) => {
      const target = event.currentTarget as HTMLButtonElement;
      if (!confirm('Hủy đơn hàng này? Thao tác này không thể hoàn tác.')) return;
      target.disabled = true;
      try {
        const response = await fetch(`/api/admin/orders/${target.dataset.orderId}/cancel`, {
          method: 'POST', credentials: 'include',
        });
        if (!response.ok) throw new Error();
        window.location.reload();
      } catch {
        target.disabled = false;
        alert('Không thể hủy đơn hàng. Vui lòng thử lại.');
      }
    });
  });
</script>
