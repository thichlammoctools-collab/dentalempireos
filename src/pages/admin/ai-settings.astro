---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { getAiSettings } from '../../lib/ai-settings-db';
import { hasAiGatewayToken, hasMotapisApiKey } from '../../lib/ai-gateway';

export const prerender = false;

const settings = await getAiSettings(env.DB);
const gatewayTokenSet = hasAiGatewayToken();
const motapisTokenSet = hasMotapisApiKey();
const gatewayReady = settings.gateway_enabled === 1 && Boolean(settings.gateway_account_id && settings.gateway_default_model && gatewayTokenSet);
const motapisReady = settings.motapis_enabled === 1 && Boolean(settings.motapis_model && motapisTokenSet);
const activeProviderReady = settings.ai_provider === 'motapis' ? motapisReady : gatewayReady;
const activeDefaultModel = settings.ai_provider === 'motapis' ? settings.motapis_model : settings.gateway_default_model;
---

<AdminLayout title="Cấu hình AI | Admin">
  <div class="max-w-6xl mx-auto w-full space-y-6" id="ai-settings-page"
    data-gateway-default-model={settings.gateway_default_model ?? ''}
    data-gateway-chat-model={settings.gateway_chat_model ?? ''}
    data-gateway-embedding-model={settings.gateway_embedding_model ?? ''}
    data-motapis-model={settings.motapis_model ?? ''}
    data-motapis-chat-model={settings.motapis_chat_model ?? ''}
    data-motapis-scanner-model={settings.motapis_scanner_model ?? ''}>
    <header class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-xs font-bold tracking-[0.16em] uppercase text-primary mb-2">AI Operations</p>
        <h1 class="text-3xl font-bold text-white">Cấu hình AI</h1>
        <p class="mt-2 max-w-2xl text-sm text-on-surface-variant">Quản lý hạ tầng AI, model mặc định và routing theo tính năng. Model riêng theo gói bán được cấu hình trực tiếp trên từng Scanner hoặc AI Tool.</p>
      </div>
      <div class={`inline-flex items-center gap-2 rounded-xl border px-4 py-3 text-sm ${activeProviderReady ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-200' : 'border-amber-500/30 bg-amber-500/10 text-amber-200'}`}>
        <span class="material-symbols-outlined text-[18px]">{activeProviderReady ? 'check_circle' : 'warning'}</span>
        <span><strong>{activeProviderReady ? 'AI sẵn sàng' : 'Cần hoàn tất cấu hình'}</strong> · {settings.ai_provider === 'motapis' ? 'Motapis' : 'Cloudflare AI Gateway'}</span>
      </div>
    </header>

    <section class="grid gap-3 sm:grid-cols-3" aria-label="Tóm tắt vận hành AI">
      <div class="rounded-2xl border border-outline-variant/20 bg-surface-container/55 p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant/55">Provider đang chạy</p>
        <p id="summary-provider" class="mt-2 text-sm font-bold text-white">{settings.ai_provider === 'motapis' ? 'Motapis' : 'Cloudflare AI Gateway'}</p>
      </div>
      <div class="rounded-2xl border border-outline-variant/20 bg-surface-container/55 p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant/55">Model nền tảng</p>
        <p id="summary-model" class="mt-2 truncate font-mono text-sm text-on-surface">{activeDefaultModel || 'Chưa chọn'}</p>
      </div>
      <div class="rounded-2xl border border-outline-variant/20 bg-surface-container/55 p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-on-surface-variant/55">Quy tắc chi phí</p>
        <p class="mt-2 text-sm font-semibold text-on-surface">Override theo Scanner / Tool</p>
      </div>
    </section>

    <nav class="sticky top-0 z-10 -mx-4 flex gap-1 overflow-x-auto border-y border-outline-variant/15 bg-surface/95 px-4 py-2 backdrop-blur sm:mx-0 sm:rounded-xl sm:border sm:px-3" aria-label="Điều hướng cấu hình AI">
      <a href="#provider" class="whitespace-nowrap rounded-lg px-3 py-2 text-xs font-semibold text-on-surface-variant hover:bg-surface-container hover:text-white">1. Provider</a>
      <a href="#routing" class="whitespace-nowrap rounded-lg px-3 py-2 text-xs font-semibold text-on-surface-variant hover:bg-surface-container hover:text-white">2. Model routing</a>
      <a href="#knowledge" class="whitespace-nowrap rounded-lg px-3 py-2 text-xs font-semibold text-on-surface-variant hover:bg-surface-container hover:text-white">3. Kho tri thức</a>
    </nav>

    <section id="provider" class="glass-card rounded-2xl p-5 sm:p-6">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex gap-3">
          <span class="material-symbols-outlined mt-0.5 text-primary">hub</span>
          <div>
            <h2 class="text-lg font-bold text-white">1. Provider & kết nối</h2>
            <p class="mt-1 text-sm text-on-surface-variant">Chọn một provider phục vụ chat, Scanner và AI Tools. API key luôn nằm trong Worker secret, không lưu trong database.</p>
          </div>
        </div>
        <span class="text-xs text-on-surface-variant/60">Lưu ý: embedding luôn chạy qua Cloudflare.</span>
      </div>

      <form id="provider-form" class="mt-6 space-y-5">
        <fieldset>
          <legend class="sr-only">Chọn AI provider</legend>
          <div class="grid gap-3 md:grid-cols-2">
            <label class="provider-choice relative cursor-pointer rounded-2xl border p-4 transition-colors" data-provider="cloudflare">
              <input class="sr-only" type="radio" name="provider" value="cloudflare" checked={settings.ai_provider === 'cloudflare'} />
              <div class="flex items-start justify-between gap-3">
                <div class="flex gap-3">
                  <span class="material-symbols-outlined text-sky-300">cloud</span>
                  <div><strong class="block text-sm text-white">Cloudflare AI Gateway</strong><span class="mt-1 block text-xs text-on-surface-variant">Unified Billing hoặc BYOK, có routing tới nhiều model.</span></div>
                </div>
                <span class={`provider-secret-status text-[11px] font-bold ${gatewayTokenSet ? 'text-emerald-300' : 'text-amber-300'}`}>{gatewayTokenSet ? 'Secret OK' : 'Thiếu secret'}</span>
              </div>
            </label>
            <label class="provider-choice relative cursor-pointer rounded-2xl border p-4 transition-colors" data-provider="motapis">
              <input class="sr-only" type="radio" name="provider" value="motapis" checked={settings.ai_provider === 'motapis'} />
              <div class="flex items-start justify-between gap-3">
                <div class="flex gap-3">
                  <span class="material-symbols-outlined text-violet-300">token</span>
                  <div><strong class="block text-sm text-white">Motapis</strong><span class="mt-1 block text-xs text-on-surface-variant">OpenAI-compatible API, phù hợp khi cần catalog model riêng.</span></div>
                </div>
                <span class={`provider-secret-status text-[11px] font-bold ${motapisTokenSet ? 'text-emerald-300' : 'text-amber-300'}`}>{motapisTokenSet ? 'Secret OK' : 'Thiếu secret'}</span>
              </div>
            </label>
          </div>
        </fieldset>

        <details class="rounded-xl border border-outline-variant/20 bg-surface-container/35 p-4">
          <summary class="cursor-pointer text-sm font-semibold text-on-surface">Kết nối Cloudflare AI Gateway</summary>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            <label class="block"><span class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-on-surface-variant/70">Cloudflare Account ID</span><input id="gateway-account-id" value={settings.gateway_account_id ?? ''} placeholder="32-character account ID" class="field" /></label>
            <label class="block"><span class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-on-surface-variant/70">Gateway ID</span><input id="gateway-id" value={settings.gateway_id || 'default'} placeholder="default" class="field" /></label>
            <label class="flex items-center gap-2 text-sm text-on-surface md:col-span-2"><input id="gateway-enabled" type="checkbox" checked={settings.gateway_enabled === 1} class="h-4 w-4 accent-primary" /> Kích hoạt Cloudflare AI Gateway</label>
          </div>
          <p class={`mt-3 text-xs ${gatewayTokenSet ? 'text-emerald-300' : 'text-amber-300'}`}>{gatewayTokenSet ? 'CF_AI_GATEWAY_TOKEN đã được thiết lập trong Worker secret.' : 'Thiết lập bằng: npx wrangler secret put CF_AI_GATEWAY_TOKEN'}</p>
        </details>

        <label class="flex items-center gap-2 text-sm text-on-surface"><input id="motapis-enabled" type="checkbox" checked={settings.motapis_enabled === 1} class="h-4 w-4 accent-primary" /> Cho phép dùng Motapis khi được chọn</label>
        <div class="flex flex-wrap items-center gap-3 border-t border-outline-variant/15 pt-5">
          <button type="button" id="provider-test" class="btn-secondary">Kiểm tra kết nối</button>
          <button type="submit" id="provider-save" class="btn-primary-metallic px-5 py-2.5 text-sm font-bold">Lưu Provider & Routing</button>
          <p id="provider-msg" class="hidden text-sm" role="status"></p>
        </div>
      </form>
    </section>

    <section id="routing" class="glass-card rounded-2xl p-5 sm:p-6">
      <div class="flex gap-3">
        <span class="material-symbols-outlined mt-0.5 text-primary">account_tree</span>
        <div>
          <h2 class="text-lg font-bold text-white">2. Model routing</h2>
          <p class="mt-1 text-sm text-on-surface-variant">Đặt model mặc định theo luồng. Model của từng Scanner hoặc AI Tool sẽ ghi đè model Scanner mặc định khi được chọn tại trang cấu hình riêng.</p>
        </div>
      </div>
      <div class="mt-5 rounded-xl border border-primary/20 bg-primary/5 px-4 py-3 text-xs text-primary/90">
        <strong>Gợi ý tối ưu giá bán:</strong> dùng model nhanh/tiết kiệm làm mặc định; chỉ đặt override model mạnh hơn cho Scanner hoặc Tool có giá cao và cần phân tích sâu.
      </div>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        <label class="block rounded-xl border border-outline-variant/20 bg-surface-container/35 p-4">
          <span class="flex items-center gap-2 text-sm font-bold text-white"><span class="material-symbols-outlined text-[18px] text-slate-300">tune</span> Model nền tảng</span>
          <span class="mt-1 block text-xs text-on-surface-variant">Fallback cho các luồng chưa có routing riêng.</span>
          <select id="default-model" class="field mt-4"><option value="">Đang tải model...</option></select>
        </label>
        <label class="block rounded-xl border border-outline-variant/20 bg-surface-container/35 p-4">
          <span class="flex items-center gap-2 text-sm font-bold text-white"><span class="material-symbols-outlined text-[18px] text-sky-300">forum</span> Chat Assistant</span>
          <span class="mt-1 block text-xs text-on-surface-variant">Trợ lý công khai trên toàn website.</span>
          <select id="chat-model" class="field mt-4"><option value="">Dùng model nền tảng</option></select>
        </label>
        <label class="block rounded-xl border border-outline-variant/20 bg-surface-container/35 p-4">
          <span class="flex items-center gap-2 text-sm font-bold text-white"><span class="material-symbols-outlined text-[18px] text-amber-300">analytics</span> Scanner mặc định</span>
          <span class="mt-1 block text-xs text-on-surface-variant">Fallback cho Scanner chưa chọn model riêng.</span>
          <select id="scanner-model" class="field mt-4"><option value="">Dùng model nền tảng</option></select>
        </label>
      </div>
      <div class="mt-5 rounded-xl border border-outline-variant/20 bg-surface-container/25 p-4">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <div><p class="text-sm font-semibold text-white">Giới hạn output mặc định</p><p class="mt-1 text-xs text-on-surface-variant">Có thể override theo từng Scanner/Tool để cân bằng chất lượng và chi phí.</p></div>
          <label class="flex items-center gap-2"><input id="max-tokens" type="number" value={settings.max_tokens} min="256" max="8192" class="field w-28" /><span class="text-xs text-on-surface-variant">tokens</span></label>
        </div>
      </div>
      <p id="routing-msg" class="hidden mt-4 text-sm" role="status"></p>
    </section>

    <section id="knowledge" class="glass-card rounded-2xl p-5 sm:p-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex gap-3"><span class="material-symbols-outlined mt-0.5 text-primary">database</span><div><h2 class="text-lg font-bold text-white">3. Kho tri thức & embedding</h2><p class="mt-1 max-w-2xl text-sm text-on-surface-variant">Embedding là model chuyên để tìm kiếm ngữ nghĩa trong sách, blog và tài nguyên. Nó không phải chat model và luôn dùng Cloudflare AI Gateway.</p></div></div>
        <span class="rounded-lg bg-surface-container px-3 py-1.5 text-xs font-medium text-on-surface-variant">Cloudflare only</span>
      </div>
      <div class="mt-5 grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
        <label class="block"><span class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-on-surface-variant/70">Embedding model</span><select id="embedding-model" class="field"><option value="">Đang tải embedding model...</option></select></label>
        <button id="embedding-save" type="button" class="btn-secondary">Lưu embedding</button>
      </div>
      <div class="mt-5 flex flex-col gap-3 border-t border-outline-variant/15 pt-5 md:flex-row md:items-center md:justify-between">
        <div><p id="embedding-current" class="text-sm font-semibold text-on-surface">Đang dùng: {settings.gateway_embedding_model || 'Chưa chọn'}</p><p class="mt-1 text-xs text-on-surface-variant">Chỉ rebuild khi nội dung nguồn hoặc model embedding thay đổi.</p></div>
        <button id="rebuild-knowledge-btn" type="button" class="btn-primary-metallic flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-bold"><span class="material-symbols-outlined text-[18px]">database_upload</span>Xây dựng lại kho tri thức</button>
      </div>
      <p id="knowledge-msg" class="hidden mt-4 text-sm" role="status"></p>
    </section>

    <section class="rounded-2xl border border-outline-variant/15 bg-surface-container/30 p-5">
      <div class="flex gap-3"><span class="material-symbols-outlined text-on-surface-variant">rule</span><div><h2 class="text-sm font-bold text-white">Thứ tự ưu tiên model</h2><ol class="mt-2 list-decimal space-y-1 pl-5 text-xs leading-5 text-on-surface-variant"><li>Model override của từng Scanner hoặc AI Tool.</li><li>Model theo tính năng: Chat Assistant hoặc Scanner mặc định.</li><li>Model nền tảng của provider đang chọn.</li></ol></div></div>
    </section>
  </div>
</AdminLayout>

<style>
  .field { width: 100%; border: 1px solid rgb(var(--outline-variant) / 0.3); border-radius: 0.75rem; background: rgb(var(--surface-container)); padding: 0.65rem 0.8rem; color: white; font-size: 0.875rem; outline: none; }
  .field:focus { border-color: rgb(var(--primary)); box-shadow: 0 0 0 2px rgb(var(--primary) / 0.2); }
  .btn-secondary { border: 1px solid rgb(var(--outline-variant) / 0.35); border-radius: 0.75rem; background: rgb(var(--surface-container)); padding: 0.65rem 1rem; color: rgb(var(--on-surface)); font-size: 0.875rem; font-weight: 600; transition: border-color .2s, background .2s; }
  .btn-secondary:hover { border-color: rgb(var(--primary) / .6); background: rgb(var(--surface-container-high)); }
  .provider-choice { border-color: rgb(var(--outline-variant) / .25); background: rgb(var(--surface-container) / .35); }
  .provider-choice:has(input:checked) { border-color: rgb(var(--primary) / .65); background: rgb(var(--primary) / .1); box-shadow: 0 0 0 1px rgb(var(--primary) / .15); }
</style>

<script>
  type AiModel = { id: string; name: string; provider: string; category: 'chat' | 'embedding' };
  const page = document.getElementById('ai-settings-page');
  const value = (name: string) => page?.dataset[name] || '';
  const configured = {
    provider: document.querySelector<HTMLInputElement>('input[name="provider"]:checked')?.value || 'cloudflare',
    cloudflare: { defaultModel: '', chatModel: '', scannerModel: '', embeddingModel: '' },
    motapis: { defaultModel: '', chatModel: '', scannerModel: '' },
  };
  const hiddenValues = {
    cloudflare: { defaultModel: value('gatewayDefaultModel'), chatModel: value('gatewayChatModel'), scannerModel: '', embeddingModel: value('gatewayEmbeddingModel') },
    motapis: { defaultModel: value('motapisModel'), chatModel: value('motapisChatModel'), scannerModel: value('motapisScannerModel') },
  };
  configured.cloudflare = { ...configured.cloudflare, ...hiddenValues.cloudflare };
  configured.motapis = { ...configured.motapis, ...hiddenValues.motapis };

  const providerForm = document.getElementById('provider-form') as HTMLFormElement;
  const providerSave = document.getElementById('provider-save') as HTMLButtonElement;
  const providerTest = document.getElementById('provider-test') as HTMLButtonElement;
  const providerMsg = document.getElementById('provider-msg') as HTMLElement;
  const routingMsg = document.getElementById('routing-msg') as HTMLElement;
  const defaultModel = document.getElementById('default-model') as HTMLSelectElement;
  const chatModel = document.getElementById('chat-model') as HTMLSelectElement;
  const scannerModel = document.getElementById('scanner-model') as HTMLSelectElement;
  const embeddingModel = document.getElementById('embedding-model') as HTMLSelectElement;
  const maxTokens = document.getElementById('max-tokens') as HTMLInputElement;
  const embeddingCurrent = document.getElementById('embedding-current') as HTMLElement;
  const knowledgeMsg = document.getElementById('knowledge-msg') as HTMLElement;
  let models: AiModel[] = [];

  function showToast(message: string, type: string) { (window as any).showToast?.(message, type); }
  function setMessage(target: HTMLElement, message: string, type: 'success' | 'error' | 'muted') {
    target.textContent = message;
    target.className = `mt-4 text-sm ${type === 'success' ? 'text-emerald-400' : type === 'error' ? 'text-rose-400' : 'text-on-surface-variant'}`;
  }
  function activeProvider() { return document.querySelector<HTMLInputElement>('input[name="provider"]:checked')?.value as 'cloudflare' | 'motapis'; }
  function selectOptions(select: HTMLSelectElement, items: AiModel[], value: string, empty: string) {
    select.innerHTML = '';
    const blank = new Option(empty, ''); select.appendChild(blank);
    const groups = new Map<string, AiModel[]>();
    items.forEach((model) => groups.set(model.provider, [...(groups.get(model.provider) || []), model]));
    for (const [provider, providerModels] of groups) {
      const group = document.createElement('optgroup'); group.label = provider;
      providerModels.forEach((model) => group.appendChild(new Option(`${model.name} (${model.id})`, model.id, false, model.id === value)));
      select.appendChild(group);
    }
    if (value && !items.some((model) => model.id === value)) select.appendChild(new Option(`${value} (đang cấu hình)`, value, false, true));
  }
  function renderRouting() {
    const provider = activeProvider();
    const chatModels = models.filter((model) => model.category === 'chat' && (provider === 'motapis' ? model.provider === 'Motapis' : model.provider !== 'Motapis'));
    const values = configured[provider];
    selectOptions(defaultModel, chatModels, values.defaultModel, 'Chọn model nền tảng');
    selectOptions(chatModel, chatModels, values.chatModel, 'Dùng model nền tảng');
    selectOptions(scannerModel, chatModels, values.scannerModel, 'Dùng model nền tảng');
    const embeddingModels = models.filter((model) => model.category === 'embedding');
    selectOptions(embeddingModel, embeddingModels, configured.cloudflare.embeddingModel, 'Chọn embedding model');
    document.getElementById('summary-provider')!.textContent = provider === 'motapis' ? 'Motapis' : 'Cloudflare AI Gateway';
    document.getElementById('summary-model')!.textContent = values.defaultModel || 'Chưa chọn';
  }
  let displayedProvider = activeProvider();
  function captureRouting(provider = displayedProvider) {
    const values = configured[provider];
    values.defaultModel = defaultModel.value;
    values.chatModel = chatModel.value;
    values.scannerModel = scannerModel.value;
  }
  document.querySelectorAll<HTMLInputElement>('input[name="provider"]').forEach((input) => input.addEventListener('change', () => {
    captureRouting(displayedProvider);
    displayedProvider = activeProvider();
    renderRouting();
  }));
  [defaultModel, chatModel, scannerModel].forEach((select) => select.addEventListener('change', () => { captureRouting(); document.getElementById('summary-model')!.textContent = configured[activeProvider()].defaultModel || 'Chưa chọn'; setMessage(routingMsg, 'Có thay đổi chưa lưu. Bấm “Lưu Provider & Routing” để áp dụng.', 'muted'); }));

  async function loadModels() {
    try {
      const response = await fetch('/api/admin/ai-models', { method: 'POST' });
      const payload = await response.json() as { models?: AiModel[] };
      models = payload.models || [];
      renderRouting();
    } catch { setMessage(routingMsg, 'Không thể tải catalog model.', 'error'); }
  }
  loadModels();

  providerForm.addEventListener('submit', async (event) => {
    event.preventDefault(); captureRouting();
    const provider = activeProvider(); const cloudflare = configured.cloudflare; const motapis = configured.motapis;
    providerSave.disabled = true; setMessage(providerMsg, 'Đang lưu cấu hình...', 'muted');
    try {
      const response = await fetch('/api/admin/ai-settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        ai_provider: provider,
        gateway_enabled: (document.getElementById('gateway-enabled') as HTMLInputElement).checked,
        gateway_account_id: (document.getElementById('gateway-account-id') as HTMLInputElement).value,
        gateway_id: (document.getElementById('gateway-id') as HTMLInputElement).value,
        max_tokens: Number(maxTokens.value),
        gateway_default_model: cloudflare.defaultModel,
        gateway_chat_model: cloudflare.chatModel,
        gateway_embedding_model: embeddingModel.value,
        motapis_enabled: (document.getElementById('motapis-enabled') as HTMLInputElement).checked,
        motapis_model: motapis.defaultModel,
        motapis_chat_model: motapis.chatModel,
        motapis_scanner_model: motapis.scannerModel,
      }) });
      const data = await response.json() as { error?: string };
      if (!response.ok) throw new Error(data.error || 'Không thể lưu cấu hình.');
      configured.cloudflare.embeddingModel = embeddingModel.value;
      embeddingCurrent.textContent = `Đang dùng: ${embeddingModel.options[embeddingModel.selectedIndex]?.text || 'Chưa chọn'}`;
      setMessage(providerMsg, 'Đã lưu Provider & Model routing.', 'success'); showToast('Đã lưu cấu hình AI.', 'success');
    } catch (error) { setMessage(providerMsg, error instanceof Error ? error.message : 'Không thể lưu cấu hình.', 'error'); }
    finally { providerSave.disabled = false; }
  });

  providerTest.addEventListener('click', async () => {
    providerTest.disabled = true; setMessage(providerMsg, 'Đang kiểm tra model nền tảng...', 'muted');
    try {
      const response = await fetch('/api/admin/ai-test', { method: 'POST' }); const data = await response.json() as { model?: string; error?: string };
      if (!response.ok) throw new Error(data.error || 'Kiểm tra thất bại.');
      setMessage(providerMsg, `Kết nối thành công với ${data.model}.`, 'success');
    } catch (error) { setMessage(providerMsg, error instanceof Error ? error.message : 'Kiểm tra thất bại.', 'error'); }
    finally { providerTest.disabled = false; }
  });

  document.getElementById('embedding-save')?.addEventListener('click', async () => {
    if (!embeddingModel.value) { setMessage(knowledgeMsg, 'Chọn embedding model trước khi lưu.', 'error'); return; }
    setMessage(knowledgeMsg, 'Đang lưu embedding model...', 'muted');
    try {
      const response = await fetch('/api/admin/ai-settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ gateway_embedding_model: embeddingModel.value }) });
      const data = await response.json() as { error?: string }; if (!response.ok) throw new Error(data.error || 'Không thể lưu embedding model.');
      configured.cloudflare.embeddingModel = embeddingModel.value; embeddingCurrent.textContent = `Đang dùng: ${embeddingModel.options[embeddingModel.selectedIndex]?.text || embeddingModel.value}`;
      setMessage(knowledgeMsg, 'Đã lưu embedding model.', 'success'); showToast('Đã lưu embedding model.', 'success');
    } catch (error) { setMessage(knowledgeMsg, error instanceof Error ? error.message : 'Không thể lưu embedding model.', 'error'); }
  });

  document.getElementById('rebuild-knowledge-btn')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement; const original = button.innerHTML; button.disabled = true; button.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span>Đang xử lý';
    try {
      setMessage(knowledgeMsg, 'Đang chia nhỏ nội dung nguồn...', 'muted');
      const rebuild = await fetch('/api/admin/sync-website-content', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }); const rebuildData = await rebuild.json() as { chunks?: number; error?: string }; if (!rebuild.ok) throw new Error(rebuildData.error || 'Không thể xây dựng kho tri thức.');
      let remaining = rebuildData.chunks || 0; let embedded = 0;
      while (remaining > 0) { setMessage(knowledgeMsg, `Đang tạo embedding: ${embedded}/${rebuildData.chunks || 0} đoạn...`, 'muted'); const response = await fetch('/api/admin/sync-website-content-vectors', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ limit: 25 }) }); const data = await response.json() as { embedded?: number; remaining?: number; error?: string; errors?: string[] }; if (!response.ok || ((data.embedded || 0) === 0 && (data.remaining || 0) > 0)) throw new Error(data.error || data.errors?.[0] || 'Không thể tạo embedding.'); embedded += data.embedded || 0; remaining = data.remaining || 0; }
      setMessage(knowledgeMsg, `Hoàn tất: đã index ${rebuildData.chunks || 0} đoạn nội dung.`, 'success'); showToast('Đã xây dựng lại kho tri thức.', 'success');
    } catch (error) { setMessage(knowledgeMsg, error instanceof Error ? error.message : 'Không thể xây dựng kho tri thức.', 'error'); }
    finally { button.disabled = false; button.innerHTML = original; }
  });
</script>
