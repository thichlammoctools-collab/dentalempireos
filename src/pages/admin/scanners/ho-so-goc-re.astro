---
import { env } from 'cloudflare:workers';
import { getSurveyDefinitionBySlug } from '../../../lib/survey-config-db';

export const prerender = false;

// This legacy, slug-based URL must resolve the database ID before using the
// shared scanner editor. Scanner IDs are not guaranteed to match their slugs.
const definition = await getSurveyDefinitionBySlug(env.DB, 'ho-so-goc-re');

return Astro.redirect(
  definition ? `/admin/scanners/${definition.id}` : '/admin/scanners',
);
---
