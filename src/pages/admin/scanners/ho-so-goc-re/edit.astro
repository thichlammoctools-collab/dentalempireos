---
import { env } from 'cloudflare:workers';
import { getSurveyDefinitionBySlug } from '../../../../lib/survey-config-db';

export const prerender = false;

const definition = await getSurveyDefinitionBySlug(env.DB, 'ho-so-goc-re');

return Astro.redirect(
  definition ? `/admin/scanners/${definition.id}` : '/admin/scanners',
);
---
