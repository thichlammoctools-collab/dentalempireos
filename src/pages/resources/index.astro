---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listResources, countResources } from '../../lib/resource-db';
import { RESOURCE_CATEGORIES } from '../../lib/resource-types';
import { canAccessResource } from '../../lib/entitlement-check';
import ContentRedemptionButton from '../../components/credits/ContentRedemptionButton.astro';
import { getActiveCreditPricingRule } from '../../lib/credit-db';

export const prerender = false;

const db = env.DB;

const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(requestedPage) ? Math.max(1, requestedPage) : 1;
const perPage = 12;
const category = Astro.url.searchParams.get('cat') ?? '';
const search = Astro.url.searchParams.get('q') ?? '';

const [resources, total] = await Promise.all([
  listResources(db, { search: search || undefined, category: category || undefined, publicOnly: true, includeAssets: true }),
  countResources(db, { search: search || undefined, category: category || undefined, publicOnly: true }),
]);

const paginated = resources.slice((page - 1) * perPage, page * perPage);
const totalPages = Math.ceil(total / perPage);
const user = Astro.locals.user;
const accessByResourceId = new Map(
  await Promise.all(
    paginated.map(async (resource) => [
      resource.id,
      resource.access_mode !== 'credits' || await canAccessResource(db, user?.id, resource.id),
    ] as const),
  ),
);
const creditPriceByResourceId = new Map(
  await Promise.all(
    paginated
       .filter((resource) => resource.access_mode === 'credits' && !accessByResourceId.get(resource.id))
      .map(async (resource) => {
        const rule = await getActiveCreditPricingRule(db, 'resource', resource.id);
        const credits = rule?.credit_amount;
        return [resource.id, typeof credits === 'number' && Number.isSafeInteger(credits) && credits > 0 ? credits : null] as const;
      }),
  ),
);

const categories = [
  { value: '', label: 'Tất cả', count: total },
  ...RESOURCE_CATEGORIES.map((categoryOption) => ({ ...categoryOption, count: 0 })),
];

const extIcon: Record<string, string> = {
  pdf: 'picture_as_pdf',
  xlsx: 'table_chart',
  docx: 'article',
  mp4: 'play_circle',
};

function getIconExt(ext: string) {
  return extIcon[ext] ?? 'insert_drive_file';
}

function getFileIcon(icon: string, ext: string) {
  return icon !== 'description' ? icon : getIconExt(ext);
}

function getExtColor(ext: string) {
  const map: Record<string, string> = {
    pdf: '#ef4444',
    xlsx: '#22c55e',
    docx: '#3b82f6',
    mp4: '#a855f7',
  };
  return map[ext] ?? '#94a3b8';
}

function getTierColor(tier: string) {
  return tier === 'premium'
    ? 'bg-amber-500/10 border-amber-500/30 text-amber-400'
    : 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400';
}

function resourceUrl(fileUrl: string): string {
  if (!fileUrl) return '#';
  if (fileUrl.startsWith('/media/')) return fileUrl;
  if (fileUrl.startsWith('http://') || fileUrl.startsWith('https://')) return fileUrl;
  return `/media/${fileUrl}`;
}

function downloadableAssets(resource: typeof paginated[number]) {
  return resource.assets?.filter((asset) => asset.asset_role === 'download') ?? [];
}
---

<BaseLayout
  title="Tài Nguyên | Dental Empire OS"
  description="Kho tài nguyên miễn phí và hữu ích dành cho quản trị phòng khám nha khoa — mẫu form, checklist, biểu mẫu, và nhiều hơn nữa."
>
  <!-- Newsroom Hero -->
  <section class="px-6 max-w-[1200px] mx-auto pt-12 pb-8 lg:pt-16 lg:pb-10">
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_19rem] gap-6 md:gap-12 items-end border-b border-outline-variant/50 pb-8 lg:pb-10">
      <div>
        <div class="flex items-center gap-2 text-primary text-[11px] font-bold uppercase tracking-[0.14em]">
          <span class="w-6 h-px bg-primary"></span>
          Dental Empire Resource Library
        </div>
        <h1 class="mt-4 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[0.98] text-white">
          Tài nguyên cho<br class="hidden sm:block" />
          <span class="text-primary">phòng khám của bạn.</span>
        </h1>
      </div>
      <p class="text-sm text-on-surface-variant leading-relaxed max-w-xs md:pb-1">
        Mẫu form, checklist SOPs, bảng tính Excel và vật liệu marketing giúp vận hành phòng khám hiệu quả hơn.
      </p>
    </div>
  </section>

  <section class="px-6 max-w-[1200px] mx-auto pt-8 pb-8">
    <div class="rounded-2xl border border-primary/30 bg-primary/5 p-5 shadow-sm sm:p-6">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-2xl">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">Bắt đầu đúng thứ tự</p>
          <h2 class="mt-2 text-xl font-bold text-slate-900 dark:text-white">Chẩn đoán điểm nghẽn trước khi chọn tài nguyên.</h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-slate-600 dark:text-on-surface-variant">
            Total OS Diagnostic cho bạn điểm số 5 chiều, ưu tiên cải thiện và kế hoạch hành động. Sau đó, chọn đúng SOP, KPI hay template phù hợp với vấn đề của phòng khám.
          </p>
        </div>
        <a href="/scanner/total-os-diagnostic" data-track-cta="total_os_diagnostic" data-track-placement="resources_lead_magnet" class="inline-flex shrink-0 items-center gap-2 rounded-xl btn-primary-metallic px-4 py-2.5 text-sm font-bold transition active:scale-95">
          <span class="material-symbols-outlined text-[18px]">troubleshoot</span>
          Làm Diagnostic miễn phí
        </a>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="px-6 max-w-[1200px] mx-auto py-10">
    <div class="flex flex-col xl:flex-row gap-10">

      <!-- Left: Resource Grid -->
      <div class="flex-1 min-w-0">

        <!-- Category Filter -->
        <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-outline-variant/50">
          <h2 class="text-base font-bold text-white">Tài nguyên</h2>
          <div class="flex flex-wrap items-center justify-end gap-2">
            {categories.map((cat) => (
              <a
                href={cat.value ? `/resources?cat=${cat.value}` : '/resources'}
                class={`px-4 py-1.5 rounded-full text-xs font-bold border transition-all active:scale-95 ${category === cat.value ? 'bg-primary text-white border-primary' : 'bg-surface-container-high text-on-surface-variant border-outline-variant hover:border-primary'}`}
              >
                {cat.label}
                <span class="opacity-60 ml-1">({cat.count})</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Search result label -->
        {search && (
          <p class="text-sm text-on-surface-variant mb-4">
            Kết quả tìm kiếm cho "<strong class="text-white">{search}</strong>" — {total} tài nguyên
          </p>
        )}

        <!-- Resources Grid -->
        {paginated.length === 0 ? (
          <div class="text-center py-20 glass-card rounded-2xl">
            <span class="material-symbols-outlined text-6xl text-on-surface-variant/30">folder_off</span>
            <p class="text-on-surface-variant mt-4">Không có tài nguyên nào</p>
            <a href="/resources" class="inline-block mt-4 px-4 py-2 bg-primary text-white rounded-lg text-sm font-bold">Xem tất cả</a>
          </div>
        ) : (
          <>
            <div class="space-y-4">
              {paginated.map((res) => (
                <article class="glass-card rounded-2xl overflow-hidden hover:-translate-y-0.5 transition-all duration-300">
                  <div class="flex flex-col sm:flex-row sm:items-center gap-5 p-6 sm:p-7">
                    <!-- Icon -->
                    <div
                      class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0"
                      style={`background: ${getExtColor(res.file_ext)}22; border: 1px solid ${getExtColor(res.file_ext)}33;`}
                    >
                      <span
                        class="material-symbols-outlined text-xl"
                        style={`color: ${getExtColor(res.file_ext)}`}
                      >
                        {getFileIcon(res.icon, res.file_ext)}
                      </span>
                    </div>

                    <!-- Info -->
                    <div class="flex-1 min-w-0 space-y-1.5">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span
                          class={`inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-bold rounded-full border ${getTierColor(res.tier)}`}
                        >
                           {res.access_mode === 'credits' && !accessByResourceId.get(res.id) ? 'Cần mở khóa' : res.access_mode === 'credits' ? 'Đã mở khóa' : 'Miễn phí'}
                         </span>
                         <span class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant/50">
                           {downloadableAssets(res).map((asset) => `.${asset.file_ext.toUpperCase()}`).join(' · ') || `.${res.file_ext.toUpperCase()}`}
                         </span>
                        {res.tag && (
                          <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-surface-container-high text-on-surface-variant border border-outline-variant">
                            {res.tag}
                          </span>
                        )}
                      </div>
                      <h3 class="font-bold text-white text-sm leading-relaxed line-clamp-1">{res.title}</h3>
                      {res.description && (
                        <p class="text-xs leading-relaxed text-on-surface-variant line-clamp-1">{res.description}</p>
                      )}
                    </div>

                    <!-- Action -->
                    <div class="shrink-0 sm:w-auto">
                       {res.access_mode === 'credits' && !accessByResourceId.get(res.id) ? (
                         creditPriceByResourceId.get(res.id) ? (
                           <ContentRedemptionButton
                             contentType="resource"
                             contentId={res.id}
                             successUrl="/resources"
                             label={`Mở khóa · ${creditPriceByResourceId.get(res.id)} Credits`}
                             class="bg-amber-500 text-black hover:bg-amber-400"
                           />
                         ) : (
                           <span class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-outline-variant/50 text-xs font-semibold text-on-surface-variant" title="Tài liệu chưa được cấu hình giá Credits.">
                             <span class="material-symbols-outlined text-[18px]">schedule</span>
                             Sắp mở khóa
                           </span>
                         )
                       ) : downloadableAssets(res).length > 0 ? (
                         <div class="flex flex-wrap gap-2">
                           {downloadableAssets(res).map((asset) => (
                             <a
                               href={resourceUrl(asset.storage_key)}
                               target="_blank"
                               rel="noopener noreferrer"
                               data-track-cta={`resource_download_${res.id}_${asset.file_ext}`}
                               data-track-placement="resources_list"
                               class={`inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs transition-all active:scale-95 ${res.access_mode === 'credits' ? 'bg-amber-500 hover:bg-amber-400 text-black' : 'btn-primary-metallic'}`}
                             >
                               <span class="material-symbols-outlined text-[18px]">download</span>
                               {asset.file_ext.toUpperCase()}
                             </a>
                           ))}
                         </div>
                       ) : res.file_url ? (
                         <a href={resourceUrl(res.file_url)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm btn-primary-metallic">
                           <span class="material-symbols-outlined text-[18px]">download</span>Tải về
                         </a>
                       ) : (
                         <span class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-surface-container-high text-on-surface-variant cursor-not-allowed opacity-50">
                           <span class="material-symbols-outlined text-[18px]">download</span>Sắp ra mắt
                         </span>
                       )}
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <!-- Pagination -->
            {totalPages > 1 && (
              <div class="flex items-center justify-center gap-2 mt-10">
                {page > 1 && (
                  <a
                    href={`/resources?page=${page - 1}&cat=${category}&q=${search}`}
                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-surface-container-high border border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary transition-all active:scale-95"
                  >
                    <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                  </a>
                )}

                {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
                  const p = i + 1;
                  return (
                    <a
                      href={`/resources?page=${p}&cat=${category}&q=${search}`}
                      class={`w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold transition-all active:scale-95 ${p === page ? 'bg-primary text-white' : 'bg-surface-container-high border border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary'}`}
                    >
                      {p}
                    </a>
                  );
                })}

                {page < totalPages && (
                  <a
                    href={`/resources?page=${page + 1}&cat=${category}&q=${search}`}
                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-surface-container-high border border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary transition-all active:scale-95"
                  >
                    <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                  </a>
                )}
              </div>
            )}
          </>
        )}
      </div>

      <!-- Right: Sidebar -->
      <aside class="w-full xl:w-72 shrink-0 space-y-6">

        <!-- Search -->
        <div class="glass-card rounded-2xl p-5 border border-primary/20">
          <h3 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[18px]">search</span>
            Tìm tài nguyên
          </h3>
          <form method="get">
            {category && <input type="hidden" name="cat" value={category} />}
            <div class="relative">
              <input
                type="text"
                name="q"
                value={search}
                placeholder="Nhập từ khóa..."
                class="w-full pl-10 pr-9 py-2.5 bg-surface-container-high border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary focus:outline-none text-on-surface placeholder:text-on-surface-variant/60 text-sm"
              />
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
              {search && (
                <a href={category ? `/resources?cat=${category}` : '/resources'} class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-primary" aria-label="Xóa tìm kiếm">
                  <span class="material-symbols-outlined text-[18px]">close</span>
                </a>
              )}
            </div>
          </form>
        </div>

        <!-- Categories -->
        <div class="glass-card rounded-2xl p-5">
          <h3 class="text-sm font-bold text-white mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[18px]">folder_open</span>
            Danh mục
          </h3>
          <ul class="space-y-1">
            {categories.map((cat) => (
              <li>
                <a
                  href={cat.value ? `/resources?cat=${cat.value}` : '/resources'}
                  class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-sm transition-all ${category === cat.value ? 'bg-primary/10 text-primary font-semibold' : 'text-on-surface-variant hover:bg-surface-container-high hover:text-white'}`}
                >
                  <span>{cat.label}</span>
                  <span class="text-xs opacity-60">({cat.count})</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tier Guide -->
        <div class="glass-card rounded-2xl p-5 border border-primary/20">
          <h3 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[18px]">info</span>
            Giải thích
          </h3>
          <div class="space-y-2.5">
            <div class="grid grid-cols-[max-content_1fr] items-center gap-2.5 rounded-xl border border-emerald-500/15 bg-emerald-500/5 px-2.5 py-2">
              <span class="inline-flex min-w-[68px] items-center justify-center rounded-md border border-emerald-500/30 bg-emerald-500/10 px-2 py-1 text-[10px] font-black tracking-wide text-emerald-700 dark:text-emerald-300">Miễn phí</span>
              <p class="text-xs leading-4 text-slate-600 dark:text-on-surface-variant">Tải và sử dụng ngay, không cần đăng nhập.</p>
            </div>
            <div class="grid grid-cols-[max-content_1fr] items-center gap-2.5 rounded-xl border border-amber-500/15 bg-amber-500/5 px-2.5 py-2">
              <span class="inline-flex min-w-[68px] items-center justify-center rounded-md border border-amber-500/35 bg-amber-500/10 px-2 py-1 text-[10px] font-black tracking-wide text-amber-800 dark:text-amber-300">Premium</span>
               <p class="text-xs leading-4 text-slate-600 dark:text-on-surface-variant">Mở khóa một lần bằng Credits, sau đó tải lại miễn phí.</p>
            </div>
          </div>
        </div>

        <!-- Newsletter -->
        <div class="glass-card rounded-2xl p-5 border border-primary/20">
          <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[18px]">mail</span>
            Đăng ký nhận tin
          </h3>
          <p class="text-xs text-on-surface-variant mb-4">Nhận tài nguyên mới nhất mỗi tuần qua email.</p>
          <form id="resources-newsletter" class="space-y-2">
            <input
              type="email"
              name="email"
              placeholder="Email của bạn..."
              required
              class="w-full px-3 py-2.5 bg-surface-container-high border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary focus:outline-none placeholder:text-white/20 text-sm text-white"
            />
            <button type="submit" class="w-full py-2.5 btn-primary-metallic text-sm font-bold rounded-xl active:scale-95 transition-all">
              Đăng ký ngay
            </button>
          </form>
          <p id="newsletter-success" class="hidden text-xs text-green-400 mt-2 text-center">
            Đăng ký thành công! Vui lòng kiểm tra email.
          </p>
          <p id="newsletter-error" class="hidden text-xs text-red-400 mt-2 text-center" role="alert"></p>
        </div>
      </aside>
    </div>
  </section>

</BaseLayout>

<script>
  document.getElementById('resources-newsletter')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const error = document.getElementById('newsletter-error');
    const success = document.getElementById('newsletter-success');
    if (button) button.disabled = true;
    error?.classList.add('hidden');

    try {
      const response = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'resources_sidebar', ...window.dentalAnalytics?.getAttribution?.(), anonymous_id: window.dentalAnalytics?.getAnonymousId?.() }),
      });
      const data = await response.json().catch(() => ({})) as { success?: boolean; error?: string };
      if (!response.ok || !data.success) throw new Error(data.error || 'Không thể đăng ký lúc này. Vui lòng thử lại.');
      form.classList.add('hidden');
      success?.classList.remove('hidden');
    } catch (err) {
      if (error) {
        error.textContent = err instanceof Error ? err.message : 'Không thể đăng ký lúc này. Vui lòng thử lại.';
        error.classList.remove('hidden');
      }
      if (button) button.disabled = false;
    }
  });
</script>
