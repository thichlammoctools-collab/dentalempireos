---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { getSurveyDefinitionFullBySlug, parseLeadFields, parseUiTranslations, parseJSON } from '../../lib/survey-config-db';
import { getClinicProfile } from '../../lib/clinic-profile-db';
import { getScannerUsage } from '../../lib/scanner-history-db';
import { getActiveCreditPricingRule, getCreditBalance } from '../../lib/credit-db';

export const prerender = false;

const currentUser = Astro.locals.user;
const slugParam = Astro.params.slug;
const slug = slugParam ?? '';
const isGuestDiagnostic = slug === 'total-os-diagnostic';

// Only the designated lead magnet accepts guests. Every other Scanner keeps its
// existing member-only policy even if middleware is bypassed.
if (!currentUser && !isGuestDiagnostic) {
  return Astro.redirect('/login');
}

let full;
try {
  full = await getSurveyDefinitionFullBySlug(env.DB, slug);
} catch (err) {
  console.error('[scanner/slug] DB error:', err);
  return new Response('Database error: ' + String(err), { status: 500 });
}

if (!full) {
  return Astro.redirect('/scanner');
}

if (full.definition.status !== 'active') {
  return Astro.redirect('/scanner');
}

const { definition, sections } = full;

const pricingRule = await getActiveCreditPricingRule(env.DB, 'scanner', definition.id);
const scannerPrice = pricingRule?.credit_amount ?? 0;
const [usage, creditBalance] = currentUser
  ? await Promise.all([
      getScannerUsage(env.DB, currentUser.id, definition.id),
      getCreditBalance(env.DB, currentUser.id),
    ])
  : [{ remaining: 1, limit: 1 }, { available: 0 }];
const requiresCredits = !isGuestDiagnostic && usage.remaining === 0;
const scannerUnavailable = requiresCredits && (scannerPrice <= 0 || creditBalance.available < scannerPrice);
const scannerNotice = isGuestDiagnostic && !currentUser
  ? 'Hoàn tất chẩn đoán để nhận liên kết báo cáo riêng tư qua email.'
  : !requiresCredits
    ? `Bạn còn ${usage.remaining}/${usage.limit} lượt miễn phí cho Scanner này. Mỗi lượt bao gồm điểm số, Phân tích AI, Kế hoạch AI và PDF.`
    : scannerPrice <= 0
      ? 'Scanner này chưa được cấu hình giá Credits. Vui lòng liên hệ quản trị viên.'
      : scannerUnavailable
        ? `Lượt miễn phí đã dùng hết. Bạn cần ${scannerPrice} Credits để thực hiện lượt tiếp theo; số dư hiện tại là ${creditBalance.available} Credits.`
        : `3 lượt miễn phí đã dùng hết. Lượt này sẽ dùng ${scannerPrice} Credits; số dư hiện tại là ${creditBalance.available} Credits.`;

let clinicProfile: any = null;
try {
  if (currentUser) clinicProfile = await getClinicProfile(env.DB, currentUser.id);
} catch (err) {
  console.error('[scanner/slug] clinicProfile error:', err);
}

const surveyData = {
  id: definition.id,
  slug: definition.slug,
  is_free: definition.is_free,
  title_vi: definition.title_vi,
  title_en: definition.title_en || definition.title_vi,
  description_vi: definition.description_vi || '',
  description_en: definition.description_en || '',
  lead_fields: parseLeadFields(definition.lead_fields),
  translations_vi: parseUiTranslations(definition.translations_vi, 'vi'),
  translations_en: parseUiTranslations(definition.translations_en, 'en'),
  sections: sections.map((s) => ({
    id: s.id,
    title_vi: s.title_vi,
    title_en: s.title_en || s.title_vi,
    subtitle_vi: s.subtitle_vi || null,
    subtitle_en: s.subtitle_en || null,
    ref: s.ref || null,
    questions: s.questions.map((q) => ({
      id: q.id,
      question_id: q.question_id,
      type: q.type,
      label_vi: q.label_vi,
      label_en: q.label_en || q.label_vi,
      placeholder_vi: q.placeholder_vi || '',
      placeholder_en: q.placeholder_en || '',
      options_vi: parseJSON(q.options_vi, null),
      options_en: parseJSON(q.options_en, null),
      scale_labels_vi: parseJSON(q.scale_labels_vi, null),
      scale_labels_en: parseJSON(q.scale_labels_en, null),
      required: q.required || false,
      anchor: q.anchor || false,
    })),
  })),
};

// Default scale labels (used when survey doesn't define custom ones)
const defaultScaleVi: Record<string, string> = {
  '1': 'Chưa có',
  '2': 'Đang bắt đầu',
  '3': 'Đã có nhưng chưa ổn định',
  '4': 'Ổn định',
  '5': 'Đầu tàu và nhất quán',
};
const defaultScaleEn: Record<string, string> = {
  '1': 'None',
  '2': 'Starting',
  '3': 'Inconsistent',
  '4': 'Stable',
  '5': 'Exemplary',
};
---

<BaseLayout title={`${definition.title_vi} | Dental Empire OS`} description={definition.description_vi || undefined}>
  <section class="relative">
    <div
      class="absolute inset-x-0 top-0 h-[420px] pointer-events-none opacity-50"
      style="background: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.15), transparent 60%);"
    ></div>

    <div class="relative">
      <!-- PASS DATA VIA DATA ATTRIBUTES — no define:vars to avoid SSR truncation -->
      <div
        id="survey-form"
        class="survey-wrap"
        data-default-lang="vi"
        data-survey-id={surveyData.id}
        data-survey-slug={surveyData.slug}
        data-survey={JSON.stringify(surveyData)}
        data-clinic={clinicProfile || currentUser?.email ? JSON.stringify({
          ...(clinicProfile || {}),
          email: currentUser?.email,
        }) : ''}
        data-guest-report={isGuestDiagnostic && !currentUser ? 'true' : 'false'}
        data-scanner-unavailable={scannerUnavailable ? 'true' : 'false'}
        data-scale-vi={JSON.stringify(defaultScaleVi)}
        data-scale-en={JSON.stringify(defaultScaleEn)}
      >
        <div
          class:list={['scanner-quota-notice', scannerUnavailable && 'scanner-quota-notice--blocked']}
          role="status"
          data-notice-vi={scannerNotice}
          data-notice-en={!requiresCredits ? `${usage.remaining}/${usage.limit} free attempts remain for this Scanner. Each attempt includes scoring, AI analysis, an AI action plan, and a PDF.` : scannerPrice <= 0 ? 'This Scanner does not have a Credits price configured. Please contact an administrator.' : scannerUnavailable ? `Your free attempts are used. You need ${scannerPrice} Credits for the next attempt; your available balance is ${creditBalance.available} Credits.` : `Your free attempts are used. This attempt will use ${scannerPrice} Credits; your available balance is ${creditBalance.available} Credits.`}
        >
          <span class="material-symbols-outlined">{scannerUnavailable ? 'lock' : 'info'}</span>
          <div class="scanner-quota-notice__content">
            <strong class="scanner-quota-notice__title">{scannerNotice}</strong>
            {scannerUnavailable && scannerPrice > 0 && (
              <span class="scanner-quota-notice__hint">Nạp thêm Credits trong ví để tiếp tục.</span>
            )}
          </div>
          {scannerUnavailable && <a href={scannerPrice > 0 ? '/account/wallet' : '/account/scanner-history'}>{scannerPrice > 0 ? 'Mở ví Credits' : 'Xem lịch sử'}</a>}
        </div>

        {!scannerUnavailable && (
          <>
            <div class="lang-toggle">
              <button type="button" class="lang-btn active" data-lang="vi">Tiếng Việt</button>
              <button type="button" class="lang-btn" data-lang="en">English</button>
            </div>

            <!-- Stepper -->
            <div class="stepper">
              <div id="stepper-fill" class="stepper-fill"></div>
              <div id="step-labels" class="step-labels"></div>
            </div>

            <!-- Parts container -->
            <div id="parts-container"></div>

            <!-- Intro card -->
            <div id="card-intro" class="intro-card card">
              <div class="intro-top">
                <h1 class="intro-title">{definition.title_vi}</h1>
                <p class="intro-desc">{definition.description_vi}</p>
              </div>
              <div class="credit-reminder">
                <span class="material-symbols-outlined">campaign</span>
                {isGuestDiagnostic && !currentUser ? (
                  <p>Nhập tên, phòng khám và email để nhận liên kết báo cáo riêng tư. Email nhận báo cáo không đồng nghĩa với đăng ký nhận tin; bạn có thể chọn riêng ở bước gửi.</p>
                ) : (
                  <p
                    data-vi="Ba lượt đầu của mỗi Scanner được miễn phí, các lượt tiếp theo dùng Credits. Hãy nhập thông tin <strong>chính xác và đầy đủ</strong> nhất để nhận được kết quả hữu ích nhất."
                    data-en="The first three attempts for each Scanner are free; later attempts use Credits. Please provide the most <strong>accurate and complete</strong> information for the most useful result."
                  >
                    Ba lượt đầu của mỗi Scanner được miễn phí, các lượt tiếp theo dùng Credits. Hãy nhập thông tin <strong>chính xác và đầy đủ</strong> nhất để nhận được kết quả hữu ích nhất.
                  </p>
                )}
              </div>
              <div class="intro-info">
                <p id="intro-info-title" class="intro-info-title">Thông tin cơ bản</p>
              </div>
              <div id="intro-fields"></div>
              <button type="button" class="btn btn-primary intro-start-btn" id="btn-start">Bắt đầu →</button>
            </div>

            <!-- Sticky bottom nav (shows on section pages, always visible) -->
            <div id="sticky-nav" class="sticky-nav hidden">
              <div class="sticky-nav-center">
                <div class="sticky-nav-inner">
                  <button type="button" class="btn btn-ghost sticky-btn-back" id="sticky-btn-back">← <span class="sticky-btn-text-back">Quay lại</span></button>
                  <div class="sticky-progress">
                    <span id="sticky-step-label">1/2</span>
                    <div class="sticky-progress-bar"><div id="sticky-progress-fill" class="sticky-progress-fill"></div></div>
                  </div>
                  <button type="button" class="btn btn-primary sticky-btn-next" id="sticky-btn-next">Tiếp tục →</button>
                </div>
              </div>
            </div>

            <!-- Submit card -->
            <div id="card-submit" class="card submit-card hidden">
              <div class="submit-top">
                <p id="submit-title" class="submit-title">Sẵn sàng gửi?</p>
                <p id="submit-desc" class="submit-desc">Hệ thống sẽ lưu hồ sơ và bắt đầu phân tích...</p>
              </div>
              <div id="submit-fields"></div>
              <div class="flex gap-3 mt-4">
                <button type="button" class="btn btn-ghost" id="btn-back-submit">← Quay lại</button>
                <button type="button" class="btn btn-primary" id="btn-submit">
                  <span id="submit-btn-label">Gửi Hồ Sơ</span>
                </button>
              </div>
              <p id="submit-error" class="error-text hidden"></p>
            </div>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<!-- External script to avoid SSR stream truncation with inline <script> tags -->
  {!scannerUnavailable && <script src="/scripts/scanner-form-client.js?v=20260812-guest-report" is:inline></script>}

<style is:global>
  .survey-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 1rem 0 7rem;
  }
  .survey-wrap *,
  .sticky-nav * { box-sizing: border-box; }
  .scanner-quota-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-success) 35%, var(--color-outline-variant));
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-success-container) 72%, transparent);
    color: var(--color-success);
    font-size: 0.8rem;
  }
  .scanner-quota-notice--blocked { border-color: color-mix(in srgb, var(--color-warning) 45%, var(--color-outline-variant)); background: color-mix(in srgb, var(--color-warning-container) 76%, transparent); color: var(--color-warning); }
  .scanner-quota-notice .material-symbols-outlined { flex: 0 0 auto; margin-top: 0.1rem; font-size: 1rem; }
  .scanner-quota-notice__content { display: grid; gap: 0.2rem; min-width: 0; }
  .scanner-quota-notice__content strong { font-weight: 700; }
  .scanner-quota-notice__hint { color: var(--color-on-surface-variant); line-height: 1.45; }
  .scanner-quota-notice a { flex: 0 0 auto; align-self: center; margin-left: auto; color: inherit; font-weight: 700; text-decoration: underline; }
  .scanner-unlock-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin: 0 0 1rem;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-warning) 45%, var(--color-outline-variant));
    border-radius: 1rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-warning-container) 82%, var(--color-surface)), var(--color-surface-container));
  }
  .scanner-unlock-card__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-warning-container) 78%, transparent);
    color: var(--color-warning);
  }
  .scanner-unlock-card__content { min-width: 0; }
  .scanner-unlock-card__eyebrow { margin: 0 0 0.25rem; color: var(--color-warning); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .scanner-unlock-card h2 { margin: 0; color: var(--color-on-surface); font-size: 1rem; font-weight: 800; }
  .scanner-unlock-card__content > p:not(.scanner-unlock-card__eyebrow):not(.scanner-unlock-card__unavailable) { margin: 0.4rem 0 1rem; color: var(--color-on-surface-variant); font-size: 0.85rem; line-height: 1.5; }
  .scanner-unlock-card__steps { display: grid; gap: 0.4rem; margin: 0 0 1rem; padding-left: 1.25rem; color: var(--color-on-surface-variant); font-size: 0.8rem; line-height: 1.45; }
  .scanner-unlock-card__steps strong { color: var(--color-on-surface); }
  .scanner-unlock-card__unavailable { margin: 0.75rem 0 0; color: var(--color-warning); font-size: 0.8rem; }
  .credit-reminder {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-warning) 45%, var(--color-outline-variant));
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-warning-container) 76%, transparent);
    color: var(--color-on-surface-variant);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .credit-reminder .material-symbols-outlined { flex: 0 0 auto; margin-top: 0.1rem; font-size: 1rem; color: var(--color-warning); }
  .credit-reminder p { margin: 0; }
  .credit-reminder strong { color: var(--color-on-surface); }
  @media (max-width: 480px) {
    .scanner-unlock-card { gap: 0.75rem; padding: 1rem; }
    .scanner-unlock-card__icon { width: 2.25rem; height: 2.25rem; }
    .scanner-quota-notice { flex-wrap: wrap; }
    .scanner-quota-notice__content { flex: 1 1 14rem; }
    .scanner-quota-notice a { width: 100%; margin-left: 1.5rem; }
  }
  .lang-toggle {
    display: flex;
    justify-content: flex-end;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }
  .lang-toggle .lang-btn {
    padding: 0.35rem 0.85rem;
    border-radius: 2rem;
    border: 1px solid var(--color-outline-variant);
    background: transparent;
    color: var(--color-on-surface-variant);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .lang-toggle .lang-btn.active {
    background: rgba(245,158,11,0.15);
    color: var(--color-warning);
    border-color: color-mix(in srgb, var(--color-warning) 45%, var(--color-outline-variant));
  }
  .stepper {
    position: relative;
    height: 3px;
    background: var(--color-surface-container-highest);
    border-radius: 2px;
    margin-bottom: 1rem;
    overflow: visible;
  }
  .stepper-fill {
    height: 100%;
    background: linear-gradient(90deg, #f59e0b, #f97316);
    border-radius: 2px;
    transition: width 0.4s ease;
    width: 0%;
  }
  .step-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-size: 0.7rem;
    color: var(--color-on-surface-variant);
  }
  .step-labels span {
    transition: color 0.2s;
  }
  .step-labels span.active {
    color: #f59e0b;
    font-weight: 600;
  }
  .card {
    min-width: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-outline-variant);
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }
  .intro-card .intro-top { margin-bottom: 1.5rem; }
  .intro-card .intro-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 800;
    background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }
  .intro-card .intro-desc {
    color: var(--color-on-surface-variant);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .intro-info { margin: 1.25rem 0 0.75rem; }
  .premium-profile-summary {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    color: var(--color-on-surface-variant);
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.22);
    border-radius: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .premium-profile-summary .material-symbols-outlined { color: #60a5fa; font-size: 1.2rem; }
  .premium-profile-summary div { flex: 1; }
   .premium-profile-summary strong { color: var(--color-on-surface); }
  .premium-profile-summary p { margin: 0.15rem 0 0; }
   .premium-profile-summary .premium-profile-note { margin-top: 0.45rem; color: var(--color-on-surface-variant); }
   .premium-profile-summary a { color: var(--color-primary); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .intro-info-title {
    font-size: 0.75rem;
    font-weight: 600;
     color: var(--color-on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.05em;
     margin-bottom: 0.75rem;
   }
   .intro-start-btn { margin-top: 1.25rem; }
  .form-row { margin-bottom: 0.875rem; }
  .form-col { display: flex; flex-direction: column; gap: 0.3rem; }
  .form-label {
    font-size: 0.8rem;
    font-weight: 500;
     color: var(--color-on-surface);
  }
  .form-label .req { color: #ef4444; }
  .form-input {
    width: 100%;
    min-width: 0;
    padding: 0.6rem 0.75rem;
     background: var(--color-surface-container-lowest);
     border: 1px solid var(--color-outline-variant);
    border-radius: 0.5rem;
     color: var(--color-on-surface);
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .form-input:focus { border-color: #f59e0b; }
   .form-input::placeholder { color: var(--color-outline); }
  .form-textarea {
    width: 100%;
    min-width: 0;
    padding: 0.6rem 0.75rem;
     background: var(--color-surface-container-lowest);
     border: 1px solid var(--color-outline-variant);
    border-radius: 0.5rem;
     color: var(--color-on-surface);
    font-size: 0.875rem;
    outline: none;
    min-height: 100px;
    resize: vertical;
    transition: border-color 0.2s;
  }
  .form-textarea:focus { border-color: #f59e0b; }
   .form-textarea::placeholder { color: var(--color-outline); }
  .save-profile-row { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.7rem 1.5rem;
    border-radius: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }
  .btn-primary {
    background: linear-gradient(135deg, #f59e0b, #f97316);
    color: white;
  }
  .btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
  .btn-primary:active { transform: scale(0.98); }
  .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
  .btn-ghost {
    background: transparent;
     border: 1px solid var(--color-outline-variant);
     color: var(--color-on-surface-variant);
  }
   .btn-ghost:hover { background: var(--color-surface-container); }
  .part-header { margin-bottom: 1.25rem; }
  .part-ref {
    font-size: 0.75rem;
    color: var(--primary, #f59e0b);
    background: rgba(245,158,11,0.1);
    border: 1px solid rgba(245,158,11,0.2);
    border-radius: 0.35rem;
    padding: 0.25rem 0.6rem;
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .part-title {
    font-size: 1.15rem;
    font-weight: 700;
     color: var(--color-on-surface);
    margin-bottom: 0.3rem;
  }
   .part-subtitle { font-size: 0.8rem; color: var(--color-on-surface-variant); line-height: 1.5; }
  .question { margin-bottom: 1.25rem; min-width: 0; }
  .question.anchor { border-left: 3px solid #f59e0b; padding-left: 1rem; }
  .anchor-badge {
    display: inline-block;
    font-size: 0.7rem;
    color: #f59e0b;
    margin-bottom: 0.3rem;
  }
  .q-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
     color: var(--color-on-surface);
    margin-bottom: 0.6rem;
    line-height: 1.5;
  }
  .scale-group {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.45rem;
    width: 100%;
  }
  .scale-option { display: block; min-width: 0; cursor: pointer; }
  .scale-option input { display: none; }
  .scale-option .scale-pill {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    width: 100%;
    height: 100%;
    text-align: center;
     background: var(--color-surface-container-low);
     border: 1px solid var(--color-outline-variant);
    border-radius: 0.5rem;
