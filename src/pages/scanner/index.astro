---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listSurveyDefinitions } from '../../lib/survey-config-db';
import { getActiveProducts, type Product } from '../../lib/payos-db';
import { listProductEntitlements } from '../../lib/entitlement-db';
import PaymentButton from '../../components/PaymentButton.astro';

export const prerender = false;

let scanners: Awaited<ReturnType<typeof listSurveyDefinitions>> = [];
let scannerPackage: Product | null = null;
try {
  const [surveyDefinitions, products] = await Promise.all([
    listSurveyDefinitions(env.DB, { status: 'active' }),
    getActiveProducts(env.DB),
  ]);
  scanners = surveyDefinitions;
  const productsWithEntitlements = await Promise.all(products.map(async (product) => ({
    product,
    entitlements: await listProductEntitlements(env.DB, product.id),
  })));
  for (const { product, entitlements } of productsWithEntitlements) {
    const scannerEntitlements = entitlements.filter((item) => item.content_type === 'scanner');
    if (!scannerEntitlements.length) continue;

    const isScannerOnlyPackage = entitlements.every((item) => item.content_type === 'scanner');
    if (isScannerOnlyPackage && (!scannerPackage || product.price < scannerPackage.price)) {
      scannerPackage = product;
    }
  }
} catch {
  scanners = [];
}

const typeLabels: Record<string, string> = {
  mini: 'Mini',
  full: 'Full',
  checklist: 'Checklist',
};

const typeColors: Record<string, string> = {
  mini: 'bg-blue-500/20 text-blue-300 border-blue-500/30',
  full: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
  checklist: 'bg-amber-500/20 text-amber-300 border-amber-500/30',
};
---

<BaseLayout
  title="Máy quét Scanner — Tự chẩn đoán phòng khám | Dental Empire OS"
  description="Các công cụ scanner tự chẩn đoán theo framework Dental Empire OS. Tự đánh giá phòng khám và nhận phân tích AI từ chuyên gia."
>
  <section class="max-w-6xl mx-auto px-4 py-8 md:py-12">
    <header class="text-center mb-12">
      <p class="text-xs uppercase tracking-wider text-amber-500 font-bold mb-2">Công cụ Scanner</p>
      <h1 class="text-4xl md:text-5xl font-bold text-on-surface mb-4">
        Tự chẩn đoán phòng khám của bạn
      </h1>
      <p class="text-on-surface-variant max-w-2xl mx-auto text-lg">
        Mỗi scanner là một "máy quét" giúp bạn nhìn rõ điểm mạnh, điểm yếu và tiềm năng phát triển của phòng khám — theo framework ROOTS, SKY, S.T.A.R.S và Hệ thống sống.
      </p>
    </header>

    {scanners.length === 0 && (
      <div class="text-center py-16 glass-card rounded-2xl">
        <span class="material-symbols-outlined text-6xl text-on-surface-variant/30">fact_check</span>
        <p class="text-on-surface font-semibold mt-4">Chưa có scanner nào đang hoạt động</p>
      </div>
    )}

    {scannerPackage && (
      <section class="mb-12" aria-labelledby="scanner-package-title">
        <div class="rounded-2xl border border-primary/35 bg-primary/8 p-6 md:p-8 shadow-lg shadow-primary/10">
          <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div class="max-w-2xl">
              <p class="text-xs uppercase tracking-wider text-amber-400 font-bold mb-2">Quyền truy cập Scanner</p>
              <h2 id="scanner-package-title" class="text-2xl md:text-3xl font-bold text-on-surface">Mở khóa toàn bộ Scanner</h2>
              <p class="mt-2 text-sm md:text-base text-on-surface-variant">Một gói riêng cho Scanner, giúp bạn sử dụng toàn bộ các bài tự chẩn đoán và phân tích AI trong hệ thống.</p>
              <p class="mt-3 text-xs text-on-surface-variant/80">{scannerPackage.duration_days ? `Thời hạn truy cập: ${scannerPackage.duration_days} ngày` : 'Thời hạn truy cập: không giới hạn'}</p>
            </div>
            <div class="w-full md:w-72 shrink-0">
              <p class="text-2xl font-bold text-on-surface text-center mb-4">{scannerPackage.price.toLocaleString('vi-VN')}₫</p>
              <PaymentButton productId={scannerPackage.id} productName={scannerPackage.name} price={scannerPackage.price} class="w-full" />
            </div>
          </div>
        </div>
      </section>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {scanners.map((s) => (
        <a
          href={`/scanner/${s.slug}`}
          class="glass-card rounded-2xl p-6 border border-outline-variant/20 hover:border-primary/50 transition-all hover:-translate-y-0.5 group"
        >
          <div class="flex items-center justify-between mb-3">
            <span class={`inline-block px-2.5 py-0.5 rounded-md text-xs font-bold border ${typeColors[s.survey_type] ?? 'bg-gray-500/20 text-gray-300 border-gray-500/30'}`}>
              {typeLabels[s.survey_type] ?? s.survey_type}
            </span>
            {s.is_free === 1 ? (
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-400">
                <span class="material-symbols-outlined text-[14px]">verified</span>
                Miễn phí
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-400" title="Scanner này cần quyền truy cập từ một gói dịch vụ">
                <span class="material-symbols-outlined text-[14px]">lock</span>
                Cần mở khóa
              </span>
            )}
          </div>
          <h3 class="text-xl font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">
            {s.title_vi}
          </h3>
          <p class="text-sm text-on-surface-variant line-clamp-3 mb-4 min-h-[3.6em]">
            {s.description_vi ?? 'Khám phá điểm mạnh và tiềm năng phòng khám của bạn.'}
          </p>
          <div class="flex items-center justify-between">
            {s.subtitle_vi && (
              <p class="text-xs text-on-surface-variant/70 truncate">{s.subtitle_vi}</p>
            )}
            <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>
      ))}
    </div>

  </section>
</BaseLayout>
