---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listSurveyDefinitions } from '../../lib/survey-config-db';
import { getActiveProducts, type Product } from '../../lib/payos-db';
import { listProductEntitlements } from '../../lib/entitlement-db';
import PaymentButton from '../../components/PaymentButton.astro';

export const prerender = false;

let scanners: Awaited<ReturnType<typeof listSurveyDefinitions>> = [];
let scannerPackage: Product | null = null;
let productsWithEntitlements: Array<{ product: Product; entitlements: Awaited<ReturnType<typeof listProductEntitlements>> }> = [];
try {
  const [surveyDefinitions, products] = await Promise.all([
    listSurveyDefinitions(env.DB, { status: 'active' }),
    getActiveProducts(env.DB),
  ]);
  scanners = surveyDefinitions;
   productsWithEntitlements = await Promise.all(products.map(async (product) => ({
    product,
    entitlements: await listProductEntitlements(env.DB, product.id),
  })));
  for (const { product, entitlements } of productsWithEntitlements) {
     const isFullScannerPackage = entitlements.some((item) =>
       item.content_type === 'scanner' && item.content_id === '*',
     );
     if (isFullScannerPackage && (!scannerPackage || product.price < scannerPackage.price)) {
      scannerPackage = product;
    }
  }
} catch {
  scanners = [];
}

const typeLabels: Record<string, string> = {
  mini: 'Mini',
  full: 'Full',
  checklist: 'Checklist',
};

const typeColors: Record<string, string> = {
  mini: 'bg-blue-500/20 text-blue-300 border-blue-500/30',
  full: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
  checklist: 'bg-amber-500/20 text-amber-300 border-amber-500/30',
};

const scannerProducts = new Map<string, Product>();
for (const { product, entitlements } of productsWithEntitlements) {
  for (const entitlement of entitlements) {
    if (entitlement.content_type !== 'scanner') continue;
    if (entitlement.content_id !== '*' && scanners.some((scanner) => scanner.id === entitlement.content_id)) {
      const current = scannerProducts.get(entitlement.content_id);
      if (!current || product.price < current.price) scannerProducts.set(entitlement.content_id, product);
    }
  }
}

const freeScanners = scanners.filter((scanner) => scanner.is_free === 1);
const paidScanners = scanners.filter((scanner) => scanner.is_free !== 1);
---

<BaseLayout
  title="Máy quét Scanner — Tự chẩn đoán phòng khám | Dental Empire OS"
  description="Các công cụ scanner tự chẩn đoán theo framework Dental Empire OS. Tự đánh giá phòng khám và nhận phân tích AI từ chuyên gia."
>
  <section class="max-w-6xl mx-auto px-4 py-8 md:py-12">
    <header class="text-center mb-12">
      <p class="text-xs uppercase tracking-wider text-amber-500 font-bold mb-2">Công cụ Scanner</p>
      <h1 class="text-4xl md:text-5xl font-bold text-on-surface mb-4">
        Tự chẩn đoán phòng khám của bạn
      </h1>
      <p class="text-on-surface-variant max-w-2xl mx-auto text-lg">
        Mỗi scanner là một "máy quét" giúp bạn nhìn rõ điểm mạnh, điểm yếu và tiềm năng phát triển của phòng khám — theo framework ROOTS, SKY, S.T.A.R.S và Hệ thống sống.
      </p>
    </header>

    {scanners.length === 0 && (
      <div class="text-center py-16 glass-card rounded-2xl">
        <span class="material-symbols-outlined text-6xl text-on-surface-variant/30">fact_check</span>
        <p class="text-on-surface font-semibold mt-4">Chưa có scanner nào đang hoạt động</p>
      </div>
    )}

    <section class="mb-12" aria-labelledby="free-scanners-title">
      <div class="flex items-end justify-between gap-4 mb-5">
        <div>
          <p class="text-xs uppercase tracking-wider text-green-400 font-bold mb-2">Bắt đầu miễn phí</p>
          <h2 id="free-scanners-title" class="text-2xl md:text-3xl font-bold text-on-surface">Scanner miễn phí</h2>
          <p class="mt-2 text-sm text-on-surface-variant">Tự kiểm tra nhanh các điểm nền tảng trong phòng khám.</p>
        </div>
        <span class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-green-400">
          <span class="material-symbols-outlined text-[16px]">verified</span>
          {freeScanners.length} công cụ
        </span>
      </div>
      {freeScanners.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {freeScanners.map((s) => (
            <a
              href={`/scanner/${s.slug}`}
              class="glass-card rounded-2xl p-6 border border-green-500/25 hover:border-green-400/60 transition-all hover:-translate-y-0.5 group"
            >
              <div class="flex items-center justify-between mb-3">
                <span class={`inline-block px-2.5 py-0.5 rounded-md text-xs font-bold border ${typeColors[s.survey_type] ?? 'bg-gray-500/20 text-gray-300 border-gray-500/30'}`}>
                  {typeLabels[s.survey_type] ?? s.survey_type}
                </span>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-400">
                  <span class="material-symbols-outlined text-[14px]">verified</span>
                  Miễn phí
                </span>
              </div>
              <h3 class="text-xl font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">{s.title_vi}</h3>
              <p class="text-sm text-on-surface-variant line-clamp-3 mb-4 min-h-[3.6em]">
                {s.description_vi ?? 'Khám phá điểm mạnh và tiềm năng phòng khám của bạn.'}
              </p>
              <div class="flex items-center justify-between">
                <span class="text-xs text-green-400 font-semibold">Bắt đầu kiểm tra</span>
                <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">arrow_forward</span>
              </div>
            </a>
          ))}
        </div>
      ) : <p class="text-sm text-on-surface-variant">Hiện chưa có Scanner miễn phí.</p>}
    </section>

    <section aria-labelledby="paid-scanners-title">
      <div class="flex items-end justify-between gap-4 mb-5">
        <div>
          <p class="text-xs uppercase tracking-wider text-amber-400 font-bold mb-2">Phân tích chuyên sâu</p>
          <h2 id="paid-scanners-title" class="text-2xl md:text-3xl font-bold text-on-surface">Scanner trả phí</h2>
          <p class="mt-2 text-sm text-on-surface-variant">Các bài đánh giá chuyên sâu kèm phân tích AI theo framework Dental Empire OS.</p>
        </div>
        <span class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-amber-400">
          <span class="material-symbols-outlined text-[16px]">lock</span>
          {paidScanners.length} công cụ
        </span>
      </div>
      {scannerPackage && (
        <div class="mb-6 rounded-2xl border border-primary/35 bg-primary/8 p-6 md:p-8 shadow-lg shadow-primary/10">
          <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div class="max-w-2xl">
              <p class="text-xs uppercase tracking-wider text-amber-400 font-bold mb-2">Gói Scanner</p>
              <h3 class="text-xl md:text-2xl font-bold text-on-surface">Mở khóa toàn bộ Scanner trả phí</h3>
              <p class="mt-2 text-sm text-on-surface-variant">Sử dụng toàn bộ bài tự chẩn đoán chuyên sâu và phân tích AI trong hệ thống.</p>
              <p class="mt-3 text-xs text-on-surface-variant/80">{scannerPackage.duration_days ? `Thời hạn truy cập: ${scannerPackage.duration_days} ngày` : 'Thời hạn truy cập: không giới hạn'}</p>
            </div>
            <div class="w-full md:w-72 shrink-0">
              <p class="text-2xl font-bold text-on-surface text-center mb-4">{scannerPackage.price.toLocaleString('vi-VN')}₫</p>
              <PaymentButton productId={scannerPackage.id} productName={scannerPackage.name} price={scannerPackage.price} class="w-full" />
            </div>
          </div>
        </div>
      )}
      {paidScanners.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
           {paidScanners.map((s) => {
             const product = scannerProducts.get(s.id);
             return (
         <div
           class="glass-card rounded-2xl p-6 border border-outline-variant/20 hover:border-primary/50 transition-all hover:-translate-y-0.5 group"
         >
          <div class="flex items-center justify-between mb-3">
            <span class={`inline-block px-2.5 py-0.5 rounded-md text-xs font-bold border ${typeColors[s.survey_type] ?? 'bg-gray-500/20 text-gray-300 border-gray-500/30'}`}>
              {typeLabels[s.survey_type] ?? s.survey_type}
            </span>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-400" title="Scanner này cần quyền truy cập từ một gói dịch vụ">
              <span class="material-symbols-outlined text-[14px]">lock</span>
              Cần mở khóa
            </span>
          </div>
          <h3 class="text-xl font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">
            {s.title_vi}
          </h3>
          <p class="text-sm text-on-surface-variant line-clamp-3 mb-4 min-h-[3.6em]">
            {s.description_vi ?? 'Khám phá điểm mạnh và tiềm năng phòng khám của bạn.'}
          </p>
           <div class="flex items-center justify-between gap-3">
             {s.subtitle_vi && (
               <p class="text-xs text-on-surface-variant/70 truncate">{s.subtitle_vi}</p>
             )}
             <a href={`/scanner/${s.slug}`} class="text-xs text-primary font-semibold hover:underline">Xem Scanner</a>
           </div>
           {product && (
             <div class="mt-4 flex items-center justify-between gap-3 border-t border-outline-variant/15 pt-4">
               <span class="text-lg font-bold text-on-surface">{product.price.toLocaleString('vi-VN')}₫</span>
               <PaymentButton productId={product.id} productName={product.name} price={product.price} class="!w-auto px-5" />
             </div>
           )}
         </div>
             );
           })}
          ))}
        </div>
      ) : <p class="text-sm text-on-surface-variant">Hiện chưa có Scanner trả phí.</p>}
    </section>

  </section>
</BaseLayout>
