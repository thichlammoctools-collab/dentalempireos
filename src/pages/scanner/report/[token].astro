---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { getGuestReportByToken } from '../../../lib/scanner-guest-report';
import { getScannerResponse, isScannerResponseExpired, parseScores } from '../../../lib/scanner-response-db';
import { getSurveyDefinitionFull, parseScoringRules } from '../../../lib/survey-config-db';
import { getScoreLevel } from '../../../lib/scoring-engine';
import { GUEST_SCANNER_NEXT_STEPS, isGuestScannerSlug } from '../../../lib/guest-scanner';

export const prerender = false;

const token = Astro.params.token ?? '';
const report = await getGuestReportByToken(env.DB, token);
if (!report) return new Response('Liên kết báo cáo không hợp lệ hoặc đã hết hạn.', { status: 404 });
const response = await getScannerResponse(env.DB, report.response_id);
if (!response || !isGuestScannerSlug(response.survey_id)) return new Response('Không tìm thấy báo cáo.', { status: 404 });
if (isScannerResponseExpired(response)) return new Response('Báo cáo này đã hết thời hạn lưu trữ.', { status: 410 });
const full = await getSurveyDefinitionFull(env.DB, response.survey_id);
if (!full) return new Response('Không tìm thấy Scanner.', { status: 404 });
const lang = response.lang === 'en' ? 'en' : 'vi';
const scores = parseScores(response.scores_json);
const rules = parseScoringRules(full.definition.scoring_rules);
const normalizeScore = (score: number | undefined) => Math.min(100, Math.max(0, score ?? 0));
const total = normalizeScore(scores.total);
const level = getScoreLevel(total, rules ?? { dimensions: [], total_formula: 'average', thresholds: { excellent: 75, good: 55, needs_work: 35, critical: 0 } }, lang);
const dimensions = (rules?.dimensions ?? []).map((dimension) => ({
  name: lang === 'en' ? (dimension.name_en ?? dimension.name_vi ?? dimension.id) : (dimension.name_vi ?? dimension.id),
  score: normalizeScore(scores[dimension.id]),
}));
const memberResultUrl = `/scanner/result/${response.id}`;
const loginUrl = `/login?redirect=${encodeURIComponent(memberResultUrl)}`;
const nextStep = GUEST_SCANNER_NEXT_STEPS[response.survey_id];
const surveyTitle = lang === 'en' ? (full.definition.title_en || full.definition.title_vi) : full.definition.title_vi;
const expiryDate = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'vi-VN', {
  day: '2-digit', month: '2-digit', year: 'numeric',
}).format(new Date(report.expires_at));
---
<BaseLayout title={`${surveyTitle} | Dental Empire OS`} noindex={true}>
  <section class="guest-report">
    <p class="eyebrow">{surveyTitle}</p>
    <h1>{lang === 'vi' ? 'Kết quả Scanner của bạn' : 'Your Scanner result'}</h1>
    <p class="muted">{response.clinic_name}</p>
    <p class="retention-notice">{lang === 'vi' ? `Liên kết và dữ liệu khảo sát được lưu đến ${expiryDate}. Sau thời điểm này, báo cáo sẽ không còn truy cập được.` : `This link and survey data are stored until ${expiryDate}. After that, the report will no longer be available.`}</p>
    <div class="score-card">
      <span>{lang === 'vi' ? 'Điểm tổng quan' : 'Overall score'}</span>
      <strong>{Math.round(total)}</strong>
      <p>{level.label_vi}</p>
    </div>
    <h2>{lang === 'vi' ? 'Các trụ cột' : 'Dimensions'}</h2>
    <div class="dimensions">
      {dimensions.map((dimension) => <article><span>{dimension.name}</span><strong>{Math.round(dimension.score)}</strong></article>)}
    </div>
    <aside class="next-step" aria-labelledby="next-step-title">
      <p class="next-step__eyebrow">{nextStep.eyebrow}</p>
      <h2 id="next-step-title">{nextStep.title}</h2>
      <p>{nextStep.description}</p>
      <a href={nextStep.href} data-track-cta={`guest_next_${response.survey_id}`} data-track-placement="guest_report" class="next-step__cta">{nextStep.cta}</a>
    </aside>
    <aside class="member-upgrade" aria-labelledby="member-analysis-title">
      <p class="member-upgrade__eyebrow">{lang === 'vi' ? 'Dành cho thành viên' : 'For members'}</p>
      <h2 id="member-analysis-title">{lang === 'vi' ? 'Mở Bản soi chiếu hệ thống bằng AI' : 'Unlock the AI System Illumination'}</h2>
      <p>{lang === 'vi'
        ? 'Báo cáo miễn phí này gồm scorecard chẩn đoán. Phân tích AI, kế hoạch hành động và PDF là tính năng dành cho thành viên, theo quyền truy cập và Credits của tài khoản sau khi đăng nhập.'
        : 'This free report includes the diagnostic scorecard. AI analysis, the action plan, and PDF are member features subject to account access and Credits after sign-in.'}</p>
      <a href={loginUrl} class="member-upgrade__cta">
        {lang === 'vi' ? 'Đăng nhập để xem lựa chọn thành viên' : 'Sign in to view member options'}
      </a>
    </aside>
    <p class="notice">{lang === 'vi' ? 'Đây là báo cáo chẩn đoán ban đầu dựa trên câu trả lời của bạn, không phải tư vấn chuyên môn.' : 'This is an initial diagnostic based on your answers and is not professional advice.'}</p>
  </section>
</BaseLayout>
<style>
  .guest-report { max-width: 760px; margin: 0 auto; padding: 4rem 1rem 6rem; }
  .eyebrow { color: var(--color-primary); font-weight: 800; letter-spacing: .12em; font-size: .75rem; }
  h1 { margin-bottom: .25rem; } .muted, .notice { color: var(--color-on-surface-variant); }
  .retention-notice { margin-top: 1rem; padding: .75rem 1rem; border-left: 3px solid var(--color-primary); border-radius: .5rem; background: var(--color-surface-container); color: var(--color-on-surface-variant); font-size: .9rem; line-height: 1.55; }
  .score-card { display: grid; justify-items: center; gap: .35rem; margin: 2rem 0; padding: 2rem; border: 1px solid var(--color-outline-variant); border-radius: 1rem; background: var(--color-surface-container); }
  .score-card strong { font-size: 4rem; color: var(--color-primary); line-height: 1; }.score-card p { margin: 0; font-weight: 700; }
  .dimensions { display: grid; gap: .75rem; }.dimensions article { display: flex; justify-content: space-between; padding: 1rem; border-radius: .75rem; background: var(--color-surface-container); }.dimensions strong { color: var(--color-primary); }
  .next-step, .member-upgrade { margin-top: 2rem; padding: 1.5rem; border: 1px solid var(--color-primary); border-radius: 1rem; background: var(--color-surface-container); }
  .next-step__eyebrow, .member-upgrade__eyebrow { margin: 0; color: var(--color-primary); font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .next-step h2 { margin: .5rem 0; font-size: 1.25rem; }.next-step p:not(.next-step__eyebrow) { color: var(--color-on-surface-variant); line-height: 1.6; }
  .next-step__cta { display: inline-block; margin-top: .5rem; padding: .7rem 1rem; border-radius: .625rem; background: var(--color-primary); color: var(--color-on-primary); font-weight: 700; text-decoration: none; }
  .member-upgrade h2 { margin: .5rem 0; font-size: 1.25rem; }.member-upgrade p:not(.member-upgrade__eyebrow) { color: var(--color-on-surface-variant); line-height: 1.6; }
  .member-upgrade__cta { display: inline-block; margin-top: .5rem; padding: .7rem 1rem; border-radius: .625rem; background: var(--color-primary); color: var(--color-on-primary); font-weight: 700; text-decoration: none; }
  .notice { margin-top: 2rem; font-size: .85rem; }
</style>
