---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { renderSafeMarkdown } from '../../../lib/sanitize';
import {
  getSurveyDefinitionFull,
  parseAiConfig,
  parseScoringRules,
  parseScaleLabels,
} from '../../../lib/survey-config-db';
import {
  parseScores,
  parseResponses,
} from '../../../lib/scanner-response-db';
import { getScoreLevel } from '../../../lib/scoring-engine';
import { getChaptersByRefs, getChapterExcerpt } from '../../../lib/book-db';
import { getRetainedScannerResponseForOwner } from '../../../lib/scanner-history-db';
import { getClinicProfile } from '../../../lib/clinic-profile-db';
import { canAccessScanner } from '../../../lib/entitlement-check';
import { getScannerActionPlanForResponseForUser } from '../../../lib/scanner-action-plan-db';
import ActionPlanChecklist from '../../../components/scanner/ActionPlanChecklist.astro';

export const prerender = false;

const idParam = Astro.params.id;
const id = idParam ? parseInt(idParam, 10) : 0;

if (!id || Number.isNaN(id)) {
  return Astro.redirect('/');
}

// Auth check — require login (middleware already redirected, but double-check)
const currentUser = Astro.locals.user;
if (!currentUser) {
  return Astro.redirect(`/login?redirect=/scanner/result/${id}`);
}

// scanner_history is the canonical report owner. Do not use a matching email as
// authority for any raw Scanner report; this also keeps expired IDs unavailable.
const response = await getRetainedScannerResponseForOwner(env.DB, currentUser.id, id);
if (!response) {
  return new Response('Response not found', { status: 404 });
}

const full = await getSurveyDefinitionFull(env.DB, response.survey_id);
if (!full) {
  return new Response('Survey not found', { status: 404 });
}

const { definition } = full;
if (!(await canAccessScanner(env.DB, currentUser.id, definition.id))) {
  return Astro.redirect('/dich-vu');
}

const lang = (response.lang === 'en' ? 'en' : 'vi') as 'vi' | 'en';
const scoringRules = parseScoringRules(definition.scoring_rules);
const scannerAiConfig = parseAiConfig(definition.ai_config);
const reportTokenBudget = scannerAiConfig.max_tokens_override ?? 4096;

const scores = parseScores(response.scores_json);
// Older responses may contain scores produced from an empty/zero selection.
// Keep reports within the 0-100 scale while new submissions are normalized upstream.
const normalizeScore = (score: number | undefined) => Math.min(100, Math.max(0, score ?? 0));
const totalScore = normalizeScore(scores.total);

// Build dimension list with names
type DimRow = { id: string; name: string; score: number; level: ReturnType<typeof getScoreLevel> };
const dimensions: DimRow[] = [];
if (scoringRules) {
  for (const dim of scoringRules.dimensions) {
    const score = normalizeScore(scores[dim.id]);
    dimensions.push({
      id: dim.id,
      name: lang === 'vi' ? (dim.name_vi ?? dim.id) : (dim.name_en ?? dim.name_vi ?? dim.id),
      score,
      level: getScoreLevel(score, scoringRules, lang),
    });
  }
}

const totalLevel = getScoreLevel(totalScore, scoringRules ?? { dimensions: [], total_formula: 'average', thresholds: { excellent: 75, good: 55, needs_work: 35, critical: 0 } }, lang);

// Pre-render analysis and plan. AI output is untrusted and must be sanitized.
const analysisText = response.ai_analysis?.trim() ?? '';
const planText = response.ai_plan?.trim() ?? '';
const analysisHtml = analysisText ? renderSafeMarkdown(analysisText) : '';
const hasAnalysis = !!analysisHtml;
const hasPlan = !!planText;
const planHtml = planText ? renderSafeMarkdown(planText) : '';
const analysisImageUrl = response.image_analysis_key ? `/api/scanner/${id}/image?type=analysis` : null;
const planImageUrl = response.image_plan_key ? `/api/scanner/${id}/image?type=plan` : null;

// AI status (from DB, defaults to 'pending' for old responses)
const planStatus = (response as any).ai_plan_status ?? 'pending';
const analysisStatus = (response as any).ai_analysis_status ?? 'pending';

// ── Section 1: Strengths & Needs Work (computed server-side) ──────────────────
type InsightItem = { question: string; value: number; label: string; score: number };
const insights: { strengths: InsightItem[]; needsWork: InsightItem[] } = { strengths: [], needsWork: [] };

const parsedResponses = parseResponses(response.responses_json);
for (const section of full.sections) {
  for (const q of section.questions) {
    if (q.type === 'select') {
      const v = parsedResponses[q.question_id];
      if (typeof v === 'number') {
        const labels = parseScaleLabels(q.scale_labels_vi);
        const label = labels[String(v)] ?? String(v);
        const rawScore = (v / 5) * 100;
        if (v >= 4) {
          insights.strengths.push({ question: lang === 'vi' ? q.label_vi : (q.label_en ?? q.label_vi), value: v, label, score: rawScore });
        } else {
          insights.needsWork.push({ question: lang === 'vi' ? q.label_vi : (q.label_en ?? q.label_vi), value: v, label, score: rawScore });
        }
      }
    }
  }
}

// ── Section 2: Reading recommendations ───────────────────────────────────────
type ChapterRef = { chapter_no: number; title: string; id: string; excerpt: string | null };
const chapterRefs: ChapterRef[] = [];
if (definition.chapter_refs) {
  try {
    const refs: string[] = JSON.parse(definition.chapter_refs);
    const chapters = await getChaptersByRefs(env.DB, refs);
    for (const ch of chapters) {
      const excerpt = await getChapterExcerpt(env.DB, ch.id);
      chapterRefs.push({ chapter_no: ch.chapter_no, title: ch.title, id: ch.id, excerpt });
    }
  } catch { /* ignore */ }
}

const surveyTitle = lang === 'vi' ? definition.title_vi : (definition.title_en || definition.title_vi);
const clinicProfile = await getClinicProfile(env.DB, currentUser.id);
const reportDate = new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', {
  day: '2-digit', month: '2-digit', year: 'numeric',
}).format(new Date(response.created_at));
const expiryDate = new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', {
  day: '2-digit', month: '2-digit', year: 'numeric',
}).format(new Date(response.expires_at));
const retentionLabel = response.retention_tier === 'credit_paid'
  ? (lang === 'vi' ? 'Lượt dùng Credits · lưu 365 ngày' : 'Credit-paid attempt · stored for 365 days')
  : (lang === 'vi' ? 'Lượt miễn phí · lưu 30 ngày' : 'Free attempt · stored for 30 days');
const actionPlan = await getScannerActionPlanForResponseForUser(env.DB, id, currentUser.id);
const visibleActionPlan = actionPlan?.retention_visibility !== 'unavailable' ? actionPlan : null;
const editableActionPlan = visibleActionPlan?.retention_visibility === 'available' ? visibleActionPlan : null;
const rescanHref = editableActionPlan ? `/scanner/${definition.slug}?action_plan_id=${encodeURIComponent(editableActionPlan.id)}` : `/scanner/${definition.slug}`;

// Cross-sell suggestions: pick 2 other active surveys
let crossSells: Array<{ id: string; slug: string; title_vi: string; title_en: string; description_vi: string | null }> = [];
try {
  const result = await env.DB
    .prepare(
      `SELECT id, slug, title_vi, title_en, description_vi
       FROM "survey_definition"
       WHERE status = 'active' AND id != ?
       ORDER BY order_index ASC
       LIMIT 3`,
    )
    .bind(definition.id)
    .all<any>();
  crossSells = (result.results ?? []).map((r) => ({
    id: r.id,
    slug: r.slug,
    title_vi: r.title_vi,
    title_en: r.title_en || r.title_vi,
    description_vi: r.description_vi,
  }));
} catch {}
---

<BaseLayout
  title={`${surveyTitle} #${id} | Dental Empire OS`}
  description={lang === 'vi' ? 'Bản phân tích hệ thống quản trị phòng khám' : 'Clinic management analysis'}
  noindex={true}
>
  <section class="result-wrap" data-response-id={id} data-scanner-id={definition.id} data-lang={lang} data-survey-slug={definition.slug} data-plan-status={planStatus} data-analysis-status={analysisStatus} data-report-token-budget={reportTokenBudget}>
    <!-- Header -->
    <header class="report-hero">
      <div class="report-identity">
        <div class="clinic-mark" aria-hidden="true">
          {clinicProfile?.logo_url ? (
            <img src={clinicProfile.logo_url} alt="" />
          ) : (
            <span class="material-symbols-outlined">local_hospital</span>
          )}
        </div>
        <div class="report-identity-copy">
          <p class="report-kicker">{surveyTitle}</p>
          <h1 class="result-title">{response.clinic_name ?? (lang === 'vi' ? 'Phòng khám' : 'Clinic')}</h1>
          <div class="report-meta">
            {response.owner_name && <span><span class="material-symbols-outlined">person</span>{response.owner_name}</span>}
            {response.clinic_address && <span><span class="material-symbols-outlined">location_on</span>{response.clinic_address}</span>}
            <span><span class="material-symbols-outlined">calendar_today</span>{reportDate}</span>
            <span title={retentionLabel}><span class="material-symbols-outlined">schedule</span>{lang === 'vi' ? `Lưu đến ${expiryDate}` : `Stored until ${expiryDate}`}</span>
          </div>
        </div>
      </div>
      <div class="report-actions" aria-label={lang === 'vi' ? 'Thao tác báo cáo' : 'Report actions'}>
        {hasPlan && hasAnalysis && (
          <a href={`/api/scanner/${id}/pdf?type=combined`} class="btn btn-primary report-action-primary">
            <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
            <span>{lang === 'vi' ? 'Xuất báo cáo PDF' : 'Export PDF report'}</span>
          </a>
        )}
        <button type="button" id="btn-share" class="btn btn-ghost report-action-utility" aria-label={lang === 'vi' ? 'Chia sẻ báo cáo' : 'Share report'} title={lang === 'vi' ? 'Chia sẻ báo cáo' : 'Share report'}>
          <span class="material-symbols-outlined" aria-hidden="true">share</span>
          <span class="report-action-label">{lang === 'vi' ? 'Chia sẻ' : 'Share'}</span>
        </button>
        <a href={rescanHref} class="btn btn-ghost report-action-rescan">
          <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
          <span>{editableActionPlan ? (lang === 'vi' ? 'Quét lại để so sánh' : 'Rescan for comparison') : (lang === 'vi' ? 'Làm khảo sát mới' : 'New survey')}</span>
        </a>
        {visibleActionPlan && (
          <a href={`/account/action-plans/${visibleActionPlan.id}`} class="btn btn-ghost report-action-utility" aria-label={lang === 'vi' ? 'Kế hoạch hành động' : 'Action plan'} title={lang === 'vi' ? 'Kế hoạch hành động' : 'Action plan'}>
            <span class="material-symbols-outlined" aria-hidden="true">assignment</span>
            <span class="report-action-label">{lang === 'vi' ? 'Kế hoạch' : 'Plan'}</span>
          </a>
        )}
        <a href="/account/scanner-history" class="btn btn-ghost report-action-utility" aria-label={lang === 'vi' ? 'Lịch sử Scanner' : 'Scanner history'} title={lang === 'vi' ? 'Lịch sử Scanner' : 'Scanner history'}>
          <span class="material-symbols-outlined" aria-hidden="true">history</span>
          <span class="report-action-label">{lang === 'vi' ? 'Lịch sử' : 'History'}</span>
        </a>
      </div>
    </header>

    {visibleActionPlan?.retention_visibility === 'legacy_source_bound' && (
      <p class="report-context" role="status"><span class="material-symbols-outlined" aria-hidden="true">visibility</span><span>{lang === 'vi' ? 'Kế hoạch legacy đang ở chế độ chỉ xem trong thời gian kết quả nguồn còn được lưu. Không thể cập nhật việc hoặc tạo lần quét lại được liên kết.' : 'This legacy plan is read-only while its source result is retained. Action updates and linked rescans are unavailable.'}</span></p>
    )}

    <div class="card score-card">
      <div class="report-context">
        <span class="material-symbols-outlined">verified</span>
        <span>{lang === 'vi' ? 'Thông tin do bạn cung cấp trong lượt khảo sát này.' : 'Details supplied for this survey response.'}</span>
      </div>
      <div class="score-header">
        <div>
          <p class="text-xs uppercase tracking-wider text-on-surface-variant font-bold">
            {lang === 'vi' ? 'Điểm tổng hợp' : 'Overall Score'}
          </p>
          <div class="score-total">
            <span class="score-num" style={`color: ${totalLevel.color}`}>{totalScore}</span>
            <span class="score-suffix">/100</span>
          </div>
          <p class="text-sm font-semibold" style={`color: ${totalLevel.color}`}>{totalLevel.label_vi}</p>
        </div>
        <div class="score-summary">
          {lang === 'vi' ? (
            <p>
              {totalScore < 40
                ? 'Phòng khám đang ở giai đoạn sơ khai — đây là thời điểm tốt để soi chiếu.'
                : totalScore < 70
                ? 'Phòng khám đang hình thành — tiếp tục đào sâu để vững mạnh.'
                : 'Phòng khám đang trưởng thành — giữ vững momentum và lan tỏa giá trị.'}
            </p>
          ) : (
            <p>
              {totalScore < 40
                ? 'Your clinic is in the early stage — this is a good time to illuminate and deepen.'
                : totalScore < 70
                ? 'Your clinic is forming — keep deepening to grow strong.'
                : 'Your clinic is maturing — keep the momentum and spread the value.'}
            </p>
          )}
        </div>
      </div>

      <div class="score-bars">
        {dimensions.map((p) => (
          <div class="bar-item">
            <div class="bar-label">
              <span class="bar-name">{p.name}</span>
              <span class="bar-value" style={`color: ${p.level.color}`}>
                {p.score} <span class="bar-level">· {lang === 'vi' ? p.level.label_vi : p.level.label_en}</span>
              </span>
            </div>
            <div class="bar-track">
              <div class="bar-fill" style={`width: ${p.score}%; background: ${p.level.color}`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {insights.strengths.length > 0 || insights.needsWork.length > 0 ? (
      <div class="card insight-card">
        <div class="insight-header">
          <span class="material-symbols-outlined text-amber-400 text-xl">lightbulb</span>
          <h2 class="insight-title">
            {lang === 'vi' ? 'Điểm này có ý nghĩa gì?' : 'What does this score mean?'}
          </h2>
        </div>
        {insights.strengths.length > 0 && (
          <div class="insight-section">
            <p class="insight-section-label success">
              <span class="material-symbols-outlined text-sm">thumb_up</span>
              {lang === 'vi' ? 'Điểm mạnh' : 'Strengths'}
            </p>
            <div class="insight-items">
              {insights.strengths.map((item) => (
                <div class="insight-item insight-item--success">
                  <div class="insight-item-header">
                    <span class="insight-question">{item.question}</span>
                    <span class="insight-badge success-badge">
                      {item.value}/5 — {item.label}
                    </span>
                  </div>
                  <div class="insight-bar-track">
                    <div class="insight-bar-fill" style={`width:${item.score}%;background:#22c55e`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
        {insights.needsWork.length > 0 && (
          <div class="insight-section">
            <p class="insight-section-label warning">
              <span class="material-symbols-outlined text-sm">construction</span>
              {lang === 'vi' ? 'Cần cải thiện' : 'Needs improvement'}
            </p>
            <div class="insight-items">
              {insights.needsWork.map((item) => (
                <div class="insight-item insight-item--warning">
                  <div class="insight-item-header">
                    <span class="insight-question">{item.question}</span>
                    <span class="insight-badge warning-badge">
                      {item.value}/5 — {item.label}
                    </span>
                  </div>
                  <div class="insight-bar-track">
                    <div class="insight-bar-fill" style={`width:${item.score}%;background:#f59e0b`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    ) : null}

    {chapterRefs.length > 0 && (
      <div class="card reading-card">
        <div class="insight-header">
          <span class="material-symbols-outlined text-amber-400 text-xl">menu_book</span>
          <h2 class="insight-title">
            {lang === 'vi' ? 'Nên đọc thêm' : 'Recommended reading'}
          </h2>
        </div>
        <div class="reading-list">
          {chapterRefs.map((ch) => (
            <a href={`/book/${ch.id}`} class="reading-item">
              <div class="reading-meta">
                <span class="reading-tag">Ch.{ch.chapter_no}</span>
                <h3 class="reading-title">{ch.title}</h3>
              </div>
              {ch.excerpt && <p class="reading-excerpt">{ch.excerpt}</p>}
              <div class="reading-cta">
                <span class="reading-link">
                  {lang === 'vi' ? 'Đọc chương này' : 'Read this chapter'}
                  <span class="material-symbols-outlined text-base">arrow_forward</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="card plan-card" id="plan-section">
      <div class="report-section-header">
        <div class="report-section-heading">
          <span class="material-symbols-outlined report-section-icon">calendar_month</span>
          <div>
            <p class="report-section-eyebrow">{lang === 'vi' ? 'AI chuyển phát hiện thành hành động' : 'AI turns findings into action'}</p>
            <h2 class="insight-title">{lang === 'vi' ? 'Kế hoạch 30 ngày' : '30-day action plan'}</h2>
          </div>
        </div>
        <span id="plan-status-chip" class:list={["ai-status-chip", { "is-ready": hasPlan, "is-working": !hasPlan && (planStatus === 'queued' || planStatus === 'running') }]}>
          <span class="material-symbols-outlined">{hasPlan ? 'check_circle' : planStatus === 'queued' || planStatus === 'running' ? 'sync' : hasAnalysis ? 'auto_awesome' : 'schedule'}</span>
          <span id="plan-status-chip-label">{hasPlan
            ? (lang === 'vi' ? 'Đã sẵn sàng' : 'Ready')
            : planStatus === 'queued' || planStatus === 'running'
              ? (lang === 'vi' ? 'AI đang làm việc' : 'AI working')
              : hasAnalysis
                ? planStatus === 'failed'
                  ? (lang === 'vi' ? 'Cần thử lại' : 'Retry needed')
                  : (lang === 'vi' ? 'Sẵn sàng lập kế hoạch' : 'Ready to build plan')
                : (lang === 'vi' ? 'Chờ bản soi chiếu' : 'Awaiting analysis')}</span>
        </span>
      </div>
      {!hasPlan && (
        <p class="report-section-description">
          {lang === 'vi' ? 'Một lộ trình ưu tiên, rõ người phụ trách và nhịp kiểm tra để đội ngũ bắt đầu ngay.' : 'A prioritized roadmap with ownership and review cadence so your team can begin immediately.'}
        </p>
      )}

      <!-- Done: show content -->
      {hasPlan ? (
        <>
          <div class="plan-tools" aria-label={lang === 'vi' ? 'Công cụ kế hoạch' : 'Plan tools'}>
            <button type="button" class="btn btn-ghost plan-tool-button" id="btn-copy-plan">
              <span class="material-symbols-outlined text-base">content_copy</span>
              {lang === 'vi' ? 'Sao chép tất cả' : 'Copy All'}
            </button>
            <a href={`/api/scanner/${id}/pdf?type=plan`} class="btn btn-primary plan-tool-button">
              <span class="material-symbols-outlined text-base">picture_as_pdf</span>
              {lang === 'vi' ? 'Tải PDF kế hoạch' : 'Download plan PDF'}
            </a>
          </div>
             <div class="plan-document-meta">
              <span class="material-symbols-outlined">assignment_turned_in</span>
              <span>{lang === 'vi' ? 'Bản giao việc 30 ngày - sẵn sàng chia sẻ với đội ngũ' : '30-day team action document - ready to share'}</span>
             </div>
             {planImageUrl && (
               <figure class="report-image">
                 <img src={planImageUrl} alt={lang === 'vi' ? 'Minh họa kế hoạch hành động AI' : 'AI action plan illustration'} />
               </figure>
             )}
             <article class="prose-content plan-content" id="plan-content" set:html={planHtml}></article>
          <template id="plan-copy-source">{planText}</template>
        </>
      ) : (
          <div id="plan-action">
            <div id="plan-loading" class="hidden ai-workspace" aria-live="polite">
              <div class="ai-workspace-heading">
                <span class="material-symbols-outlined ai-pulse-icon">auto_awesome</span>
                <div>
                  <p class="ai-workspace-label">{lang === 'vi' ? 'AI đang xây kế hoạch riêng cho phòng khám của bạn' : 'AI is building a plan tailored to your clinic'}</p>
                  <div id="plan-status" class="ai-workspace-status">
                    {lang === 'vi' ? 'Đang tạo kế hoạch 30 ngày...' : 'Generating your 30-day plan...'}
                  </div>
                </div>
              </div>
              <ol class="ai-workflow" aria-label={lang === 'vi' ? 'Tiến trình lập kế hoạch AI' : 'AI planning progress'}>
                <li data-ai-stage="source"><span class="material-symbols-outlined">check_circle</span>{lang === 'vi' ? 'Đọc các điểm nghẽn đã phát hiện' : 'Review identified bottlenecks'}</li>
                <li data-ai-stage="priority"><span class="material-symbols-outlined">radio_button_unchecked</span>{lang === 'vi' ? 'Sắp xếp ưu tiên theo tác động' : 'Prioritize by impact'}</li>
                <li data-ai-stage="plan"><span class="material-symbols-outlined">radio_button_unchecked</span>{lang === 'vi' ? 'Phân kỳ hành động theo từng tuần' : 'Sequence actions by week'}</li>
              </ol>
              <p id="plan-elapsed" class="ai-elapsed"></p>
              <pre id="plan-stream" class="ai-stream-preview prose-content-sm whitespace-pre-wrap text-sm text-on-surface-variant max-h-96 overflow-y-auto"></pre>
              <div class="ai-workspace-footer">
                <span class="material-symbols-outlined">cloud_done</span>
                <p>{lang === 'vi' ? 'Bạn có thể rời trang — kết quả được lưu tự động và sẽ có thông báo khi hoàn tất.' : 'You can leave this page — your result is saved automatically and you will be notified when it is ready.'}</p>
              </div>
              <div class="text-center mt-3">
                <button type="button" class="btn btn-ghost btn-retry" id="btn-retry-running-plan">
                  {lang === 'vi' ? 'Tạo lại kế hoạch' : 'Generate again'}
                </button>
              </div>
            </div>
          <div id="plan-cta" class:list={{ 'hidden': !hasAnalysis }}>
            <div class="ai-action-intro">
              <span class="material-symbols-outlined">auto_awesome</span>
              <p>{lang === 'vi' ? 'AI sẽ biến Bản soi chiếu thành các việc cần làm theo tuần, có thứ tự ưu tiên rõ ràng.' : 'AI will turn your analysis into weekly actions with a clear priority order.'}</p>
            </div>
            <button type="button" class="btn btn-amber btn-run" id="btn-run-plan">
              <span class="material-symbols-outlined text-base">auto_awesome</span>
              {lang === 'vi' ? 'Tạo kế hoạch 30 ngày với AI' : 'Create the 30-day plan with AI'}
            </button>
          </div>
          {!hasAnalysis && (
            <div class="report-locked-state">
              <span class="material-symbols-outlined">lock</span>
              <p>{lang === 'vi' ? 'AI sẽ mở phần này ngay khi Bản soi chiếu hoàn tất, để chuyển phát hiện thành hành động cụ thể.' : 'AI will unlock this once the System Illumination is complete, turning findings into specific action.'}</p>
            </div>
          )}
          <div id="plan-error" class="text-center py-4 hidden">
            <p class="text-sm text-red-400 mb-3">{lang === 'vi' ? 'Có lỗi xảy ra.' : 'An error occurred.'}</p>
            <button type="button" class="btn btn-ghost btn-retry" id="btn-retry-plan">
              {lang === 'vi' ? 'Thử lại' : 'Retry'}
            </button>
          </div>
        </div>
      )}
    </div>

    {visibleActionPlan && (
      <ActionPlanChecklist planId={visibleActionPlan.id} compact={true} readOnly={visibleActionPlan.retention_visibility === 'legacy_source_bound'} />
    )}

    <div class="card analysis-card" id="analysis-section">
      <div class="report-section-header">
        <div class="report-section-heading">
          <span class="material-symbols-outlined report-section-icon">psychology</span>
          <div>
            <p class="report-section-eyebrow">{lang === 'vi' ? 'Phân tích AI' : 'AI Analysis'}</p>
            <h2 class="analysis-title">{lang === 'vi' ? 'Bản soi chiếu hệ thống' : 'System Illumination'}</h2>
          </div>
        </div>
        <span class:list={["ai-status-chip", { "is-ready": hasAnalysis, "is-working": !hasAnalysis && (analysisStatus === 'queued' || analysisStatus === 'running') }]}>
          <span class="material-symbols-outlined">{hasAnalysis ? 'check_circle' : analysisStatus === 'queued' || analysisStatus === 'running' ? 'sync' : 'insights'}</span>
          {hasAnalysis
            ? (lang === 'vi' ? 'Đã phân tích' : 'Analyzed')
            : analysisStatus === 'queued' || analysisStatus === 'running'
              ? (lang === 'vi' ? 'AI đang làm việc' : 'AI working')
              : (lang === 'vi' ? 'Sẵn sàng phân tích' : 'Ready to analyze')}
        </span>
      </div>
      {!hasAnalysis && (
        <p class="report-section-description">
          {lang === 'vi' ? 'AI đối chiếu điểm số, câu trả lời và các mối liên hệ giữa các vận hành để chỉ ra điểm cần ưu tiên.' : 'AI compares your scores, answers, and operational connections to identify the priority areas.'}
        </p>
      )}

      <div id="analysis-unlocked">
        {hasAnalysis ? (
          <>
            <div class="analysis-tools">
              <button type="button" class="btn btn-ghost plan-tool-button" id="btn-copy-analysis">
                <span class="material-symbols-outlined text-base">content_copy</span>
                {lang === 'vi' ? 'Sao chép tất cả' : 'Copy All'}
              </button>
              <a href={`/api/scanner/${id}/pdf?type=analysis`} class="btn btn-primary plan-tool-button">
                <span class="material-symbols-outlined text-base">picture_as_pdf</span>
                {lang === 'vi' ? 'Tải PDF soi chiếu' : 'Download analysis PDF'}
              </a>
            </div>
            {analysisImageUrl && (
              <figure class="report-image">
                <img src={analysisImageUrl} alt={lang === 'vi' ? 'Minh họa bản soi chiếu hệ thống AI' : 'AI system analysis illustration'} />
              </figure>
            )}
            <article class="prose-content" set:html={analysisHtml}></article>
            <template id="analysis-copy-source">{analysisText}</template>
          </>
        ) : (
          <div id="analysis-action">
            <div id="analysis-loading" class="hidden ai-workspace" aria-live="polite">
              <div class="ai-workspace-heading">
                <span class="material-symbols-outlined ai-pulse-icon">psychology</span>
                <div>
                  <p class="ai-workspace-label">{lang === 'vi' ? 'AI đang soi chiếu hệ thống vận hành của bạn' : 'AI is examining your operating system'}</p>
                  <div id="analysis-status" class="ai-workspace-status"></div>
                </div>
              </div>
              <ol class="ai-workflow" aria-label={lang === 'vi' ? 'Tiến trình phân tích AI' : 'AI analysis progress'}>
                <li data-ai-stage="source"><span class="material-symbols-outlined">check_circle</span>{lang === 'vi' ? 'Đọc điểm số và câu trả lời Scanner' : 'Review Scanner scores and answers'}</li>
                <li data-ai-stage="pattern"><span class="material-symbols-outlined">radio_button_unchecked</span>{lang === 'vi' ? 'Tìm mối liên hệ giữa các điểm nghẽn' : 'Find connections between bottlenecks'}</li>
                <li data-ai-stage="insight"><span class="material-symbols-outlined">radio_button_unchecked</span>{lang === 'vi' ? 'Viết nhận định và ưu tiên hệ thống' : 'Write system insights and priorities'}</li>
              </ol>
              <p id="analysis-elapsed" class="ai-elapsed"></p>
              <pre id="analysis-stream" class="ai-stream-preview prose-content-sm whitespace-pre-wrap text-sm text-on-surface-variant max-h-96 overflow-y-auto"></pre>
              <div class="ai-workspace-footer">
                <span class="material-symbols-outlined">cloud_done</span>
                <p>{lang === 'vi' ? 'Bạn có thể rời trang — AI tiếp tục làm việc, kết quả được lưu và gửi thông báo khi sẵn sàng.' : 'You can leave this page — AI continues working, and your result is saved with a notification when ready.'}</p>
              </div>
            </div>
            <div id="analysis-cta" class="text-center">
              <div class="ai-action-intro">
                <span class="material-symbols-outlined">insights</span>
                <p>{lang === 'vi' ? 'Không chỉ tóm tắt điểm số: AI tìm ra điểm nghẽn có ảnh hưởng lớn nhất đến toàn hệ thống.' : 'More than a score summary: AI identifies the bottlenecks with the greatest system-wide impact.'}</p>
              </div>
              <button type="button" class="btn btn-amber btn-run" id="btn-run-analysis">
                <span class="material-symbols-outlined text-base">auto_awesome</span>
                {lang === 'vi' ? 'Để AI soi chiếu hệ thống' : 'Let AI examine the system'}
              </button>
            </div>
            <div id="analysis-error" class="text-center py-4 hidden">
              <p class="text-sm text-red-400 mb-3">{lang === 'vi' ? 'Có lỗi xảy ra.' : 'An error occurred.'}</p>
              <button type="button" class="btn btn-ghost btn-retry" id="btn-retry-analysis">
                {lang === 'vi' ? 'Thử lại' : 'Retry'}
              </button>
            </div>
          </div>
        )}
      </div>

    </div>

    <!-- Cross-sell (other scanners) -->
    {crossSells.length > 0 && (
      <div class="card cross-sell-card">
        <h3 class="cross-sell-title">
          {lang === 'vi' ? 'Khám phá thêm các máy quét khác' : 'Explore other scanners'}
        </h3>
        <div class="cross-sell-grid">
          {crossSells.map((s) => (
            <a href={`/scanner/${s.slug}`} class="cross-sell-item">
              <span class="material-symbols-outlined text-primary text-2xl">fact_check</span>
              <div>
                <p class="text-sm font-semibold text-on-surface">{lang === 'vi' ? s.title_vi : s.title_en}</p>
                {s.description_vi && <p class="text-xs text-on-surface-variant line-clamp-2 mt-0.5">{s.description_vi}</p>}
              </div>
              <span class="material-symbols-outlined text-on-surface-variant/50">arrow_forward</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>

  <dialog id="report-confirm-dialog" class="report-confirm-dialog">
    <form method="dialog" class="report-confirm-content">
      <button type="submit" class="report-confirm-close" aria-label="Đóng">×</button>
      <span class="material-symbols-outlined report-confirm-icon">auto_awesome</span>
      <p class="report-confirm-eyebrow">AI REPORT</p>
      <h2 id="report-confirm-title"></h2>
      <p id="report-confirm-description"></p>
      <div class="report-confirm-cost">
        <span class="material-symbols-outlined">token</span>
        <span id="report-confirm-tokens"></span>
      </div>
      <p class="report-confirm-note">{lang === 'vi' ? 'Chỉ bắt đầu khi bạn đồng ý. Báo cáo được lưu tự động sau khi hoàn tất.' : 'Generation starts only after confirmation. Your report is saved automatically when complete.'}</p>
      <div class="report-confirm-actions">
        <button type="submit" class="btn btn-ghost">{lang === 'vi' ? 'Hủy' : 'Cancel'}</button>
        <button type="button" id="report-confirm-accept" class="btn btn-amber">{lang === 'vi' ? 'Đồng ý và tạo' : 'Accept and generate'}</button>
      </div>
    </form>
  </dialog>

</BaseLayout>

