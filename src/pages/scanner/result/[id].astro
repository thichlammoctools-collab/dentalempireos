<script>
  const wrap = document.querySelector('.result-wrap') as HTMLElement;
  const responseId = wrap?.dataset.responseId;
  const lang = (wrap?.dataset.lang ?? 'vi') as 'vi' | 'en';
  const planStatusInit = wrap?.dataset.planStatus ?? 'pending';
  const analysisStatusInit = wrap?.dataset.analysisStatus ?? 'pending';

  // ── Polling ───────────────────────────────────────────────────────
  let pollInterval: ReturnType<typeof setInterval> | null = null;
  const activeGenerations = new Set<string>();

  function pollForResult() {
    if (pollInterval) return;
    let attempts = 0;
    pollInterval = setInterval(async () => {
      attempts++;
      try {
        const res = await fetch(`/api/scanner/${responseId}`, { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json() as {
          ai_analysis?: string | null;
          ai_plan?: string | null;
          ai_analysis_status?: string;
          ai_plan_status?: string;
        };
        const planDone = data.ai_plan_status !== 'running';
        const analysisDone = data.ai_analysis_status !== 'running';
        if (planDone && analysisDone) {
          clearInterval(pollInterval!);
          pollInterval = null;
          window.location.reload();
          return;
        }
        // Update UI per section
        updatePlanUI(data.ai_plan_status ?? 'pending', !!data.ai_plan);
        updateAnalysisUI(data.ai_analysis_status ?? 'pending', !!data.ai_analysis);
        // Stop polling when nothing running
        const running = (data.ai_plan_status === 'running') || (data.ai_analysis_status === 'running');
        if (!running) {
          clearInterval(pollInterval);
          pollInterval = null;
        }
      } catch { /* ignore */ }
      if (attempts >= 60) {
        clearInterval(pollInterval!);
        pollInterval = null;
        updatePlanUI('failed', false);
      }
    }, 4000);
  }

  function updatePlanUI(status: string, hasContent: boolean) {
    const cta = document.getElementById('plan-cta');
    const loading = document.getElementById('plan-loading');
    const error = document.getElementById('plan-error');
    if (!cta || !loading || !error) return;
    cta.classList.add('hidden');
    loading.classList.add('hidden');
    error.classList.add('hidden');
    if (hasContent) {
      window.location.reload();
    } else if (status === 'running') {
      loading.classList.remove('hidden');
    } else if (status === 'failed') {
      error.classList.remove('hidden');
    } else {
      cta.classList.remove('hidden');
    }
  }

  function updateAnalysisUI(status: string, hasContent: boolean) {
    const cta = document.getElementById('analysis-cta');
    const loading = document.getElementById('analysis-loading');
    const error = document.getElementById('analysis-error');
    if (!cta || !loading || !error) return;
    cta.classList.add('hidden');
    loading.classList.add('hidden');
    error.classList.add('hidden');
    if (hasContent) {
      window.location.reload();
    } else if (status === 'running') {
      loading.classList.remove('hidden');
    } else if (status === 'failed') {
      error.classList.remove('hidden');
    } else {
      cta.classList.remove('hidden');
    }
  }

  // ── SSE Streaming ───────────────────────────────────────────────
  function getStreamContainer(type: 'analysis' | 'plan'): HTMLElement | null {
    if (type === 'plan') return document.getElementById('plan-stream');
    return document.getElementById('analysis-stream');
  }

  function getStatusEl(type: 'analysis' | 'plan'): HTMLElement | null {
    if (type === 'plan') return document.getElementById('plan-status');
    return document.getElementById('analysis-status');
  }

  function getElapsedEl(type: 'analysis' | 'plan'): HTMLElement | null {
    if (type === 'plan') return document.getElementById('plan-elapsed');
    return document.getElementById('analysis-elapsed');
  }

  function startGenerationFeedback(type: 'analysis' | 'plan'): () => void {
    const elapsedEl = getElapsedEl(type);
    const startedAt = Date.now();
    const task = type === 'plan'
      ? (lang === 'vi' ? 'kế hoạch 30 ngày' : '30-day plan')
      : (lang === 'vi' ? 'bản soi chiếu hệ thống' : 'system reflection');

    const update = () => {
      if (!elapsedEl) return;
      const seconds = Math.floor((Date.now() - startedAt) / 1000);
      const stage = seconds < 3
        ? (lang === 'vi' ? 'Đã nhận yêu cầu, đang chuẩn bị dữ liệu...' : 'Request received, preparing your data...')
        : seconds < 10
          ? (lang === 'vi' ? `Đang đọc kết quả để tạo ${task}...` : `Reviewing your results for the ${task}...`)
          : seconds < 25
            ? (lang === 'vi' ? 'AI đang soạn nội dung riêng cho bạn...' : 'AI is drafting your personalised content...')
            : (lang === 'vi' ? 'Đang hoàn thiện và lưu kết quả, vui lòng giữ trang này mở.' : 'Finalising and saving your result. Please keep this page open.');
      elapsedEl.textContent = `${stage} (${seconds}s)`;
    };

    update();
    const interval = setInterval(update, 1000);
    return () => clearInterval(interval);
  }

  async function triggerAi(type: 'analysis' | 'plan') {
    const generationKey = type;
    if (activeGenerations.has(generationKey)) return;
    activeGenerations.add(generationKey);
    const stopFeedback = startGenerationFeedback(type);

    // Show streaming state
    if (type === 'plan') {
      document.getElementById('plan-cta')?.classList.add('hidden');
      document.getElementById('plan-loading')?.classList.remove('hidden');
      document.getElementById('plan-error')?.classList.add('hidden');
    }
    if (type === 'analysis') {
      document.getElementById('analysis-cta')?.classList.add('hidden');
      document.getElementById('analysis-loading')?.classList.remove('hidden');
      document.getElementById('analysis-error')?.classList.add('hidden');
    }

    const statusEl = getStatusEl(type);
    const container = getStreamContainer(type);
    if (statusEl) statusEl.textContent = lang === 'vi' ? 'Đang phân tích...' : 'Analyzing...';
    if (container) container.classList.remove('hidden');

    let completed = false;
    try {
      const res = await fetch('/api/scanner/run-ai-stream', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ response_id: Number(responseId), type }),
      });

      if (!res.ok || !res.body) {
        let errMsg = `HTTP ${res.status}`;
        try {
          const errData = await res.json() as { error?: string };
          if (errData.error) errMsg = errData.error;
        } catch { /* ignore */ }
        throw new Error(errMsg);
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const events = buffer.split(/\r?\n\r?\n/);
        buffer = events.pop() ?? '';

        for (const rawEvent of events) {
          if (!rawEvent.trim()) continue;

          let event = '';
          let dataStr = '';

          for (const segment of rawEvent.split(/\r?\n/)) {
            const s = segment.trim();
            if (s.startsWith('event: ')) event = s.slice(7).trim();
            if (s.startsWith('data: ')) dataStr = s.slice(6).trim();
          }
          if (!dataStr) continue;

          let data: Record<string, unknown>;
          try { data = JSON.parse(dataStr); } catch { continue; }

          const chunkType = String(data.type ?? type) as 'analysis' | 'plan';

          if (event === 'chunk') {
            const text = String(data.text ?? '');
            const targetContainer = getStreamContainer(chunkType);
            const targetStatus = getStatusEl(chunkType);
            if (targetContainer) targetContainer.textContent = (targetContainer.textContent ?? '') + text;
            if (targetStatus && data.message) targetStatus.textContent = String(data.message);
          } else if (event === 'status') {
            const targetStatus = getStatusEl(chunkType);
            if (targetStatus) targetStatus.textContent = String(data.message ?? '');
          } else if (event === 'done') {
            const targetStatus = getStatusEl(chunkType);
            if (targetStatus) targetStatus.textContent = lang === 'vi' ? 'Hoàn tất!' : 'Done!';
            // The API sends this event only after the result is saved to D1.
            // R2 is optional, so do not wait for its keys before displaying it.
            completed = true;
            setTimeout(() => window.location.reload(), 300);
          } else if (event === 'error') {
            throw new Error(String(data.message ?? 'Stream error'));
          }
        }
      }
      if (!completed) throw new Error(lang === 'vi' ? 'Kết nối kết thúc trước khi hoàn tất. Vui lòng thử lại.' : 'The connection ended before completion. Please try again.');
    } catch (err) {
      console.error('[scanner] SSE error:', err);
      const targetContainer = getStreamContainer(type);
      const targetStatus = getStatusEl(type);
      if (targetContainer) {
        targetContainer.textContent = '';
        targetContainer.classList.add('hidden');
      }

      // Show error message with details
      const errMsg = err instanceof Error ? err.message : String(err);
      if (targetStatus) {
        targetStatus.textContent = lang === 'vi'
          ? `Lỗi: ${errMsg}`
          : `Error: ${errMsg}`;
        targetStatus.style.color = 'var(--error, #ef4444)';
      }

      if (type === 'plan') {
        document.getElementById('plan-error')?.classList.remove('hidden');
      } else {
        document.getElementById('analysis-error')?.classList.remove('hidden');
      }
    } finally {
      stopFeedback();
      activeGenerations.delete(generationKey);
    }
  }

  // ── Button bindings ─────────────────────────────────────────────
  document.getElementById('btn-run-plan')?.addEventListener('click', () => triggerAi('plan'));
  document.getElementById('btn-retry-plan')?.addEventListener('click', () => triggerAi('plan'));
  document.getElementById('btn-retry-running-plan')?.addEventListener('click', () => triggerAi('plan'));
  document.getElementById('btn-run-analysis')?.addEventListener('click', () => triggerAi('analysis'));
  document.getElementById('btn-retry-analysis')?.addEventListener('click', () => triggerAi('analysis'));

  // ── Plan copy ─────────────────────────────────────────────────────
  const btnCopyPlan = document.getElementById('btn-copy-plan') as HTMLButtonElement | null;

  async function copyPlanText(text: string) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();
    document.execCommand('copy');
    textarea.remove();
  }

  btnCopyPlan?.addEventListener('click', async () => {
    const source = document.getElementById('plan-copy-source') as HTMLTemplateElement | null;
    const text = source?.content.textContent?.trim() ?? '';
    if (!text) return;
    const original = btnCopyPlan.innerHTML;
    try {
      await copyPlanText(text);
      btnCopyPlan.innerHTML = `<span class="material-symbols-outlined text-base">check</span>${lang === 'vi' ? 'Đã sao chép' : 'Copied'}`;
      setTimeout(() => { btnCopyPlan.innerHTML = original; }, 2000);
    } catch {
      btnCopyPlan.innerHTML = `<span class="material-symbols-outlined text-base">error</span>${lang === 'vi' ? 'Không thể sao chép' : 'Copy failed'}`;
      setTimeout(() => { btnCopyPlan.innerHTML = original; }, 2500);
    }
  });

  // ── Initial UI state from server status ─────────────────────────
  // Plan
  if (planStatusInit === 'running') {
    document.getElementById('plan-cta')?.classList.add('hidden');
    document.getElementById('plan-loading')?.classList.remove('hidden');
    const planStatus = document.getElementById('plan-status');
    if (planStatus && !planStatus.textContent?.trim()) {
      planStatus.textContent = lang === 'vi' ? 'Đang tạo kế hoạch 30 ngày...' : 'Generating your 30-day plan...';
    }
    pollForResult();
  } else if (planStatusInit === 'failed') {
    document.getElementById('plan-cta')?.classList.add('hidden');
    document.getElementById('plan-error')?.classList.remove('hidden');
  }
  // Analysis (unlocked section)
  if (analysisStatusInit === 'running') {
    document.getElementById('analysis-cta')?.classList.add('hidden');
    document.getElementById('analysis-loading')?.classList.remove('hidden');
    pollForResult();
  } else if (analysisStatusInit === 'failed') {
    document.getElementById('analysis-cta')?.classList.add('hidden');
    document.getElementById('analysis-error')?.classList.remove('hidden');
  }
  // Share button
  const btnShare = document.getElementById('btn-share');
  if (btnShare) {
    btnShare.addEventListener('click', async () => {
      const url = window.location.href;
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url });
        } catch {}
      } else {
        await navigator.clipboard.writeText(url);
        const orig = btnShare.innerHTML;
        btnShare.innerHTML = `<span class="material-symbols-outlined text-base">check</span> <span>${lang === 'vi' ? 'Đã copy!' : 'Copied!'}</span>`;
        setTimeout(() => { btnShare.innerHTML = orig; }, 2000);
      }
    });
  }
</script>
