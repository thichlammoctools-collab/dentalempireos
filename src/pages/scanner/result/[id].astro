</style>

<script>
  const wrap = document.querySelector('.result-wrap') as HTMLElement;
  const responseId = wrap?.dataset.responseId;
  const lang = (wrap?.dataset.lang ?? 'vi') as 'vi' | 'en';
  const planStatusInit = wrap?.dataset.planStatus ?? 'pending';
  const analysisStatusInit = wrap?.dataset.analysisStatus ?? 'pending';
  const reportTokenLimit = Number(wrap?.dataset.reportTokenBudget ?? 4096);

  // ── Polling ───────────────────────────────────────────────────────
  let pollInterval: ReturnType<typeof setInterval> | null = null;
  const activeGenerations = new Set<string>();

  function pollForResult() {
    if (pollInterval) return;
    let attempts = 0;
    let isPolling = false;
    pollInterval = setInterval(async () => {
      if (isPolling) return;
      isPolling = true;
      attempts++;
      try {
        const res = await fetch(`/api/scanner/${responseId}`, { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json() as {
          ai_analysis?: string | null;
          ai_plan?: string | null;
          ai_analysis_status?: string;
          ai_plan_status?: string;
        };
        const planDone = !['queued', 'running'].includes(data.ai_plan_status ?? 'pending');
        const analysisDone = !['queued', 'running'].includes(data.ai_analysis_status ?? 'pending');
        if (planDone && analysisDone) {
          clearInterval(pollInterval!);
          pollInterval = null;
          window.location.reload();
          return;
        }
        // Update UI per section
        updatePlanUI(data.ai_plan_status ?? 'pending', !!data.ai_plan, !!data.ai_analysis);
        updateAnalysisUI(data.ai_analysis_status ?? 'pending', !!data.ai_analysis);
        // Stop polling when nothing running
        const running = ['queued', 'running'].includes(data.ai_plan_status ?? 'pending')
          || ['queued', 'running'].includes(data.ai_analysis_status ?? 'pending');
        if (!running) {
          if (pollInterval !== null) clearInterval(pollInterval);
          pollInterval = null;
        }
      } catch { /* keep polling while the connection recovers */ }
      finally { isPolling = false; }
      if (attempts >= 90 && pollInterval !== null) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
    }, 2000);
  }

  function updatePlanUI(status: string, hasContent: boolean, hasAnalysisContent: boolean) {
    const cta = document.getElementById('plan-cta');
    const loading = document.getElementById('plan-loading');
    const error = document.getElementById('plan-error');
    const chip = document.getElementById('plan-status-chip');
    if (!cta || !loading || !error) return;
    cta.classList.add('hidden');
    loading.classList.add('hidden');
    error.classList.add('hidden');
    if (chip) {
      const working = status === 'queued' || status === 'running';
      chip.classList.toggle('is-ready', hasContent);
      chip.classList.toggle('is-working', !hasContent && working);
      const icon = chip.querySelector('.material-symbols-outlined');
      if (icon) icon.textContent = hasContent ? 'check_circle' : working ? 'sync' : hasAnalysisContent ? 'auto_awesome' : 'schedule';
      const label = document.getElementById('plan-status-chip-label');
      if (label) label.textContent = hasContent
        ? (lang === 'vi' ? 'Đã sẵn sàng' : 'Ready')
        : working
          ? (lang === 'vi' ? 'AI đang làm việc' : 'AI working')
          : status === 'failed' && hasAnalysisContent
            ? (lang === 'vi' ? 'Cần thử lại' : 'Retry needed')
            : hasAnalysisContent
              ? (lang === 'vi' ? 'Sẵn sàng lập kế hoạch' : 'Ready to build plan')
              : (lang === 'vi' ? 'Chờ bản soi chiếu' : 'Awaiting analysis');
    }
    if (hasContent) {
      window.location.reload();
    } else if (status === 'queued' || status === 'running') {
      loading.classList.remove('hidden');
    } else if (status === 'failed') {
      error.classList.remove('hidden');
    } else if (hasAnalysisContent) {
      cta.classList.remove('hidden');
    }
  }

  function updateAnalysisUI(status: string, hasContent: boolean) {
    const cta = document.getElementById('analysis-cta');
    const loading = document.getElementById('analysis-loading');
    const error = document.getElementById('analysis-error');
    if (!cta || !loading || !error) return;
    cta.classList.add('hidden');
    loading.classList.add('hidden');
    error.classList.add('hidden');
    if (hasContent) {
      window.location.reload();
    } else if (status === 'queued' || status === 'running') {
      loading.classList.remove('hidden');
    } else if (status === 'failed') {
      error.classList.remove('hidden');
    } else {
      cta.classList.remove('hidden');
    }
  }

  // ── SSE Streaming ───────────────────────────────────────────────
  function getStreamContainer(type: 'analysis' | 'plan'): HTMLElement | null {
    if (type === 'plan') return document.getElementById('plan-stream');
    return document.getElementById('analysis-stream');
  }

  function getStatusEl(type: 'analysis' | 'plan'): HTMLElement | null {
    if (type === 'plan') return document.getElementById('plan-status');
    return document.getElementById('analysis-status');
  }

  function getElapsedEl(type: 'analysis' | 'plan'): HTMLElement | null {
    if (type === 'plan') return document.getElementById('plan-elapsed');
    return document.getElementById('analysis-elapsed');
  }

  function updateWorkflowProgress(type: 'analysis' | 'plan', seconds: number) {
    const stages = type === 'plan' ? ['source', 'priority', 'plan'] : ['source', 'pattern', 'insight'];
    const activeIndex = seconds < 10 ? 0 : seconds < 25 ? 1 : 2;
    const scope = type === 'plan' ? '#plan-loading' : '#analysis-loading';
    stages.forEach((stage, index) => {
      const item = document.querySelector(`${scope} [data-ai-stage="${stage}"]`);
      const icon = item?.querySelector('.material-symbols-outlined');
      if (!item || !icon) return;
      item.classList.toggle('is-complete', index < activeIndex);
      item.classList.toggle('is-active', index === activeIndex);
      icon.textContent = index < activeIndex ? 'check_circle' : index === activeIndex ? 'sync' : 'radio_button_unchecked';
    });
  }

  function startGenerationFeedback(type: 'analysis' | 'plan'): () => void {
    const elapsedEl = getElapsedEl(type);
    const startedAt = Date.now();
    const task = type === 'plan'
      ? (lang === 'vi' ? 'kế hoạch 30 ngày' : '30-day plan')
      : (lang === 'vi' ? 'bản soi chiếu hệ thống' : 'system reflection');

    const update = () => {
      if (!elapsedEl) return;
      const seconds = Math.floor((Date.now() - startedAt) / 1000);
      const stage = seconds < 3
        ? (lang === 'vi' ? 'Đã nhận yêu cầu, đang chuẩn bị dữ liệu...' : 'Request received, preparing your data...')
        : seconds < 10
          ? (lang === 'vi' ? `Đang chờ lượt xử lý để tạo ${task}...` : `Waiting for processing capacity for the ${task}...`)
          : seconds < 25
            ? (lang === 'vi' ? 'AI đang xử lý dữ liệu của bạn...' : 'AI is processing your data...')
            : (lang === 'vi' ? 'Đang xử lý hoặc chờ lượt. Bạn có thể rời trang, kết quả sẽ được lưu tự động.' : 'Processing or waiting in queue. You can leave this page; the result will be saved automatically.');
      elapsedEl.textContent = `${stage} (${seconds}s)`;
      updateWorkflowProgress(type, seconds);
    };

    update();
    const interval = setInterval(update, 1000);
    return () => clearInterval(interval);
  }

  async function triggerAi(type: 'analysis' | 'plan') {
    const generationKey = type;
    if (activeGenerations.has(generationKey)) return;
    activeGenerations.add(generationKey);
    const stopFeedback = startGenerationFeedback(type);

    // Show queued state while the durable worker processes the job.
    if (type === 'plan') {
      document.getElementById('plan-cta')?.classList.add('hidden');
      document.getElementById('plan-loading')?.classList.remove('hidden');
      document.getElementById('plan-error')?.classList.add('hidden');
    }
    if (type === 'analysis') {
      document.getElementById('analysis-cta')?.classList.add('hidden');
      document.getElementById('analysis-loading')?.classList.remove('hidden');
      document.getElementById('analysis-error')?.classList.add('hidden');
    }

    const statusEl = getStatusEl(type);
    const container = getStreamContainer(type);
    if (statusEl) statusEl.textContent = lang === 'vi' ? 'Đã xếp hàng, đang chờ xử lý...' : 'Queued and waiting for processing...';
    if (container) container.classList.add('hidden');

    try {
      const res = await fetch('/api/scanner/run-ai', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ response_id: Number(responseId), type }),
      });

      if (!res.ok) {
        let errMsg = `HTTP ${res.status}`;
        try {
          const errData = await res.json() as { error?: string };
          if (errData.error) errMsg = errData.error;
        } catch { /* ignore */ }
        throw new Error(errMsg);
      }

      pollForResult();
    } catch (err) {
      stopFeedback();
      console.error('[scanner] SSE error:', err);
      const targetContainer = getStreamContainer(type);
      const targetStatus = getStatusEl(type);
      if (targetContainer) {
        targetContainer.textContent = '';
        targetContainer.classList.add('hidden');
      }

      // Show error message with details
      const errMsg = err instanceof Error ? err.message : String(err);
      if (targetStatus) {
        targetStatus.textContent = lang === 'vi'
          ? `Lỗi: ${errMsg}`
          : `Error: ${errMsg}`;
        targetStatus.style.color = 'var(--error, #ef4444)';
      }

      if (type === 'plan') {
        document.getElementById('plan-error')?.classList.remove('hidden');
      } else {
        document.getElementById('analysis-error')?.classList.remove('hidden');
      }
    } finally {
      activeGenerations.delete(generationKey);
    }
  }

  const confirmDialog = document.getElementById('report-confirm-dialog') as HTMLDialogElement | null;
  const confirmTitle = document.getElementById('report-confirm-title');
  const confirmDescription = document.getElementById('report-confirm-description');
  const confirmTokens = document.getElementById('report-confirm-tokens');
  const confirmAccept = document.getElementById('report-confirm-accept');
  let pendingConfirmation: (() => void) | null = null;

  function requestConfirmation(
    title: string,
    description: string,
    cost: string,
    action: () => void,
  ) {
    if (!confirmDialog || !confirmTitle || !confirmDescription || !confirmTokens || !confirmAccept) return action();
    pendingConfirmation = action;
    confirmTitle.textContent = title;
    confirmDescription.textContent = description;
    confirmTokens.textContent = cost;
    confirmDialog.showModal();
  }

  confirmAccept?.addEventListener('click', () => {
    const action = pendingConfirmation;
    pendingConfirmation = null;
    confirmDialog?.close();
    action?.();
  });

  // ── Button bindings ─────────────────────────────────────────────
  const requestReport = (type: 'analysis' | 'plan') => requestConfirmation(
    type === 'analysis'
      ? (lang === 'vi' ? 'Tạo Bản soi chiếu hệ thống' : 'Create System Illumination')
      : (lang === 'vi' ? 'Tạo Kế hoạch 30 ngày' : 'Create 30-day plan'),
    type === 'analysis'
      ? (lang === 'vi' ? 'AI sẽ phân tích kết quả Scanner của bạn trước khi mở bước lập kế hoạch.' : 'AI will analyze your Scanner results before the planning step is unlocked.')
      : (lang === 'vi' ? 'AI sẽ chuyển các phát hiện từ Bản soi chiếu thành hành động ưu tiên trong 30 ngày.' : 'AI will turn System Illumination findings into prioritized 30-day actions.'),
    lang === 'vi' ? `Tối đa ${reportTokenLimit.toLocaleString('vi-VN')} token đầu ra` : `Up to ${reportTokenLimit.toLocaleString('en-US')} output tokens`,
    () => triggerAi(type),
  );
  document.getElementById('btn-run-plan')?.addEventListener('click', () => requestReport('plan'));
  document.getElementById('btn-retry-plan')?.addEventListener('click', () => requestReport('plan'));
  document.getElementById('btn-retry-running-plan')?.addEventListener('click', () => requestReport('plan'));
  document.getElementById('btn-run-analysis')?.addEventListener('click', () => requestReport('analysis'));
  document.getElementById('btn-retry-analysis')?.addEventListener('click', () => requestReport('analysis'));

  // ── Report copy ───────────────────────────────────────────────────
  async function copyPlanText(text: string) {
    if (!navigator.clipboard?.writeText) {
      throw new Error('Clipboard API is unavailable.');
    }
    await navigator.clipboard.writeText(text);
  }

  function bindCopyButton(buttonId: string, sourceId: string) {
    const button = document.getElementById(buttonId) as HTMLButtonElement | null;
    button?.addEventListener('click', async () => {
      const source = document.getElementById(sourceId) as HTMLTemplateElement | null;
      const text = source?.content.textContent?.trim() ?? '';
      if (!text) return;
      const original = button.innerHTML;
      try {
        await copyPlanText(text);
        button.innerHTML = `<span class="material-symbols-outlined text-base">check</span>${lang === 'vi' ? 'Đã sao chép' : 'Copied'}`;
        setTimeout(() => { button.innerHTML = original; }, 2000);
      } catch {
        button.innerHTML = `<span class="material-symbols-outlined text-base">error</span>${lang === 'vi' ? 'Không thể sao chép' : 'Copy failed'}`;
        setTimeout(() => { button.innerHTML = original; }, 2500);
      }
    });
  }

  bindCopyButton('btn-copy-plan', 'plan-copy-source');
  bindCopyButton('btn-copy-analysis', 'analysis-copy-source');

  // ── Initial UI state from server status ─────────────────────────
  // Plan
   if (planStatusInit === 'queued' || planStatusInit === 'running') {
    document.getElementById('plan-cta')?.classList.add('hidden');
    document.getElementById('plan-loading')?.classList.remove('hidden');
    const planStatus = document.getElementById('plan-status');
    if (planStatus && !planStatus.textContent?.trim()) {
      planStatus.textContent = lang === 'vi' ? 'Đang tạo kế hoạch 30 ngày...' : 'Generating your 30-day plan...';
    }
    startGenerationFeedback('plan');
    pollForResult();
  } else if (planStatusInit === 'failed') {
    document.getElementById('plan-cta')?.classList.add('hidden');
    document.getElementById('plan-error')?.classList.remove('hidden');
  }
  // Analysis (unlocked section)
   if (analysisStatusInit === 'queued' || analysisStatusInit === 'running') {
     document.getElementById('analysis-cta')?.classList.add('hidden');
     document.getElementById('analysis-loading')?.classList.remove('hidden');
     const analysisStatus = document.getElementById('analysis-status');
     if (analysisStatus && !analysisStatus.textContent?.trim()) {
       analysisStatus.textContent = lang === 'vi' ? 'AI đang chuẩn bị dữ liệu để phân tích...' : 'AI is preparing your data for analysis...';
     }
     startGenerationFeedback('analysis');
     pollForResult();
  } else if (analysisStatusInit === 'failed') {
    document.getElementById('analysis-cta')?.classList.add('hidden');
    document.getElementById('analysis-error')?.classList.remove('hidden');
  }
  // Share button
  const btnShare = document.getElementById('btn-share');
  if (btnShare) {
    btnShare.addEventListener('click', async () => {
      const url = window.location.href;
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url });
        } catch {}
      } else {
        await navigator.clipboard.writeText(url);
        const orig = btnShare.innerHTML;
        btnShare.innerHTML = `<span class="material-symbols-outlined text-base">check</span> <span>${lang === 'vi' ? 'Đã copy!' : 'Copied!'}</span>`;
        setTimeout(() => { btnShare.innerHTML = orig; }, 2000);
      }
    });
  }
</script>
