---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { marked } from 'marked';
import {
  getSurveyDefinitionFull,
  parseScoringRules,
  parseAiConfig,
  parseScaleLabels,
} from '../../../lib/survey-config-db';
import {
  getScannerResponse,
  parseScores,
  parseResponses,
} from '../../../lib/scanner-response-db';
import { getScoreLevel } from '../../../lib/scoring-engine';
import { getChaptersByRefs, getChapterExcerpt } from '../../../lib/book-db';
import { isResponseOwnedByUser } from '../../../lib/scanner-history-db';
import { getUserByEmail } from '../../../lib/user-db';
import { getClinicProfile } from '../../../lib/clinic-profile-db';
import { canAccessScanner } from '../../../lib/entitlement-check';

export const prerender = false;

const idParam = Astro.params.id;
const id = idParam ? parseInt(idParam, 10) : 0;

if (!id || Number.isNaN(id)) {
  return Astro.redirect('/');
}

const response = await getScannerResponse(env.DB, id);
if (!response) {
  return new Response('Response not found', { status: 404 });
}

// Auth check — require login (middleware already redirected, but double-check)
const currentUser = Astro.locals.user;
if (!currentUser) {
  return Astro.redirect(`/login?redirect=/scanner/result/${id}`);
}

// Ownership check — must own this response (via scanner_history or email match)
const owned = await isResponseOwnedByUser(env.DB, currentUser.id, id);
const ownsByEmail = response.email
  ? (await getUserByEmail(env.DB, response.email))?.id === currentUser.id
  : false;

if (!owned && !ownsByEmail) {
  return new Response(
    'Bạn không có quyền xem kết quả này.',
    { status: 403 },
  );
}

const full = await getSurveyDefinitionFull(env.DB, response.survey_id);
if (!full) {
  return new Response('Survey not found', { status: 404 });
}

const { definition } = full;
if (!(await canAccessScanner(env.DB, currentUser.id, definition.id))) {
  return Astro.redirect('/dich-vu');
}

const lang = (response.lang === 'en' ? 'en' : 'vi') as 'vi' | 'en';
const scoringRules = parseScoringRules(definition.scoring_rules);
const aiConfig = parseAiConfig(definition.ai_config);

const scores = parseScores(response.scores_json);
const totalScore = scores.total ?? 0;

// Build dimension list with names
type DimRow = { id: string; name: string; score: number; level: ReturnType<typeof getScoreLevel> };
const dimensions: DimRow[] = [];
if (scoringRules) {
  for (const dim of scoringRules.dimensions) {
    const score = scores[dim.id] ?? 0;
    dimensions.push({
      id: dim.id,
      name: lang === 'vi' ? (dim.name_vi ?? dim.id) : (dim.name_en ?? dim.name_vi ?? dim.id),
      score,
      level: getScoreLevel(score, scoringRules, lang),
    });
  }
}

const totalLevel = getScoreLevel(totalScore, scoringRules ?? { dimensions: [], total_formula: 'average', thresholds: { excellent: 75, good: 55, needs_work: 35, critical: 0 } }, lang);

// Pre-render analysis and plan
marked.setOptions({ gfm: true, breaks: true });
const analysisText = response.ai_analysis?.trim() ?? '';
const planText = response.ai_plan?.trim() ?? '';
const analysisHtml = analysisText ? (marked.parse(analysisText) as string) : '';
const hasAnalysis = !!analysisHtml;
const hasPlan = !!planText;
const planHtml = planText ? (marked.parse(planText) as string) : '';

// AI status (from DB, defaults to 'pending' for old responses)
const planStatus = (response as any).ai_plan_status ?? 'pending';
const analysisStatus = (response as any).ai_analysis_status ?? 'pending';

// ── Section 1: Strengths & Needs Work (computed server-side) ──────────────────
type InsightItem = { question: string; value: number; label: string; score: number };
const insights: { strengths: InsightItem[]; needsWork: InsightItem[] } = { strengths: [], needsWork: [] };

const parsedResponses = parseResponses(response.responses_json);
for (const section of full.sections) {
  for (const q of section.questions) {
    if (q.type === 'select') {
      const v = parsedResponses[q.question_id];
      if (typeof v === 'number') {
        const labels = parseScaleLabels(q.scale_labels_vi);
        const label = labels[String(v)] ?? String(v);
        const rawScore = (v / 5) * 100;
        if (v >= 4) {
          insights.strengths.push({ question: lang === 'vi' ? q.label_vi : (q.label_en ?? q.label_vi), value: v, label, score: rawScore });
        } else {
          insights.needsWork.push({ question: lang === 'vi' ? q.label_vi : (q.label_en ?? q.label_vi), value: v, label, score: rawScore });
        }
      }
    }
  }
}

// ── Section 2: Reading recommendations ───────────────────────────────────────
type ChapterRef = { chapter_no: number; title: string; id: string; excerpt: string | null };
const chapterRefs: ChapterRef[] = [];
if (definition.chapter_refs) {
  try {
    const refs: string[] = JSON.parse(definition.chapter_refs);
    const chapters = await getChaptersByRefs(env.DB, refs);
    for (const ch of chapters) {
      const excerpt = await getChapterExcerpt(env.DB, ch.id);
      chapterRefs.push({ chapter_no: ch.chapter_no, title: ch.title, id: ch.id, excerpt });
    }
  } catch { /* ignore */ }
}

const surveyTitle = lang === 'vi' ? definition.title_vi : (definition.title_en || definition.title_vi);
const clinicProfile = await getClinicProfile(env.DB, currentUser.id);
const reportDate = new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', {
  day: '2-digit', month: '2-digit', year: 'numeric',
}).format(new Date(response.created_at));

// AI analysis sections from ai_config (optional, used for header)
const analysisSections = aiConfig.analysis_sections ?? [];

// Cross-sell suggestions: pick 2 other active surveys
let crossSells: Array<{ id: string; slug: string; title_vi: string; title_en: string; description_vi: string | null }> = [];
try {
  const result = await env.DB
    .prepare(
      `SELECT id, slug, title_vi, title_en, description_vi
       FROM "survey_definition"
       WHERE status = 'active' AND id != ?
       ORDER BY order_index ASC
       LIMIT 3`,
    )
    .bind(definition.id)
    .all<any>();
  crossSells = (result.results ?? []).map((r) => ({
    id: r.id,
    slug: r.slug,
    title_vi: r.title_vi,
    title_en: r.title_en || r.title_vi,
    description_vi: r.description_vi,
  }));
} catch {}
---

<BaseLayout
  title={`${surveyTitle} #${id} | Dental Empire OS`}
  description={lang === 'vi' ? 'Bản phân tích hệ thống quản trị phòng khám' : 'Clinic management analysis'}
  noindex={true}
>
  <section class="result-wrap" data-response-id={id} data-scanner-id={definition.id} data-lang={lang} data-survey-slug={definition.slug} data-plan-status={planStatus} data-analysis-status={analysisStatus}>
    <!-- Header -->
    <header class="report-hero">
      <div class="report-identity">
        <div class="clinic-mark" aria-hidden="true">
          {clinicProfile?.logo_url ? (
            <img src={clinicProfile.logo_url} alt="" />
          ) : (
            <span class="material-symbols-outlined">local_hospital</span>
          )}
        </div>
        <div class="report-identity-copy">
          <p class="report-kicker">{surveyTitle}</p>
          <h1 class="result-title">{response.clinic_name ?? (lang === 'vi' ? 'Phòng khám' : 'Clinic')}</h1>
          <div class="report-meta">
            {response.owner_name && <span><span class="material-symbols-outlined">person</span>{response.owner_name}</span>}
            {response.clinic_address && <span><span class="material-symbols-outlined">location_on</span>{response.clinic_address}</span>}
            <span><span class="material-symbols-outlined">calendar_today</span>{reportDate}</span>
          </div>
        </div>
      </div>
      <div class="report-actions">
        {hasPlan && hasAnalysis && (
          <a href={`/api/scanner/${id}/pdf?type=combined`} class="btn btn-primary">
            <span class="material-symbols-outlined text-base">picture_as_pdf</span>
            <span>{lang === 'vi' ? 'Xuất báo cáo PDF' : 'Export PDF report'}</span>
          </a>
        )}
        <button type="button" id="btn-share" class="btn btn-ghost">
          <span class="material-symbols-outlined text-base">share</span>
          <span>{lang === 'vi' ? 'Chia sẻ' : 'Share'}</span>
        </button>
        <a href={`/scanner/${definition.slug}`} class="btn btn-ghost">
          {lang === 'vi' ? 'Làm khảo sát mới' : 'New survey'}
        </a>
        <a href="/account/scanner-history" class="btn btn-ghost">
          <span class="material-symbols-outlined text-base">history</span>
          <span>{lang === 'vi' ? 'Lịch sử' : 'History'}</span>
        </a>
      </div>
    </header>

    <div class="card score-card">
      <div class="report-context">
        <span class="material-symbols-outlined">verified</span>
        <span>{lang === 'vi' ? 'Thông tin do bạn cung cấp trong lượt khảo sát này.' : 'Details supplied for this survey response.'}</span>
      </div>
      <div class="score-header">
        <div>
          <p class="text-xs uppercase tracking-wider text-on-surface-variant font-bold">
            {lang === 'vi' ? 'Điểm tổng hợp' : 'Overall Score'}
          </p>
          <div class="score-total">
            <span class="score-num" style={`color: ${totalLevel.color}`}>{totalScore}</span>
            <span class="score-suffix">/100</span>
          </div>
          <p class="text-sm font-semibold" style={`color: ${totalLevel.color}`}>{totalLevel.label_vi}</p>
        </div>
        <div class="score-summary">
          {lang === 'vi' ? (
            <p>
              {totalScore < 40
                ? 'Phòng khám đang ở giai đoạn sơ khai — đây là thời điểm tốt để soi chiếu.'
                : totalScore < 70
                ? 'Phòng khám đang hình thành — tiếp tục đào sâu để vững mạnh.'
                : 'Phòng khám đang trưởng thành — giữ vững momentum và lan tỏa giá trị.'}
            </p>
          ) : (
            <p>
              {totalScore < 40
                ? 'Your clinic is in the early stage — this is a good time to illuminate and deepen.'
                : totalScore < 70
                ? 'Your clinic is forming — keep deepening to grow strong.'
                : 'Your clinic is maturing — keep the momentum and spread the value.'}
            </p>
          )}
        </div>
      </div>

      <div class="score-bars">
        {dimensions.map((p) => (
          <div class="bar-item">
            <div class="bar-label">
              <span class="bar-name">{p.name}</span>
              <span class="bar-value" style={`color: ${p.level.color}`}>
                {p.score} <span class="bar-level">· {lang === 'vi' ? p.level.label_vi : p.level.label_en}</span>
              </span>
            </div>
            <div class="bar-track">
              <div class="bar-fill" style={`width: ${p.score}%; background: ${p.level.color}`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {insights.strengths.length > 0 || insights.needsWork.length > 0 ? (
      <div class="card insight-card">
        <div class="insight-header">
          <span class="material-symbols-outlined text-amber-400 text-xl">lightbulb</span>
          <h2 class="insight-title">
            {lang === 'vi' ? 'Điểm này có ý nghĩa gì?' : 'What does this score mean?'}
          </h2>
        </div>
        {insights.strengths.length > 0 && (
          <div class="insight-section">
            <p class="insight-section-label success">
              <span class="material-symbols-outlined text-sm">thumb_up</span>
              {lang === 'vi' ? 'Điểm mạnh' : 'Strengths'}
            </p>
            <div class="insight-items">
              {insights.strengths.map((item) => (
                <div class="insight-item insight-item--success">
                  <div class="insight-item-header">
                    <span class="insight-question">{item.question}</span>
                    <span class="insight-badge success-badge">
                      {item.value}/5 — {item.label}
                    </span>
                  </div>
                  <div class="insight-bar-track">
                    <div class="insight-bar-fill" style={`width:${item.score}%;background:#22c55e`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
        {insights.needsWork.length > 0 && (
          <div class="insight-section">
            <p class="insight-section-label warning">
              <span class="material-symbols-outlined text-sm">construction</span>
              {lang === 'vi' ? 'Cần cải thiện' : 'Needs improvement'}
            </p>
            <div class="insight-items">
              {insights.needsWork.map((item) => (
                <div class="insight-item insight-item--warning">
                  <div class="insight-item-header">
                    <span class="insight-question">{item.question}</span>
                    <span class="insight-badge warning-badge">
                      {item.value}/5 — {item.label}
                    </span>
                  </div>
                  <div class="insight-bar-track">
                    <div class="insight-bar-fill" style={`width:${item.score}%;background:#f59e0b`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    ) : null}

    {chapterRefs.length > 0 && (
      <div class="card reading-card">
        <div class="insight-header">
          <span class="material-symbols-outlined text-amber-400 text-xl">menu_book</span>
          <h2 class="insight-title">
            {lang === 'vi' ? 'Nên đọc thêm' : 'Recommended reading'}
          </h2>
        </div>
        <div class="reading-list">
          {chapterRefs.map((ch) => (
            <a href={`/book/${ch.id}`} class="reading-item">
              <div class="reading-meta">
                <span class="reading-tag">Ch.{ch.chapter_no}</span>
                <h3 class="reading-title">{ch.title}</h3>
              </div>
              {ch.excerpt && <p class="reading-excerpt">{ch.excerpt}</p>}
              <div class="reading-cta">
                <span class="reading-link">
                  {lang === 'vi' ? 'Đọc chương này' : 'Read this chapter'}
                  <span class="material-symbols-outlined text-base">arrow_forward</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="card plan-card" id="plan-section">
      <div class="insight-header">
        <span class="material-symbols-outlined text-amber-400 text-xl">calendar_month</span>
        <h2 class="insight-title">
          {lang === 'vi' ? 'Kế hoạch 30 ngày' : '30-day action plan'}
        </h2>
      </div>

      <!-- Done: show content -->
      {hasPlan ? (
        <>
          <div class="plan-tools" aria-label={lang === 'vi' ? 'Công cụ kế hoạch' : 'Plan tools'}>
            <button type="button" class="btn btn-ghost plan-tool-button" id="btn-copy-plan">
              <span class="material-symbols-outlined text-base">content_copy</span>
              {lang === 'vi' ? 'Sao chép tất cả' : 'Copy All'}
            </button>
            <a href={`/api/scanner/${id}/pdf?type=plan`} class="btn btn-primary plan-tool-button">
              <span class="material-symbols-outlined text-base">picture_as_pdf</span>
              {lang === 'vi' ? 'Tải PDF kế hoạch' : 'Download plan PDF'}
            </a>
          </div>
          <div class="plan-document-meta">
            <span class="material-symbols-outlined">assignment_turned_in</span>
            <span>{lang === 'vi' ? 'Bản giao việc 30 ngày - sẵn sàng chia sẻ với đội ngũ' : '30-day team action document - ready to share'}</span>
          </div>
          <article class="prose-content plan-content" id="plan-content" set:html={planHtml}></article>
          <template id="plan-copy-source">{planText}</template>
        </>
      ) : (
        <!-- Not done: show button or loading -->
          <div id="plan-action">
            <div id="plan-loading" class="hidden">
              <div id="plan-status" class="text-center text-sm text-on-surface-variant mb-3">
                {lang === 'vi' ? 'Đang tạo kế hoạch 30 ngày...' : 'Generating your 30-day plan...'}
              </div>
               <pre id="plan-stream" class="ai-stream-preview prose-content-sm whitespace-pre-wrap text-sm text-on-surface-variant max-h-96 overflow-y-auto"></pre>
              <div class="text-center mt-3">
                <p class="text-xs text-on-surface-variant mb-2">
                  {lang === 'vi' ? 'Nếu quá trình dừng quá lâu, bạn có thể tạo lại kế hoạch.' : 'If this takes too long, you can generate the plan again.'}
                </p>
                <button type="button" class="btn btn-ghost btn-retry" id="btn-retry-running-plan">
                  {lang === 'vi' ? 'Tạo lại kế hoạch' : 'Generate again'}
                </button>
              </div>
            </div>
          <div id="plan-cta">
            <button type="button" class="btn btn-amber btn-run" id="btn-run-plan">
              <span class="material-symbols-outlined text-base">auto_awesome</span>
              {lang === 'vi' ? 'Tạo kế hoạch 30 ngày' : 'Generate 30-Day Plan'}
            </button>
          </div>
          <div id="plan-error" class="text-center py-4 hidden">
            <p class="text-sm text-red-400 mb-3">{lang === 'vi' ? 'Có lỗi xảy ra.' : 'An error occurred.'}</p>
            <button type="button" class="btn btn-ghost btn-retry" id="btn-retry-plan">
              {lang === 'vi' ? 'Thử lại' : 'Retry'}
            </button>
          </div>
        </div>
      )}
    </div>

    <div class="card analysis-card" id="analysis-section">
      <div class="analysis-header">
        <div>
          <p class="text-xs uppercase tracking-wider text-amber-500 font-bold">
            {lang === 'vi' ? 'Phân tích AI' : 'AI Analysis'}
          </p>
          <h2 class="analysis-title">
            {lang === 'vi' ? 'Bản soi chiếu hệ thống' : 'System Illumination'}
          </h2>
        </div>
      </div>

      <div id="analysis-unlocked">
        {hasAnalysis ? (
          <>
            <div class="analysis-tools">
              <a href={`/api/scanner/${id}/pdf?type=analysis`} class="btn btn-primary plan-tool-button">
                <span class="material-symbols-outlined text-base">picture_as_pdf</span>
                {lang === 'vi' ? 'Tải PDF soi chiếu' : 'Download analysis PDF'}
              </a>
            </div>
            <article class="prose-content" set:html={analysisHtml}></article>
          </>
        ) : (
          <div id="analysis-action">
            <div id="analysis-loading" class="hidden">
              <div id="analysis-status" class="text-center text-sm text-on-surface-variant mb-3"></div>
               <pre id="analysis-stream" class="ai-stream-preview prose-content-sm whitespace-pre-wrap text-sm text-on-surface-variant max-h-96 overflow-y-auto"></pre>
            </div>
            <div id="analysis-cta" class="text-center">
              <button type="button" class="btn btn-amber btn-run" id="btn-run-analysis">
                <span class="material-symbols-outlined text-base">auto_awesome</span>
                {lang === 'vi' ? 'Bắt đầu phân tích AI' : 'Start AI Analysis'}
              </button>
            </div>
            <div id="analysis-error" class="text-center py-4 hidden">
              <p class="text-sm text-red-400 mb-3">{lang === 'vi' ? 'Có lỗi xảy ra.' : 'An error occurred.'}</p>
              <button type="button" class="btn btn-ghost btn-retry" id="btn-retry-analysis">
                {lang === 'vi' ? 'Thử lại' : 'Retry'}
              </button>
            </div>
          </div>
        )}
      </div>

    </div>

    <!-- Cross-sell (other scanners) -->
    {crossSells.length > 0 && (
      <div class="card cross-sell-card">
        <h3 class="cross-sell-title">
          {lang === 'vi' ? 'Khám phá thêm các máy quét khác' : 'Explore other scanners'}
        </h3>
        <div class="cross-sell-grid">
          {crossSells.map((s) => (
            <a href={`/scanner/${s.slug}`} class="cross-sell-item">
              <span class="material-symbols-outlined text-primary text-2xl">fact_check</span>
              <div>
                <p class="text-sm font-semibold text-on-surface">{lang === 'vi' ? s.title_vi : s.title_en}</p>
                {s.description_vi && <p class="text-xs text-on-surface-variant line-clamp-2 mt-0.5">{s.description_vi}</p>}
              </div>
              <span class="material-symbols-outlined text-on-surface-variant/50">arrow_forward</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>

</BaseLayout>

<style>
  .result-wrap {
    max-width: 880px;
    margin: 0 auto;
    padding: 2rem 1rem 5rem;
  }
  .report-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
     background: linear-gradient(135deg, var(--color-surface-container-high), var(--color-surface-container));
     border: 1px solid var(--color-outline-variant);
    border-radius: 1rem;
    flex-wrap: wrap;
  }
  .report-identity { display: flex; align-items: center; gap: 1rem; min-width: 0; }
  .clinic-mark {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    flex: none;
     color: var(--color-warning);
     background: color-mix(in srgb, var(--color-warning-container) 75%, transparent);
     border: 1px solid color-mix(in srgb, var(--color-warning) 40%, var(--color-outline-variant));
    border-radius: 0.875rem;
    overflow: hidden;
  }
  .clinic-mark .material-symbols-outlined { font-size: 1.75rem; }
   .clinic-mark img { width: 100%; height: 100%; object-fit: contain; background: var(--color-surface-bright); }
  .report-identity-copy { min-width: 0; }
   .report-kicker { color: var(--color-warning); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; margin: 0 0 0.35rem; text-transform: uppercase; }
  .result-title {
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0;
     color: var(--color-on-surface);
  }
   .report-meta { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.65rem; color: var(--color-on-surface-variant); font-size: 0.8rem; }
  .report-meta span { display: inline-flex; align-items: center; gap: 0.3rem; }
   .report-meta .material-symbols-outlined { font-size: 0.95rem; color: var(--color-on-surface-variant); }
  .report-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }

  .card {
     background: var(--color-surface);
     border: 1px solid var(--color-outline-variant);
    border-radius: 1rem;
    padding: 1.75rem;
    margin-bottom: 1.25rem;
  }

  .score-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .report-context {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: -0.25rem 0 1.5rem;
    padding: 0.65rem 0.75rem;
     color: var(--color-on-surface-variant);
     background: color-mix(in srgb, var(--color-primary-container) 42%, transparent);
     border: 1px solid color-mix(in srgb, var(--color-primary) 32%, var(--color-outline-variant));
    border-radius: 0.625rem;
    font-size: 0.78rem;
    line-height: 1.4;
  }
