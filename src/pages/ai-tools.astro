---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listApps, type App } from '../lib/app-db';
import { getActiveProducts, type Product } from '../lib/payos-db';
import { listProductEntitlements } from '../lib/entitlement-db';

export const prerender = false;

let apps: Awaited<ReturnType<typeof listApps>> = [];
let activeProducts: Product[] = [];
let productEntitlements = new Map<string, Awaited<ReturnType<typeof listProductEntitlements>>>();

try {
  apps = await listApps(env.DB).then(a => a.filter(app => app.status === 'active' && app.slug !== 'ho-so-goc-re'));
} catch {
  apps = [];
}

try {
  activeProducts = await getActiveProducts(env.DB);
  const entries = await Promise.all(activeProducts.map(async (product) => [
    product.id,
    await listProductEntitlements(env.DB, product.id),
  ] as const));
  productEntitlements = new Map(entries);
} catch {
  activeProducts = [];
  productEntitlements = new Map();
}

function getEntitlementProduct(contentType: 'ai_app', contentId: string): Product | null {
  return activeProducts
    .filter((product) => productEntitlements.get(product.id)?.some(
      (entitlement) => entitlement.content_type === contentType
        && (entitlement.content_id === contentId || entitlement.content_id === '*'),
    ))
    .sort((a, b) => a.price - b.price)[0] ?? null;
}

const getAppProduct = (app: App) => getEntitlementProduct('ai_app', app.id);
const isAppFree = (app: App) => !getAppProduct(app);

const appTypeLabels: Record<string, string> = {
  survey: 'Khảo sát',
  ebook_ai: 'Tài liệu AI',
  course_ai: 'Khóa học AI',
  tool: 'Công cụ',
  generator: 'Tạo nội dung',
};

const appTypeColors: Record<string, { bg: string; border: string; text: string }> = {
  survey:    { bg: 'bg-purple-50 dark:bg-purple-500/10', border: 'border-purple-200 dark:border-purple-500/30', text: 'text-purple-700 dark:text-purple-300' },
  ebook_ai:  { bg: 'bg-blue-50 dark:bg-blue-500/10',   border: 'border-blue-200 dark:border-blue-500/30',   text: 'text-blue-700 dark:text-blue-300' },
  course_ai: { bg: 'bg-green-50 dark:bg-green-500/10',  border: 'border-green-200 dark:border-green-500/30',  text: 'text-green-700 dark:text-green-300' },
  tool:      { bg: 'bg-amber-50 dark:bg-amber-500/10',  border: 'border-amber-200 dark:border-amber-500/30',  text: 'text-amber-700 dark:text-amber-300' },
  generator: { bg: 'bg-pink-50 dark:bg-pink-500/10',   border: 'border-pink-200 dark:border-pink-500/30',   text: 'text-pink-700 dark:text-pink-300' },
};

const appGroups = [
  { title: 'AI Tools miễn phí', description: 'Công cụ hỗ trợ bạn bắt đầu, phác thảo và kiểm tra công việc nhanh hơn.', items: apps.filter(isAppFree), free: true },
  { title: 'AI Tools chuyên sâu', description: 'Công cụ có trả phí hoặc cần mở khóa để tạo ra đầu ra chuyên biệt hơn.', items: apps.filter((app) => !isAppFree(app)), free: false },
];
---

<BaseLayout
  title="Công cụ AI — Dental Empire OS"
  description="AI Tools cho phòng khám nha khoa: biến dữ liệu, ý tưởng và kiến thức thành đầu ra có thể triển khai. Xem rõ công cụ miễn phí và công cụ chuyên sâu có trả phí."
  ogImage="/images/ai-tools-og.svg"
  ogImageAlt="Công cụ AI cho phòng khám - Dental Empire OS"
>
  <section class="relative overflow-hidden">
    <!-- Ambient background -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="ai-tools-grid absolute inset-0"></div>
      <div class="absolute top-0 inset-x-0 h-[560px]" style="background: radial-gradient(ellipse 70% 55% at 50% -8%, rgba(0,139,210,0.16), transparent 68%);"></div>
      <div class="ai-tools-circuit ai-tools-circuit--left"></div>
      <div class="ai-tools-circuit ai-tools-circuit--right"></div>
      <svg class="ai-tools-tooth ai-tools-tooth--left" viewBox="0 0 160 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M43 19c18-11 56-11 74 0 18 11 26 35 18 57-6 16-14 25-17 46l-8 42c-2 11-17 11-19 1l-8-34c-1-5-5-8-10-8s-9 3-10 8l-8 34c-2 10-17 10-19-1l-8-42c-3-21-11-30-17-46-8-22 0-46 18-57Z" />
        <path d="M43 60c20 11 54 11 74 0M73 28v30M57 38l16 20 16-20" />
      </svg>
      <svg class="ai-tools-tooth ai-tools-tooth--right" viewBox="0 0 160 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M43 19c18-11 56-11 74 0 18 11 26 35 18 57-6 16-14 25-17 46l-8 42c-2 11-17 11-19 1l-8-34c-1-5-5-8-10-8s-9 3-10 8l-8 34c-2 10-17 10-19-1l-8-42c-3-21-11-30-17-46-8-22 0-46 18-57Z" />
        <path d="M43 60c20 11 54 11 74 0M73 28v30M57 38l16 20 16-20" />
      </svg>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 pt-12 pb-20 md:pt-16">
      <!-- Hero -->
      <header class="mx-auto mb-10 max-w-3xl text-center md:mb-12">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.16em] text-amber-600 dark:text-amber-400">AI Scanner</p>
        <h1 class="text-4xl font-bold leading-[1.02] tracking-tight text-on-surface md:text-5xl lg:text-6xl">
          Đưa bối cảnh vào.<br />
          <span class="text-primary">Nhận hướng đi ra.</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-on-surface-variant md:text-lg">Mỗi AI Tool là một hành trình có cấu trúc: bạn cung cấp thông tin theo từng bước, AI phân tích và tạo đầu ra để đội ngũ có thể triển khai.</p>
      </header>

      <section class="mb-14 grid overflow-hidden border border-outline-variant/30 sm:grid-cols-3">
        <div class="border-b border-outline-variant/30 p-5 sm:border-b-0 sm:border-r"><span class="mb-3 block text-xs font-bold text-primary">01 / CUNG CẤP BỐI CẢNH</span><h2 class="font-bold text-on-surface">Trả lời theo từng bước</h2><p class="mt-2 text-sm leading-relaxed text-on-surface-variant">Tập trung vào những thông tin AI cần để hiểu đúng vấn đề.</p></div>
        <div class="border-b border-outline-variant/30 p-5 sm:border-b-0 sm:border-r"><span class="mb-3 block text-xs font-bold text-primary">02 / AI PHÂN TÍCH</span><h2 class="font-bold text-on-surface">Làm rõ ưu tiên</h2><p class="mt-2 text-sm leading-relaxed text-on-surface-variant">Hệ thống tổng hợp bối cảnh và đặt các câu hỏi cần thiết.</p></div>
        <div class="p-5"><span class="mb-3 block text-xs font-bold text-primary">03 / NHẬN ĐẦU RA</span><h2 class="font-bold text-on-surface">Chuyển thành hành động</h2><p class="mt-2 text-sm leading-relaxed text-on-surface-variant">Nhận phân tích, tài liệu hoặc kế hoạch để tiếp tục triển khai.</p></div>
      </section>

      <!-- AI Apps -->
      {apps.length > 0 && (
        <div class="mb-16">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-500/15 flex items-center justify-center">
              <span class="material-symbols-outlined text-purple-600 dark:text-purple-400 text-[20px]">smart_toy</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-on-surface">Chọn hành trình AI</h2>
              <p class="text-sm text-on-surface-variant">Mỗi công cụ bắt đầu bằng bối cảnh của phòng khám bạn.</p>
            </div>
          </div>

          <div class="space-y-10">
            {appGroups.map((group) => group.items.length > 0 && (
              <section>
                <div class="mb-4 flex items-start gap-3">
                  <span class={`material-symbols-outlined mt-0.5 ${group.free ? 'text-emerald-500' : 'text-amber-500'}`}>{group.free ? 'check_circle' : 'lock'}</span>
                  <div><h3 class="font-bold text-on-surface">{group.title}</h3><p class="mt-0.5 text-sm text-on-surface-variant">{group.description}</p></div>
                </div>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((app) => {
              const color = appTypeColors[app.type] ?? { bg: 'bg-gray-50 dark:bg-gray-500/10', border: 'border-gray-200 dark:border-gray-500/30', text: 'text-gray-700 dark:text-gray-300' };
              const product = getAppProduct(app);
              const isFree = isAppFree(app);
              return (
                <a
                  href={`/app/${app.slug}`}
                  class="group glass-card rounded-2xl p-5 border border-outline-variant/15 hover:border-primary/40 transition-all duration-300 hover:-translate-y-0.5 flex flex-col"
                >
                   <div class="flex items-center gap-3 mb-3">
                    <div class={`w-10 h-10 rounded-xl ${color.bg} border ${color.border} flex items-center justify-center group-hover:scale-105 transition-transform`}>
                      <span class={`material-symbols-outlined ${color.text} text-[20px]`}>
                        {app.type === 'survey' ? 'quiz' : app.type === 'ebook_ai' ? 'menu_book' : app.type === 'course_ai' ? 'school' : app.type === 'tool' ? 'build' : 'auto_awesome'}
                      </span>
                    </div>
                     <div class="flex flex-1 flex-wrap items-center gap-1.5 min-w-0">
                       <span class={`text-[11px] font-bold px-2 py-0.5 rounded-md border ${color.bg} ${color.border} ${color.text}`}>
                         {appTypeLabels[app.type] ?? app.type}
                       </span>
                         <span class={`text-[11px] font-bold ${isFree ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400'}`}>{isFree ? 'Miễn phí' : product ? `Từ ${product.price.toLocaleString('vi-VN')}₫` : 'Liên hệ'}</span>
                    </div>
                  </div>

                  <h3 class="text-sm font-bold text-on-surface mb-1.5 group-hover:text-primary transition-colors truncate">
                    {app.name}
                  </h3>
                   {app.description && (
                    <p class="text-xs text-on-surface-variant leading-relaxed line-clamp-2 flex-1">
                      {app.description}
                    </p>
                   )}
                   <p class="mt-3 text-xs font-semibold text-primary">Bao gồm: đối thoại theo bước và đầu ra AI để triển khai.</p>

                  <div class="flex items-center justify-end mt-3">
                    <span class="text-xs font-bold text-primary">Bắt đầu hành trình <span class="material-symbols-outlined align-middle text-[18px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span></span>
                  </div>
                </a>
              );
            })}
                </div>
              </section>
            ))}
          </div>
        </div>
      )}

      <!-- Empty state -->
      {apps.length === 0 && (
        <div class="text-center py-20 glass-card rounded-2xl border border-outline-variant/20">
          <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-primary-container/30 dark:from-primary/20 dark:to-primary/5 flex items-center justify-center border border-primary/10">
            <span class="material-symbols-outlined text-primary/70 dark:text-primary/60 text-[40px]">smart_toy</span>
          </div>
          <h3 class="text-xl font-bold text-on-surface/80 mb-2">Chưa có công cụ AI nào</h3>
          <p class="text-sm text-on-surface-variant/70 dark:text-on-surface-variant/50 max-w-sm mx-auto leading-relaxed">
            Các công cụ AI đang được phát triển. Quay lại sau để khám phá.
          </p>
        </div>
      )}

      <!-- Back link -->
      <div class="text-center mt-12">
        <a href="/" class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors">
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          Quay về trang chủ
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ai-tools-grid {
    background-image:
      linear-gradient(rgba(27, 124, 178, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(27, 124, 178, 0.09) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 62%);
  }

  .ai-tools-circuit {
    position: absolute;
    width: 34rem;
    height: 16rem;
    border: 1px solid rgba(43, 154, 216, 0.28);
    border-radius: 50%;
    opacity: 0.7;
  }

  .ai-tools-circuit::before,
  .ai-tools-circuit::after {
    content: '';
    position: absolute;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: rgb(59, 170, 233);
    box-shadow: 0 0 16px rgba(59, 170, 233, 0.9);
  }

  .ai-tools-circuit--left {
    top: 6rem;
    left: -20rem;
    transform: rotate(-22deg);
  }

  .ai-tools-circuit--left::before { right: 4rem; top: 1.1rem; }
  .ai-tools-circuit--left::after { right: 0.5rem; bottom: 3rem; }

  .ai-tools-circuit--right {
    top: 2rem;
    right: -21rem;
    transform: rotate(24deg);
  }

  .ai-tools-circuit--right::before { left: 4rem; top: 1.1rem; }
  .ai-tools-circuit--right::after { left: 0.5rem; bottom: 3rem; }

  .ai-tools-tooth {
    position: absolute;
    width: 11rem;
    stroke: rgba(26, 145, 207, 0.25);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 18px rgba(42, 154, 216, 0.15));
  }

  .ai-tools-tooth--left { top: 12rem; left: 4%; transform: rotate(-14deg); }
  .ai-tools-tooth--right { top: 4rem; right: 5%; transform: rotate(18deg); }

  :global(.dark) .ai-tools-grid {
    background-image:
      linear-gradient(rgba(123, 205, 255, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(123, 205, 255, 0.09) 1px, transparent 1px);
  }

  :global(.dark) .ai-tools-tooth { stroke: rgba(123, 205, 255, 0.3); }

  @media (max-width: 767px) {
    .ai-tools-tooth { width: 8rem; opacity: 0.6; }
    .ai-tools-tooth--left { left: -3rem; top: 15rem; }
    .ai-tools-tooth--right { right: -3rem; top: 2rem; }
    .ai-tools-circuit { width: 24rem; }
  }
</style>
