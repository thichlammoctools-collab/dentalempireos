---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listSurveyDefinitions, type SurveyDefinition } from '../lib/survey-config-db';
import { listApps, type App } from '../lib/app-db';
import { listProducts, getScannerProductMapping } from '../lib/payos-db';

export const prerender = false;

let scanners: Awaited<ReturnType<typeof listSurveyDefinitions>> = [];
let apps: Awaited<ReturnType<typeof listApps>> = [];
let activeProducts: Awaited<ReturnType<typeof listProducts>> = [];
let scannerProductMap = new Map<string, string>();

try {
  scanners = await listSurveyDefinitions(env.DB, { status: 'active' });
} catch {
  scanners = [];
}

try {
  apps = await listApps(env.DB).then(a => a.filter(app => app.status === 'active' && app.slug !== 'ho-so-goc-re'));
} catch {
  apps = [];
}

try {
  const [products, scannerMap] = await Promise.all([
    listProducts(env.DB),
    getScannerProductMapping(env.DB),
  ]);
  activeProducts = products.filter((product) => product.is_active === 1);
  scannerProductMap = scannerMap;
} catch {
  activeProducts = [];
  scannerProductMap = new Map();
}

const appProductMap = new Map(
  activeProducts
    .filter((product) => product.app_id)
    .map((product) => [product.app_id as string, product]),
);

const isScannerPaid = (scanner: SurveyDefinition) => scannerProductMap.has(scanner.id);
const getScannerProduct = (scanner: SurveyDefinition) => {
  const productId = scannerProductMap.get(scanner.id);
  return activeProducts.find((product) => product.id === productId) ?? null;
};
const isAppPaid = (app: App) => appProductMap.has(app.id);

const typeColors: Record<string, { bg: string; border: string; text: string; icon: string }> = {
  mini:       { bg: 'bg-blue-50 dark:bg-blue-500/10',   border: 'border-blue-200 dark:border-blue-500/30',   text: 'text-blue-700 dark:text-blue-300',   icon: 'flash_on' },
  full:       { bg: 'bg-purple-50 dark:bg-purple-500/10', border: 'border-purple-200 dark:border-purple-500/30', text: 'text-purple-700 dark:text-purple-300', icon: 'radio_button_checked' },
  checklist:  { bg: 'bg-amber-50 dark:bg-amber-500/10',  border: 'border-amber-200 dark:border-amber-500/30',  text: 'text-amber-700 dark:text-amber-300',  icon: 'checklist' },
};

function getScannerColor(s: SurveyDefinition) {
  return typeColors[s.survey_type] ?? { bg: 'bg-gray-50 dark:bg-gray-500/10', border: 'border-gray-200 dark:border-gray-500/30', text: 'text-gray-700 dark:text-gray-300', icon: 'quiz' };
}

const appTypeLabels: Record<string, string> = {
  survey: 'Khảo sát',
  ebook_ai: 'Ebook AI',
  course_ai: 'Khóa học AI',
  tool: 'Công cụ',
  generator: 'Tạo nội dung',
};

const appTypeColors: Record<string, { bg: string; border: string; text: string }> = {
  survey:    { bg: 'bg-purple-50 dark:bg-purple-500/10', border: 'border-purple-200 dark:border-purple-500/30', text: 'text-purple-700 dark:text-purple-300' },
  ebook_ai:  { bg: 'bg-blue-50 dark:bg-blue-500/10',   border: 'border-blue-200 dark:border-blue-500/30',   text: 'text-blue-700 dark:text-blue-300' },
  course_ai: { bg: 'bg-green-50 dark:bg-green-500/10',  border: 'border-green-200 dark:border-green-500/30',  text: 'text-green-700 dark:text-green-300' },
  tool:      { bg: 'bg-amber-50 dark:bg-amber-500/10',  border: 'border-amber-200 dark:border-amber-500/30',  text: 'text-amber-700 dark:text-amber-300' },
  generator: { bg: 'bg-pink-50 dark:bg-pink-500/10',   border: 'border-pink-200 dark:border-pink-500/30',   text: 'text-pink-700 dark:text-pink-300' },
};

const scannerGroups = [
  { title: 'Scanner miễn phí', description: 'Khảo sát nhanh để nhìn ra một vấn đề cụ thể và nhận định hướng cải thiện ban đầu.', items: scanners.filter((scanner) => !isScannerPaid(scanner)), free: true },
  { title: 'Scanner chuyên sâu', description: 'Phân tích AI chuyên sâu, dành cho những vấn đề cần kế hoạch hành động và góc nhìn hệ thống.', items: scanners.filter(isScannerPaid), free: false },
];

const appGroups = [
  { title: 'AI Tools miễn phí', description: 'Công cụ hỗ trợ bạn bắt đầu, phác thảo và kiểm tra công việc nhanh hơn.', items: apps.filter((app) => !isAppPaid(app)), free: true },
  { title: 'AI Tools chuyên sâu', description: 'Công cụ có trả phí hoặc cần mở khóa để tạo ra đầu ra chuyên biệt hơn.', items: apps.filter(isAppPaid), free: false },
];
---

<BaseLayout
  title="Công cụ AI — Dental Empire OS"
  description="Scanner và AI Tools cho phòng khám nha khoa: xác định điểm nghẽn, nhận phân tích AI và tạo kế hoạch hành động cụ thể. Xem rõ công cụ miễn phí và công cụ chuyên sâu có trả phí."
  ogImage="/images/ai-tools-og.svg"
  ogImageAlt="Công cụ AI cho phòng khám - Dental Empire OS"
>
  <section class="relative overflow-hidden">
    <!-- Ambient background -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="ai-tools-grid absolute inset-0"></div>
      <div class="absolute top-0 inset-x-0 h-[560px]" style="background: radial-gradient(ellipse 70% 55% at 50% -8%, rgba(0,139,210,0.16), transparent 68%);"></div>
      <div class="ai-tools-circuit ai-tools-circuit--left"></div>
      <div class="ai-tools-circuit ai-tools-circuit--right"></div>
      <svg class="ai-tools-tooth ai-tools-tooth--left" viewBox="0 0 160 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M43 19c18-11 56-11 74 0 18 11 26 35 18 57-6 16-14 25-17 46l-8 42c-2 11-17 11-19 1l-8-34c-1-5-5-8-10-8s-9 3-10 8l-8 34c-2 10-17 10-19-1l-8-42c-3-21-11-30-17-46-8-22 0-46 18-57Z" />
        <path d="M43 60c20 11 54 11 74 0M73 28v30M57 38l16 20 16-20" />
      </svg>
      <svg class="ai-tools-tooth ai-tools-tooth--right" viewBox="0 0 160 180" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M43 19c18-11 56-11 74 0 18 11 26 35 18 57-6 16-14 25-17 46l-8 42c-2 11-17 11-19 1l-8-34c-1-5-5-8-10-8s-9 3-10 8l-8 34c-2 10-17 10-19-1l-8-42c-3-21-11-30-17-46-8-22 0-46 18-57Z" />
        <path d="M43 60c20 11 54 11 74 0M73 28v30M57 38l16 20 16-20" />
      </svg>
    </div>

    <div class="relative max-w-5xl mx-auto px-4 pt-16 pb-20">
      <!-- Hero -->
      <header class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 text-amber-700 dark:text-amber-400 text-xs font-bold mb-6">
          <span class="material-symbols-outlined text-[14px]">auto_awesome</span>
          Công cụ AI
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-on-surface mb-6 leading-tight">
          Trí tuệ AI<br />
          <span class="bg-gradient-to-r from-primary to-cyan-600 dark:from-primary dark:to-cyan-400 bg-clip-text text-transparent">cho phòng khám</span>
          <br />của bạn
        </h1>
        <p class="text-on-surface-variant text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
          Xác định điểm nghẽn, nhận phân tích rõ ràng và biết việc cần làm tiếp theo cho phòng khám của bạn.
        </p>
      </header>

      <!-- This concise overview is intentionally suitable for OG screenshots. -->
      <section class="mb-16 overflow-hidden rounded-3xl border border-primary/25 bg-gradient-to-br from-primary/10 via-surface-container to-amber-500/5 p-6 md:p-8">
        <div class="flex flex-col gap-7 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Dental Empire OS · AI Workspace</p>
            <h2 class="mt-2 text-2xl font-black text-on-surface md:text-3xl">Từ “đang rối ở đâu?” đến hành động rõ ràng.</h2>
            <p class="mt-3 leading-relaxed text-on-surface-variant">Scanner giúp bạn đo lường thực trạng. AI Tools giúp biến dữ liệu, ý tưởng và kiến thức thành nội dung hoặc quyết định có thể triển khai.</p>
          </div>
          <div class="grid shrink-0 grid-cols-3 gap-2 text-center text-xs">
            <div class="rounded-2xl bg-surface-container-lowest/80 px-3 py-3"><span class="material-symbols-outlined block text-primary">fact_check</span><b class="mt-1 block text-on-surface">Đánh giá</b><span class="text-on-surface-variant">điểm nghẽn</span></div>
            <div class="rounded-2xl bg-surface-container-lowest/80 px-3 py-3"><span class="material-symbols-outlined block text-primary">psychology</span><b class="mt-1 block text-on-surface">Phân tích</b><span class="text-on-surface-variant">cùng AI</span></div>
            <div class="rounded-2xl bg-surface-container-lowest/80 px-3 py-3"><span class="material-symbols-outlined block text-primary">route</span><b class="mt-1 block text-on-surface">Hành động</b><span class="text-on-surface-variant">có ưu tiên</span></div>
          </div>
        </div>
        <div class="mt-6 flex flex-wrap gap-3 text-sm">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3 py-1.5 font-semibold text-emerald-700 dark:text-emerald-300"><span class="material-symbols-outlined text-[16px]">check_circle</span> Miễn phí: bắt đầu quét và nhận định hướng</span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/25 bg-amber-500/10 px-3 py-1.5 font-semibold text-amber-700 dark:text-amber-300"><span class="material-symbols-outlined text-[16px]">lock</span> Chuyên sâu: cần mua hoặc mở khóa để dùng</span>
        </div>
      </section>

      <!-- Scanner Cards -->
      {scanners.length > 0 && (
        <div class="mb-16">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-500/15 flex items-center justify-center">
              <span class="material-symbols-outlined text-amber-600 dark:text-amber-400 text-[20px]">psychology</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-on-surface">Máy quét tự chẩn đoán</h2>
              <p class="text-sm text-on-surface-variant">Scanner — đánh giá toàn diện với AI phân tích</p>
            </div>
          </div>

          <div class="space-y-10">
            {scannerGroups.map((group) => group.items.length > 0 && (
              <section>
                <div class="mb-4 flex items-start gap-3">
                  <span class={`material-symbols-outlined mt-0.5 ${group.free ? 'text-emerald-500' : 'text-amber-500'}`}>{group.free ? 'check_circle' : 'lock'}</span>
                  <div><h3 class="font-bold text-on-surface">{group.title}</h3><p class="mt-0.5 text-sm text-on-surface-variant">{group.description}</p></div>
                </div>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {group.items.map((s) => {
              const color = getScannerColor(s);
              const product = getScannerProduct(s);
              return (
                <a
                  href={`/scanner/${s.slug}`}
                  class="group glass-card rounded-2xl p-6 border border-outline-variant/20 hover:border-primary/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:hover:shadow-[0_0_40px_rgba(146,204,255,0.12)] flex flex-col"
                >
                  <div class="flex items-start justify-between gap-3 mb-4">
                    <div class={`w-12 h-12 rounded-xl ${color.bg} border ${color.border} flex items-center justify-center group-hover:scale-110 transition-transform`}>
                      <span class={`material-symbols-outlined ${color.text} text-[22px]`}>{color.icon}</span>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class={`inline-block px-2 py-0.5 rounded-md text-[11px] font-bold border ${color.bg} ${color.border} ${color.text}`}>
                        {s.survey_type}
                      </span>
                      {!product ? (
                        <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-600 dark:text-green-400">
                          <span class="material-symbols-outlined text-[12px]">verified</span>
                          Miễn phí
                        </span>
                      ) : (
                        <span class="text-xs font-semibold text-amber-600 dark:text-amber-400">{product.price.toLocaleString('vi-VN')}₫</span>
                      )}
                    </div>
                  </div>

                  <h3 class="text-lg font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">
                    {s.title_vi}
                  </h3>
                    <p class="text-sm text-on-surface-variant leading-relaxed flex-1 line-clamp-3">
                      {s.description_vi ?? 'Đánh giá toàn diện giúp bạn hiểu rõ thực trạng và tiềm năng phát triển của phòng khám.'}
                    </p>

                    <p class="mt-3 text-xs font-semibold text-primary">Kết quả: điểm đánh giá, điểm cần ưu tiên và gợi ý hành động.</p>

                  <div class="flex items-center justify-between mt-5 pt-4 border-t border-outline-variant/10">
                    <div class="flex items-center gap-2 text-xs text-on-surface-variant/60">
                      <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                      Bắt đầu quét
                    </div>
                    <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">arrow_forward</span>
                  </div>
                </a>
              );
            })}
                </div>
              </section>
            ))}
          </div>
        </div>
      )}

      <!-- Other AI Apps -->
      {apps.length > 0 && (
        <div class="mb-16">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-500/15 flex items-center justify-center">
              <span class="material-symbols-outlined text-purple-600 dark:text-purple-400 text-[20px]">smart_toy</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-on-surface">Ứng dụng AI khác</h2>
              <p class="text-sm text-on-surface-variant">Ebook, khóa học, công cụ và generator</p>
            </div>
          </div>

          <div class="space-y-10">
            {appGroups.map((group) => group.items.length > 0 && (
              <section>
                <div class="mb-4 flex items-start gap-3">
                  <span class={`material-symbols-outlined mt-0.5 ${group.free ? 'text-emerald-500' : 'text-amber-500'}`}>{group.free ? 'check_circle' : 'lock'}</span>
                  <div><h3 class="font-bold text-on-surface">{group.title}</h3><p class="mt-0.5 text-sm text-on-surface-variant">{group.description}</p></div>
                </div>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((app) => {
              const color = appTypeColors[app.type] ?? { bg: 'bg-gray-50 dark:bg-gray-500/10', border: 'border-gray-200 dark:border-gray-500/30', text: 'text-gray-700 dark:text-gray-300' };
              const product = appProductMap.get(app.id);
              return (
                <a
                  href={`/app/${app.slug}`}
                  class="group glass-card rounded-2xl p-5 border border-outline-variant/15 hover:border-primary/40 transition-all duration-300 hover:-translate-y-0.5 flex flex-col"
                >
                   <div class="flex items-center gap-3 mb-3">
                    <div class={`w-10 h-10 rounded-xl ${color.bg} border ${color.border} flex items-center justify-center group-hover:scale-105 transition-transform`}>
                      <span class={`material-symbols-outlined ${color.text} text-[20px]`}>
                        {app.type === 'survey' ? 'quiz' : app.type === 'ebook_ai' ? 'menu_book' : app.type === 'course_ai' ? 'school' : app.type === 'tool' ? 'build' : 'auto_awesome'}
                      </span>
                    </div>
                     <div class="flex flex-1 flex-wrap items-center gap-1.5 min-w-0">
                       <span class={`text-[11px] font-bold px-2 py-0.5 rounded-md border ${color.bg} ${color.border} ${color.text}`}>
                         {appTypeLabels[app.type] ?? app.type}
                       </span>
                        <span class={`text-[11px] font-bold ${product ? 'text-amber-600 dark:text-amber-400' : 'text-emerald-600 dark:text-emerald-400'}`}>{product ? `${product.price.toLocaleString('vi-VN')}₫` : 'Miễn phí'}</span>
                    </div>
                  </div>

                  <h3 class="text-sm font-bold text-on-surface mb-1.5 group-hover:text-primary transition-colors truncate">
                    {app.name}
                  </h3>
                   {app.description && (
                    <p class="text-xs text-on-surface-variant leading-relaxed line-clamp-2 flex-1">
                      {app.description}
                    </p>
                   )}
                   <p class="mt-3 text-xs font-semibold text-primary">Kết quả: đầu ra AI để bạn tiếp tục chỉnh sửa hoặc triển khai.</p>

                  <div class="flex items-center justify-end mt-3">
                    <span class="material-symbols-outlined text-primary text-[18px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                  </div>
                </a>
              );
            })}
                </div>
              </section>
            ))}
          </div>
        </div>
      )}

      <!-- Empty state -->
      {scanners.length === 0 && apps.length === 0 && (
        <div class="text-center py-20 glass-card rounded-2xl border border-outline-variant/20">
          <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-primary-container/30 dark:from-primary/20 dark:to-primary/5 flex items-center justify-center border border-primary/10">
            <span class="material-symbols-outlined text-primary/70 dark:text-primary/60 text-[40px]">smart_toy</span>
          </div>
          <h3 class="text-xl font-bold text-on-surface/80 mb-2">Chưa có công cụ AI nào</h3>
          <p class="text-sm text-on-surface-variant/70 dark:text-on-surface-variant/50 max-w-sm mx-auto leading-relaxed">
            Các công cụ AI đang được phát triển. Quay lại sau để khám phá.
          </p>
        </div>
      )}

      <!-- Back link -->
      <div class="text-center mt-12">
        <a href="/" class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors">
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          Quay về trang chủ
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ai-tools-grid {
    background-image:
      linear-gradient(rgba(27, 124, 178, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(27, 124, 178, 0.09) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 62%);
  }

  .ai-tools-circuit {
    position: absolute;
    width: 34rem;
    height: 16rem;
    border: 1px solid rgba(43, 154, 216, 0.28);
    border-radius: 50%;
    opacity: 0.7;
  }

  .ai-tools-circuit::before,
  .ai-tools-circuit::after {
    content: '';
    position: absolute;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: rgb(59, 170, 233);
    box-shadow: 0 0 16px rgba(59, 170, 233, 0.9);
  }

  .ai-tools-circuit--left {
    top: 6rem;
    left: -20rem;
    transform: rotate(-22deg);
  }

  .ai-tools-circuit--left::before { right: 4rem; top: 1.1rem; }
  .ai-tools-circuit--left::after { right: 0.5rem; bottom: 3rem; }

  .ai-tools-circuit--right {
    top: 2rem;
    right: -21rem;
    transform: rotate(24deg);
  }

  .ai-tools-circuit--right::before { left: 4rem; top: 1.1rem; }
  .ai-tools-circuit--right::after { left: 0.5rem; bottom: 3rem; }

  .ai-tools-tooth {
    position: absolute;
    width: 11rem;
    stroke: rgba(26, 145, 207, 0.25);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 18px rgba(42, 154, 216, 0.15));
  }

  .ai-tools-tooth--left { top: 12rem; left: 4%; transform: rotate(-14deg); }
  .ai-tools-tooth--right { top: 4rem; right: 5%; transform: rotate(18deg); }

  :global(.dark) .ai-tools-grid {
    background-image:
      linear-gradient(rgba(123, 205, 255, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(123, 205, 255, 0.09) 1px, transparent 1px);
  }

  :global(.dark) .ai-tools-tooth { stroke: rgba(123, 205, 255, 0.3); }

  @media (max-width: 767px) {
    .ai-tools-tooth { width: 8rem; opacity: 0.6; }
    .ai-tools-tooth--left { left: -3rem; top: 15rem; }
    .ai-tools-tooth--right { right: -3rem; top: 2rem; }
    .ai-tools-circuit { width: 24rem; }
  }
</style>
